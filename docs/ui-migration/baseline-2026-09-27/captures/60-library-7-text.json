[{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Echoes/vert/Title/Hori/Title","text":"Echoes"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/Quests/Quests_Button/Text (TMP)","text":"Quests"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Retreating/vert/Title/Hori/Title","text":"Retreating"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Roadmap/vert/Title/Hori/Title","text":"Roadmap"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/Hub_Dropdown/hub_Button/Text (TMP)","text":"Hub"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Disciples/vert/Title/Hori/Title","text":"Alter Echoes"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/Library/Wiki_Button/Text (TMP)","text":"Library"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Reaping/vert/Title/Hori/Title","text":"Reaping"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/Begin Adventure/BeginAdventure_Button/Text (TMP)","text":"Adventure"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/TownsFolk/Townsfolk_Button/Text (TMP)","text":"Townsfolk"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Buffs/vert/Title/Hori/Title","text":"Buffs"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Tasks (1)/vert/Title/Hori/Title","text":"Patch Notes"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Tasks/vert/Title/Hori/Title","text":"Tasks\n"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Combat/vert/Title/Hori/Title","text":"Combat\n"},{"path":"Canvas/SafeArea/TownUI/TownButtons/RunButtonsDadJoke/DadJoke/Dad-O'cado/Text (TMP)","text":"Dad-O-Cado"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Items/vert/Title/Hori/Title","text":"Item Tiers"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Cauldron/vert/Title/Hori/Title","text":"Cauldron"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Quests/vert/Title/Hori/Title","text":"Quests"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Echoes/vert/Title/Image/Detail","text":"Echoes are alternate versions of Caleb who will shift slightly into his reality to help out under various circumstances.\n\nEach echo can have a combination of Caleb's skillset. But most Echoes won't have them all.\n\nThe main difference in Echo behaviour comes from whether or not they are combat enabled.\nCombat-enabled Echoes have two different styles depending on whether or not they can also complete tasks. \n\nA combat-enabled Echo that does NOT have the ability to do tasks will seek out enemies specifically.\nA combat-enabled Echo that DOES have the ability to do tasks will prioritize tasks over combat and only engage enemies that see them.\n\nEchoes that do not have combat will not be targeted by or target enemies.\n\nDev Note | Right now there are no echoes in the game that can do both combat and tasks. Echoes from Milestones specifically seek out tasks for that skills milestone EG an echo spawned with woodcutting will only seek out woodcutting tasks."},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Forge/vert/Title/Hori/Title","text":"Forge"}]