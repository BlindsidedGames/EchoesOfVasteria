[{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Echoes/vert/Title/Hori/Title","text":"Echoes"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/Quests/Quests_Button/Text (TMP)","text":"Quests"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Retreating/vert/Title/Hori/Title","text":"Retreating"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Roadmap/vert/Title/Hori/Title","text":"Roadmap"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/Hub_Dropdown/hub_Button/Text (TMP)","text":"Hub"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Disciples/vert/Title/Hori/Title","text":"Alter Echoes"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/Library/Wiki_Button/Text (TMP)","text":"Library"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Reaping/vert/Title/Hori/Title","text":"Reaping"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/Begin Adventure/BeginAdventure_Button/Text (TMP)","text":"Adventure"},{"path":"Canvas/SafeArea/UnifiedWindow/TopBar/WindowButtons/TownsFolk/Townsfolk_Button/Text (TMP)","text":"Townsfolk"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Buffs/vert/Title/Hori/Title","text":"Buffs"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Forge/vert/Title/Image/Detail","text":"Ivan's forge is a magical place. Whether you're chilling in town or out on the road, you can help guide him as he improves his smithing skills.\n\nYou have access to two toggles while forging:\n\n<b>Stop for Vastium:</b> Always stops if you roll a Vastium piece, even if it is a downgrade.\n\n<b>Stat Matching:</b> With this enabled, the forge will continue to work until an upgrade has the exact same stat types as your equipped piece of gear.\n\nQuality is represented by this icon: <sprite=206>\n\nThis is where you craft gear and choose the best stats for your build. \nRight now there are 8 stats that can be rolled on gear with each piece guaranteeing a specific one.\n\n<sprite=198> = Damage.\n<sprite=200> = Attack Speed.\n<sprite=199> = Crit Chance.\n<sprite=205> = Crit Damage.  \n\n<sprite=202> = Health.\n<sprite=203> = Regen.\n<sprite=201> = Defense.\n<sprite=204> = Movement.\n\n<sprite=192> = Upgrade.\n<sprite=193> = Downgrade. \n<sprite=194> = No change.\n<sprite=195> Stat is not on new item.\n<sprite=196> Stat is not on old item.\n\n<b>Weapon</b> | Guarantees <sprite=198>\n<b>Helmet</b> | Guarantees <sprite=202>\n<b>Chest</b> | Guarantees <sprite=201>\n<b>Boots</b> | Guarantees <sprite=204> which is exclusive to this slot.\n\nGear is automatically salvaged when you craft a new piece, select a different slot, or close the game.\n\nDepending on rarity you can receive up to 5 stats on a piece of gear. There are plans to add additional stats to gear in the future!"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Tasks (1)/vert/Title/Hori/Title","text":"Patch Notes"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Tasks/vert/Title/Hori/Title","text":"Tasks\n"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Combat/vert/Title/Hori/Title","text":"Combat\n"},{"path":"Canvas/SafeArea/TownUI/TownButtons/RunButtonsDadJoke/DadJoke/Dad-O'cado/Text (TMP)","text":"Dad-O-Cado"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Items/vert/Title/Hori/Title","text":"Item Tiers"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Cauldron/vert/Title/Hori/Title","text":"Cauldron"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Quests/vert/Title/Hori/Title","text":"Quests"},{"path":"Canvas/SafeArea/UnifiedWindow/TownWIndows/Library_Window/Image/ScrollViews/Quests_SV/Viewport/Content/Forge/vert/Title/Hori/Title","text":"Forge"}]