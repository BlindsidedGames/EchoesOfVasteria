    m_Localized: "\xA1Nueva mejora!\u2014Velocidad de tareas: +25\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904150
    m_Localized: "Velocidad de tareas: +25\_%<sprite=194>50\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904153
    m_Localized: "Velocidad de tareas: +50\_%<sprite=194>75\_%."
