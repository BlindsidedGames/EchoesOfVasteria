%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Quests_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: f47e1bc3466d50a44a1f557a2552b815, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 53574254592
    m_Localized: You get this one for free!
    m_Metadata:
      m_Items: []
  - m_Id: 689627873280
    m_Localized: "You wake as if from a dream, gentle words fade into the distance
      drifting away on the winds of time. \n\"Begin this journey, see it through
      and I shall release you from this realm\" - The Vast One"
    m_Metadata:
      m_Items: []
  - m_Id: 723614318592
    m_Localized: Access to more quests!
    m_Metadata:
      m_Items: []
  - m_Id: 4299472388096
    m_Localized: Which Witch?
    m_Metadata:
      m_Items: []
  - m_Id: 4344246583296
    m_Localized: Eva's Magic Watering Can!
    m_Metadata:
      m_Items: []
  - m_Id: 4318774575104
    m_Localized: '"Take my magic watering can and fetch some radishes for my jam"
      - Eva'
    m_Metadata:
      m_Items: []
  - m_Id: 4506201243648
    m_Localized: An Intro to Reaping
    m_Metadata:
      m_Items: []
  - m_Id: 4508550053888
    m_Localized: '"Carl the Reaper will ensure you don''t stray too far from the
      town. As you assist the townsfolk he will gradually loosen the leash" - The
      Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 4510643011584
    m_Localized: 'You can now enter The Farmlands!

      Reap distance increased
      by 50.'
    m_Metadata:
      m_Items: []
  - m_Id: 4640641269760
    m_Localized: A Matter of Health
    m_Metadata:
      m_Items: []
  - m_Id: 4642964914176
    m_Localized: '"Collect resources for me and I will cook you up a hearty treat!"
      - Eva'
    m_Metadata:
      m_Items: []
  - m_Id: 4644424531968
    m_Localized: 0.5% Increased Alter-Echo power
    m_Metadata:
      m_Items: []
  - m_Id: 4796379971584
    m_Localized: An Old Timer
    m_Metadata:
      m_Items: []
  - m_Id: 4801358610432
    m_Localized: '"Heh, this guy''s almost been here as long as me. You can find
      him in the Woods, Barkley probably shouldn''t be prospecting anyways" - The
      Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 4802210054144
    m_Localized: Reap Distance increased by 20.
    m_Metadata:
      m_Items: []
  - m_Id: 4904353939456
    m_Localized: '"In this realm Ivan is your brother. He will assist you in upgrading
      your various stats, but you will need to gather the resources he needs" - The
      Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 4905721282560
    m_Localized: Reap distance increased by 25.
    m_Metadata:
      m_Items: []
  - m_Id: 4902881738752
    m_Localized: Meeting Ivan
    m_Metadata:
      m_Items: []
  - m_Id: 5136814850048
    m_Localized: '"I may be old but I know me stuff. The metals you find down here
      will make ye speedy. If ye help me gather some I will share my secrets with
      Ivan" - The Old Timer'
    m_Metadata:
      m_Items: []
  - m_Id: 5135506227200
    m_Localized: Rock and Stone
    m_Metadata:
      m_Items: []
  - m_Id: 5137989255168
    m_Localized: You can now enter The Mines.
    m_Metadata:
      m_Items: []
  - m_Id: 5292075401216
    m_Localized: The Name's Gill
    m_Metadata:
      m_Items: []
  - m_Id: 5293610516480
    m_Localized: '"Hows it goin'' mate? Just got back from the best fishin'' trip
      of me life. What''s that? You''ve never been fishing!? Here, take me spare
      rod and fish up some Flippy Floppy for Mildred. They can be found just about
      anywhere!" - Gill'
    m_Metadata:
      m_Items: []
  - m_Id: 5294684258304
    m_Localized: 'You can now catch fish! '
    m_Metadata:
      m_Items: []
  - m_Id: 5493825617920
    m_Localized: Into The Woods
    m_Metadata:
      m_Items: []
  - m_Id: 5582187020288
    m_Localized: A Sturdier Frame
    m_Metadata:
      m_Items: []
  - m_Id: 5495314595840
    m_Localized: '"Here, take my spare axe and go into them woods. We''ll need at
      least 10 logs to get this frame started" - Barkley'
    m_Metadata:
      m_Items: []
  - m_Id: 5496426086400
    m_Localized: Unlocks the Alter-Echoes screen!
    m_Metadata:
      m_Items: []
  - m_Id: 5583185264640
    m_Localized: '"Much appreciated lad! Now''s time to reinforce this thing, if
      you don''t mind fetching me another few logs?" - Barkley'
    m_Metadata:
      m_Items: []
  - m_Id: 5583919267840
    m_Localized: Reaping distance increased by 10.
    m_Metadata:
      m_Items: []
  - m_Id: 6023255834624
    m_Localized: Putting up Walls
    m_Metadata:
      m_Items: []
  - m_Id: 6024656732160
    m_Localized: '"Wow, you''re a real help! While I get started on these walls would
      you mind grabbing some more logs for the roof?" - Barkley'
    m_Metadata:
      m_Items: []
  - m_Id: 6025701113856
    m_Localized: Reaping distance increased by 10.
    m_Metadata:
      m_Items: []
  - m_Id: 6098321293312
    m_Localized: Adding a Roof
    m_Metadata:
      m_Items: []
  - m_Id: 6099218874368
    m_Localized: '"You''re simply the best. Not much to go now! I''ll get this roof
      on and then we will get started on the walls" - Barkley '
    m_Metadata:
      m_Items: []
  - m_Id: 6100049346560
    m_Localized: Reaping distance increased by 25.
    m_Metadata:
      m_Items: []
  - m_Id: 6386549669888
    m_Localized: Finishing Touches
    m_Metadata:
      m_Items: []
  - m_Id: 6388466466816
    m_Localized: '"The Old Timer suggested reinforcing my walls with Stone! What
      a fantastic idea! You don''t mind helping me out one last time do you?" - Barkley'
    m_Metadata:
      m_Items: []
  - m_Id: 6390102245376
    m_Localized: 1% Increased Alter-Echo power
    m_Metadata:
      m_Items: []
  - m_Id: 6568989310976
    m_Localized: Another Magicool Gift
    m_Metadata:
      m_Items: []
  - m_Id: 6571346509824
    m_Localized: '"Seek out Barkley, he''s been searching for the perfect lumber
      and you can find him in the Farmlands" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 6572961316864
    m_Localized: 'You can now enter The Woods!

      Reaping distance increased
      by 25.'
    m_Metadata:
      m_Items: []
  - m_Id: 6905842253824
    m_Localized: A Slime in Time
    m_Metadata:
      m_Items: []
  - m_Id: 6922204233728
    m_Localized: '"Drive back the slimes in the surrounding area and I shall allow
      you to travel further" - Carl'
    m_Metadata:
      m_Items: []
  - m_Id: 6943423217664
    m_Localized: Reaping distance increased by 50.
    m_Metadata:
      m_Items: []
  - m_Id: 7063816519680
    m_Localized: Protect the Town
    m_Metadata:
      m_Items: []
  - m_Id: 7083122900992
    m_Localized: '"I''ve left an artifact with Ivan. Clear out the additional slimes
      surrounding the town and I am sure he will give it to you" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 7084691570688
    m_Localized: Magic Dice - Provides combat advantages!
    m_Metadata:
      m_Items: []
  - m_Id: 7243521474560
    m_Localized: Strange Patterns
    m_Metadata:
      m_Items: []
  - m_Id: 7244716851200
    m_Localized: '"Much obliged sir, you''re welcome to grow our corn crops any time
      you need some. Wait whats that!? I''ve never seen a Radish grow like that before!
      It seems to be connected to you somehow! I''d love to see where this goes.
      Fetch me some Corn and I will teach you how to grow Wheat" - Tillman'
    m_Metadata:
      m_Items: []
  - m_Id: 7245635403776
    m_Localized: Unlock the Wheat crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7520072908800
    m_Localized: Too Big to Handle
    m_Metadata:
      m_Items: []
  - m_Id: 7521440251904
    m_Localized: '"There''s no way we can get that many radishes in time for Eva...
      Oh! I see you have her magic watering can! If you gather me 100 Radishes I''d
      happily get Tillman to teach you a thing or two about Corn" - Flora'
    m_Metadata:
      m_Items: []
  - m_Id: 7522576908288
    m_Localized: Unlock the Corn crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7639480549376
    m_Localized: "<i>Giggles</i> \"Thanks for helping with all that wheat Tillman\u2019s
      been setting out. I\u2019d like to make a refreshing drink for the whole town.
      I\u2019ll set out some watermelones; would you mind growing them for me?\"
      - Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7638297755648
    m_Localized: Set the Rows
    m_Metadata:
      m_Items: []
  - m_Id: 7640587845632
    m_Localized: Unlock the Carrot crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7872075677696
    m_Localized: Some Like It Hot
    m_Metadata:
      m_Items: []
  - m_Id: 7873216528384
    m_Localized: "\u201CYou\u2019ve been such a help. Could you fetch me some of
      those peppers? I\u2019d like to send Eva a gift basket\u2014she absolutely
      adores them.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7874336407552
    m_Localized: Unlock the Chili crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7954296619008
    m_Localized: Cool as a Cucumber
    m_Metadata:
      m_Items: []
  - m_Id: 7955139674112
    m_Localized: "\u201CLet\u2019s whip up a salad to surprise Eva. Fetch us some
      tomatoes and lettuce, and we\u2019ll see what we can do.\u201D \u2014 Flora
      & Tillman "
    m_Metadata:
      m_Items: []
  - m_Id: 7955957563392
    m_Localized: Unlock the Cucumber crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7955958563392
    m_Localized: A Fishy Situation
    m_Metadata:
      m_Items: []
  - m_Id: 7955959563392
    m_Localized: '"It looks like Mildred has taken a liking to you! I bet if you
      give her some of your Flippy Floppys she will happily help you out on your
      travels!" - Eva'
    m_Metadata:
      m_Items: []
  - m_Id: 7955960563392
    m_Localized: 'Mildred follows and provides you with buffs!

      Task & Combat
      Echo buffs.'
    m_Metadata:
      m_Items: []
  - m_Id: 7955966563392
    m_Localized: Another buff slot.
    m_Metadata:
      m_Items: []
  - m_Id: 7955967563392
    m_Localized: Mew
    m_Metadata:
      m_Items: []
  - m_Id: 7955969563392
    m_Localized: Another buff slot.
    m_Metadata:
      m_Items: []
  - m_Id: 7955976563392
    m_Localized: Chunky Business
    m_Metadata:
      m_Items: []
  - m_Id: 7955977563392
    m_Localized: '"*Grumbles* This town could sure use a better footing. Go fetch
      some Nori Chunks and we will get started on some pathing" - The Old Timer'
    m_Metadata:
      m_Items: []
  - m_Id: 7955978563392
    m_Localized: 'Unlocks Dlog nodes.

      Reaping distance increased by 25.'
    m_Metadata:
      m_Items: []
  - m_Id: 7955985563392
    m_Localized: Echo Casting
    m_Metadata:
      m_Items: []
  - m_Id: 7955986563392
    m_Localized: '"As you use these buffs more often, my power will feel more natural
      to you and echoes from your past will cast them for you" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 7955987563392
    m_Localized: Autocast buff slot 1 is now togglable.
    m_Metadata:
      m_Items: []
  - m_Id: 7956029563392
    m_Localized: Another buff slot!
    m_Metadata:
      m_Items: []
  - m_Id: 7956033563392
    m_Localized: The 100
    m_Metadata:
      m_Items: []
  - m_Id: 7956034563392
    m_Localized: '"Each slot will require more casts than the last to unlock. Such
      is the nature of Echo Casting..." - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 7956035563392
    m_Localized: Autocast buff slot 2 is now togglable.
    m_Metadata:
      m_Items: []
  - m_Id: 7956036563392
    m_Localized: A lap, and a Feast
    m_Metadata:
      m_Items: []
  - m_Id: 7956038563392
    m_Localized: Another buff slot!
    m_Metadata:
      m_Items: []
  - m_Id: 7956039563392
    m_Localized: Coping Strategies
    m_Metadata:
      m_Items: []
  - m_Id: 7956040563392
    m_Localized: "\"What's that you've got there? Pretty shiny and blue\u2014Lirium,
      eh? I bet I could forge some top-tier upgrades with that stuff! Could you fetch
      me some more?\" \u2014 Ivan"
    m_Metadata:
      m_Items: []
  - m_Id: 7956041563392
    m_Localized: Unlocks Copium nodes.
    m_Metadata:
      m_Items: []
  - m_Id: 7956042563392
    m_Localized: Stoking the Flames
    m_Metadata:
      m_Items: []
  - m_Id: 7956043563392
    m_Localized: "*Chuckles* \"Hah! You actually did it\u2014well I'll be damned.
      Bring me some of that Dlog ore and we'll see about getting Ivan's forge improved!\"
      - The Old Timer"
    m_Metadata:
      m_Items: []
  - m_Id: 7956044563392
    m_Localized: Unlocks Erif nodes.
    m_Metadata:
      m_Items: []
  - m_Id: 7956045563392
    m_Localized: Ring Leader
    m_Metadata:
      m_Items: []
  - m_Id: 7956046563392
    m_Localized: "\u201CStrawberries are about the sweetest fruit we know. You\u2019re
      almost a master farmer now, and I think it\u2019s time for a reward.\u201D
      \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956047563392
    m_Localized: Unlock the Funion crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956048563392
    m_Localized: Full Steam Ahead
    m_Metadata:
      m_Items: []
  - m_Id: 7956049563392
    m_Localized: "\u201CPheeewwww! Well then, that green stuff\u2019s got a bit of
      a kick\u2014these minecarts\u2019ll be moving faster than Eva on a broom! What
      say ye mine some more Copium and we\u2019ll see how much deeper we can get.\u201D
      \u2014 The Old Timer"
    m_Metadata:
      m_Items: []
  - m_Id: 7956050563392
    m_Localized: Unlocks Idle nodes.
    m_Metadata:
      m_Items: []
  - m_Id: 7956051563392
    m_Localized: Leek the Deal
    m_Metadata:
      m_Items: []
  - m_Id: 7956052563392
    m_Localized: "\u201CGill promised to trade us a new plant he found on his travels
      in exchange for some cucumbers! You don\u2019t mind fetching me some do you?\u201D
      \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956053563392
    m_Localized: Unlock the Leek crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956054563392
    m_Localized: Leaf It To Me
    m_Metadata:
      m_Items: []
  - m_Id: 7956055563392
    m_Localized: "\u201CAt this point you know the drill \u2014 walk with me while
      I set these tomato seeds, will you? Bring me some of your juiciest Tomatoes
      and I\u2019ll show you the secret to growing crisp, refreshing Lettuce.\u201D
      \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956056563392
    m_Localized: Unlock the Lettuce crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956057563392
    m_Localized: Fueling Forges
    m_Metadata:
      m_Items: []
  - m_Id: 7956058563392
    m_Localized: "\"I'm beginning to like you, young one. Now that the forge can
      handle it, fetch some of that Erif you spotted\u2014It\u2019ll get the forge
      burning hotter than anything this side of the sun.\" \u2014 The Old Timer"
    m_Metadata:
      m_Items: []
  - m_Id: 7956059563392
    m_Localized: Unlocks Lirium nodes.
    m_Metadata:
      m_Items: []
  - m_Id: 7956060563392
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 7956061563392
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 7956062563392
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 7956063563392
    m_Localized: Root Awakening
    m_Metadata:
      m_Items: []
  - m_Id: 7956064563392
    m_Localized: "\u201CGill says they\u2019re called leeks\u2014whatever that means!
      Anyway, the rabbits are hungry; let\u2019s see if they like them.\u201D \u2014
      Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956065563392
    m_Localized: Unlock the Parsnip crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956066563392
    m_Localized: Pepper Upper
    m_Metadata:
      m_Items: []
  - m_Id: 7956067563392
    m_Localized: "\u201CUh\u2026 we definitely shouldn\u2019t feed leeks to the rabbits.
      Luckily Eva was here to help. I think we\u2019ll stick to parsnip for now \u2014
      please, please get some for my babies.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956068563392
    m_Localized: Unlock the Pepper crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956069563392
    m_Localized: Gourd Deeds
    m_Metadata:
      m_Items: []
  - m_Id: 7956070563392
    m_Localized: "\u201CBeats me why The Old Timer likes this stuff, but he promised
      us some Pumking seeds if we help him out.\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956071563392
    m_Localized: Unlock the Pumking crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956072563392
    m_Localized: Roots of the Matter
    m_Metadata:
      m_Items: []
  - m_Id: 7956073563392
    m_Localized: "\"That watermelone juice hit the spot\u2014reminds me of the old
      days when I wanted to try carrot juice. How about I set out some seeds and
      you help me try this out? Bring the carrots in and let\u2019s see where this
      goes.\" - Roots of the Matter"
    m_Metadata:
      m_Items: []
  - m_Id: 7956074563392
    m_Localized: Unlock the Spud crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956075563392
    m_Localized: Berry Scary
    m_Metadata:
      m_Items: []
  - m_Id: 7956076563392
    m_Localized: "\u201CPumkings make perfect scarecrow heads. Fetch us some and
      we\u2019ll help you keep the pests away.\u201D \u2014 Flora & Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956077563392
    m_Localized: Unlock the Strawberry crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956078563392
    m_Localized: Vine and Dine
    m_Metadata:
      m_Items: []
  - m_Id: 7956079563392
    m_Localized: "<i>Smiles</i> \"Eva\u2019s at it again\u2014she must be cooking
      up a feast with that many potatoes in mind! I\u2019ll seed some potatoes for
      you; would you mind growing them for me?\" - Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956080563392
    m_Localized: Unlock the Tomato crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956081563392
    m_Localized: Feisty Funions
    m_Metadata:
      m_Items: []
  - m_Id: 7956082563392
    m_Localized: "\u201CEvery master farmer needs to know how to wrangle the most
      devilish food of them all: Funions! Don\u2019t let the name deceive you\u2014this
      crop may test your sanity. Fetch me some, and I\u2019ll teach you how to grow
      turnips.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956083563392
    m_Localized: Unlock the Turnip crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7956084563392
    m_Localized: Bottomless Ambition
    m_Metadata:
      m_Items: []
  - m_Id: 7956085563392
    m_Localized: "\u201CBy the Vast One\u2019s beard, this mine never ends, does
      it? I\u2019ll wager that Idle ore you\u2019re hauling could be put to fine
      use. Let\u2019s see how far you can go\u2014I\u2019m just gonna plant myself
      right here and watch.\u201D \u2014 The Old Timer"
    m_Metadata:
      m_Items: []
  - m_Id: 7956086563392
    m_Localized: Unlocks Vastium nodes.
    m_Metadata:
      m_Items: []
  - m_Id: 7956087563392
    m_Localized: Way of The Water
    m_Metadata:
      m_Items: []
  - m_Id: 7956088563392
    m_Localized: <i>A piece of wheat chaff between his teeth</i> "Well then... looks
      like each time you harvest something your connection to these plants increases.
      I've asked Barkley to build a fence and I'm giving you this bit of land, I'm
      going to teach you to grow every type of crop I know!"
    m_Metadata:
      m_Items: []
  - m_Id: 7956089563392
    m_Localized: Unlock the Watermelone crop.
    m_Metadata:
      m_Items: []
  - m_Id: 7955964563392
    m_Localized: Seriously?
    m_Metadata:
      m_Items: []
  - m_Id: 7956027563392
    m_Localized: Just Keep Eating.
    m_Metadata:
      m_Items: []
  - m_Id: 7957296563392
    m_Localized: Did you say 1000!?
    m_Metadata:
      m_Items: []
  - m_Id: 7957396563392
    m_Localized: '"I enjoy building worlds, but at times it gets a little lonely"
      - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 7957496563392
    m_Localized: Autocast buff slot 3 is now togglable.
    m_Metadata:
      m_Items: []
  - m_Id: 7957596563392
    m_Localized: You cannot be serious...
    m_Metadata:
      m_Items: []
  - m_Id: 7957696563392
    m_Localized: '"As you explore this world consider the implications of your actions.
      You''re growing the lives of characters I created, assisting them as you assist
      yourself. Remember yourself in your love for others as sometimes you''re all
      you''ve got" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 7957796563392
    m_Localized: Autocast buff slot 4 is now togglable.
    m_Metadata:
      m_Items: []
  - m_Id: 889194730110976
    m_Localized: Autocast buff slot 5 is now togglable.
    m_Metadata:
      m_Items: []
  - m_Id: 889193538928640
    m_Localized: '"With great power comes great responsibility...Use this wisely
      young one" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 889191659880448
    m_Localized: It's over 9000!
    m_Metadata:
      m_Items: []
  - m_Id: 7955968563392
    m_Localized: Mildred looks hungry, perhaps you should feed her.
    m_Metadata:
      m_Items: []
  - m_Id: 7955965563392
    m_Localized: Seriously. This cat wants more food.
    m_Metadata:
      m_Items: []
  - m_Id: 7956028563392
    m_Localized: Mildred purrs and licks her paws, then she sits back expectantly
      waiting for more.
    m_Metadata:
      m_Items: []
  - m_Id: 7956037563392
    m_Localized: Mildred jumps onto your lap and paws at the sack of fish. Perhaps
      you should just give it to her.
    m_Metadata:
      m_Items: []
  - m_Id: 1575797333049344
    m_Localized: Tracking Twins
    m_Metadata:
      m_Items: []
  - m_Id: 1575867566669824
    m_Localized: '"The jam was a real hit! But now everyone in the town wants some.
      The Twins provide me with all my farming needs. You can find them somewhere
      in Farmlands, place an order for me and I will teach you to expand your connection
      to Echoes" - Eva'
    m_Metadata:
      m_Items: []
  - m_Id: 1575905307017216
    m_Localized: 0.5% Increased Alter-Echo power
    m_Metadata:
      m_Items: []
  - m_Id: 1640742938624000
    m_Localized: 'New Buffs:

      Echo | Combat, Echo | Tasks'
    m_Metadata:
      m_Items: []
  - m_Id: 1640699355611136
    m_Localized: Into The Multiverse
    m_Metadata:
      m_Items: []
  - m_Id: 1640721103077376
    m_Localized: '"No doubt by now you have noticed occasional spikes in temporal
      energy, shadows of yourself assisting you. All my realms are connected, these...
      Echoes of your past bleed through to assist you. Your persistance in aiding
      the townsfolk has earned you the right to harness some of my power to summon
      Echoes at will" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 1871405633650688
    m_Localized: '"Tillman tells me you''re growing crops with your essence now?
      *whistles* that''s incredible. Anyhow don''t tell him I told ya but he''s planning
      to give you that plot of land over by the windmill and asked me to get started
      on a fence. If you give me some of them sticks you''ve collected I would be
      more than happy to get started for you" - Barkley'
    m_Metadata:
      m_Items: []
  - m_Id: 1871406690615296
    m_Localized: Reaping distance increased by 50.
    m_Metadata:
      m_Items: []
  - m_Id: 1871404551520256
    m_Localized: A Fence For Your Farm
    m_Metadata:
      m_Items: []
  - m_Id: 1876363284201473
    m_Localized: '"So what do you think?! It''s nice right? I''ll need some more
      sticks to continue though and I am out of logs for the posts. You wouldn''t
      mind fetching some more would ya?" - Barkley'
    m_Metadata:
      m_Items: []
  - m_Id: 1876363284201472
    m_Localized: Out Of Materials
    m_Metadata:
      m_Items: []
  - m_Id: 1876363284201474
    m_Localized: Reaping distance increased by 100.
    m_Metadata:
      m_Items: []
  - m_Id: 1879594387259392
    m_Localized: That's One Fine Gate
    m_Metadata:
      m_Items: []
  - m_Id: 1879594387259393
    m_Localized: '"Few more and we''ll be done, this time I will need a bit of slime
      as well, I''ll use it in the lashings for the gate" - Barkley'
    m_Metadata:
      m_Items: []
  - m_Id: 1879594387259394
    m_Localized: Reaping distance increased by 150.
    m_Metadata:
      m_Items: []
  - m_Id: 2561275523907584
    m_Localized: Watch Them Rattle
    m_Metadata:
      m_Items: []
  - m_Id: 2561275549073408
    m_Localized: '"Killing Skeletons is a lot of fun. Don''t believe me? Just try
      it and I will make it worth your while" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 2561275549073409
    m_Localized: Reaping distance increased by 50.
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869056
    m_Localized: "Rattle \u2018n\u2019 Roll"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869058
    m_Localized: Reaping distance increased by 50.
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869059
    m_Localized: Bonefire Night
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869061
    m_Localized: Reaping distance increased by 100.
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869062
    m_Localized: Shiver in Your Bones
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869064
    m_Localized: Reaping distance increased by 100.
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869065
    m_Localized: Bone to Pick
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869067
    m_Localized: Reaping distance increased by 150.
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869068
    m_Localized: Grind Their Bones
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869070
    m_Localized: Reaping distance increased by 150.
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869071
    m_Localized: Beyond the Bone
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869072
    m_Localized: '"Okay, I''m about out of Skelleton based names, finish this last
      one off for me will ya? You''ve done well to get this far. I appreciate you"
      - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869057
    m_Localized: '"Rattles made of skeletons, skeletons made of rattles, oh I don''t
      know how this stuff works anymore" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869060
    m_Localized: '"Erif is hot enough to melt bones, bit of magic should solve that
      though" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869063
    m_Localized: '"Contrary to popular belief Lirium is actually quite warm, but
      the essence sends a shiver through anyone who touches it so people assume its
      cold" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869066
    m_Localized: '"Lifes tough kid, but you''re tougher. Keep up the great work!"
      - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869069
    m_Localized: '"At this point you''re crushing everything you touch right? Well
      it just keeps getting tougher from here so strap in" - The Vast One'
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869073
    m_Localized: Reaping distance increased by 150.
    m_Metadata:
      m_Items: []
