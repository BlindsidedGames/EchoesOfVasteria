%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Quests_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: f47e1bc3466d50a44a1f557a2552b815, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 53574254592
    m_Localized: "Esta aqui \xE9 por nossa conta!"
    m_Metadata:
      m_Items: []
  - m_Id: 689627873280
    m_Localized: "Voc\xEA desperta como se sa\xEDsse de um sonho. Uma voz desaparece ao longe.\n\n\u201CConclua esta jornada, e eu libertarei voc\xEA deste reino.\u201D \u2014 Orin\n\nReceba esta recompensa e feche Miss\xF5es para continuar."
    m_Metadata:
      m_Items: []
  - m_Id: 723614318592
    m_Localized: "Acesso a mais miss\xF5es!"
    m_Metadata:
      m_Items: []
  - m_Id: 4299472388096
    m_Localized: "Que bruxa \xE9 essa?"
    m_Metadata:
      m_Items: []
  - m_Id: 4344246583296
    m_Localized: "O regador m\xE1gico da Eva!"
    m_Metadata:
      m_Items: []
  - m_Id: 4318774575104
    m_Localized: "\"Pegue meu regador m\xE1gico e traga uns rabanetes para minha geleia\" - Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 4506201243648
    m_Localized: "Uma introdu\xE7\xE3o \xE0 Ceifa"
    m_Metadata:
      m_Items: []
  - m_Id: 4508550053888
    m_Localized: "\u201CCarl, o Ceifador, garante que voc\xEA n\xE3o se afaste demais da vila. Ajude os moradores e ele dar\xE1 mais liberdade.\u201D \u2014 Orin\n\nSua dist\xE2ncia de ceifa \xE9 seu limite de viagem. Algumas miss\xF5es o aumentam. Sofrer uma ceifa no limite adiciona 1% no Rio, no Bosque e nas Minas; nas Terras de Cultivo n\xE3o h\xE1 aumento. Vale Sombrio usa abates em vez de dist\xE2ncia."
    m_Metadata:
      m_Items: []
  - m_Id: 4510643011584
    m_Localized: "Agora voc\xEA pode entrar nas Terras de Cultivo!\nDist\xE2ncia de Ceifa aumentada em 50."
    m_Metadata:
      m_Items: []
  - m_Id: 4640641269760
    m_Localized: "Uma quest\xE3o de sa\xFAde"
    m_Metadata:
      m_Items: []
  - m_Id: 4642964914176
    m_Localized: "\"Junte recursos para mim e eu preparo uma refei\xE7\xE3o revigorante para voc\xEA!\" - Eva\n\n<b>Junte recursos nas aventuras e traga-os para ajudar a vila.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 4644424531968
    m_Localized: "Avan\xE7a a hist\xF3ria da vila."
    m_Metadata:
      m_Items: []
  - m_Id: 4796379971584
    m_Localized: Um velho conhecido
    m_Metadata:
      m_Items: []
  - m_Id: 4801358610432
    m_Localized: "\"Heh, esse sujeito est\xE1 aqui quase h\xE1 tanto tempo quanto eu. Voc\xEA pode encontr\xE1-lo no Bosque; afinal, Barkley nem deveria estar prospectando\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 4802210054144
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 20."
    m_Metadata:
      m_Items: []
  - m_Id: 4904353939456
    m_Localized: "\u201CNeste reino, Ivan \xE9 seu irm\xE3o. Leve materiais a ele, e ele forjar\xE1 equipamentos para voc\xEA.\u201D \u2014 Orin\n\nAbra <link=\"help:forge\"><u><color=#EFB889>Vila \u2192 Forja</color></u></link> depois de encontrar Ivan."
    m_Metadata:
      m_Items: []
  - m_Id: 4905721282560
    m_Localized: "Li\xE7\xF5es de Forja.\n\nDist\xE2ncia de Ceifa aumentada em 25."
    m_Metadata:
      m_Items: []
  - m_Id: 4902881738752
    m_Localized: Encontre Ivan
    m_Metadata:
      m_Items: []
  - m_Id: 5136814850048
    m_Localized: "\"Posso ser velho, mas sei das coisas. Os metais que voc\xEA encontra aqui embaixo v\xE3o deixar voc\xEA ligeiro. Se me ajudar a juntar alguns, compartilho meus segredos com Ivan\" - O Velho Mineiro"
    m_Metadata:
      m_Items: []
  - m_Id: 5135506227200
    m_Localized: Rocha e pedra
    m_Metadata:
      m_Items: []
  - m_Id: 5137989255168
    m_Localized: "Agora voc\xEA pode entrar nas Minas."
    m_Metadata:
      m_Items: []
  - m_Id: 5292075401216
    m_Localized: "Meu nome \xE9 Gill"
    m_Metadata:
      m_Items: []
  - m_Id: 5293610516480
    m_Localized: "\u201CTudo certo, camarada? Acabei de fazer a melhor pescaria da minha vida. Nunca pescou? Aqui, pegue minha vara reserva. Pesque uns Flippy Floppy para Mildred!\u201D \u2014 Gill"
    m_Metadata:
      m_Items: []
  - m_Id: 5294684258304
    m_Localized: "Agora voc\xEA pode pescar! "
    m_Metadata:
      m_Items: []
  - m_Id: 5493825617920
    m_Localized: Rumo ao Bosque
    m_Metadata:
      m_Items: []
  - m_Id: 5582187020288
    m_Localized: Uma estrutura mais firme
    m_Metadata:
      m_Items: []
  - m_Id: 5495314595840
    m_Localized: "\u201CTome meu machado reserva e v\xE1 para o bosque. Vamos precisar de pelo menos 10 troncos para come\xE7ar esta estrutura.\u201D \u2014 Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 5496426086400
    m_Localized: "Avan\xE7a as melhorias da vila."
    m_Metadata:
      m_Items: []
  - m_Id: 5583185264640
    m_Localized: "\"Muito obrigado, rapaz! Agora \xE9 hora de refor\xE7ar isso aqui. Pode buscar mais algumas toras?\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 5583919267840
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 10."
    m_Metadata:
      m_Items: []
  - m_Id: 6023255834624
    m_Localized: Erguendo paredes
    m_Metadata:
      m_Items: []
  - m_Id: 6024656732160
    m_Localized: "\"Uau, voc\xEA ajuda mesmo! Enquanto come\xE7o essas paredes, pode buscar mais toras para o telhado?\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 6025701113856
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 10."
    m_Metadata:
      m_Items: []
  - m_Id: 6098321293312
    m_Localized: Colocando o telhado
    m_Metadata:
      m_Items: []
  - m_Id: 6099218874368
    m_Localized: "\"Voc\xEA \xE9 demais. Falta pouco! Vou colocar este telhado e depois come\xE7amos as paredes\" - Barkley "
    m_Metadata:
      m_Items: []
  - m_Id: 6100049346560
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 25."
    m_Metadata:
      m_Items: []
  - m_Id: 6386549669888
    m_Localized: Toques finais
    m_Metadata:
      m_Items: []
  - m_Id: 6388466466816
    m_Localized: "\"O Velho Mineiro sugeriu refor\xE7ar minhas paredes com pedra! Que ideia fant\xE1stica! Pode me ajudar uma \xFAltima vez?\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 6390102245376
    m_Localized: Conclui as melhorias da vila.
    m_Metadata:
      m_Items: []
  - m_Id: 6568989310976
    m_Localized: Outro presente magicool
    m_Metadata:
      m_Items: []
  - m_Id: 6571346509824
    m_Localized: "\"Procure Barkley. Ele est\xE1 atr\xE1s da madeira perfeita, e voc\xEA pode encontr\xE1-lo nas Terras de Cultivo\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 6572961316864
    m_Localized: "Agora voc\xEA pode entrar no Bosque!\nDist\xE2ncia de Ceifa aumentada em 25."
    m_Metadata:
      m_Items: []
  - m_Id: 6905842253824
    m_Localized: Gosma na hora certa
    m_Metadata:
      m_Items: []
  - m_Id: 6922204233728
    m_Localized: "\"Expulse as gosmas dos arredores e eu permitirei que voc\xEA viaje mais longe\" - Carl"
    m_Metadata:
      m_Items: []
  - m_Id: 6943423217664
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 50."
    m_Metadata:
      m_Items: []
  - m_Id: 7063816519680
    m_Localized: Proteja a vila
    m_Metadata:
      m_Items: []
  - m_Id: 7083122900992
    m_Localized: "\"Deixei um artefato com Ivan. Acabe com as gosmas extras ao redor da vila e tenho certeza de que ele vai entreg\xE1-lo a voc\xEA\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 7084691570688
    m_Localized: "Dados m\xE1gicos - Oferecem vantagens em combate!"
    m_Metadata:
      m_Items: []
  - m_Id: 7243521474560
    m_Localized: "Padr\xF5es estranhos"
    m_Metadata:
      m_Items: []
  - m_Id: 7244716851200
    m_Localized: "\u201CNunca vi milho crescer como o seu. Seja l\xE1 o que voc\xEA est\xE1 fazendo, continue.\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7245635403776
    m_Localized: "2.600 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7520072908800
    m_Localized: Grande demais para dar conta
    m_Metadata:
      m_Items: []
  - m_Id: 7521440251904
    m_Localized: "\u201CEva pediu rabanetes. S\xF3 n\xE3o avisou que precisar\xEDamos de uma carro\xE7a para eles.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7522576908288
    m_Localized: "1.400 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7639480549376
    m_Localized: "\u201CUma bebida gelada cairia bem depois de arrancar tanta erva daninha. Como est\xE3o as melancias?\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7638297755648
    m_Localized: Um pedido suculento
    m_Metadata:
      m_Items: []
  - m_Id: 7640587845632
    m_Localized: "4.600 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7872075677696
    m_Localized: Tem quem goste de calor
    m_Metadata:
      m_Items: []
  - m_Id: 7873216528384
    m_Localized: "\u201CVoc\xEA tem ajudado tanto. Pode trazer umas dessas pimentas? Quero mandar uma cesta de presentes para Eva \u2014 ela adora.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7874336407552
    m_Localized: "13.600 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7954296619008
    m_Localized: A salada da Eva
    m_Metadata:
      m_Items: []
  - m_Id: 7955139674112
    m_Localized: "\u201CVamos preparar uma salada para surpreender Eva. Traga tomates e alface, e vemos o que fazer.\u201D \u2014 Flora e Tillman "
    m_Metadata:
      m_Items: []
  - m_Id: 7955957563392
    m_Localized: "9.000 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7955958563392
    m_Localized: "Tem peixe nessa hist\xF3ria"
    m_Metadata:
      m_Items: []
  - m_Id: 7955959563392
    m_Localized: "\"Parece que Mildred gostou de voc\xEA! Aposto que, se der a ela alguns Flippy Floppy, ela ajudar\xE1 voc\xEA nas viagens com prazer!\" - Eva\n\n<b>Os poderes t\xEAm uma aba pr\xF3pria que fica na Central!</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 7955960563392
    m_Localized: "Mildred acompanha voc\xEA e oferece poderes!\nPoderes de Eco de tarefas e combate."
    m_Metadata:
      m_Items: []
  - m_Id: 7955966563392
    m_Localized: "Mais um espa\xE7o de poder."
    m_Metadata:
      m_Items: []
  - m_Id: 7955967563392
    m_Localized: Miau
    m_Metadata:
      m_Items: []
  - m_Id: 7955969563392
    m_Localized: "Mais um espa\xE7o de poder."
    m_Metadata:
      m_Items: []
  - m_Id: 7955976563392
    m_Localized: "Um trabalho em peda\xE7os"
    m_Metadata:
      m_Items: []
  - m_Id: 7955977563392
    m_Localized: "\"*Resmunga* Esta vila precisa de um ch\xE3o melhor. V\xE1 buscar uns peda\xE7os de Ferro e come\xE7amos a pavimenta\xE7\xE3o\" - O Velho Mineiro"
    m_Metadata:
      m_Items: []
  - m_Id: 7955978563392
    m_Localized: "2.800 de experi\xEAncia em Minera\xE7\xE3o\nDist\xE2ncia de Ceifa aumentada em 25."
    m_Metadata:
      m_Items: []
  - m_Id: 7955985563392
    m_Localized: "Conjura\xE7\xE3o de Ecos"
    m_Metadata:
      m_Items: []
  - m_Id: 7955986563392
    m_Localized: "\u201CContinue invocando esse poder. Ele j\xE1 come\xE7a a responder antes de voc\xEA terminar de cham\xE1-lo.\u201D \u2014 Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 7955987563392
    m_Localized: "Desbloqueia a conjura\xE7\xE3o autom\xE1tica do primeiro espa\xE7o e o poder Experi\xEAncia extra."
    m_Metadata:
      m_Items: []
  - m_Id: 7956029563392
    m_Localized: "Mais um espa\xE7o de poder!"
    m_Metadata:
      m_Items: []
  - m_Id: 7956033563392
    m_Localized: Os 100
    m_Metadata:
      m_Items: []
  - m_Id: 7956034563392
    m_Localized: "\"Cada espa\xE7o exige mais conjura\xE7\xF5es que o anterior para ser desbloqueado. \xC9 a natureza da Conjura\xE7\xE3o de Ecos...\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 7956035563392
    m_Localized: "Agora voc\xEA pode ativar a conjura\xE7\xE3o autom\xE1tica do espa\xE7o de poder 2."
    m_Metadata:
      m_Items: []
  - m_Id: 7956036563392
    m_Localized: Um colo e um banquete
    m_Metadata:
      m_Items: []
  - m_Id: 7956038563392
    m_Localized: "Mais um espa\xE7o de poder!"
    m_Metadata:
      m_Items: []
  - m_Id: 7956039563392
    m_Localized: "Estrat\xE9gias de Copium"
    m_Metadata:
      m_Items: []
  - m_Id: 7956040563392
    m_Localized: "\"O que voc\xEA tem a\xED? Bonito e azul \u2014 Lirium, \xE9? Aposto que posso forjar melhorias de primeira com isso! Pode trazer mais?\" \u2014 Ivan"
    m_Metadata:
      m_Items: []
  - m_Id: 7956041563392
    m_Localized: "7.200 de experi\xEAncia em Minera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7956042563392
    m_Localized: Tudo que reluz
    m_Metadata:
      m_Items: []
  - m_Id: 7956043563392
    m_Localized: "\u201CIvan quer examinar esse ouro de perto. Melhor deixar o martelo com ele.\u201D \u2014 O Velho Mineiro"
    m_Metadata:
      m_Items: []
  - m_Id: 7956044563392
    m_Localized: "4.000 de experi\xEAncia em Minera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7956045563392
    m_Localized: Doce recompensa
    m_Metadata:
      m_Items: []
  - m_Id: 7956046563392
    m_Localized: "\u201COs morangos est\xE3o entre as frutas mais doces que conhecemos. Voc\xEA j\xE1 \xE9 quase um mestre do cultivo, e acho que merece uma recompensa.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956047563392
    m_Localized: "16.800 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956048563392
    m_Localized: A todo vapor
    m_Metadata:
      m_Items: []
  - m_Id: 7956049563392
    m_Localized: "\u201COs caminhos da vila est\xE3o desgastados. Traga mais peda\xE7os de Copium e eu deixo o ch\xE3o mais firme.\u201D \u2014 O Velho Mineiro"
    m_Metadata:
      m_Items: []
  - m_Id: 7956050563392
    m_Localized: "Melhora os caminhos da vila.\n9.200 de experi\xEAncia em Minera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7956051563392
    m_Localized: "O almo\xE7o verde de Gill"
    m_Metadata:
      m_Items: []
  - m_Id: 7956052563392
    m_Localized: "\u201CGill vive perguntando dos nossos pepinos. Acho que ele cansou de peixe.\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956053563392
    m_Localized: "10.400 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956054563392
    m_Localized: O melhor da horta
    m_Metadata:
      m_Items: []
  - m_Id: 7956055563392
    m_Localized: "\u201CGuarde os tomates mais suculentos para mim. Os outros podem ir para o ensopado.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956056563392
    m_Localized: "8.000 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956057563392
    m_Localized: Alimentando forjas
    m_Metadata:
      m_Items: []
  - m_Id: 7956058563392
    m_Localized: "\u201CEsses peda\xE7os de Fogo queimam mais que tudo que j\xE1 desenterrei. Ivan vai querer dar uma olhada.\u201D \u2014 O Velho Mineiro"
    m_Metadata:
      m_Items: []
  - m_Id: 7956059563392
    m_Localized: "5.400 de experi\xEAncia em Minera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7956060563392
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 7956061563392
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 7956062563392
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 7956063563392
    m_Localized: "O despertar das ra\xEDzes"
    m_Metadata:
      m_Items: []
  - m_Id: 7956064563392
    m_Localized: "\u201CGill diz que isso se chama alho-por\xF3 \u2014 seja l\xE1 o que for! Enfim, os coelhos est\xE3o com fome; vamos ver se gostam.\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956065563392
    m_Localized: "11.400 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956066563392
    m_Localized: "De volta \xE0s ra\xEDzes"
    m_Metadata:
      m_Items: []
  - m_Id: 7956067563392
    m_Localized: "\u201CAh... definitivamente n\xE3o dev\xEDamos dar alho-por\xF3 aos coelhos. Ainda bem que Eva estava aqui para ajudar. Acho melhor ficarmos com a pastinaca por enquanto \u2014 por favor, por favor, traga um pouco para meus beb\xEAs.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956068563392
    m_Localized: "12.400 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956069563392
    m_Localized: Calor para o inverno
    m_Metadata:
      m_Items: []
  - m_Id: 7956070563392
    m_Localized: "\u201CO Velhote quer mais pimentas. Disse algo sobre espantar o frio.\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956071563392
    m_Localized: "14.800 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956072563392
    m_Localized: "A raiz da quest\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7956073563392
    m_Localized: "\u201CO suco da Flora estava uma del\xEDcia. Ser\xE1 que cenouras dariam t\xE3o certo?\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956074563392
    m_Localized: "5.800 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956075563392
    m_Localized: Frutinhas assustadoras
    m_Metadata:
      m_Items: []
  - m_Id: 7956076563392
    m_Localized: "\u201CPumking d\xE1 uma \xF3tima cabe\xE7a de espantalho. Traga alguns e ajudamos voc\xEA a manter as pragas longe.\u201D \u2014 Flora e Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956077563392
    m_Localized: "15.800 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956078563392
    m_Localized: Jantar para a Eva
    m_Metadata:
      m_Items: []
  - m_Id: 7956079563392
    m_Localized: "\u201CEva est\xE1 planejando outro banquete. Espero que voc\xEA esteja cuidando das batatas.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956080563392
    m_Localized: "7.000 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956081563392
    m_Localized: Funions furiosas
    m_Metadata:
      m_Items: []
  - m_Id: 7956082563392
    m_Localized: "\u201CSe conseguir colher Funions sem perder a paci\xEAncia, vou chamar voc\xEA de agricultor de verdade.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956083563392
    m_Localized: "18.000 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956084563392
    m_Localized: "Ambi\xE7\xE3o sem fundo"
    m_Metadata:
      m_Items: []
  - m_Id: 7956085563392
    m_Localized: "\u201CPela barba de Orin, esta mina n\xE3o acaba nunca, n\xE3o \xE9? Aposto que esse min\xE9rio Crimsonite que voc\xEA carrega pode ser muito \xFAtil. Vamos ver at\xE9 onde voc\xEA chega \u2014 vou me instalar bem aqui e assistir.\u201D \u2014 O Velho Mineiro"
    m_Metadata:
      m_Items: []
  - m_Id: 7956086563392
    m_Localized: "11.200 de experi\xEAncia em Minera\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7956087563392
    m_Localized: "Um gr\xE3o de verdade"
    m_Metadata:
      m_Items: []
  - m_Id: 7956088563392
    m_Localized: "\u201CFique de olho nesse trigo. Uma boa colheita vai ensinar bastante.\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956089563392
    m_Localized: "3.600 de experi\xEAncia em Cultivo"
    m_Metadata:
      m_Items: []
  - m_Id: 7955964563392
    m_Localized: "S\xE9rio?"
    m_Metadata:
      m_Items: []
  - m_Id: 7956027563392
    m_Localized: Continue comendo.
    m_Metadata:
      m_Items: []
  - m_Id: 7957296563392
    m_Localized: "Voc\xEA disse 1000!?"
    m_Metadata:
      m_Items: []
  - m_Id: 7957396563392
    m_Localized: "\"Gosto de criar mundos, mas \xE0s vezes bate uma solid\xE3o\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 7957496563392
    m_Localized: "Agora voc\xEA pode ativar a conjura\xE7\xE3o autom\xE1tica do espa\xE7o de poder 3."
    m_Metadata:
      m_Items: []
  - m_Id: 7957596563392
    m_Localized: "Voc\xEA n\xE3o pode estar falando s\xE9rio..."
    m_Metadata:
      m_Items: []
  - m_Id: 7957696563392
    m_Localized: "\"Ao explorar este mundo, pense nas consequ\xEAncias das suas a\xE7\xF5es. Voc\xEA faz crescer a vida de personagens que criei, ajudando a eles enquanto ajuda a si mesmo. N\xE3o se esque\xE7a de voc\xEA ao amar os outros, pois \xE0s vezes voc\xEA s\xF3 tem a si mesmo\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 7957796563392
    m_Localized: "Agora voc\xEA pode ativar a conjura\xE7\xE3o autom\xE1tica do espa\xE7o de poder 4."
    m_Metadata:
      m_Items: []
  - m_Id: 889194730110976
    m_Localized: "Agora voc\xEA pode ativar a conjura\xE7\xE3o autom\xE1tica do espa\xE7o de poder 5."
    m_Metadata:
      m_Items: []
  - m_Id: 889193538928640
    m_Localized: "\"Com grandes poderes v\xEAm grandes responsabilidades... Use isso com sabedoria, jovem\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 889191659880448
    m_Localized: "\xC9 mais de 9000!"
    m_Metadata:
      m_Items: []
  - m_Id: 7955968563392
    m_Localized: "Mildred parece estar com fome; talvez voc\xEA devesse aliment\xE1-la."
    m_Metadata:
      m_Items: []
  - m_Id: 7955965563392
    m_Localized: "\xC9 s\xE9rio. Essa gata quer mais comida."
    m_Metadata:
      m_Items: []
  - m_Id: 7956028563392
    m_Localized: Mildred ronrona e lambe as patas, depois se senta esperando ansiosamente por mais.
    m_Metadata:
      m_Items: []
  - m_Id: 7956037563392
    m_Localized: Mildred pula no seu colo e bate a pata no saco de peixes. Talvez seja melhor dar tudo a ela.
    m_Metadata:
      m_Items: []
  - m_Id: 1575797333049344
    m_Localized: "Atr\xE1s dos g\xEAmeos"
    m_Metadata:
      m_Items: []
  - m_Id: 1575867566669824
    m_Localized: "\u201CFlora e Tillman cultivam a maioria dos meus ingredientes. Voc\xEA vai encontr\xE1-los nas terras agr\xEDcolas.\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 1575905307017216
    m_Localized: "Avan\xE7a a hist\xF3ria da vila."
    m_Metadata:
      m_Items: []
  - m_Id: 1640742938624000
    m_Localized: 'Novos poderes:

      Eco | Combate, Eco | Tarefas'
    m_Metadata:
      m_Items: []
  - m_Id: 1640699355611136
    m_Localized: Rumo ao Multiverso
    m_Metadata:
      m_Items: []
  - m_Id: 1640721103077376
    m_Localized: "\"Voc\xEA certamente j\xE1 notou picos de energia temporal, sombras de si mesmo ajudando voc\xEA. Todos os meus reinos est\xE3o conectados; esses... Ecos do seu passado atravessam para ajudar. Sua persist\xEAncia em ajudar os moradores lhe rendeu o direito de usar parte do meu poder para invocar Ecos quando quiser\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 1871405633650688
    m_Localized: "\u201CUma cerca perto do moinho cairia bem. Sen\xE3o, esses animais v\xE3o se servir \xE0 vontade.\u201D \u2014 Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 1871406690615296
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 50."
    m_Metadata:
      m_Items: []
  - m_Id: 1871404551520256
    m_Localized: Uma cerca para sua horta
    m_Metadata:
      m_Items: []
  - m_Id: 1876363284201473
    m_Localized: "\"Ent\xE3o, o que achou?! Ficou bonito, n\xE9? Mas preciso de mais gravetos para continuar e acabaram as toras para os postes. Pode buscar mais?\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 1876363284201472
    m_Localized: Sem materiais
    m_Metadata:
      m_Items: []
  - m_Id: 1876363284201474
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 100."
    m_Metadata:
      m_Items: []
  - m_Id: 1879594387259392
    m_Localized: "Que belo port\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 1879594387259393
    m_Localized: "\"Mais um pouco e terminamos. Desta vez preciso de gosma tamb\xE9m, para amarrar o port\xE3o\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 1879594387259394
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 150."
    m_Metadata:
      m_Items: []
  - m_Id: 2561275523907584
    m_Localized: "Ou\xE7a o chocalho"
    m_Metadata:
      m_Items: []
  - m_Id: 2561275549073408
    m_Localized: "\"Matar esqueletos \xE9 muito divertido. N\xE3o acredita? Experimente, e eu fa\xE7o valer a pena\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2561275549073409
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 50."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869056
    m_Localized: Osso, som e rock
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869058
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 50."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869059
    m_Localized: Fogueira de ossos
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869061
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 100."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869062
    m_Localized: Calafrio nos ossos
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869064
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 100."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869065
    m_Localized: Um osso a roer
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869067
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 150."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869068
    m_Localized: Moendo os ossos
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869070
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 150."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869071
    m_Localized: "Al\xE9m dos ossos"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869072
    m_Localized: "\"Bom, quase acabaram meus nomes de esqueleto. Pode terminar este \xFAltimo para mim? Voc\xEA mandou bem chegando at\xE9 aqui. Agrade\xE7o de verdade\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869057
    m_Localized: '"Chocalhos de esqueletos, esqueletos de chocalhos... Ah, nem sei mais como isso funciona" - Orin'
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869060
    m_Localized: "\"Fogo \xE9 quente o bastante para derreter ossos, mas um pouco de magia deve resolver\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869063
    m_Localized: "\"Ao contr\xE1rio do que dizem, Lirium \xE9 bem quente, mas sua ess\xEAncia arrepia quem toca nele, ent\xE3o todos acham que \xE9 frio\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869066
    m_Localized: "\"A vida \xE9 dura, jovem, mas voc\xEA \xE9 mais forte. Continue assim!\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869069
    m_Localized: "\"A essa altura voc\xEA esmaga tudo que toca, certo? Pois daqui para frente fica cada vez mais dif\xEDcil. Prepare-se\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869073
    m_Localized: "Dist\xE2ncia de Ceifa aumentada em 150."
    m_Metadata:
      m_Items: []
