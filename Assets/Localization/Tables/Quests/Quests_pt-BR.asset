    m_Localized: 'Velocidade de movimento: +30%<sprite=194>40%.'
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904144
    m_Localized: 'Velocidade de movimento: +40%<sprite=194>50%.'
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904147
    m_Localized: "Novo poder!\u2014Velocidade de tarefas: +25%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904150
    m_Localized: 'Velocidade de tarefas: +25%<sprite=194>50%.'
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904153
    m_Localized: 'Velocidade de tarefas: +50%<sprite=194>75%.'
    m_Metadata:
