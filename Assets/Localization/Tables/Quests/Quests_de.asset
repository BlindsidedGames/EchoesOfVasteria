    m_Localized: "Bewegungstempo: +30\_%<sprite=194>40\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904144
    m_Localized: "Bewegungstempo: +40\_%<sprite=194>50\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904147
    m_Localized: "Neuer Zauber!\u2014Aufgabentempo: +25\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904150
    m_Localized: "Aufgabentempo: +25\_%<sprite=194>50\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904153
    m_Localized: "Aufgabentempo: +50\_%<sprite=194>75\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904156
    m_Localized: "Aufgabentempo: +75\_%<sprite=194>100\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904159
    m_Localized: "Aufgabentempo: +100\_%<sprite=194>150\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904162
    m_Localized: "Aufgabentempo: +150\_%<sprite=194>200\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904165
    m_Localized: "Neuer Zauber!\u2014Kampfverst\xE4rker: Schaden +25\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904168
    m_Localized: "Kampfverst\xE4rker: Schaden +25\_%<sprite=194>50\_%; +25\_% Verteidigung."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904171
    m_Localized: "Kampfverst\u00e4rker: Schaden +50\u00a0%<sprite=194>+75\u00a0%; Verteidigung +25\u00a0%<sprite=194>+50\u00a0%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904174
    m_Localized: Schaltet den Kessel frei.
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904177
    m_Localized: "Schaltet Gl\xFCcksfall, Sammlerinstinkt und Echo-Resonanz frei."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904180
    m_Localized: "Schaltet Gl\xFCcksfall frei."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904183
    m_Localized: Schaltet Sammlerinstinkt frei.
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904186
    m_Localized: Schaltet Echo-Resonanz frei.
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904189
    m_Localized: "Neuer Zauber!\u2014Regeneration: +40\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904192
    m_Localized: "Regeneration: +40\_%<sprite=194>80\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904195
    m_Localized: "Regeneration: +80\_%<sprite=194>120\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904198
    m_Localized: "Regeneration: +120\_%<sprite=194>150\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904201
    m_Localized: "Neuer Zauber!\u2014Kritischer Wurf: kritische Trefferchance +10\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904204
    m_Localized: "Kritischer Wurf: 10\_%<sprite=194>15\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904207
    m_Localized: "Kritischer Wurf: 15\_%<sprite=194>20\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904210
    m_Localized: "Kritischer Wurf: 20\_%<sprite=194>25\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904213
    m_Localized: "Neuer Zauber!\u2014Ressourcenmultiplikator: +25\_% Ressourcen beim Abschlie\xDFen von Aufgaben."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904216
    m_Localized: "Ressourcenmultiplikator: 25\_%<sprite=194>50\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904219
    m_Localized: "Ressourcenmultiplikator: 50\_%<sprite=194>70\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904222
    m_Localized: "Ressourcenmultiplikator: 70\_%<sprite=194>100\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834126098434
    m_Localized: "Ressourcenmultiplikator: 100\_%<sprite=194>150\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904132
    m_Localized: Aufgaben-Echos 1<sprite=194>2
    m_Metadata:
      m_Items: []
  - m_Id: 8817834096738304
    m_Localized: Orins Vorliebe
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904128
    m_Localized: "\"Orin scheint rosa Schleime am liebsten zu m\xF6gen. Sammle genug von ihrer Kraft, dann wird bestimmt deine Verbindung zum Kampf st\xE4rker und dieser Zauber m\xE4chtiger\" - Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904129
    m_Localized: Kampf-Echos 1<sprite=194>2
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904130
    m_Localized: Macht
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904131
    m_Localized: "\"Deine Verbindung zu Orins Reich ist stark. Sie w\xE4chst wohl mit allem, was du hier tust. Warum nicht ein paar Aufgaben abschlie\xDFen? Ich brauche immer Radieschen f\xFCr meine Marmelade\" - Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8818639323414528
    m_Localized: "\xDCberw\xE4ltigend"
    m_Metadata:
      m_Items: []
  - m_Id: 8818639323414529
    m_Localized: "\"Aus gro\xDFer Macht folgt gro\xDFe ... Nein, nur ein Scherz. Aber um deine Verbindung weiter zu st\xE4rken, musst du viel mehr tun als letztes Mal\" - Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8818639323414530
    m_Localized: Aufgaben-Echos 2<sprite=194>3
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904133
    m_Localized: Einfach weiterschwimmen ...
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904134
    m_Localized: '"Manchmal landest du auf dem Wasser, aber bleib dort nicht lange. Egal wie schnell du bist, es ist nicht sicher" - Gill'
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904136
    m_Localized: Aufkommende Winde
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904137
    m_Localized: '"Je weiter du kommst, desto schneller wirst du" - Orin'
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904139
    m_Localized: Fokus. Tempo. Ich bin das Tempo.
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904140
    m_Localized: '"Erinnert dich das an etwas?" - Orin'
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904142
    m_Localized: Schneller als der Blitz
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904143
    m_Localized: "Jetzt bist du der Schnellste \xFCberhaupt."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904145
    m_Localized: Schnell und Flora-los
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904146
    m_Localized: "\u201CWenn du schneller erntest, essen wir vielleicht sogar vor Sonnenuntergang.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904148
    m_Localized: Turbo-Tillman
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904149
    m_Localized: "\u201CPflanz-pflanz, pfl\xFCck-pfl\xFCck \u2014 Aufgaben mit einem Klick.\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904151
    m_Localized: Mildreds Erst-streicheln-Protokoll
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904152
    m_Localized: "\u201CErst Streicheln. Dann Aufgaben. Ich mache die Regeln nicht\u201D \u2014 Mildred"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904154
    m_Localized: Der Wirbelwind des Alten
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904155
    m_Localized: "\u201CMach's schnell, mach's richtig \u2014 einmal blinzeln, schon bist du beim n\xE4chsten\u201D \u2014 Der Alte"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904157
    m_Localized: Die Blitzrunde des Alten
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904158
    m_Localized: "\u201CF\xFCnfzig Aufgaben in der Zeit f\xFCr f\xFCnf\u201D \u2014 Der Alte"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904160
    m_Localized: Evas Chrono-Sprint
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904161
    m_Localized: "\u201CHab die Zeit ein bisschen verbogen. Verschwende sie nicht\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904163
    m_Localized: "Schleim-Zeitpr\xFCfung"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904164
    m_Localized: "\u201CRegel eins: Was wackelt, hat sich freiwillig gemeldet\u201D \u2014 Der Alte"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904166
    m_Localized: Das Klappern verstummen lassen
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904167
    m_Localized: "\u201CKnochen sollen ruhen. Hilf ihnen, sich zu erinnern\u201D \u2014 Der Alte"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904169
    m_Localized: Arkane Zerlegung
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904170
    m_Localized: "\u201CZiel auf die Gelenke. Der Rest folgt der Physik\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904172
    m_Localized: Kaltessel
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904173
    m_Localized: "\u201ESo sagt man das doch, oder?\u201C \u2014 Orin\n\n\xD6ffne <link=\"help:cauldron\"><u><color=#EFB889>Dorf \u2192 Kessel</color></u></link>, um Nahrung zu Eintopf zu verarbeiten und Karten zu erhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904175
    m_Localized: Ein besonderes Interesse
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904176
    m_Localized: Sag der Welt, was du suchst. Vielleicht kommt sie dir entgegen. - Orin
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904178
    m_Localized: Ein kleines Extra
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904179
    m_Localized: Zehn kleine Siege. Ein unerwartetes Geschenk. - Orin
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904181
    m_Localized: Die fehlenden Teile
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904182
    m_Localized: "Du hast deine Erfolge gez\xE4hlt. Z\xE4hle nun, was du \xFCbersehen hast. - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904184
    m_Localized: In guter Gesellschaft
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904185
    m_Localized: Dein Echo erinnert sich an die Arbeit. Antworte ihm. - Orin
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904187
    m_Localized: Automatische Patchnotizen
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904188
    m_Localized: "\u201CIch habe deinen Hotfix genehmigt \u2014 Fleisch, kompilier dich\u201D \u2014 Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904190
    m_Localized: Regenerationsprotokoll
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904191
    m_Localized: "\u201CBl\xE4tter erinnern sich an ihre Form. Du auch \u2014 nimm sie wieder an\u201D \u2014 Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904193
    m_Localized: "Leise-K\xF6cheln-Protokoll"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904194
    m_Localized: "\u201CMacht ist geduldig. Halte sie auf kleiner Flamme und lass den Sud entscheiden\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904196
    m_Localized: Verwirrende Infusion
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904197
    m_Localized: "\u201CF\xFCrchte nicht den Wirbel. F\xFCrchte den Stillstand\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904199
    m_Localized: "Blaugl\xFChende Schneide"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904200
    m_Localized: "\u201CHandgelenk locker, Spitze fest \u2014 kritische Treffer leben von Kontrolle, nicht von Kraft\u201D \u2014 Ivan"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904202
    m_Localized: "Gef\xFChl f\xFCr die Maserung"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904203
    m_Localized: "\u201CAlles hat eine Maserung \u2014 schneide erst mit ihr, dann quer dazu\u201D \u2014 Ivan"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904205
    m_Localized: "Ged\xE4chtnis der Schneide"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904206
    m_Localized: "\u201CHalte den bew\xE4hrten Winkel und wiederhole ihn \u2014 Pr\xE4zision schafft ihr eigenes Gl\xFCck\u201D \u2014 Ivan"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904208
    m_Localized: Ein wahrer Schnitt
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904209
    m_Localized: "\u201CEine saubere Linie schl\xE4gt f\xFCnf unsaubere\u201D \u2014 Ivan"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904211
    m_Localized: Lieferkettenreaktion
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904212
    m_Localized: "\u201CMehr rein hei\xDFt mehr raus \u2014 Alchemie achtet auf Mengen\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904214
    m_Localized: "Anforderung: \xDCberschuss"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904215
    m_Localized: "\u201CJa, ich sagte alles \u2014 dank mir, wenn es sich vervielfacht\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904217
    m_Localized: "Kapazit\xE4ts-Stresstest"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904218
    m_Localized: "\u201CWir finden die Kapazit\xE4t, indem wir sie \xFCberschreiten\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904220
    m_Localized: Mehr bringt mehr
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904221
    m_Localized: "\u201CBeweise das Gesetz der F\xFClle \u2014 mehr bringt mehr\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834126098432
    m_Localized: "Kapazit\xE4t bezwungen"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834126098433
    m_Localized: "\u201CWir finden keine Grenzen. Wir setzen neue Ma\xDFst\xE4be\u201D \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 22109034010525696
    m_Localized: "Spuktakul\xE4r"
    m_Metadata:
      m_Items: []
  - m_Id: 22109034035691520
    m_Localized: "\"Ich dekoriere meinen Hinterhof. Kannst du Pumking bringen?\" \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 22109034035691521
    m_Localized: "Schaltet die Karte Gruselwelt frei"
    m_Metadata:
      m_Items: []
  - m_Id: 34882991914631168
    m_Localized: "F\xFCr die Marmelade!"
    m_Metadata:
      m_Items: []
  - m_Id: 34882991939796992
    m_Localized: "Kannst du f\xFCr meine Marmelade 50 Radieschen im Ackerland sammeln?"
    m_Metadata:
      m_Items: []
  - m_Id: 34882991939796993
    m_Localized: 1.000 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 38005472116490240
    m_Localized: Gillivers Reisen
    m_Metadata:
      m_Items: []
  - m_Id: 38005472141656064
    m_Localized: "\"Ein Freund erz\xE4hlte mir mal, er h\xE4tte die Welt bereist und lauter verr\xFCckte Sachen gefunden. Daf\xFCr hab ich keine Zeit, aber unser Fluss hat reichlich schicke Fische. Bring mir einen Haufen, damit ich ihm zeigen kann, dass mir hier nichts entgeht. Ich sorge daf\xFCr, dass sich die M\xFChe lohnt\" \u2014 Gill"
    m_Metadata:
      m_Items: []
  - m_Id: 38005472141656065
    m_Localized: 15.000 Angel-XP
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000000
    m_Localized: Unsere eigenen Felder
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000001
    m_Localized: "Baue dein erstes Beet und s\xE4e das Radieschensamenp\xE4ckchen von Flora und Tillman aus. Gie\xDFe es, um die Wachstumszeit zu halbieren. Ernte Pflanzen, um deine Felder-Stufe zu erh\xF6hen und weitere Beete freizuschalten. Weitere Samenp\xE4ckchen findest du durch Ernteaufgaben auf Abenteuern."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000002
    m_Localized: "1. Schaltet Samenfunde auf Abenteuern frei."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000010
    m_Localized: Unser erstes Beet
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000011
    m_Localized: Erreiche Felder-Stufe 1 und sammle die Materialien zum Bau dieser Beete. Kaufe sie hier oder unter Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000012
    m_Localized: "Felder-Kapazit\xE4t: 1 Anbaubeet."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000020
    m_Localized: Platz zum Wachsen
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000021
    m_Localized: Erreiche Felder-Stufe 10 und sammle die Materialien zum Bau dieser Beete. Kaufe sie hier oder unter Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000022
    m_Localized: "Felder-Kapazit\xE4t: 2 Anbaubeete."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000030
    m_Localized: "Das alte Feld zur\xFCckgewinnen"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000031
    m_Localized: Erreiche Felder-Stufe 35 und sammle die Materialien zum Bau dieser Beete. Kaufe sie hier oder unter Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000032
    m_Localized: "Felder-Kapazit\xE4t: 3 Anbaubeete."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000040
    m_Localized: Eine zweite Reihe
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000041
    m_Localized: Erreiche Felder-Stufe 65 und sammle die Materialien zum Bau dieser Beete. Kaufe sie hier oder unter Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000042
    m_Localized: "Felder-Kapazit\xE4t: 4 Anbaubeete."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000050
    m_Localized: Jenseits des alten Feldes
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000051
    m_Localized: Erreiche Felder-Stufe 95 und sammle die Materialien zum Bau dieser Beete. Kaufe sie hier oder unter Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000052
    m_Localized: "Felder-Kapazit\xE4t: 5 Anbaubeete."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000060
    m_Localized: Die Felder sind fertig
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000061
    m_Localized: Erreiche Felder-Stufe 125 und sammle die Materialien zum Bau dieser Beete. Kaufe sie hier oder unter Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000062
    m_Localized: "Felder-Kapazit\xE4t: 6 Anbaubeete."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000070
    m_Localized: "Wurzeln f\xFCr morgen"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000071
    m_Localized: Erreiche Felder-Stufe 5 und sammle die Materialien zum Bau dieser Beete. Kaufe sie hier oder unter Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000072
    m_Localized: "Schaltet Obstgartenpl\xE4tze 1\u20132 frei."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000080
    m_Localized: Noch ein Wurzelpaar
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000081
    m_Localized: Erreiche Felder-Stufe 50 und sammle die Materialien zum Bau dieser Beete. Kaufe sie hier oder unter Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000082
    m_Localized: "Schaltet Obstgartenpl\xE4tze 3\u20134 frei."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000090
    m_Localized: Die letzte Baumreihe
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000091
    m_Localized: Erreiche Felder-Stufe 110 und sammle die Materialien zum Bau dieser Beete. Kaufe sie hier oder unter Felder.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000092
    m_Localized: "Schaltet Obstgartenpl\xE4tze 5\u20136 frei."
    m_Metadata:
      m_Items: []
  - m_Id: 159845896289914880
    m_Localized: "Hier ist deine erste Angel! Ich zeige dir einen geheimen Angelplatz unten am Fluss.\n\nDiese alten Stiefel habe ich auch gefunden. Sie scheinen deine Gr\xF6\xDFe zu haben."
    m_Metadata:
      m_Items: []
  - m_Id: 159845897237827584
    m_Localized: "Deine erste Angel, Zugang zum Fluss und Stiefel: +10 Bewegung, +25 Leben, +5 Verteidigung, +1 Regeneration (automatisch ausger\xFCstet)."
    m_Metadata:
      m_Items: []
  - m_Id: 159849588615417856
    m_Localized: "Deine erste Angel, Zugang zum Fluss und ein Paar Stiefel (automatisch ausger\xFCstet)."
    m_Metadata:
      m_Items: []
  - m_Id: 159850354524688384
    m_Localized: "Hole diese Belohnung ab, schlie\xDFe das Auftragsfenster und w\xE4hle dann <link=\"help:adventure\"><u><color=#EFB889>Abenteuer \u2192 Ackerland</color></u></link>. Dein Held erntet reife Pflanzen automatisch. Flora und Tillman helfen dir sp\xE4ter, eigene Pflanzen anzubauen."
    m_Metadata:
      m_Items: []
  - m_Id: 159859916489232384
    m_Localized: "Carl der Schnitter wacht dar\xFCber, wie weit du dich von der Stadt entfernst. Vorerst liegt deine Grenze bei 50. Hilf den Stadtbewohnern und schalte neue Gebiete frei, um weiter reisen zu k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 159859916514398208
    m_Localized: "Du kennst deine Grenzen. Hilf den Stadtbewohnern, um weiter reisen zu d\xFCrfen."
    m_Metadata:
      m_Items: []
  - m_Id: 159865356388274176
    m_Localized: Suche Barkley am Fluss auf. Er sucht nach dem perfekten Holz.
    m_Metadata:
      m_Items: []
  - m_Id: 159865356442800128
    m_Localized: "Ivan ist dein Bruder in dieser Welt. Er kann aus deinen gesammelten Materialien Ausr\xFCstung schmieden."
    m_Metadata:
      m_Items: []
  - m_Id: 159880735105880064
    m_Localized: "Hole diese Belohnung ab und schlie\xDFe dann das Questfenster, um mit Eva zu sprechen."
    m_Metadata:
      m_Items: []
  - m_Id: 159880735131045888
    m_Localized: "Eva hat dir ihre magische Gie\xDFkanne geliehen. Ernte f\xFCnf Radieschen im Ackerland."
    m_Metadata:
      m_Items: []
  - m_Id: 159880735131045889
    m_Localized: "Danke f\xFCr die Radieschen!"
    m_Metadata:
      m_Items: []
  - m_Id: 159890707516624896
    m_Localized: "Finde Ivan im Wald und kehre dann in die Stadt zur\xFCck. Er zeigt dir, wie du dein erstes Schwert schmiedest."
    m_Metadata:
      m_Items: []
  - m_Id: 159890707558567936
    m_Localized: Ivans erste Lektion
    m_Metadata:
      m_Items: []
  - m_Id: 159890707558567937
    m_Localized: "Ivan hat Materialien f\xFCr dein erstes Schwert bereitgelegt. Nimm sie an und folge dann seiner Einf\xFChrung in der Schmiede."
    m_Metadata:
      m_Items: []
  - m_Id: 159890707558567938
    m_Localized: "Materialien f\xFCr deinen ersten Barren und einen Basiskern."
    m_Metadata:
      m_Items: []
  - m_Id: 160252005534273536
    m_Localized: "Bringe Mildred 5 Flippy Floppys, um deine ersten Echo-Zauber freizuschalten. W\xE4hle ein Aufgaben-Echo zum Ressourcensammeln oder ein Kampf-Echo zum Bek\xE4mpfen von Gegnern."
    m_Metadata:
      m_Items: []
  - m_Id: 160252005576216576
    m_Localized: "Aufgaben-Echo- und Kampf-Echo-Zauber. Weise einen unter Hauptmen\xFC \u2192 Zauber zu."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
