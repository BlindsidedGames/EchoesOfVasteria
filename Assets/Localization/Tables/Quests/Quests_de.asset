%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Quests_de
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: f47e1bc3466d50a44a1f557a2552b815, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 53574254592
    m_Localized: Das gibt's gratis!
    m_Metadata:
      m_Items: []
  - m_Id: 689627873280
    m_Localized: "Du erwachst wie aus einem Traum. Eine Stimme verklingt in der Ferne.\n\n\u201EBringe diese Reise zu Ende, dann werde ich dich aus dieser Welt entlassen.\u201C \u2014 Orin\n\nHole diese Belohnung ab und schlie\xDFe dann das Auftragsfenster, um fortzufahren."
    m_Metadata:
      m_Items: []
  - m_Id: 723614318592
    m_Localized: "Zugang zu weiteren Auftr\xE4gen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4299472388096
    m_Localized: Welche Hexe?
    m_Metadata:
      m_Items: []
  - m_Id: 4344246583296
    m_Localized: "Evas magische Gie\xDFkanne!"
    m_Metadata:
      m_Items: []
  - m_Id: 4318774575104
    m_Localized: "\"Nimm meine magische Gie\xDFkanne und besorg ein paar Radieschen f\xFCr meine Marmelade\" - Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 4506201243648
    m_Localized: "Einf\xFChrung in die Seelenernte"
    m_Metadata:
      m_Items: []
  - m_Id: 4508550053888
    m_Localized: "\u201ECarl der Schnitter sorgt daf\xFCr, dass du dich nicht zu weit von der Stadt entfernst. Hilf den Bewohnern, dann l\xE4sst er die Leine lockerer.\u201C \u2014 Orin\n\nDeine Schnitterdistanz ist deine Reisegrenze. Manche Quests erh\xF6hen sie. An der Grenze zur\xFCckgeholt zu werden, gibt 1\_% mehr Distanz in Fluss, Wald und Minen; Ackerland gibt keine Steigerung. Gruselwelt verwendet die Zahl besiegter Gegner statt der Entfernung."
    m_Metadata:
      m_Items: []
  - m_Id: 4510643011584
    m_Localized: "Du kannst jetzt das Ackerland betreten!\nReisedistanz um 50 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 4640641269760
    m_Localized: Eine Frage der Gesundheit
    m_Metadata:
      m_Items: []
  - m_Id: 4642964914176
    m_Localized: "\"Sammle Ressourcen f\xFCr mich, dann koche ich dir etwas Herzhaftes!\" - Eva\n\n<b>Sammle auf Abenteuern Ressourcen und bring sie zur\xFCck, um der Stadt zu helfen.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 4644424531968
    m_Localized: Bringt die Stadtgeschichte voran.
    m_Metadata:
      m_Items: []
  - m_Id: 4796379971584
    m_Localized: Ein alter Haudegen
    m_Metadata:
      m_Items: []
  - m_Id: 4801358610432
    m_Localized: '"Heh, der ist fast so lange hier wie ich. Du findest ihn im Wald. Barkley sollte wohl ohnehin nicht nach Erz suchen" - Orin'
    m_Metadata:
      m_Items: []
  - m_Id: 4802210054144
    m_Localized: "Reisedistanz um 20 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 4904353939456
    m_Localized: "\u201EIn dieser Welt ist Ivan dein Bruder. Bringe ihm Materialien, dann schmiedet er Ausr\xFCstung f\xFCr dich.\u201C \u2014 Orin\n\n\xD6ffne <link=\"help:forge\"><u><color=#EFB889>Dorf \u2192 Schmiede</color></u></link>, nachdem du Ivan getroffen hast."
    m_Metadata:
      m_Items: []
  - m_Id: 4905721282560
    m_Localized: "Unterricht an der Schmiede.\n\nSchnitterdistanz um 25 erh\u00f6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 4902881738752
    m_Localized: Ivan kennenlernen
    m_Metadata:
      m_Items: []
  - m_Id: 5136814850048
    m_Localized: '"Ich mag alt sein, aber ich kenn mich aus. Die Metalle hier unten machen dich flink. Hilfst du mir beim Sammeln, teile ich meine Geheimnisse mit Ivan" - Der Alte'
    m_Metadata:
      m_Items: []
  - m_Id: 5135506227200
    m_Localized: Fels und Stein
    m_Metadata:
      m_Items: []
  - m_Id: 5137989255168
    m_Localized: Du kannst jetzt die Minen betreten.
    m_Metadata:
      m_Items: []
  - m_Id: 5292075401216
    m_Localized: Gill ist der Name
    m_Metadata:
      m_Items: []
  - m_Id: 5293610516480
    m_Localized: "\u201EWie geht's, Kumpel? Ich hatte gerade den besten Angelausflug meines Lebens. Du hast noch nie geangelt? Hier, nimm meine Ersatzangel. Fang ein paar Flippy Floppy f\xFCr Mildred!\u201C \u2014 Gill"
    m_Metadata:
      m_Items: []
  - m_Id: 5294684258304
    m_Localized: 'Du kannst jetzt Fische fangen! '
    m_Metadata:
      m_Items: []
  - m_Id: 5493825617920
    m_Localized: Ab in den Wald
    m_Metadata:
      m_Items: []
  - m_Id: 5582187020288
    m_Localized: Ein stabilerer Rahmen
    m_Metadata:
      m_Items: []
  - m_Id: 5495314595840
    m_Localized: "\u201EHier, nimm meine Ersatzaxt und geh in den Wald. Wir brauchen mindestens 10 St\xE4mme, um mit diesem Ger\xFCst anzufangen.\u201C \u2014 Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 5496426086400
    m_Localized: Bringt den Stadtausbau voran.
    m_Metadata:
      m_Items: []
  - m_Id: 5583185264640
    m_Localized: "\"Vielen Dank, Junge! Jetzt m\xFCssen wir das Ding verst\xE4rken. W\xFCrdest du mir noch ein paar Holzst\xE4mme besorgen?\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 5583919267840
    m_Localized: "Reisedistanz um 10 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 6023255834624
    m_Localized: "W\xE4nde hochziehen"
    m_Metadata:
      m_Items: []
  - m_Id: 6024656732160
    m_Localized: "\"Wow, du bist eine echte Hilfe! W\xE4hrend ich mit den W\xE4nden anfange, k\xF6nntest du mehr Holzst\xE4mme f\xFCrs Dach holen?\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 6025701113856
    m_Localized: "Reisedistanz um 10 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 6098321293312
    m_Localized: Ein Dach drauf
    m_Metadata:
      m_Items: []
  - m_Id: 6099218874368
    m_Localized: "\"Du bist einfach der Beste. Es fehlt nicht mehr viel! Ich setze das Dach drauf, dann machen wir uns an die W\xE4nde\" - Barkley "
    m_Metadata:
      m_Items: []
  - m_Id: 6100049346560
    m_Localized: "Reisedistanz um 25 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 6386549669888
    m_Localized: Der letzte Schliff
    m_Metadata:
      m_Items: []
  - m_Id: 6388466466816
    m_Localized: "\"Der Alte hat vorgeschlagen, meine W\xE4nde mit Stein zu verst\xE4rken! Fantastische Idee! Du hilfst mir doch noch ein letztes Mal, oder?\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 6390102245376
    m_Localized: "Schlie\xDFt den Stadtausbau ab."
    m_Metadata:
      m_Items: []
  - m_Id: 6568989310976
    m_Localized: Noch ein zauberhaftes Geschenk
    m_Metadata:
      m_Items: []
  - m_Id: 6571346509824
    m_Localized: "\"Such Barkley. Er h\xE4lt nach dem perfekten Bauholz Ausschau, und du findest ihn im Ackerland\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 6572961316864
    m_Localized: "Du kannst jetzt den Wald betreten!\nReisedistanz um 25 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 6905842253824
    m_Localized: Schleim zur rechten Zeit
    m_Metadata:
      m_Items: []
  - m_Id: 6922204233728
    m_Localized: "\"Dr\xE4nge die Schleime in der Umgebung zur\xFCck, dann erlaube ich dir, weiter zu reisen\" - Carl"
    m_Metadata:
      m_Items: []
  - m_Id: 6943423217664
    m_Localized: "Reisedistanz um 50 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 7063816519680
    m_Localized: "Die Stadt besch\xFCtzen"
    m_Metadata:
      m_Items: []
  - m_Id: 7083122900992
    m_Localized: "\"Ich habe Ivan ein Artefakt gegeben. Beseitige die zus\xE4tzlichen Schleime rund um die Stadt, dann \xFCberl\xE4sst er es dir bestimmt\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 7084691570688
    m_Localized: "Magische W\xFCrfel - Vorteile im Kampf!"
    m_Metadata:
      m_Items: []
  - m_Id: 7243521474560
    m_Localized: Seltsame Muster
    m_Metadata:
      m_Items: []
  - m_Id: 7244716851200
    m_Localized: "\"Vielen Dank! Du kannst jederzeit unseren Mais anbauen. Moment, was ist das!? So habe ich noch nie ein Radieschen wachsen sehen! Es scheint irgendwie mit dir verbunden zu sein! Das m\xF6chte ich weiterverfolgen. Hol mir Mais, dann zeige ich dir den Weizenanbau\" - Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7245635403776
    m_Localized: 2.600 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7520072908800
    m_Localized: Zu viel des Guten
    m_Metadata:
      m_Items: []
  - m_Id: 7521440251904
    m_Localized: "<b>Im Aufgaben-Reiter der Statistik kannst du die Aufgabengewichtungen leicht anpassen.</b>\n\"So viele Radieschen bekommen wir niemals rechtzeitig f\xFCr Eva zusammen ... Oh! Du hast ihre magische Gie\xDFkanne! Sammle mir 100 Radieschen, dann bringt Tillman dir gern etwas \xFCber Mais bei\" - Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7522576908288
    m_Localized: 1.400 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7639480549376
    m_Localized: "<i>Kichert</i> \"Danke f\xFCr deine Hilfe mit dem ganzen Weizen, den Tillman ges\xE4t hat. Ich m\xF6chte der Stadt etwas Erfrischendes zu trinken machen. Ich s\xE4e Watermelone; k\xF6nntest du sie f\xFCr mich anbauen?\" - Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7638297755648
    m_Localized: In Reih und Glied
    m_Metadata:
      m_Items: []
  - m_Id: 7640587845632
    m_Localized: 4.600 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7872075677696
    m_Localized: "Manche m\xF6gen's hei\xDF"
    m_Metadata:
      m_Items: []
  - m_Id: 7873216528384
    m_Localized: "\u201CDu hast uns so geholfen. K\xF6nntest du ein paar dieser Paprika holen? Ich m\xF6chte Eva einen Geschenkkorb schicken \u2014 sie liebt die.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7874336407552
    m_Localized: 13.600 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7954296619008
    m_Localized: Cool wie eine Gurke
    m_Metadata:
      m_Items: []
  - m_Id: 7955139674112
    m_Localized: "\u201C\xDCberraschen wir Eva mit einem Salat. Hol uns Tomaten und Salat, dann sehen wir, was wir daraus machen.\u201D \u2014 Flora & Tillman "
    m_Metadata:
      m_Items: []
  - m_Id: 7955957563392
    m_Localized: 9.000 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7955958563392
    m_Localized: Eine fischige Sache
    m_Metadata:
      m_Items: []
  - m_Id: 7955959563392
    m_Localized: "\"Mildred scheint dich zu m\xF6gen! Gib ihr ein paar Flippy Floppy, dann hilft sie dir bestimmt gern auf deinen Reisen!\" - Eva\n\n<b>Zauber haben einen eigenen Reiter im Hauptmen\xFC!</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 7955960563392
    m_Localized: 'Mildred begleitet dich und versorgt dich mit Zaubern!

      Aufgaben- und Kampf-Echo-Zauber.'
    m_Metadata:
      m_Items: []
  - m_Id: 7955966563392
    m_Localized: Ein weiterer Zauberplatz.
    m_Metadata:
      m_Items: []
  - m_Id: 7955967563392
    m_Localized: Miau
    m_Metadata:
      m_Items: []
  - m_Id: 7955969563392
    m_Localized: Ein weiterer Zauberplatz.
    m_Metadata:
      m_Items: []
  - m_Id: 7955976563392
    m_Localized: Eine klumpige Angelegenheit
    m_Metadata:
      m_Items: []
  - m_Id: 7955977563392
    m_Localized: "\"*Grummelt* Diese Stadt k\xF6nnte einen besseren Untergrund gebrauchen. Hol ein paar Eisen-Brocken, dann legen wir Wege an\" - Der Alte"
    m_Metadata:
      m_Items: []
  - m_Id: 7955978563392
    m_Localized: "2.800 Bergbau-XP\nReisedistanz um 25 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 7955985563392
    m_Localized: Echo-Zauberei
    m_Metadata:
      m_Items: []
  - m_Id: 7955986563392
    m_Localized: "Wirke 10-mal Zauber, um automatisches Wirken f\xFCr deinen ersten Zauberplatz und den Zauber Bonuserfahrung freizuschalten."
    m_Metadata:
      m_Items: []
  - m_Id: 7955987563392
    m_Localized: "Schaltet automatisches Wirken f\u00fcr den ersten Zauberplatz und den Zauber Bonuserfahrung frei."
    m_Metadata:
      m_Items: []
  - m_Id: 7956029563392
    m_Localized: Ein weiterer Zauberplatz!
    m_Metadata:
      m_Items: []
  - m_Id: 7956033563392
    m_Localized: Die 100
    m_Metadata:
      m_Items: []
  - m_Id: 7956034563392
    m_Localized: '"Jeder Platz erfordert mehr Zauber als der vorige. So ist die Natur der Echo-Zauberei ..." - Orin'
    m_Metadata:
      m_Items: []
  - m_Id: 7956035563392
    m_Localized: "Automatisches Wirken f\xFCr Zauberplatz 2 kann jetzt umgeschaltet werden."
    m_Metadata:
      m_Items: []
  - m_Id: 7956036563392
    m_Localized: "Ein Scho\xDF und ein Festmahl"
    m_Metadata:
      m_Items: []
  - m_Id: 7956038563392
    m_Localized: Ein weiterer Zauberplatz!
    m_Metadata:
      m_Items: []
  - m_Id: 7956039563392
    m_Localized: "Bew\xE4ltigungsstrategien"
    m_Metadata:
      m_Items: []
  - m_Id: 7956040563392
    m_Localized: "\"Was hast du da? Sch\xF6n gl\xE4nzend und blau \u2014 Lirium, was? Damit k\xF6nnte ich erstklassige Verbesserungen schmieden! Kannst du mehr davon holen?\" \u2014 Ivan"
    m_Metadata:
      m_Items: []
  - m_Id: 7956041563392
    m_Localized: 7.200 Bergbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956042563392
    m_Localized: "Das Feuer sch\xFCren"
    m_Metadata:
      m_Items: []
  - m_Id: 7956043563392
    m_Localized: "*Lacht leise* \"Ha! Du hast es wirklich geschafft \u2014 ich werd verr\xFCckt. Bring mir etwas von diesem Gold-Erz, dann sehen wir zu, dass Ivans Schmiede besser wird!\" - Der Alte"
    m_Metadata:
      m_Items: []
  - m_Id: 7956044563392
    m_Localized: 4.000 Bergbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956045563392
    m_Localized: Herr der Ringe
    m_Metadata:
      m_Items: []
  - m_Id: 7956046563392
    m_Localized: "\u201CErdbeeren sind so ziemlich die s\xFC\xDFesten Fr\xFCchte, die wir kennen. Du bist jetzt fast ein Meister im Ackerbau. Zeit f\xFCr eine Belohnung.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956047563392
    m_Localized: 16.800 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956048563392
    m_Localized: Volle Kraft voraus
    m_Metadata:
      m_Items: []
  - m_Id: 7956049563392
    m_Localized: "\u201CPuhhhh! Das gr\xFCne Zeug hat's in sich \u2014 damit fahren die Loren schneller als Eva auf ihrem Besen! Bau mehr Copium ab, dann schauen wir, wie tief wir noch kommen.\u201D \u2014 Der Alte"
    m_Metadata:
      m_Items: []
  - m_Id: 7956050563392
    m_Localized: 9.200 Bergbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956051563392
    m_Localized: "Lauchende Gesch\xE4fte"
    m_Metadata:
      m_Items: []
  - m_Id: 7956052563392
    m_Localized: "\u201CGill will uns eine neue Pflanze von seinen Reisen geben, wenn wir ihm Gurken bringen! W\xFCrdest du ein paar f\xFCr mich besorgen?\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956053563392
    m_Localized: 10.400 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956054563392
    m_Localized: "Blatt f\xFCr Blatt"
    m_Metadata:
      m_Items: []
  - m_Id: 7956055563392
    m_Localized: "\u201CDu kennst den Ablauf \u2014 komm mit, w\xE4hrend ich die Tomatensamen s\xE4e. Bring deine saftigsten Tomaten, dann zeige ich dir das Geheimnis knackigen, erfrischenden Salats.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956056563392
    m_Localized: 8.000 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956057563392
    m_Localized: "Brennstoff f\xFCr die Schmiede"
    m_Metadata:
      m_Items: []
  - m_Id: 7956058563392
    m_Localized: "\"Langsam mag ich dich, junger Freund. Jetzt, wo die Schmiede es vertr\xE4gt, hol etwas von dem Feuer, das du entdeckt hast \u2014 damit wird sie hei\xDFer als alles diesseits der Sonne.\" \u2014 Der Alte"
    m_Metadata:
      m_Items: []
  - m_Id: 7956059563392
    m_Localized: 5.400 Bergbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956060563392
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 7956061563392
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 7956062563392
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 7956063563392
    m_Localized: Wurzelerwachen
    m_Metadata:
      m_Items: []
  - m_Id: 7956064563392
    m_Localized: "\u201CGill nennt sie Lauch \u2014 was immer das hei\xDFen soll! Jedenfalls haben die Kaninchen Hunger. Mal sehen, ob sie's m\xF6gen.\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956065563392
    m_Localized: 11.400 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956066563392
    m_Localized: Paprika-Power
    m_Metadata:
      m_Items: []
  - m_Id: 7956067563392
    m_Localized: "\u201C\xC4h ... wir sollten den Kaninchen wirklich keinen Lauch geben. Zum Gl\xFCck war Eva da. Bleiben wir vorerst bei Pastinaken \u2014 bitte, bitte hol welche f\xFCr meine Kleinen.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956068563392
    m_Localized: 12.400 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956069563392
    m_Localized: "Gute K\xFCrbistaten"
    m_Metadata:
      m_Items: []
  - m_Id: 7956070563392
    m_Localized: "\u201CKeine Ahnung, warum der Alte das Zeug mag. Aber er hat uns Pumking-Samen versprochen, wenn wir ihm helfen.\u201D \u2014 Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956071563392
    m_Localized: 14.800 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956072563392
    m_Localized: Die Wurzel der Sache
    m_Metadata:
      m_Items: []
  - m_Id: 7956073563392
    m_Localized: "\"Der Watermelone-Saft tat gut \u2014 erinnert mich daran, wie ich fr\xFCher Karottensaft probieren wollte. Ich s\xE4e ein paar Samen, und du hilfst mir dabei? Bring die Karotten, dann schauen wir weiter.\" - Die Wurzel der Sache"
    m_Metadata:
      m_Items: []
  - m_Id: 7956074563392
    m_Localized: 5.800 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956075563392
    m_Localized: Beerenstark erschreckt
    m_Metadata:
      m_Items: []
  - m_Id: 7956076563392
    m_Localized: "\u201CPumking ergeben perfekte Vogelscheuchenk\xF6pfe. Hol uns welche, dann helfen wir dir, das Ungeziefer fernzuhalten.\u201D \u2014 Flora & Tillman"
    m_Metadata:
      m_Items: []
  - m_Id: 7956077563392
    m_Localized: 15.800 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956078563392
    m_Localized: Ranken und Schlemmen
    m_Metadata:
      m_Items: []
  - m_Id: 7956079563392
    m_Localized: "<i>L\xE4chelt</i> \"Eva plant schon wieder etwas \u2014 bei so vielen Kartoffeln bestimmt ein Festmahl! Ich s\xE4e Kartoffeln f\xFCr dich; w\xFCrdest du sie f\xFCr mich anbauen?\" - Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956080563392
    m_Localized: 7.000 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956081563392
    m_Localized: Widerspenstige Funions
    m_Metadata:
      m_Items: []
  - m_Id: 7956082563392
    m_Localized: "\u201CJeder Meister im Ackerbau muss das teuflischste Gem\xFCse beherrschen: Funions! Lass dich vom Namen nicht t\xE4uschen \u2014 diese Pflanze stellt deine Nerven auf die Probe. Hol mir welche, dann zeige ich dir den R\xFCbenanbau.\u201D \u2014 Flora"
    m_Metadata:
      m_Items: []
  - m_Id: 7956083563392
    m_Localized: 18.000 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956084563392
    m_Localized: Bodenloser Ehrgeiz
    m_Metadata:
      m_Items: []
  - m_Id: 7956085563392
    m_Localized: "\u201CBei Orins Bart, diese Mine h\xF6rt nie auf, was? Das Crimsonite-Erz, das du schleppst, l\xE4sst sich bestimmt gut nutzen. Mal sehen, wie weit du kommst \u2014 ich bleib genau hier und schau zu.\u201D \u2014 Der Alte"
    m_Metadata:
      m_Items: []
  - m_Id: 7956086563392
    m_Localized: 11.200 Bergbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7956087563392
    m_Localized: Der Weg des Wassers
    m_Metadata:
      m_Items: []
  - m_Id: 7956088563392
    m_Localized: "<i>Ein St\xFCck Weizenspreu zwischen den Z\xE4hnen</i> \"Nun ... jedes Mal, wenn du etwas erntest, wird deine Verbindung zu diesen Pflanzen st\xE4rker. Barkley soll einen Zaun bauen, und ich schenke dir dieses St\xFCck Land. Ich zeige dir, wie du jede Pflanze anbaust, die ich kenne!\""
    m_Metadata:
      m_Items: []
  - m_Id: 7956089563392
    m_Localized: 3.600 Ackerbau-XP
    m_Metadata:
      m_Items: []
  - m_Id: 7955964563392
    m_Localized: Ernsthaft?
    m_Metadata:
      m_Items: []
  - m_Id: 7956027563392
    m_Localized: Einfach weiterfressen.
    m_Metadata:
      m_Items: []
  - m_Id: 7957296563392
    m_Localized: Hast du 1000 gesagt!?
    m_Metadata:
      m_Items: []
  - m_Id: 7957396563392
    m_Localized: '"Ich erschaffe gern Welten, aber manchmal wird es etwas einsam" - Orin'
    m_Metadata:
      m_Items: []
  - m_Id: 7957496563392
    m_Localized: "Automatisches Wirken f\xFCr Zauberplatz 3 kann jetzt umgeschaltet werden."
    m_Metadata:
      m_Items: []
  - m_Id: 7957596563392
    m_Localized: Das kann nicht dein Ernst sein ...
    m_Metadata:
      m_Items: []
  - m_Id: 7957696563392
    m_Localized: "\"Denk beim Erkunden dieser Welt \xFCber die Folgen deiner Taten nach. Du bereicherst das Leben der Figuren, die ich geschaffen habe, und hilfst ihnen wie dir selbst. Vergiss dich bei aller Liebe f\xFCr andere nicht \u2014 manchmal hast du nur dich\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 7957796563392
    m_Localized: "Automatisches Wirken f\xFCr Zauberplatz 4 kann jetzt umgeschaltet werden."
    m_Metadata:
      m_Items: []
  - m_Id: 889194730110976
    m_Localized: "Automatisches Wirken f\xFCr Zauberplatz 5 kann jetzt umgeschaltet werden."
    m_Metadata:
      m_Items: []
  - m_Id: 889193538928640
    m_Localized: "\"Aus gro\xDFer Macht folgt gro\xDFe Verantwortung ... Nutze sie weise, junger Freund\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 889191659880448
    m_Localized: "Es ist \xFCber 9000!"
    m_Metadata:
      m_Items: []
  - m_Id: 7955968563392
    m_Localized: "Mildred sieht hungrig aus. Vielleicht solltest du sie f\xFCttern."
    m_Metadata:
      m_Items: []
  - m_Id: 7955965563392
    m_Localized: Ernsthaft. Diese Katze will mehr Futter.
    m_Metadata:
      m_Items: []
  - m_Id: 7956028563392
    m_Localized: Mildred schnurrt, leckt ihre Pfoten und wartet dann erwartungsvoll auf mehr.
    m_Metadata:
      m_Items: []
  - m_Id: 7956037563392
    m_Localized: "Mildred springt dir auf den Scho\xDF und tatzt nach dem Fischsack. Vielleicht solltest du ihn ihr einfach geben."
    m_Metadata:
      m_Items: []
  - m_Id: 1575797333049344
    m_Localized: Die Zwillinge finden
    m_Metadata:
      m_Items: []
  - m_Id: 1575867566669824
    m_Localized: "Die Zwillinge liefern mir Zutaten vom Feld. Finde sie im Ackerland und gib eine Bestellung f\u00fcr mich auf. Ich zeige dir, wie du deine Verbindung zu Echos st\u00e4rkst. \u2014 Eva"
    m_Metadata:
      m_Items: []
  - m_Id: 1575905307017216
    m_Localized: Bringt die Stadtgeschichte voran.
    m_Metadata:
      m_Items: []
  - m_Id: 1640742938624000
    m_Localized: 'Neue Zauber:

      Echo | Kampf, Echo | Aufgaben'
    m_Metadata:
      m_Items: []
  - m_Id: 1640699355611136
    m_Localized: Ins Multiversum
    m_Metadata:
      m_Items: []
  - m_Id: 1640721103077376
    m_Localized: "\"Bestimmt hast du die gelegentlichen Ausschl\xE4ge zeitlicher Energie bemerkt: Schatten deiner selbst, die dir helfen. Alle meine Reiche sind verbunden. Diese ... Echos deiner Vergangenheit dringen hindurch, um dich zu unterst\xFCtzen. Deine beharrliche Hilfe f\xFCr die Stadtbewohner hat dir das Recht verdient, mit einem Teil meiner Macht Echos nach Belieben zu rufen\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 1871405633650688
    m_Localized: "\"Tillman sagt, du baust jetzt mit deiner Essenz Pflanzen an? *Pfeift* Unglaublich. Sag ihm nicht, dass ich's verraten habe, aber er will dir das Land an der Windm\xFChle schenken. Ich soll schon mit dem Zaun anfangen. Gib mir ein paar deiner gesammelten St\xF6cke, dann leg ich gern los\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 1871406690615296
    m_Localized: "Reisedistanz um 50 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 1871404551520256
    m_Localized: "Ein Zaun f\xFCr deinen Hof"
    m_Metadata:
      m_Items: []
  - m_Id: 1876363284201473
    m_Localized: "\"Na, was meinst du?! H\xFCbsch, oder? Zum Weitermachen brauche ich mehr St\xF6cke und Holzst\xE4mme f\xFCr die Pfosten. K\xF6nntest du noch welche holen?\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 1876363284201472
    m_Localized: Material fehlt
    m_Metadata:
      m_Items: []
  - m_Id: 1876363284201474
    m_Localized: "Reisedistanz um 100 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 1879594387259392
    m_Localized: "So ein sch\xF6nes Tor"
    m_Metadata:
      m_Items: []
  - m_Id: 1879594387259393
    m_Localized: "\"Noch ein paar, dann sind wir fertig. Diesmal brauche ich auch etwas Schleim, f\xFCr die Bindungen am Tor\" - Barkley"
    m_Metadata:
      m_Items: []
  - m_Id: 1879594387259394
    m_Localized: "Reisedistanz um 150 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 2561275523907584
    m_Localized: Lass sie klappern
    m_Metadata:
      m_Items: []
  - m_Id: 2561275549073408
    m_Localized: "\"Skelette zu t\xF6ten macht Spa\xDF. Du glaubst mir nicht? Probier's aus, dann sorge ich daf\xFCr, dass es sich lohnt\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2561275549073409
    m_Localized: "Reisedistanz um 50 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869056
    m_Localized: Klappern und Rollen
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869058
    m_Localized: "Reisedistanz um 50 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869059
    m_Localized: Knochenfeuernacht
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869061
    m_Localized: "Reisedistanz um 100 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869062
    m_Localized: Es geht durch Mark und Bein
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869064
    m_Localized: "Reisedistanz um 100 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869065
    m_Localized: "Ein H\xFChnchen zu rupfen"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869067
    m_Localized: "Reisedistanz um 150 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869068
    m_Localized: Zermalme ihre Knochen
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869070
    m_Localized: "Reisedistanz um 150 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869071
    m_Localized: Jenseits der Knochen
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869072
    m_Localized: "\"Mir gehen langsam die Skelettnamen aus. Erledigst du den letzten noch f\xFCr mich? Du hast dich gut geschlagen. Ich wei\xDF dich zu sch\xE4tzen\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869057
    m_Localized: "\"Rasseln aus Skeletten, Skelette aus Rasseln \u2014 ich wei\xDF doch selbst nicht mehr, wie das alles funktioniert\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869060
    m_Localized: "\"Feuer ist hei\xDF genug, um Knochen zu schmelzen. Ein bisschen Magie sollte das l\xF6sen\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869063
    m_Localized: "\"Anders als viele glauben ist Lirium ziemlich warm. Seine Essenz jagt jedem, der es ber\xFChrt, einen Schauer \xFCber den R\xFCcken. Deshalb halten die Leute es f\xFCr kalt\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869066
    m_Localized: "\"Das Leben ist hart, Junge, aber du bist h\xE4rter. Mach weiter so!\" - Orin"
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869069
    m_Localized: '"Inzwischen zerquetschst du wohl alles, was du anfasst? Ab hier wird''s nur noch schwerer, also mach dich bereit" - Orin'
    m_Metadata:
      m_Items: []
  - m_Id: 2570098317869073
    m_Localized: "Reisedistanz um 150 erh\xF6ht."
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904135
