    m_Localized: "\xAB\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0441\u0443\u0434\u0430\u0440\u044C! \u0412\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0439 \u043D\u0430\u0448\u0443 \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u0443, \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F. \u041F\u043E\u0441\u0442\u043E\u0439, \u0447\u0442\u043E \u044D\u0442\u043E?! \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B, \u0447\u0442\u043E\u0431\u044B \u0440\u0435\u0434\u0438\u0441 \u0442\u0430\u043A \u0440\u043E\u0441! \u041E\u043D \u0431\u0443\u0434\u0442\u043E \u0441\u0432\u044F\u0437\u0430\u043D \u0441 \u0442\u043E\u0431\u043E\u0439! \u041B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E, \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0434\u0430\u043B\u044C\u0448\u0435. \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u0443, \u0438 \u044F \u043D\u0430\u0443\u0447\u0443 \u0442\u0435\u0431\u044F \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0442\u044C \u043F\u0448\u0435\u043D\u0438\u0446\u0443\xBB \u2014 \u0422\u0438\u043B\u043B\u043C\u0430\u043D"
