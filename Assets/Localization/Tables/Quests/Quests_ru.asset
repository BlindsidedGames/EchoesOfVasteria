  - m_Id: 1640721103077376
    m_Localized: "\xAB\u0422\u044B \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u0432\u0441\u043F\u043B\u0435\u0441\u043A\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u2014 \u0442\u0432\u043E\u0438 \u0442\u0435\u043D\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0442\u0435\u0431\u0435. \u0412\u0441\u0435 \u043C\u043E\u0438 \u043C\u0438\u0440\u044B \u0441\u0432\u044F\u0437\u0430\u043D\u044B. \u042D\u0442\u043E... \u044D\u0445\u043E \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0441\u044E\u0434\u0430 \u0442\u0435\u0431\u0435 \u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C. \u0423\u043F\u043E\u0440\u043D\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u044F \u0433\u043E\u0440\u043E\u0436\u0430\u043D\u0430\u043C, \u0442\u044B \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B \u043F\u0440\u0430\u0432\u043E \u0432\u043B\u0430\u0434\u0435\u0442\u044C \u0447\u0430\u0441\u0442\u044C\u044E \u043C\u043E\u0435\u0439 \u0441\u0438\u043B\u044B \u0438 \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u0442\u044C \u044D\u0445\u043E \u043F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E\xBB \u2014 \u041E\u0440\u0438\u043D"
