  - m_Id: 7956087563392
    m_Localized: "\u0427\u0442\u043E \u0415\u0434\u044F\u0442 \u0410\u043D\u0433\u0435\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 7956088563392
    m_Localized: "<i>\u0421\u043E\u043B\u043E\u043C\u0438\u043D\u043A\u0430 \u043F\u0448\u0435\u043D\u0438\u0446\u044B
      \u0432 \u0437\u0443\u0431\u0430\u0445</i> \"\u041D\u0443 \u0447\u0442\u043E
      \u0436\u2026 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043A\u0430\u0436\u0434\u044B\u0439
      \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0447\u0442\u043E-\u0442\u043E
      \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C, \u0442\u0432\u043E\u044F
      \u0441\u0432\u044F\u0437\u044C \u0441 \u044D\u0442\u0438\u043C\u0438 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F\u043C\u0438
      \u043A\u0440\u0435\u043F\u043D\u0435\u0442. \u042F \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
      \u0411\u0430\u0440\u043A\u043B\u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0437\u0430\u0431\u043E\u0440 \u0438 \u0432\u044B\u0434\u0435\u043B\u044F\u044E
      \u0442\u0435\u0431\u0435 \u044D\u0442\u043E\u0442 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0437\u0435\u043C\u043B\u0438. \u042F \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
      \u043D\u0430\u0443\u0447\u0438\u0442\u044C \u0442\u0435\u0431\u044F \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0442\u044C
      \u0432\u0441\u0435 \u0432\u0438\u0434\u044B \u043A\u0443\u043B\u044C\u0442\u0443\u0440,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u043D\u0430\u044E!\""
