      m_Items: []
  - m_Id: 7956054563392
    m_Localized: "\u0417\u0435\u043B\u0451\u043D\u0430\u044F \u0442\u0435\u0440\u0430\u043F\u0438\u044F:
      \u0445\u0440\u0443\u0441\u0442\u0438\u0442 \u0438 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 7956055563392
    m_Localized: "\"\u0422\u044B \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0440\u043E\u0439\u0434\u0438\u0441\u044C
      \u0441\u043E \u043C\u043D\u043E\u0439, \u043F\u043E\u043A\u0430 \u044F \u0441\u0430\u0436\u0430\u044E
      \u044D\u0442\u0438 \u0442\u043E\u043C\u0430\u0442\u044B, \u043B\u0430\u0434\u043D\u043E?
      \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u043D\u0435 \u0441\u0430\u043C\u044B\u0435
      \u0441\u043E\u0447\u043D\u044B\u0435 \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u044B,
      \u0438 \u044F \u043F\u043E\u043A\u0430\u0436\u0443 \u0442\u0435\u0431\u0435
      \u0441\u0435\u043A\u0440\u0435\u0442 \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u043D\u0438\u044F
      \u0445\u0440\u0443\u0441\u0442\u044F\u0449\u0435\u0433\u043E, \u043E\u0441\u0432\u0435\u0436\u0430\u044E\u0449\u0435\u0433\u043E
      \u0441\u0430\u043B\u0430\u0442\u0430-\u043B\u0430\u0442\u0443\u043A\u0430.\"
      - \u0424\u043B\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7956056563392
