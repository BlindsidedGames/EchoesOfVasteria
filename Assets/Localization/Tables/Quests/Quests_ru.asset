  - m_Id: 38005472141656064
    m_Localized: "\xAB\u041E\u0434\u0438\u043D \u043C\u043E\u0439 \u0434\u0440\u0443\u0433 \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E \u043E\u0431\u044A\u0435\u0437\u0434\u0438\u043B \u0432\u0435\u0441\u044C \u043C\u0438\u0440 \u0438 \u043D\u0430\u0448\u0451\u043B \u043A\u0443\u0447\u0443 \u0434\u0438\u043A\u043E\u0432\u0438\u043D. \u041C\u043D\u0435 \u043D\u0435\u043A\u043E\u0433\u0434\u0430, \u0437\u0430\u0442\u043E \u043D\u0430\u0448\u0430 \u0440\u0435\u043A\u0430 \u043F\u043E\u043B\u043D\u0430 \u0441\u043B\u0430\u0432\u043D\u043E\u0439 \u0440\u044B\u0431\u044B. \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435 \u2014 \u043F\u043E\u043A\u0430\u0436\u0443 \u0435\u043C\u0443, \u0447\u0442\u043E \u0438 \u0442\u0443\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0443\u043F\u0443\u0441\u043A\u0430\u044E. \u0422\u0440\u0443\u0434\u044B \u0442\u0432\u043E\u0438 \u0434\u0430\u0440\u043E\u043C \u043D\u0435 \u043F\u0440\u043E\u043F\u0430\u0434\u0443\u0442\xBB. \u2014 \u0413\u0438\u043B\u043B"
