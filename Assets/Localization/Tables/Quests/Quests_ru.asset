    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904130
    m_Localized: "\u041C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904131
    m_Localized: "\xAB\u0422\u0432\u043E\u044F \u0441\u0432\u044F\u0437\u044C \u0441 \u043C\u0438\u0440\u043E\u043C \u041E\u0440\u0438\u043D\u0430 \u0441\u0438\u043B\u044C\u043D\u0430. \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u044B \u0437\u0434\u0435\u0441\u044C \u0434\u0435\u043B\u0430\u0435\u0448\u044C, \u0442\u0435\u043C \u043A\u0440\u0435\u043F\u0447\u0435 \u043E\u043D\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F. \u041F\u043E\u0447\u0435\u043C\u0443 \u0431\u044B \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439? \u041C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0443\u0436\u0435\u043D \u0440\u0435\u0434\u0438\u0441 \u0434\u043B\u044F \u0432\u0430\u0440\u0435\u043D\u044C\u044F\xBB \u2014 \u0415\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8818639323414528
    m_Localized: "\u041F\u043E\u0434\u0430\u0432\u043B\u044F\u044E\u0449\u0430\u044F \u0441\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8818639323414529
    m_Localized: "\xAB\u0421 \u0432\u0435\u043B\u0438\u043A\u043E\u0439 \u0441\u0438\u043B\u043E\u0439 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0432\u0435\u043B\u0438\u043A\u0430\u044F... \u0414\u0430 \u0448\u0443\u0447\u0443 \u044F! \u041D\u043E \u0447\u0442\u043E\u0431\u044B \u0443\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0441\u0432\u044F\u0437\u044C, \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0432 \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0440\u0430\u0437\xBB \u2014 \u0415\u0432\u0430"
    m_Metadata:
      m_Items: []
