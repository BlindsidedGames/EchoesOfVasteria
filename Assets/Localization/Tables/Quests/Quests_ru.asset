    m_Localized: "\u041A\u0443\u0437\u043D\u0438\u0446\u0430 \u0438 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u043C\u0435\u0447!\n\u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0436\u0430\u0442\u0432\u044B \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0430 \u043D\u0430 25."
