  m_TableData:
  - m_Id: 7955958563392
    m_Localized: "\u0420\u044B\u0431\u043D\u043E\u0435 \u0434\u0435\u043B\u044C\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 7955959563392
    m_Localized: "\"\u041F\u043E\u0445\u043E\u0436\u0435, \u0442\u044B \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u041C\u0438\u043B\u0434\u0440\u0435\u0434! \u0411\u044C\u044E\u0441\u044C
      \u043E\u0431 \u0437\u0430\u043A\u043B\u0430\u0434, \u0435\u0441\u043B\u0438
      \u0434\u0430\u0448\u044C \u0435\u0439 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0441\u0432\u043E\u0438\u0445 \u0424\u043B\u0438\u043F\u043F\u0438 \u0424\u043B\u043E\u043F\u043F\u0441\u043E\u0432,
      \u043E\u043D\u0430 \u0441 \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u0432
      \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F\u0445!\"
      - \u0415\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7955960563392
    m_Localized: "\u041C\u0438\u043B\u044C\u0434\u0440\u0435\u0434 \u0441\u043B\u0435\u0434\u0443\u0435\u0442
      \u0437\u0430 \u0442\u043E\u0431\u043E\u0439 \u0438 \u0434\u0430\u0451\u0442
      \u0431\u0430\u0444\u0444\u044B! \n\u0417\u0430\u0434\u0430\u043D\u0438\u044F
      & \u0411\u043E\u0435\u0432\u044B\u0435 \u042D\u0445\u043E \u0411\u0430\u0444\u0444\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 7955967563392
    m_Localized: "\u041C\u044F\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 7955968563392
    m_Localized: "\u041C\u0438\u043B\u044C\u0434\u0440\u0435\u0434 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0433\u043E\u043B\u043E\u0434\u043D\u043E\u0439, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0441\u0442\u043E\u0438\u0442 \u0435\u0451 \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 7955969563392
    m_Localized: "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0441\u043B\u043E\u0442
      \u0431\u0430\u0444\u0444\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7955964563392
    m_Localized: "\u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 7955965563392
    m_Localized: "\u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E. \u042D\u0442\u0430
      \u043A\u043E\u0448\u043A\u0430 \u0445\u043E\u0447\u0435\u0442 \u0435\u0449\u0451
      \u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 7955966563392
    m_Localized: "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0441\u043B\u043E\u0442
      \u0431\u0430\u0444\u0444\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7956027563392
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439
      \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 7956028563392
    m_Localized: "\u041C\u0438\u043B\u044C\u0434\u0440\u0435\u0434 \u043C\u0443\u0440\u0447\u0438\u0442
      \u0438 \u043E\u0431\u043B\u0438\u0437\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u043F\u043A\u0438,
      \u0437\u0430\u0442\u0435\u043C \u0443\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0436\u0434\u0451\u0442 \u0434\u043E\u0431\u0430\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7956029563392
    m_Localized: "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0441\u043B\u043E\u0442
      \u0431\u0430\u0444\u0444\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 7956036563392
    m_Localized: "\u041D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438 - \u0438 \u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7956037563392
    m_Localized: "\u041C\u0438\u043B\u044C\u0434\u0440\u0435\u0434 \u0437\u0430\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0435\u0442
      \u0442\u0435\u0431\u0435 \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438
      \u0438 \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u043B\u0430\u043F\u0430\u043C\u0438
      \u043F\u043E \u043C\u0435\u0448\u043A\u0443 \u0441 \u0440\u044B\u0431\u043E\u0439.
      \u041F\u043E\u0445\u043E\u0436\u0435, \u043B\u0443\u0447\u0448\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0442\u0434\u0430\u0442\u044C \u0435\u0433\u043E \u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 7956038563392
    m_Localized: "\u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0441\u043B\u043E\u0442
      \u0431\u0430\u0444\u0444\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 7955985563392
    m_Localized: "\u042D\u0445\u043E-\u043A\u0430\u0441\u0442\u0438\u043D\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 7955986563392
    m_Localized: "\"\u0427\u0435\u043C \u0447\u0430\u0449\u0435 \u0442\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0448\u044C
      \u044D\u0442\u0438 \u0431\u0430\u0444\u0444\u044B, \u0442\u0435\u043C \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0435\u0435
      \u0431\u0443\u0434\u0435\u0442 \u043E\u0449\u0443\u0449\u0430\u0442\u044C\u0441\u044F
      \u043C\u043E\u044F \u0441\u0438\u043B\u0430, \u0438 \u044D\u0445\u043E \u0442\u0432\u043E\u0435\u0433\u043E
      \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u0431\u0443\u0434\u0435\u0442
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u0438\u0445
      \u0437\u0430 \u0442\u0435\u0431\u044F.\" - \u0412\u0435\u043B\u0438\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 7955987563392
    m_Localized: "\u042F\u0447\u0435\u0439\u043A\u0430 1 \u0430\u0432\u0442\u043E\u043A\u0430\u0441\u0442\u0430
      \u0442\u0435\u043F\u0435\u0440\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7956033563392
    m_Localized: 100
    m_Metadata:
      m_Items: []
  - m_Id: 7956034563392
    m_Localized: "\"\u041A\u0430\u0436\u0434\u0430\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u044F\u0447\u0435\u0439\u043A\u0430 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0435\u0451.
      \u0422\u0430\u043A\u043E\u0432\u0430 \u043F\u0440\u0438\u0440\u043E\u0434\u0430
      \u042D\u0445\u043E-\u043A\u0430\u0441\u0442\u0438\u043D\u0433\u0430\u2026\"
      - \u0412\u0435\u043B\u0438\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 7956035563392
    m_Localized: "\u042F\u0447\u0435\u0439\u043A\u0430 2 \u0430\u0432\u0442\u043E\u043A\u0430\u0441\u0442\u0430
      \u0442\u0435\u043F\u0435\u0440\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7957296563392
    m_Localized: "\u0422\u044B \u0441\u043A\u0430\u0437\u0430\u043B 1000!?"
    m_Metadata:
      m_Items: []
  - m_Id: 7957396563392
    m_Localized: "\xAB\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u043C\u0438\u0440\u044B,
      \u043D\u043E \u043F\u043E\u0440\u043E\u0439 \u044D\u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043E\u0434\u0438\u043D\u043E\u043A\u043E.\xBB - \u0412\u0435\u043B\u0438\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 7957496563392
    m_Localized: "\u042F\u0447\u0435\u0439\u043A\u0430 3 \u0430\u0432\u0442\u043E\u043A\u0430\u0441\u0442\u0430
      \u0442\u0435\u043F\u0435\u0440\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7957596563392
    m_Localized: "\u0422\u044B \u0432\u0435\u0434\u044C \u043D\u0435 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 7957696563392
    m_Localized: "\"\u0418\u0441\u0441\u043B\u0435\u0434\u0443\u044F \u044D\u0442\u043E\u0442
      \u043C\u0438\u0440, \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u0439\u0441\u044F
      \u043E \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F\u0445
      \u0441\u0432\u043E\u0438\u0445 \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u043E\u0432.
      \u0422\u044B \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0448\u044C \u0436\u0438\u0437\u043D\u0438
      \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0445 \u043C\u043D\u043E\u0439
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439, \u043F\u043E\u043C\u043E\u0433\u0430\u044F
      \u0438\u043C \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0448\u044C
      \u0441\u0435\u0431\u0435. \u041F\u043E\u043C\u043D\u0438 \u043E \u0441\u0435\u0431\u0435
      \u0432 \u0441\u0432\u043E\u0435\u0439 \u043B\u044E\u0431\u0432\u0438 \u043A
      \u0434\u0440\u0443\u0433\u0438\u043C, \u0432\u0435\u0434\u044C \u0438\u043D\u043E\u0433\u0434\u0430
      \u0442\u044B - \u044D\u0442\u043E \u0432\u0441\u0435, \u0447\u0442\u043E \u0443
      \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C\" - \u0412\u0435\u043B\u0438\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 7957796563392
    m_Localized: "\u042F\u0447\u0435\u0439\u043A\u0430 4 \u0430\u0432\u0442\u043E\u043A\u0430\u0441\u0442\u0430
      \u0442\u0435\u043F\u0435\u0440\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 889191659880448
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0435 9000!"
    m_Metadata:
      m_Items: []
  - m_Id: 889193538928640
    m_Localized: "\xAB\u0421 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0438\u043B\u043E\u0439
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0438 \u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u2026
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0435\u0451 \u043C\u0443\u0434\u0440\u043E,
      \u044E\u043D\u0435\u0446.\xBB - \u0412\u0435\u043B\u0438\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 889194730110976
    m_Localized: "\u042F\u0447\u0435\u0439\u043A\u0430 5 \u0430\u0432\u0442\u043E\u043A\u0430\u0441\u0442\u0430
      \u0442\u0435\u043F\u0435\u0440\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7520072908800
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439, \u041F\u0443\u043F\u044B\u0440\u0447\u0430\u0442\u044B\u0439
      \u0438 \u0416\u0451\u043B\u0442\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 7521440251904
    m_Localized: "\"\u041C\u044B \u043D\u0438\u043A\u0430\u043A \u043D\u0435 \u0443\u0441\u043F\u0435\u0435\u043C
      \u0434\u043E\u0441\u0442\u0430\u0442\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0440\u0435\u0434\u0438\u0441\u0430 \u043A \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044E
      \u0415\u0432\u044B\u2026 \u041E! \u0412\u0438\u0436\u0443, \u0443 \u0442\u0435\u0431\u044F
      \u0435\u0451 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0430\u044F \u043B\u0435\u0439\u043A\u0430!
      \u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0448\u044C
      \u043C\u043D\u0435 100 \u0440\u0435\u0434\u0438\u0441\u043E\u043A, \u044F \u0441
      \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E \u043F\u043E\u043F\u0440\u043E\u0448\u0443
      \u0422\u0438\u043B\u043B\u043C\u0430\u043D\u0430 \u043D\u0430\u0443\u0447\u0438\u0442\u044C
      \u0442\u0435\u0431\u044F \u043A\u0430\u043A \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0442\u044C
      \u0437\u0430 \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u043E\u0439.\" - \u0424\u043B\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7522576908288
    m_Localized: "\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u044B
      \u0441\u0435\u043C\u0435\u043D\u0430 \u041A\u0443\u043A\u0443\u0440\u0443\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 7243521474560
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u0430\u044F \u0417\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7244716851200
    m_Localized: "\"\u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0441\u044D\u0440, \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0439
      \u043D\u0430\u0448\u0443 \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u0443 \u043A\u043E\u0433\u0434\u0430
      \u0434\u0443\u0448\u0435 \u0443\u0433\u043E\u0434\u043D\u043E. \u041F\u043E\u0441\u0442\u043E\u0439,
      \u044D\u0442\u043E \u043A\u0430\u043A!? \u041D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0432\u0438\u0434\u0435\u043B, \u0447\u0442\u043E\u0431\u044B
      \u0440\u0435\u0434\u0438\u0441 \u0440\u043E\u0441 \u0432\u043E\u0442 \u0442\u0430\u043A!
      \u041F\u043E\u0445\u043E\u0436\u0435, \u044D\u0442\u043E \u043A\u0430\u043A-\u0442\u043E
      \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u0442\u043E\u0431\u043E\u0439!
      \u0425\u043E\u0447\u0443 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C,
      \u043A \u0447\u0435\u043C\u0443 \u044D\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442.
      \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u043D\u0435 \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u044B
      - \u0438 \u044F \u043D\u0430\u0443\u0447\u0443 \u0442\u0435\u0431\u044F \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0442\u044C
      \u043F\u0448\u0435\u043D\u0438\u0446\u0443.\" - \u0422\u0438\u043B\u043B\u043C\u0430\u043D"
