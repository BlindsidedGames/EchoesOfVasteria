      m_Items: []
  - m_Id: 8817834121904160
    m_Localized: "\u0425\u0440\u043E\u043D\u043E\u0441\u043F\u0440\u0438\u043D\u0442 \u0415\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904161
    m_Localized: "\xAB\u0427\u0443\u0442\u043E\u043A \u0441\u043E\u0433\u043D\u0443\u043B\u0430 \u0432\u0440\u0435\u043C\u044F. \u041D\u0435 \u0442\u0440\u0430\u0442\u044C \u0437\u0440\u044F\xBB. \u2014 \u0415\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904163
    m_Localized: "\u0417\u0430\u0431\u0435\u0433 \u043F\u0440\u043E\u0442\u0438\u0432 \u0441\u043B\u0438\u0437\u043D\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904164
    m_Localized: "\xAB\u041F\u0440\u0430\u0432\u0438\u043B\u043E \u043F\u0435\u0440\u0432\u043E\u0435: \u0435\u0441\u043B\u0438 \u0434\u0440\u043E\u0436\u0438\u0442, \u0437\u043D\u0430\u0447\u0438\u0442, \u0441\u0430\u043C\u043E \u0432\u044B\u0437\u0432\u0430\u043B\u043E\u0441\u044C\xBB. \u2014 \u0421\u0442\u0430\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904166
    m_Localized: "\u0423\u0442\u0438\u0445\u043E\u043C\u0438\u0440\u0438\u0442\u044C \u043A\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904167
    m_Localized: "\xAB\u041A\u043E\u0441\u0442\u044F\u043C \u043D\u0443\u0436\u0435\u043D \u043F\u043E\u043A\u043E\u0439. \u041F\u043E\u043C\u043E\u0433\u0438 \u0438\u043C \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C\xBB. \u2014 \u0421\u0442\u0430\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904169
    m_Localized: "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0440\u0430\u0437\u0431\u043E\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904170
    m_Localized: "\xAB\u0426\u0435\u043B\u044C\u0441\u044F \u0432 \u0441\u0443\u0441\u0442\u0430\u0432\u044B, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u0441\u0434\u0435\u043B\u0430\u0435\u0442 \u0444\u0438\u0437\u0438\u043A\u0430\xBB. \u2014 \u0415\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904172
    m_Localized: "\u041A\u043E\u0442 \u0438 \u0451\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904173
    m_Localized: "\xAB\u0422\u0430\u043A \u0432\u0435\u0434\u044C \u044D\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442\u0441\u044F?\xBB \u2014 \u041E\u0440\u0438\u043D\n\n<b>\u0415\u0449\u0451 \u043E\u0434\u043D\u0430 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \xAB\u0413\u043E\u0440\u043E\u0436\u0430\u043D\u0435\xBB. \u0417\u0434\u0435\u0441\u044C \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C \u043D\u0435\u043C\u0430\u043B\u043E \u0441\u0438\u043B\u044B.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904175
    m_Localized: "\u041E\u0441\u043E\u0431\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904176
    m_Localized: "\u0421\u043A\u0430\u0436\u0438 \u043C\u0438\u0440\u0443, \u0447\u0442\u043E \u0438\u0449\u0435\u0448\u044C. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u043D \u043E\u0442\u043A\u043B\u0438\u043A\u043D\u0435\u0442\u0441\u044F. \u2014 \u041E\u0440\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904178
    m_Localized: "\u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u0432\u0435\u0440\u0445\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904179
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0445 \u043F\u043E\u0431\u0435\u0434. \u041E\u0434\u0438\u043D \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A. \u2014 \u041E\u0440\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904181
    m_Localized: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0438\u0435 \u0447\u0430\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904182
    m_Localized: "\u0422\u044B \u0441\u043E\u0441\u0447\u0438\u0442\u0430\u043B \u043F\u043E\u0431\u0435\u0434\u044B. \u0422\u0435\u043F\u0435\u0440\u044C \u0441\u043E\u0441\u0447\u0438\u0442\u0430\u0439 \u0442\u043E, \u0447\u0442\u043E \u0443\u043F\u0443\u0441\u0442\u0438\u043B. \u2014 \u041E\u0440\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904184
    m_Localized: "\u0412 \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904185
    m_Localized: "\u0422\u0432\u043E\u0451 \u044D\u0445\u043E \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u0440\u0443\u0434. \u041E\u0442\u0432\u0435\u0442\u044C \u0435\u043C\u0443. \u2014 \u041E\u0440\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904187
    m_Localized: "\u0410\u0432\u0442\u043E\u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904188
    m_Localized: "\xAB\u042F \u043E\u0434\u043E\u0431\u0440\u0438\u043B \u0442\u0432\u043E\u0451 \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u2014 \u043F\u043B\u043E\u0442\u044C, \u043A\u043E\u043C\u043F\u0438\u043B\u0438\u0440\u0443\u0439\u0441\u044F\xBB. \u2014 \u041E\u0440\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904190
    m_Localized: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043E\u0442\u0440\u0430\u0441\u0442\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904191
    m_Localized: "\xAB\u041B\u0438\u0441\u0442\u044C\u044F \u043F\u043E\u043C\u043D\u044F\u0442 \u0441\u0432\u043E\u044E \u0444\u043E\u0440\u043C\u0443. \u0422\u044B \u0442\u043E\u0436\u0435 \u2014 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438 \u0435\u0451\xBB. \u2014 \u041E\u0440\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904193
    m_Localized: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u0441\u043B\u0430\u0431\u043E\u0433\u043E \u043A\u0438\u043F\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904194
    m_Localized: "\xAB\u0421\u0438\u043B\u0430 \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u0430: \u043F\u0443\u0441\u0442\u044C \u043E\u0433\u043E\u043D\u044C \u0435\u0434\u0432\u0430 \u0448\u0435\u043F\u0447\u0435\u0442, \u0430 \u0432\u0430\u0440\u0435\u0432\u043E \u0441\u0430\u043C\u043E \u0440\u0435\u0448\u0438\u0442\xBB. \u2014 \u0415\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904196
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u0439 \u0438 \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904197
    m_Localized: "\xAB\u0411\u043E\u0439\u0441\u044F \u043D\u0435 \u0432\u0438\u0445\u0440\u044F, \u0430 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u0438\xBB. \u2014 \u0415\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904199
    m_Localized: "\u041B\u0435\u0437\u0432\u0438\u0435 \u0441\u0438\u043D\u0435\u0433\u043E \u0436\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904200
    m_Localized: "\xAB\u041C\u044F\u0433\u043A\u043E\u0435 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435, \u0442\u0432\u0451\u0440\u0434\u043E\u0435 \u043E\u0441\u0442\u0440\u0438\u0451 \u2014 \u043A\u0440\u0438\u0442 \u0440\u043E\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0438\u0437 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F, \u0430 \u043D\u0435 \u0441\u0438\u043B\u044B\xBB. \u2014 \u0418\u0432\u0430\u043D"
