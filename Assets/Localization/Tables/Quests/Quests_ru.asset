    m_Localized: "\xAB\u0421\u0435\u0435\u043C-\u0441\u0435\u0435\u043C, \u0436\u043D\u0451\u043C-\u0436\u043D\u0451\u043C \u2014 \u0434\u0435\u043B\u043E \u0449\u0451\u043B\u043A, \u0438 \u0437\u0430\u0436\u0438\u0432\u0451\u043C\xBB. \u2014 \u0422\u0438\u043B\u043B\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904151
    m_Localized: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043B\u0430\u0441\u043A\u0438 \u041C\u0438\u043B\u0434\u0440\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904152
    m_Localized: "\xAB\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0433\u043B\u0430\u0434\u0438\u0442\u044C. \u041F\u043E\u0442\u043E\u043C \u0434\u0435\u043B\u0430. \u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B\u0430 \u043D\u0435 \u044F\xBB. \u2014 \u041C\u0438\u043B\u0434\u0440\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904154
    m_Localized: "\u0412\u0438\u0445\u0440\u044C \u0421\u0442\u0430\u0440\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904155
    m_Localized: "\xAB\u0414\u0435\u043B\u0430\u0439 \u0431\u044B\u0441\u0442\u0440\u043E, \u0434\u0435\u043B\u0430\u0439 \u0442\u043E\u043B\u043A\u043E\u043C \u2014 \u043C\u043E\u0440\u0433\u043D\u0443\u043B, \u0430 \u0442\u044B \u0443\u0436\u0435 \u0437\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C\xBB. \u2014 \u0421\u0442\u0430\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904157
    m_Localized: "\u041C\u043E\u043B\u043D\u0438\u0435\u043D\u043E\u0441\u043D\u044B\u0439 \u0440\u0430\u0443\u043D\u0434 \u0421\u0442\u0430\u0440\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 8817834121904158
    m_Localized: "\xAB\u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u0435\u043B \u0437\u0430 \u0432\u0440\u0435\u043C\u044F \u043F\u044F\u0442\u0438\xBB. \u2014 \u0421\u0442\u0430\u0440\u0438\u043A"
