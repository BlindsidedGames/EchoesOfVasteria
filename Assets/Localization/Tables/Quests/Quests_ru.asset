  - m_Id: 7639480549376
    m_Localized: "<i>\u0425\u0438\u0445\u0438\u043A\u0430\u0435\u0442</i> \"\u0421\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0447\u0442\u043E \u043F\u043E\u043C\u043E\u0433 \u0441 \u0442\u043E\u0439
      \u043F\u0448\u0435\u043D\u0438\u0446\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0440\u0430\u0441\u043A\u0441\u0430\u0436\u0438\u0432\u0430\u043B \u0422\u0438\u043B\u043B\u043C\u0430\u043D.
      \u0425\u043E\u0447\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043E\u0441\u0432\u0435\u0436\u0430\u044E\u0449\u0438\u0439
      \u043D\u0430\u043F\u0438\u0442\u043E\u043A \u0434\u043B\u044F \u0432\u0441\u0435\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u0430. \u042F \u043F\u043E\u0441\u0435\u044E
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0430\u0440\u0431\u0443\u0437\u043E\u0432;
      \u043D\u0435 \u043C\u043E\u0433 \u0431\u044B \u0442\u044B \u0432\u044B\u0440\u0430\u0441\u0442\u0438\u0442\u044C
