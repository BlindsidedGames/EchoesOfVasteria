  - m_Id: 7956072563392
    m_Localized: "\u041A\u043E\u0440\u0435\u043D\u044C \u0411\u044B\u0442\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 7956073563392
    m_Localized: "\"\u042D\u0442\u043E\u0442 \u0430\u0440\u0431\u0443\u0437\u043D\u044B\u0439
      \u0441\u043E\u043A \u043F\u0440\u0438\u0448\u0451\u043B\u0441\u044F \u043A\u0441\u0442\u0430\u0442\u0438,
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u0441\u0442\u0430\u0440\u044B\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0430, \u043A\u043E\u0433\u0434\u0430
      \u044F \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043C\u043E\u0440\u043A\u043E\u0432\u043D\u044B\u0439. \u041A\u0430\u043A
      \u043D\u0430\u0441\u0447\u0451\u0442 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u044F \u0432\u044B\u043B\u043E\u0436\u0438\u043B \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0441\u0435\u043C\u044F\u043D, \u0430 \u0442\u044B \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C
      \u043C\u043D\u0435? \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u043E\u0440\u043A\u043E\u0432\u044C,
      \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u0447\u0442\u043E
      \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u0432\u044B\u0439\u0434\u0435\u0442.\"
      - \u041A\u043E\u0440\u0435\u043D\u044C \u0411\u044B\u0442\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 7956074563392
