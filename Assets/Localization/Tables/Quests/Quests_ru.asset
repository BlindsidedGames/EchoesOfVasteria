    m_Localized: "\xAB\u041F\u043E\u0433\u0440\u0435\u043C\u0443\u0448\u043A\u0438 \u0438\u0437 \u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432, \u0441\u043A\u0435\u043B\u0435\u0442\u044B \u0438\u0437 \u043F\u043E\u0433\u0440\u0435\u043C\u0443\u0448\u0435\u043A... \u0443\u0436\u0435 \u0438 \u043D\u0435 \u0437\u043D\u0430\u044E, \u043A\u0430\u043A \u044D\u0442\u043E \u0432\u0441\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\xBB \u2014 \u041E\u0440\u0438\u043D"
    m_Metadata:
