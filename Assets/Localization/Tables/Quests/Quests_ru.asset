  - m_Id: 4801358610432
    m_Localized: "\xAB\u0425\u0435\u0445, \u044D\u0442\u043E\u0442 \u043F\u0430\u0440\u0435\u043D\u044C \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u0447\u0442\u0438 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0436\u0435, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u044F. \u041D\u0430\u0439\u0434\u0451\u0448\u044C \u0435\u0433\u043E \u0432 \u041B\u0435\u0441\u0443. \u0411\u0430\u0440\u043A\u043B\u0438, \u043F\u043E\u0436\u0430\u043B\u0443\u0439, \u043D\u0435 \u0441\u0442\u043E\u0438\u043B\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u043E\u0439 \u0440\u0443\u0434\u044B\xBB \u2014 \u041E\u0440\u0438\u043D"
