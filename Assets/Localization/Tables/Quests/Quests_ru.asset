  - m_Id: 87000000000000011
    m_Localized: "\u0424\u043B\u043E\u0440\u0430 \u0438 \u0422\u0438\u043B\u043B\u043C\u0430\u043D: \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0438 \u0443\u0440\u043E\u0432\u043D\u044F \u0431\u043B\u0438\u0437\u043D\u0435\u0446\u043E\u0432 1 \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0411\u0430\u0440\u043A\u043B\u0438 \u0434\u043B\u044F \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u044F. \u0422\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E \u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432. \u041E\u0434\u043D\u0430 \u0441\u0434\u0430\u0447\u0430 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432 \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0432\u0441\u044E \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000012
    m_Localized: "\u0412\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u044C \u041F\u043E\u043B\u0435\u0439: 1 \u0433\u0440\u044F\u0434\u043E\u043A \u0438 0 \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u0432 \u0441\u0430\u0434\u0430. \u0411\u0435\u0437 \u0434\u043E\u043F\u043B\u0430\u0442 \u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430."
