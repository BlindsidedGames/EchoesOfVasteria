  - m_Id: 34882991939796992
    m_Localized: "\xAB\u041D\u044C\u0435-\u0445\u0435-\u0445\u0435, \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439. \u042F \u0432\u0435\u0434\u044C\u043C\u0430, \u0438 \u043D\u0430\u0443\u0447\u0443 \u0442\u0435\u0431\u044F \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0442\u044C \u0437\u0430 \u0437\u0435\u043C\u043B\u0451\u0439. \u0427\u0442\u043E, \u0434\u0443\u043C\u0430\u043B, \u0431\u0443\u0434\u0443 \u0432\u0430\u0440\u0438\u0442\u044C \u0442\u0435\u0431\u0435 \u0437\u0435\u043B\u044C\u044F? \u041F\u0440\u043E\u0447\u044C \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0441\u0442\u0435\u0440\u0435\u043E\u0442\u0438\u043F\u0430\u043C\u0438. \u0418 \u043F\u0440\u0438\u043D\u0435\u0441\u0438 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0437\u0440\u0435\u043B\u044B\u0445 \u0440\u0435\u0434\u0438\u0441\u043E\u043A. \u041A\u0430\u043A \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E, \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0434\u043B\u044F \u043C\u043E\u0435\u0433\u043E \u0432\u0430\u0440\u0435\u043D\u044C\u044F\xBB. \u2014 \u0422\u043E\u0447\u043D\u043E \u043D\u0435 \u043D\u0430\u0448\u0430 \u0415\u0432\u0430"
