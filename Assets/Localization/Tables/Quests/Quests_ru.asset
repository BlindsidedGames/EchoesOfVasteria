  - m_Id: 2570098317869060
    m_Localized: "\xAB\u042D\u0440\u0438\u0444 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0433\u043E\u0440\u044F\u0447, \u0447\u0442\u043E\u0431\u044B \u043F\u043B\u0430\u0432\u0438\u0442\u044C \u043A\u043E\u0441\u0442\u0438, \u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043C\u0430\u0433\u0438\u0438 \u0440\u0435\u0448\u0438\u0442 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443\xBB \u2014 \u041E\u0440\u0438\u043D"
