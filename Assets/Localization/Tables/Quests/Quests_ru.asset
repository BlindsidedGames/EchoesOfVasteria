    m_Metadata:
      m_Items: []
  - m_Id: 7521440251904
    m_Localized: "<b>\u0412\u0435\u0441 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043C\u043E\u0436\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0432\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0438.</b>\n\xAB\u0421\u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0434\u0438\u0441\u0430 \u0434\u043B\u044F \u0415\u0432\u044B \u043D\u0430\u043C \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u0442\u044C... \u041E! \u0423 \u0442\u0435\u0431\u044F \u0435\u0451 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0430\u044F \u043B\u0435\u0439\u043A\u0430! \u0421\u043E\u0431\u0435\u0440\u0438 100 \u0440\u0435\u0434\u0438\u0441\u043E\u043A, \u0438 \u044F \u043F\u043E\u043F\u0440\u043E\u0448\u0443 \u0422\u0438\u043B\u043B\u043C\u0430\u043D\u0430 \u043D\u0430\u0443\u0447\u0438\u0442\u044C \u0442\u0435\u0431\u044F \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0442\u044C \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u0443\xBB \u2014 \u0424\u043B\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
