  - m_Id: 87000000000000000
    m_Localized: "\u041D\u0430\u0448\u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043F\u043E\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000001
    m_Localized: "\u0424\u043B\u043E\u0440\u0430 \u0438 \u0422\u0438\u043B\u043B\u043C\u0430\u043D \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043E \u041F\u043E\u043B\u044F\u0445. \u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0439 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0441 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430\u043C\u0438 \u0432 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F\u0445, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430\u0431\u043E\u0440\u044B \u0441\u0435\u043C\u044F\u043D. \u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0440\u043E\u0436\u0430\u0439 \u0441 \u0437\u0430\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u043C\u0438 \u043F\u043E\u0441\u0430\u0434\u043E\u0447\u043D\u044B\u043C\u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C\u0438 \u0434\u0430\u0451\u0442 \u0438\u043C \u043E\u0431\u0449\u0438\u0439 \u043E\u043F\u044B\u0442. \u041E\u0434\u043D\u043E\u043A\u0440\u0430\u0442\u043D\u044B\u0439 \u043F\u043E\u043B\u0438\u0432 \u0432\u0434\u0432\u043E\u0435 \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u0440\u0435\u043C\u044F \u0440\u043E\u0441\u0442\u0430. \u041F\u043E\u043B\u044F \u0440\u0430\u0441\u0442\u0443\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438 \u0437\u0430\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0439 \u0438\u0433\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000000002
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u0438\u0441\u043A \u0441\u0435\u043C\u044F\u043D \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u043A\u0443\u043B\u044C\u0442\u0443\u0440. \u0411\u0435\u0437 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0445 \u0441\u0435\u043C\u044F\u043D, \u043E\u043F\u044B\u0442\u0430 \u0438 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430 \u0433\u0440\u044F\u0434\u043E\u043A."
    m_Metadata:
