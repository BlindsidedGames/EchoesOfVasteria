  - m_Id: 5293610516480
    m_Localized: "\xAB\u041A\u0430\u043A \u0434\u0435\u043B\u0430, \u0434\u0440\u0443\u0436\u0438\u0449\u0435? \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0441 \u043B\u0443\u0447\u0448\u0435\u0439 \u0440\u044B\u0431\u0430\u043B\u043A\u0438 \u0432 \u0436\u0438\u0437\u043D\u0438. \u0427\u0435\u0433\u043E? \u0422\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0440\u044B\u0431\u0430\u0447\u0438\u043B?! \u0414\u0435\u0440\u0436\u0438 \u0437\u0430\u043F\u0430\u0441\u043D\u0443\u044E \u0443\u0434\u043E\u0447\u043A\u0443 \u0438 \u043D\u0430\u043B\u043E\u0432\u0438 \u0424\u043B\u0438\u043F\u043F\u0438-\u0424\u043B\u043E\u043F\u043F\u0438 \u0434\u043B\u044F \u041C\u0438\u043B\u0434\u0440\u0435\u0434. \u041E\u043D\u0438 \u0432\u043E\u0434\u044F\u0442\u0441\u044F \u043F\u043E\u0447\u0442\u0438 \u0432\u0435\u0437\u0434\u0435!\xBB \u2014 \u0413\u0438\u043B\u043B"
