    m_Localized: "\xAB\u0415\u0441\u043B\u0438 \u0441\u043E\u0431\u0435\u0440\u0451\u0448\u044C \u0443\u0440\u043E\u0436\u0430\u0439 \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u043C\u044B, \u043C\u043E\u0436\u0435\u0442, \u043F\u043E\u0435\u0434\u0438\u043C \u0434\u043E \u0437\u0430\u043A\u0430\u0442\u0430\xBB. \u2014 \u0424\u043B\u043E\u0440\u0430"
