    m_Metadata:
      m_Items: []
  - m_Id: 4508550053888
    m_Localized: "\xAB\u041A\u0430\u0440\u043B-\u0416\u043D\u0435\u0446 \u043D\u0435 \u0434\u0430\u0441\u0442 \u0442\u0435\u0431\u0435 \u0443\u0439\u0442\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E \u043E\u0442 \u0433\u043E\u0440\u043E\u0434\u0430. \u041F\u043E\u043C\u043E\u0433\u0430\u0439 \u0433\u043E\u0440\u043E\u0436\u0430\u043D\u0430\u043C, \u0438 \u043E\u043D \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u043E\u0441\u043B\u0430\u0431\u0438\u0442 \u043F\u043E\u0432\u043E\u0434\u043E\u043A\xBB \u2014 \u041E\u0440\u0438\u043D\n\n<b>\u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0436\u0430\u0442\u0432\u044B \u2014 \u043F\u0440\u0435\u0434\u0435\u043B\u044C\u043D\u043E\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0439\u0442\u0438. \u041E\u043D\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0437\u0430 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0438\u043B\u0438 \u043D\u0430 1%, \u043A\u043E\u0433\u0434\u0430 \u0442\u0435\u0431\u044F \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0416\u043D\u0435\u0446.</b>"
