    m_Localized: Semillas de {0}
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003051
    m_Localized: "A\xFAn no se puede acceder a la fuente de recolecci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003050
    m_Localized: "Faltan fuentes de recolecci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003049
    m_Localized: "Completa la misi\xF3n de construcci\xF3n anterior."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003048
    m_Localized: "Construcci\xF3n desconocida."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003047
    m_Localized: Prepara los bancales antes de plantar.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003046
    m_Localized: Ya hay un cultivo creciendo en este bancal.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003045
    m_Localized: "Primero encuentra un paquete de semillas de r\xE1bano en una aventura."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003044
    m_Localized: No hay bancales listos para cosechar.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003043
    m_Localized: Vuelve al pueblo para cuidar los bancales.
