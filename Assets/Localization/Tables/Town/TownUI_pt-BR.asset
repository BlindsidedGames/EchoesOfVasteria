    m_Localized: "{0} \xB7 Flora e Tillman \xB7 N\xEDvel {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003015
    m_Localized: "G\u00eameos no n\u00edvel 20: colhe e replanta usando 9 pacotes de sementes do mesmo tipo ou 1 muda do mesmo tipo. Para quando os insumos acabam."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003014
    m_Localized: "Volte \xE0 cidade para cuidar dos Campos."
    m_Metadata:
