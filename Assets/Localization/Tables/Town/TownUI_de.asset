      m_Items: []
  - m_Id: 166516885933396023
    m_Localized: "Der Spielstand ist zu gro\xDF oder konnte nicht f\xFCr den Export vorbereitet werden."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396024
    m_Localized: "Der Export \xFCberschreitet die Grenze von {0:N0} Zeichen. Es wurde nichts kopiert."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396025
    m_Localized: "F\xFCge einen Spielstand zum Importieren ein."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396026
    m_Localized: "Der Import \xFCberschreitet die Grenze von {0:N0} Zeichen."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396027
    m_Localized: "Dieser Text ist kein unterst\xFCtzter Spielstandexport."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396028
    m_Localized: "Die Spielstanddaten sind unvollst\xE4ndig oder besch\xE4digt. F\xFCge den vollst\xE4ndigen Export ein und versuche es erneut."
    m_Metadata:
      m_Items: []
