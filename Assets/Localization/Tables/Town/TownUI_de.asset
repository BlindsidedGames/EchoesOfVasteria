    m_Metadata:
      m_Items: []
  - m_Id: 166516885933395972
    m_Localized: "Verwende einen Namen ohne Zeilenumbr\xFCche oder Steuerzeichen."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933395973
    m_Localized: "Verwende einen Namen mit h\xF6chstens 24 Zeichen."
