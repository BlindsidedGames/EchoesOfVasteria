      m_Items: []
  - m_Id: 87000000000003015
    m_Localized: "Zwillinge Stufe 20: Erntet und pflanzt mit 9 passenden Samenp\u00e4ckchen oder 1 passenden Setzling neu. Stoppt, wenn die Vorr\u00e4te aufgebraucht sind."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003014
    m_Localized: "Kehre zur Stadt zur\xFCck, um die Felder zu pflegen."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003013
    m_Localized: Bereit
    m_Metadata:
