  - m_Id: 87000000000003082
    m_Localized: Aus
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003081
    m_Localized: An
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003080
    m_Localized: Laden
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003079
    m_Localized: "L\xF6schen"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003078
    m_Localized: Speichern
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003077
    m_Localized: Leeren
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003076
    m_Localized: "Ausf\xFChren"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003075
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003074
    m_Localized: Konsole
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003073
    m_Localized: "L\xE4dt ..."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003072
    m_Localized: "Triff mich wieder in der Stadt. Ich habe etwas Besonderes f\xFCr dich, und du musst mir helfen, Holzst\xE4mme zu besorgen."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003071
    m_Localized: "Aber f\xFCr mein Haus brauche ich das perfekte Bauholz ..."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003070
    m_Localized: "Ich bin hierhergekommen, um ein paar B\xE4ume zu f\xE4llen. "
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003069
    m_Localized: "Njeh heh heh, Abenteurer. Ich bin die Hexe, die dich lehrt, den Boden zu pflegen. Was, du dachtest, ich braue Tr\xE4nke f\xFCr dich? H\xF6r auf mit deinen Klischees. Und bring f\xFCnf ausgewachsene Radieschen zur\xFCck. Als Beweis, ganz sicher nicht f\xFCr meine Radieschenmarmelade."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003068
    m_Localized: "Ich geh zur\xFCck in meine Minen. Triff mich dort, wenn du echtes ERZ sehen willst!"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003067
    m_Localized: "ER HAT NICHT ERW\xC4HNT, DASS ES DIESER SCHROTTHAUFEN IST!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003066
    m_Localized: "Hmpf ... als Barkley sagte, hier drau\xDFen g\xE4be es Erz ..."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003065
    m_Localized: Eva will wie viele Radieschen!?
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003064
    m_Localized: "Wir k\xF6nnten deine Hilfe mit ihnen wirklich gebrauchen ..."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003063
    m_Localized: Aber die Schleime sind wohl weiter vorgedrungen als sonst.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003062
    m_Localized: "Wir suchen hier drau\xDFen nach neuen Samen."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003061
    m_Localized: Freut mich, dich kennenzulernen
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003060
    m_Localized: "Hier, ein Schwert von mir! Ich gehe zur\xFCck in die Stadt."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003059
    m_Localized: "Ich glaube, Ausr\xFCstung zu schmieden liegt mir besser, als diese Kerle zu bek\xE4mpfen. "
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003058
    m_Localized: 'Ah, da bist du ja, Bruder! '
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003057
    m_Localized: Zwillingsstufe {0} erforderlich.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003056
    m_Localized: "Diese Feldaktion ist nicht verf\xFCgbar ({0})."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003055
    m_Localized: Beet {0}
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003054
    m_Localized: Baumparzelle {0}
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003053
    m_Localized: '{0:N0} {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003052
    m_Localized: '{0}-Samen'
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003051
    m_Localized: "Sammelquelle noch nicht zug\xE4nglich."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003050
    m_Localized: Sammelquellen fehlen.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003049
    m_Localized: "Schlie\xDFe den vorherigen Bauauftrag ab."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003048
    m_Localized: Unbekannter Bau.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003047
    m_Localized: Bereite die Beete vor dem Pflanzen vor.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003046
    m_Localized: "In diesem Beet w\xE4chst bereits eine Pflanze."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003045
    m_Localized: Finde zuerst auf einem Abenteuer ein Radieschen-Saatgutpaket.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003044
    m_Localized: Keine Beete sind erntereif.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003043
    m_Localized: "Kehre zur Stadt zur\xFCck, um die Beete zu pflegen."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003042
    m_Localized: Baumaterialien sammeln
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003041
    m_Localized: Bereit zum Bauen
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003040
    m_Localized: Gebaut
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003039
    m_Localized: Triff Flora und Tillman auf einem Abenteuer
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003038
    m_Localized: "H\xF6re Flora und Tillmans Einf\xFChrung"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003037
    m_Localized: Abgeschlossen
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003036
