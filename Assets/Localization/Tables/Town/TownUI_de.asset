      m_Items: []
  - m_Id: 166516885933396018
    m_Localized: "Du beh\xE4ltst die auf deinem Abenteuer gesammelten Ressourcen."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396019
    m_Localized: "Schlie\xDFe die Zusammenfassung, um fortzufahren."
