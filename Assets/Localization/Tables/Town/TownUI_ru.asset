    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003818
    m_Localized: "\u0420\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u044F \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F +{0}%"
