    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u044C \u0432\u0435\u0441 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u044D\u0442\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F. \u0420\u0443\u0431\u0435\u0436\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0442 \u0431\u043E\u043D\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003636
    m_Localized: "\u0411\u043E\u043D\u0443\u0441 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u0432\u043A\u043B\u044E\u0447\u0451\u043D. \u041D\u0430\u0436\u043C\u0438, \u0447\u0442\u043E\u0431\u044B \u0443\u0431\u0440\u0430\u0442\u044C \u0431\u043E\u043D\u0443\u0441 \u0432\u0435\u0441\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F."
