  - m_Id: 87000000000004019
    m_Localized: "\u0414\u043b\u044f \u043f\u043e\u0441\u0435\u0432\u0430 \u0433\u0440\u044f\u0434\u043a\u0438 \u043d\u0443\u0436\u043d\u043e 9 \u043f\u0430\u043a\u0435\u0442\u043e\u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0441\u0435\u043c\u044f\u043d."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000004020
    m_Localized: "Сначала найдите подходящий саженец в приключении."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000004021
    m_Localized: "\u041d\u0430 \u0433\u0440\u044f\u0434\u043a\u0443 \u043d\u0443\u0436\u043d\u043e {0} \u043f\u0430\u043a\u0435\u0442\u043e\u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0441\u0435\u043c\u044f\u043d."
    m_Metadata:
      m_Items: []
