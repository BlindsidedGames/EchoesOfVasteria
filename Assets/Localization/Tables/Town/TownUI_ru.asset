    m_Localized: "\u0417\u043D\u0430\u044E, \u0447\u0442\u043E \u043F\u043E\u043D\u0430\u0447\u0430\u043B\u0443 \u0438\u0433\u0440\u0430 \u043C\u043E\u0436\u0435\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u0431\u0438\u0432\u0430\u0442\u044C \u0441 \u0442\u043E\u043B\u043A\u0443. \u041F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0435 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0435\u0449\u0451 \u0432 \u0440\u0430\u0431\u043E\u0442\u0435, \u0430 \u043F\u043E\u043A\u0430 \u044D\u0442\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043F\u043E\u0441\u043B\u0443\u0436\u0438\u0442 \u043A\u0440\u0430\u0442\u043A\u043E\u0439 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u043E\u0439.\n\n\u041F\u0440\u0435\u0436\u0434\u0435 \u0432\u0441\u0435\u0433\u043E, \u044D\u0442\u043E idle-\u0438\u0433\u0440\u0430: \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0438\u0434\u0451\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0438 \u0432 \u0444\u043E\u043D\u0435, \u043F\u043E\u043A\u0430 \u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0434\u0435\u043B\u0430\u043C\u0438!\n\n\u041E \u0440\u0430\u0437\u043D\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445 \u043C\u043E\u0436\u043D\u043E \u0443\u0437\u043D\u0430\u0442\u044C, \u043D\u0430\u0436\u0430\u0432 \u043A\u043D\u043E\u043F\u043A\u0443 \xAB\u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430\xBB \u0441\u0432\u0435\u0440\u0445\u0443.\n\n\u041D\u0430\u0447\u043D\u0438 \u0441 \u0437\u0430\u0434\u0430\u043D\u0438\u0439: \u043E\u043D\u0438 \u043F\u043E\u043C\u043E\u0433\u0443\u0442 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0438 \u0431\u0443\u0434\u0443\u0442 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u0442\u0435\u0431\u044F \u0434\u0430\u043B\u044C\u0448\u0435. \n\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u044B\u043B\u0430\u0437\u043A\u0438 \u0433\u0435\u0440\u043E\u0439 \u0441\u0430\u043C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F.\n\n\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435\u0442 \u0432\u0435\u0441\u0435\u043B\u043E. \u0415\u0441\u043B\u0438 \u0437\u0430\u0441\u0442\u0440\u044F\u043D\u0435\u0448\u044C, \u043C\u0435\u043D\u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0432 Discord!"
    m_Metadata:
      m_Items: []
