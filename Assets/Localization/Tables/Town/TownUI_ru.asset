  - m_Id: 87000000000003073
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003072
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u0432 \u0433\u043E\u0440\u043E\u0434\u0435: \u0443 \u043C\u0435\u043D\u044F \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u043A\u043E\u0435-\u0447\u0442\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0435, \u0430 \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C \u0441 \u0431\u0440\u0451\u0432\u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003071
    m_Localized: "\u041D\u043E \u0434\u043B\u044F \u0434\u043E\u043C\u0430 \u043D\u0443\u0436\u043D\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003070
    m_Localized: "\u042F \u043F\u0440\u0438\u0448\u0451\u043B \u0441\u044E\u0434\u0430 \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0434\u043B\u044F \u0440\u0443\u0431\u043A\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003069
    m_Localized: "\u041D\u044C\u0435-\u0445\u0435-\u0445\u0435, \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439. \u042F \u0432\u0435\u0434\u044C\u043C\u0430, \u0438 \u043D\u0430\u0443\u0447\u0443 \u0442\u0435\u0431\u044F \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0442\u044C \u0437\u0430 \u0437\u0435\u043C\u043B\u0451\u0439. \u0427\u0442\u043E, \u0434\u0443\u043C\u0430\u043B, \u0431\u0443\u0434\u0443 \u0432\u0430\u0440\u0438\u0442\u044C \u0442\u0435\u0431\u0435 \u0437\u0435\u043B\u044C\u044F? \u041F\u0440\u043E\u0447\u044C \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0441\u0442\u0435\u0440\u0435\u043E\u0442\u0438\u043F\u0430\u043C\u0438. \u0418 \u043F\u0440\u0438\u043D\u0435\u0441\u0438 \u043F\u044F\u0442\u044C \u0437\u0440\u0435\u043B\u044B\u0445 \u0440\u0435\u0434\u0438\u0441\u043E\u043A. \u041A\u0430\u043A \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E, \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0434\u043B\u044F \u043C\u043E\u0435\u0433\u043E \u0432\u0430\u0440\u0435\u043D\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003068
    m_Localized: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0441\u044C \u0432 \u0448\u0430\u0445\u0442\u044B. \u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u0442\u0430\u043C, \u0435\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u0420\u0423\u0414\u0423!"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003067
    m_Localized: "\u041E\u041D \u041D\u0415 \u0421\u041A\u0410\u0417\u0410\u041B, \u0427\u0422\u041E \u042D\u0422\u041E \u0422\u0410\u041A\u041E\u0419 \u0425\u041B\u0410\u041C!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003066
    m_Localized: "\u0425\u043C-\u043C... \u043A\u043E\u0433\u0434\u0430 \u0411\u0430\u0440\u043A\u043B\u0438 \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u0440\u0443\u0434\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003065
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u0434\u0438\u0441\u043E\u043A \u043D\u0443\u0436\u043D\u043E \u0415\u0432\u0435!?"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003064
    m_Localized: "\u041D\u0430\u043C \u0431\u044B \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u043F\u043E\u043C\u043E\u0449\u044C \u0441 \u043D\u0438\u043C\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003063
    m_Localized: "\u041D\u043E \u0441\u043B\u0438\u0437\u043D\u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0437\u0430\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0434\u0430\u043B\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003062
    m_Localized: "\u041C\u044B \u043F\u0440\u0438\u0448\u043B\u0438 \u0441\u044E\u0434\u0430 \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u0441\u0435\u043C\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003061
    m_Localized: "\u0420\u0430\u0434 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003060
    m_Localized: "\u0414\u0435\u0440\u0436\u0438 \u043C\u043E\u0439 \u043C\u0435\u0447! \u042F \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0441\u044C \u0432 \u0433\u043E\u0440\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003059
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043A\u043E\u0432\u0430\u0442\u044C \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0443 \u043C\u0435\u043D\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0434\u0440\u0430\u0442\u044C\u0441\u044F \u0441 \u043D\u0438\u043C\u0438. "
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003058
    m_Localized: "\u0410, \u0432\u043E\u0442 \u0442\u044B \u0433\u0434\u0435, \u0431\u0440\u0430\u0442! "
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003057
    m_Localized: "\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0431\u043B\u0438\u0437\u043D\u0435\u0446\u043E\u0432 {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003056
    m_Localized: "\u042D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043D\u0430 \u041F\u043E\u043B\u044F\u0445 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E ({0})."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003055
    m_Localized: "\u0413\u0440\u044F\u0434\u043A\u0430 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003054
