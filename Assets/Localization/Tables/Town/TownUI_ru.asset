  - m_Id: 87000000000003663
    m_Localized: "\u0420\u0435\u0441\u0443\u0440\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003662
    m_Localized: "\u0412\u0440\u0430\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003661
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u043E\u0431\u0449\u0438\u0435 \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u043A\u0430\u0440\u0442. \u0417\u0434\u0435\u0441\u044C \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0437\u0430\u0434\u0430\u043D\u043D\u044B\u0435 \u0441\u043F\u0438\u0441\u043A\u0438 \u0434\u043E\u0431\u044B\u0447\u0438; \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003660
    m_Localized: "\u041D\u0430\u0439\u0434\u0435\u043D\u043E \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003659
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043A\u0430\u0440\u0442\u0443, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0451 \u0440\u0435\u0441\u0443\u0440\u0441\u044B, \u0432\u0440\u0430\u0433\u043E\u0432 \u0438 \u0441\u0432\u043E\u0438 \u0440\u0435\u043A\u043E\u0440\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003658
    m_Localized: "\u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439 \u043A\u0430\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003657
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043F\u043E\u043A\u0430 \u043D\u0435\u0442 \u043D\u0435\u0434\u0430\u0432\u043D\u0438\u0445 \u0432\u044B\u043B\u0430\u0437\u043E\u043A. \u041E\u0431\u0449\u0438\u0435 \u0440\u0435\u043A\u043E\u0440\u0434\u044B \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u044B."
    m_Metadata:
