    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003049
    m_Localized: "\u0412\u044B\u043F\u043E\u043B\u043D\u0438 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003048
    m_Localized: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003047
    m_Localized: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C \u0433\u0440\u044F\u0434\u043A\u0438 \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u0441\u0430\u0434\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003046
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0439 \u0433\u0440\u044F\u0434\u043A\u0435 \u0443\u0436\u0435 \u0447\u0442\u043E-\u0442\u043E \u0440\u0430\u0441\u0442\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003045
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0439\u0434\u0438 \u043D\u0430\u0431\u043E\u0440 \u0441\u0435\u043C\u044F\u043D \u0440\u0435\u0434\u0438\u0441\u0430 \u0432 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003044
    m_Localized: "\u041D\u0435\u0442 \u0433\u0440\u044F\u0434\u043E\u043A \u0441 \u0433\u043E\u0442\u043E\u0432\u044B\u043C \u0443\u0440\u043E\u0436\u0430\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003043
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0441\u044C \u0432 \u0433\u043E\u0440\u043E\u0434, \u0447\u0442\u043E\u0431\u044B \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0442\u044C \u0437\u0430 \u0433\u0440\u044F\u0434\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003042
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003041
    m_Localized: "\u041C\u043E\u0436\u043D\u043E \u0441\u0442\u0440\u043E\u0438\u0442\u044C"
