  - m_Id: 87000000000003823
    m_Localized: "\u0428\u0430\u043D\u0441 \u043A\u0440\u0438\u0442\u0430 +{0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003822
    m_Localized: "{0:0.#}% \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u043F\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003821
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 +{0}%"
