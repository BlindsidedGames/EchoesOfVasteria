    m_Localized: "\u0421\u0442\u0443\u043F\u0435\u043D\u044C {0}<sprite=194>{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003118
    m_Localized: "\u0424\u0430\u0439\u043B {0} \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u0438\u043B\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043F\u0440\u0438\u043C\u0435\u043D\u0451\u043D \u043A \u0437\u0430\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0439 \u0438\u0433\u0440\u0435. \u0410\u0432\u0442\u043E\u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u043E, \u0438\u043C\u0435\u044E\u0449\u0438\u0435\u0441\u044F \u0441\u043D\u0438\u043C\u043A\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B. \u041F\u043E\u0432\u0442\u043E\u0440\u0438 \u043F\u043E\u043F\u044B\u0442\u043A\u0443, \u0437\u0430\u043A\u0440\u044B\u0432 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0438\u043B\u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u043E\u0433\u043E \u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u044D\u0442\u0438 \u0444\u0430\u0439\u043B\u044B.\n\n{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003117
    m_Localized: "\u0412 \u0444\u0430\u0439\u043B\u0435 {0} \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043D \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442 \u0446\u0435\u043B\u043E\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0438\u043B\u0438 \u043E\u0431\u043B\u0430\u0447\u043D\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438. \u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C \u043F\u043E\u043F\u044B\u0442\u043A\u0443; \u0432\u0441\u0435 \u0438\u043C\u0435\u044E\u0449\u0438\u0435\u0441\u044F \u0441\u043D\u0438\u043C\u043A\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B. \u0415\u0441\u043B\u0438 \u044F\u0432\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043D\u0430\u0447\u0430\u043B\u043E \u0441 \u043D\u0443\u043B\u044F, \u0431\u0443\u0434\u0435\u0442 \u0441\u043E\u0437\u0434\u0430\u043D\u0430 \u043D\u043E\u0432\u0430\u044F \u043E\u0431\u043B\u0430\u0447\u043D\u0430\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0431\u0435\u0437 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u0441\u0442\u0430\u0440\u044B\u0445 \u0444\u0430\u0439\u043B\u043E\u0432.\n\n{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003116
    m_Localized: "\u0424\u0430\u0439\u043B {0} \u0441\u043E\u0437\u0434\u0430\u043D \u0431\u043E\u043B\u0435\u0435 \u043D\u043E\u0432\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0435\u0439 \u0438\u0433\u0440\u044B \u0438 \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0451\u043D. \u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438 \u043D\u043E\u0432\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438 \u043F\u043E\u043F\u044B\u0442\u043A\u0443 \u043B\u0438\u0431\u043E \u043E\u0442\u043A\u0440\u043E\u0439 \u043F\u0430\u043F\u043A\u0443 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0439. \u041D\u0430\u0447\u0430\u043B\u043E \u0441 \u043D\u0443\u043B\u044F \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u043E \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430.\n\n{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003115
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0430\u043F\u043A\u0443 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0439"
