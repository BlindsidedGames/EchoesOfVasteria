  - m_Id: 87000000000003476
    m_Localized: "\u0417\u0430\u0434\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003475
    m_Localized: "\u0414\u0430\u0451\u0442 {0}% \u0448\u0430\u043D\u0441 \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C \u044D\u0445\u043E \u0432 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435 {1}, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0449\u0438\u0435 {2} \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 {3:0.#} \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003474
    m_Localized: "\u0414\u0430\u0451\u0442 {0}% \u0448\u0430\u043D\u0441 \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C \u044D\u0445\u043E, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0449\u0435\u0435 {1} \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 {2:0.#} \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003473
    m_Localized: "\u0414\u0430\u0451\u0442 {0}% \u0448\u0430\u043D\u0441 \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C \u044D\u0445\u043E \u0432 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435 {1}, \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0449\u0438\u0435 \u0432 \u0431\u043E\u044E \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 {2:0.#} \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003472
    m_Localized: "\u0414\u0430\u0451\u0442 {0}% \u0448\u0430\u043D\u0441 \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C \u044D\u0445\u043E, \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0449\u0435\u0435 \u0432 \u0431\u043E\u044E \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 {1:0.#} \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003471
    m_Localized: "\u0440\u0430\u0437\u043D\u044B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003470
    m_Localized: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u043C\u044B\u043B \u043C\u0430\u0448\u0438\u043D\u0443 \u0441\u044B\u043D\u043E\u043C, \u0438 \u043E\u043D \u0441\u043F\u0440\u043E\u0441\u0438\u043B: \xAB\u041F\u0430\u043F\u0430, \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0451\u0448\u044C \u0433\u0443\u0431\u043A\u0443?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003469
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u043D\u0430 \u043D\u043E\u0440\u0432\u0435\u0436\u0441\u043A\u0438\u0445 \u043A\u043E\u0440\u0430\u0431\u043B\u044F\u0445 \u0448\u0442\u0440\u0438\u0445\u043A\u043E\u0434\u044B? \u0427\u0442\u043E\u0431\u044B \u0432 \u043F\u043E\u0440\u0442\u0443 \u0438\u0445 \u043C\u043E\u0433\u043B\u0438... \u043E\u0442\u0441\u043A\u0430\u043D\u0434\u0438\u043D\u0430\u0432\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003468
    m_Localized: "\u0414\u0432\u0430 \u043F\u043E\u043F\u0443\u0433\u0430\u044F \u0441\u0438\u0434\u044F\u0442 \u043D\u0430 \u043E\u043A\u0443\u043D\u0435.\n\u041E\u0434\u0438\u043D \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0433\u043E: \xAB\u0420\u044B\u0431\u043E\u0439 \u043D\u0435 \u043F\u0430\u0445\u043D\u0435\u0442?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003467
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u043E, \u043A\u0430\u043A \u043F\u0442\u0435\u0440\u043E\u0434\u0430\u043A\u0442\u0438\u043B\u044C \u041F\u0442\u0435\u0440\u0440\u0438 \u0445\u043E\u0434\u0438\u0442 \u0432 \u0442\u0443\u0430\u043B\u0435\u0442?\n\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0435\u0433\u043E \xAB\u043F\xBB \u0431\u0435\u0437\u0437\u0432\u0443\u0447\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003466
    m_Localized: "\u0421\u043B\u044B\u0448\u0430\u043B \u043E \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u043E\u0438\u0442\u0441\u044F \u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0447\u0438\u0441\u0435\u043B?\n\u0427\u0442\u043E\u0431\u044B \u0438\u0445 \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C, \u043E\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0430 \u043D\u0443\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003465
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0443 \u043A\u0440\u0443\u0433\u0430 360\xB0?\n\u041E\u043D \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u043B \u0432\u044B\u0441\u0448\u0435\u0435 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003464
    m_Localized: "\u0427\u0435\u043C \u0434\u0438\u0430\u043C\u0435\u0442\u0440 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0440\u0430\u0434\u0438\u0443\u0441\u0430?\n\u0420\u0430\u0434\u0438\u0443\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003463
    m_Localized: "\u0428\u0443\u0442\u043A\u0438 \u043F\u0440\u043E \u043B\u0438\u0444\u0442\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043C\u043D\u0435 \u043D\u0430 \u043D\u0435\u0440\u0432\u044B.\n\u041E\u043D\u0438 \u043C\u0435\u043D\u044F \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442.\n\n\u0418 \u043F\u043B\u043E\u0445\u0438 \u043D\u0430 \u0432\u0441\u0435\u0445 \u0443\u0440\u043E\u0432\u043D\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003462
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0431\u0440\u0438\u0442\u0430\u043D\u0446\u044B \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \xAB\u043B\u0438\u0444\u0442\xBB, \u0430 \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0446\u044B \u2014 \xAB\u044D\u043B\u0435\u0432\u0430\u0442\u043E\u0440\xBB?\n\u041D\u0430\u0441 \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003461
    m_Localized: "\u042F \u0431\u043E\u044E\u0441\u044C \u043B\u0438\u0444\u0442\u043E\u0432... \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E \u0448\u0430\u0433\u0438, \u0447\u0442\u043E\u0431\u044B \u0438\u0445 \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003460
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0430\u043A\u0443\u043B\u044B \u0436\u0438\u0432\u0443\u0442 \u0432 \u0441\u043E\u043B\u0451\u043D\u043E\u0439 \u0432\u043E\u0434\u0435?\n\u041E\u0442 \u043F\u0435\u0440\u0435\u0447\u043D\u043E\u0439 \u0432\u043E\u0434\u044B \u043E\u043D\u0438 \u0447\u0438\u0445\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003459
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u043A\u0443\u0440\u0438\u0446\u0430 \u043F\u043E\u0448\u043B\u0430 \u043D\u0430 \u0441\u043F\u0438\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0441\u0435\u0430\u043D\u0441?\n\u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003458
    m_Localized: "\u0421\u043B\u044B\u0448\u0430\u043B? \u042F \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B \u043D\u043E\u0432\u043E\u0435 \u0441\u043B\u043E\u0432\u043E!\n\xAB\u041F\u043B\u0430\u0433\u0438\u0430\u0442\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003457
    m_Localized: "\u041A\u0430\u043A\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E \u043F\u043E\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F \u0432 \u043B\u0430\u0434\u043E\u043D\u0438?\n\u041F\u0430\u043B\u044C\u043C\u0430: \u043F\u043E-\u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438 \u043E\u043D\u0430 \u0438 \u0435\u0441\u0442\u044C \u043B\u0430\u0434\u043E\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003456
    m_Localized: "\u041A\u0430\u043A \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u0443\u043A\u0430\u0435\u0442 \u043D\u0430 \u043B\u044E\u0434\u044F\u0445?\n\u0427\u0430\u0441\u0442\u043D\u044B\u0439 \u0440\u0435\u043F\u0435\u0442\u0438\u0442\u043E\u0440 \u043F\u043E \u0433\u0430\u0437\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003455
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u0440\u0435\u0431\u0451\u043D\u043E\u043A \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u043B \u043C\u0430\u0441\u043B\u043E \u0432 \u043E\u043A\u043D\u043E?\n\u0427\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0431\u0430\u0431\u043E\u0447\u043A\u0443: \u043F\u043E-\u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438 \u043E\u043D\u0430 \xAB\u043C\u0430\u0441\u043B\u043E-\u043C\u0443\u0445\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003454
    m_Localized: "\u0427\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0434\u0432\u0443\u044F\u0437\u044B\u0447\u043D\u0430\u044F \u043A\u043E\u0448\u043A\u0430?\n\u0413\u0430\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003453
    m_Localized: "\u0427\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043A\u0435\u0430\u043D, \u0433\u043B\u044F\u0434\u044F \u043D\u0430 \u043C\u0438\u0441\u043A\u0443 \u0441\u043E\u043B\u0438?\n\xAB\u042F \u0432\u0438\u0436\u0443 \u043C\u043E\u0440\u0441\u043A\u0443\u044E \u0441\u043E\u043B\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003452
    m_Localized: "\u0427\u0435\u043C \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0431\u0430\u0442\u0430\u0442 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0441\u0432\u0438\u043D\u044C\u0438, \u0432\u044B\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0439 \u0432 \u043E\u043A\u043D\u043E?\n\u041E\u0434\u0438\u043D \u2014 \u043F\u0435\u0447\u0451\u043D\u044B\u0439 \u043A\u043B\u0443\u0431\u0435\u043D\u044C, \u0434\u0440\u0443\u0433\u0430\u044F \u2014 \u043B\u0435\u0442\u044F\u0449\u0438\u0439 \u043E\u043A\u043E\u0440\u043E\u043A. "
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003451
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0447\u0430\u0439\u043A\u0438 \u043B\u0435\u0442\u0430\u044E\u0442 \u0443 \u043C\u043E\u0440\u044F?\n\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0443 \u0437\u0430\u043B\u0438\u0432\u0430 \u043E\u043D\u0438 \u0441\u0442\u0430\u043B\u0438 \u0431\u044B \u0431\u0435\u0439\u0433\u043B\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003450
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043D\u044B\u0440\u044F\u043B\u044C\u0449\u0438\u043A\u0438 \u043F\u0430\u0434\u0430\u044E\u0442 \u0441 \u043B\u043E\u0434\u043A\u0438 \u043D\u0430\u0437\u0430\u0434?\n\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432\u043F\u0435\u0440\u0451\u0434 \u043E\u043D\u0438 \u0443\u043F\u0430\u043B\u0438 \u0431\u044B \u0432 \u043B\u043E\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003449
    m_Localized: "\u041D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435 \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u043C\u043D\u043E\u0439 \u0441\u0438\u0434\u0438\u0442 \u043A\u043E\u0444\u0435\u0439\u043D\u043E\u0435 \u0437\u0435\u0440\u043D\u043E. \u0420\u0430\u0431\u043E\u0442\u0430 \u0441\u0442\u043E\u0438\u0442: \u043E\u043D \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u043B\u0430\u0442\u0442\u0435-\u0431\u043E\u043B\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003448
    m_Localized: "\u041A\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0446\u0432\u0435\u0442\u043E\u043A \u043D\u0430 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0435? \u042D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0432 \u0433\u043E\u0440\u0448\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003447
    m_Localized: "\u041A\u0442\u043E \u0442\u0430\u043A\u043E\u0439 \u0414\u0436\u0435\u043A \u0438 \u043F\u043E\u0447\u0435\u043C\u0443 \u0443 \u043D\u0435\u0433\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u043C\u0435\u043D\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003446
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0448\u0443\u0442\u043A\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043F\u0430\u043F\u0438\u043D\u043E\u0439? \u041A\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E, \u043A\u0442\u043E \u0435\u0451 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003445
    m_Localized: "\u0412\u0447\u0435\u0440\u0430 \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F \u043D\u0430 \u0431\u0443\u043B\u043A\u0435. \u0414\u0435\u043B\u0430 \u0443 \u043D\u0435\u0433\u043E \u043A\u0430\u0442\u0438\u043B\u0438\u0441\u044C \u043A\u0430\u043A \u043F\u043E \u043C\u0430\u0441\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003444
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u043B \u0444\u0435\u0440\u043C\u0435\u0440\u0430, \u043F\u043E\u0447\u0435\u043C\u0443 \u0443 \u043D\u0435\u0433\u043E \u0431\u043E\u043B\u0438\u0442 \u0433\u043E\u043B\u043E\u0432\u0430. \u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B: \xAB\u041C\u043E\u0438 \u0437\u0435\u0440\u0435\u043D\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003443
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043C\u0435\u043A\u0441\u0438\u043A\u0430\u043D\u0435\u0446 \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B \u0436\u0435\u043D\u0443 \u0441 \u043C\u043E\u0441\u0442\u0430? \u0422\u0435\u043A\u0438\u043B\u0430: \xAB\u0442\u0435 \u043A\u0438\u043B\u0430\xBB \u2014 \xAB\u0443\u0431\u0438\u0442\u044C \u0442\u0435\u0431\u044F\xBB!"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003442
    m_Localized: "\u042F \u0437\u043D\u0430\u044E 25 \u0431\u0443\u043A\u0432 \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u0430\u043B\u0444\u0430\u0432\u0438\u0442\u0430. \u041D\u0435 \u0437\u043D\u0430\u044E, \u043F\u043E\u0447\u0435\u043C\u0443 y."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003441
    m_Localized: "\u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442, \u0435\u0441\u043B\u0438 \u0442\u0435\u0431\u044F \u0447\u0430\u0441\u0442\u043E \u0431\u0438\u0442\u044C \u043F\u043E \u043B\u0438\u0446\u0443? \u0411\u0443\u0434\u0435\u0442 \u0431\u043E\u043B\u044C\u043D\u043E \u0432 \u0433\u0435\u0440\u0446\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003440
    m_Localized: "\u042F \u0431\u0440\u043E\u0441\u0438\u043B \u0441\u043E\u0441\u0435\u0434\u0430 \u0432 \u044F\u0434\u0435\u0440\u043D\u044B\u0439 \u0440\u0435\u0430\u043A\u0442\u043E\u0440, \u0438 \u043E\u043D \u0443\u043C\u0435\u0440. \u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C?! \u0411\u0430\u0440\u0438\u0439 \u2014 \u0438 \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003439
    m_Localized: "\u041A\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u0430\u044F \u0440\u044B\u0431\u0430? \u0420\u044B\u0431\u0430-\u043F\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003438
    m_Localized: "\u0421\u043B\u044B\u0448\u0430\u043B \u043E \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0435 \xAB\u041A\u0430\u0440\u043C\u0430\xBB? \u041C\u0435\u043D\u044E \u043D\u0435\u0442 \u2014 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0448\u044C \u043F\u043E \u0437\u0430\u0441\u043B\u0443\u0433\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003437
    m_Localized: "\u0427\u0442\u043E \u0411\u044D\u0442\u043C\u0435\u043D \u0437\u0430\u043A\u0430\u0437\u0430\u043B \u0432 \u0431\u0430\u0440\u0435? \u0422\u043E\u043B\u044C\u043A\u043E \u043B\u0451\u0434 \u2014 \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \xAB\u043F\u0440\u0430\u0432\u043E\u0441\u0443\u0434\u0438\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003436
    m_Localized: "\u0425\u043E\u0442\u0435\u043B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0430\u043C \u0448\u0443\u0442\u043A\u0443 \u043F\u0440\u043E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F \u0432\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u043D\u043E \u043E\u043D\u0430 \u0432\u0430\u043C \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003435
    m_Localized: "\u041A\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u044E\u0442\u0443\u0431\u0435\u0440\u0430-\u043E\u0431\u043E\u0440\u043E\u0442\u043D\u044F? \u041B\u0430\u0439\u043A-\u0438-\u043F\u043E\u0434\u043F\u0438\u0448\u0438\u0441\u044C-\u0430\u043D\u0442\u0440\u043E\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003434
    m_Localized: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u043F\u044F\u0442\u043D\u043E \u043D\u0430 \u0434\u0430\u043B\u043C\u0430\u0442\u0438\u043D\u0446\u0435-\u0430\u043B\u044C\u0431\u0438\u043D\u043E\u0441\u0435. \u0425\u043E\u0442\u044F \u0431\u044B \u0447\u0442\u043E-\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003433
    m_Localized: "\u042F, I, \u043B\u044E\u0431\u043B\u044E \u0440\u0438\u043C\u0441\u043A\u0438\u0435 \u0446\u0438\u0444\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003432
    m_Localized: "\u041C\u0430\u0448\u0438\u043D\u0430 \u0438\u0434\u0451\u0442 \u0432 \u043A\u043E\u0441\u043C\u043E\u0441? \u041D\u0435\u0442, \u043C\u0430\u0448\u0438\u043D\u0430 \u0438\u0434\u0451\u0442 \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003431
    m_Localized: "\u041A\u0430\u043A \u0437\u043E\u0432\u0443\u0442 \u0436\u0435\u043D\u0449\u0438\u043D\u0443 \u0441 \u043E\u0434\u043D\u043E\u0439 \u043D\u043E\u0433\u043E\u0439? \u0410\u0439\u043B\u0438\u043D \u2014 \xAB\u044F \u043D\u0430\u043A\u043B\u043E\u043D\u044F\u044E\u0441\u044C\xBB."
