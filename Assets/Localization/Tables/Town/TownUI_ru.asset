    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003790
    m_Localized: "\u2022 \u0421\u0440. \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0439 / \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435: {0:N2}  \u2022 \u0421\u0430\u043C\u044B\u0439 \u0434\u043E\u043B\u0433\u0438\u0439 \u043F\u0435\u0440\u0435\u0440\u044B\u0432: {1:N0}"
    m_Metadata:
      m_Items: []
