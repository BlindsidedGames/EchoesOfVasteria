      m_Items: []
  - m_Id: 87000000000003829
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438\u0433\u0440\u044B +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003828
    m_Localized: "\u0420\u0435\u0441\u0443\u0440\u0441\u044B \u043F\u043E\u0441\u043B\u0435 \u044D\u0445\u0430 +{0:0.#}% (10\u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003827
    m_Localized: "\u0411\u043E\u043D\u0443\u0441 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 +{0:0.#}% \u043A\u0430\u0436\u0434\u044B\u0435 10 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003826
    m_Localized: "\u0412\u0435\u0441 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0434\u043E +{0:0.#}%"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003825
    m_Localized: "\u0412\u0435\u0441 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0438 +{0:0.#}%"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003824
    m_Localized: "\u041A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D +{0}%"
