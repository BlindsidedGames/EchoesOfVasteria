      m_Items: []
  - m_Id: 87000000000003853
    m_Localized: "\u041D\u0430\u0437\u043D\u0430\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003852
    m_Localized: "\u042F\u0447\u0435\u0439\u043A\u0430 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003851
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003850
    m_Localized: "\u041F\u0443\u0441\u0442\u0430\u044F \u044F\u0447\u0435\u0439\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003849
    m_Localized: "{0} \xB7 \u0410\u0432\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003848
    m_Localized: "{0} \xB7 \u0410\u0432\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0432\u044B\u043A\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003847
    m_Localized: "{0} \xB7 \u0410\u0432\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0432\u043A\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003846
    m_Localized: "\u042F\u0447\u0435\u0439\u043A\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003845
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F. \u041D\u0430\u0436\u043C\u0438 \u0437\u0430\u043D\u044F\u0442\u0443\u044E \u044F\u0447\u0435\u0439\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0430\u0432\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003844
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u044F\u0447\u0435\u0439\u043A\u0443 \u0434\u043B\u044F {0}. \u041D\u0430\u0436\u043C\u0438 \xAB\u041E\u0442\u043C\u0435\u043D\u0430\xBB, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0431\u0435\u0437 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003843
    m_Localized: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u044B\u043B\u0430\u0437\u043E\u043A \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E. \u041D\u0430\u0436\u043C\u0438 \u0437\u0430\u043D\u044F\u0442\u0443\u044E \u044F\u0447\u0435\u0439\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0430\u0432\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003842
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003841
    m_Localized: "\u042D\u0445\u043E | \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003840
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003839
    m_Localized: "\u041C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003838
    m_Localized: "\u042D\u0445\u043E | \u0411\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003837
    m_Localized: "\u041A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u0440\u043E\u0441\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003836
    m_Localized: "\u0420\u0435\u0437\u043E\u043D\u0430\u043D\u0441 \u044D\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003835
    m_Localized: "\u0411\u043E\u0435\u0432\u043E\u0435 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003834
    m_Localized: "\u0418\u043D\u0441\u0442\u0438\u043D\u043A\u0442 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003833
    m_Localized: "\u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043E\u043F\u044B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003832
    m_Localized: "\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u044B\u0439 \u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003831
    m_Localized: "\u0420\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003830
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E"
