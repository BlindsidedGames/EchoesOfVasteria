    m_Localized: Continuer
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396021
    m_Localized: "\xC0 suivre : {0} au niveau {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396022
    m_Localized: Booster
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396023
    m_Localized: "La sauvegarde est trop volumineuse ou n'a pas pu \xEAtre pr\xE9par\xE9e pour l'exportation."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396024
    m_Localized: "L'exportation d\xE9passe la limite de {0:N0} caract\xE8res. Rien n'a \xE9t\xE9 copi\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396025
    m_Localized: "Saisis une sauvegarde \xE0 importer."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396026
    m_Localized: "L'importation d\xE9passe la limite de {0:N0} caract\xE8res."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396027
    m_Localized: "Ce texte n'est pas une sauvegarde export\xE9e prise en charge."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396028
    m_Localized: "Les donn\xE9es de sauvegarde sont incompl\xE8tes ou endommag\xE9es. Colle l'exportation compl\xE8te et r\xE9essaie."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396029
    m_Localized: Impossible de lire la sauvegarde.
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396030
    m_Localized: "Cette sauvegarde utilise le format {0} ; ce jeu prend en charge le format {1}. Mets le jeu \xE0 jour avant l'importation."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396031
    m_Localized: "Impossible de mettre cette sauvegarde \xE0 niveau pour cette version du jeu. Ta progression actuelle n'a pas \xE9t\xE9 remplac\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396032
    m_Localized: "Le jeu n'est pas pr\xEAt \xE0 importer une sauvegarde. R\xE9essaie une fois le chargement termin\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396033
    m_Localized: "Impossible d'activer la sauvegarde import\xE9e en toute s\xE9curit\xE9. R\xE9essaie une fois le chargement termin\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396034
    m_Localized: "Impossible de terminer l'importation. R\xE9essaie. Les d\xE9tails techniques ont \xE9t\xE9 enregistr\xE9s pour l'assistance."
    m_Metadata:
      m_Items: []
