  - m_Id: 87000000000003051
    m_Localized: "Source de r\xE9colte encore inaccessible."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003050
    m_Localized: "Sources de r\xE9colte manquantes."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003049
    m_Localized: "Terminez la qu\xEAte de construction pr\xE9c\xE9dente."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003048
    m_Localized: Construction inconnue.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003047
    m_Localized: "Pr\xE9parez les plates-bandes avant de planter."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003046
    m_Localized: "Une culture pousse d\xE9j\xE0 dans cette plate-bande."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003045
    m_Localized: "Trouvez d\u2019abord un sachet de graines de radis en aventure."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003044
    m_Localized: "Aucune plate-bande pr\xEAte \xE0 r\xE9colter."
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003043
    m_Localized: Retournez au village pour entretenir les plates-bandes.
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003042
    m_Localized: "R\xE9unissez les mat\xE9riaux de construction"
