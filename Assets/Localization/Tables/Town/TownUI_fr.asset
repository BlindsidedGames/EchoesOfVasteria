    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396012
    m_Localized: "Retourne en ville pour rendre cette qu\xEAte."
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396013
    m_Localized: "\xC9pinglage auto"
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396014
    m_Localized: "S\xE9lectionne une barre pour voir les d\xE9tails"
