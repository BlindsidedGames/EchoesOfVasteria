  - m_Id: 87000000000003103
    m_Localized: "Import\xE9 en s\xE9curit\xE9 sur le disque ; red\xE9marrez le jeu ou utilisez R\xE9essayer pour terminer le chargement"
    m_Metadata:
      m_Items: []
  - m_Id: 87000000000003102
