    m_Localized: "Ouvre <link=\"help:statistics/graphs\"><u><color=#EFB889><sprite=\"NavigationInlineSprites\" name=\"statistics\" tint=1> \u2192 Graphiques</color></u></link> pour voir tes derni\xE8res aventures."
