    m_Localized: Suivant
    m_Metadata:
      m_Items: []
  - m_Id: 166516885933396018
    m_Localized: "Tu conserves les ressources r\xE9colt\xE9es pendant ton aventure."
    m_Metadata:
      m_Items: []
