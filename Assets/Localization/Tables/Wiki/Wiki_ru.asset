    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0437\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u044F \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F\u0445. <link=\"help:quests\"><u><color=#EFB889>\u0417\u0430\u0434\u0430\u043D\u0438\u044F</color></u></link> \u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0441 NPC \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u0443\u0442\u0438."
