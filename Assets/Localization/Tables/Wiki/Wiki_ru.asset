  - m_Id: 12027031164698624
    m_Localized: "<link=\"help:cauldron\"><u><color=#EFB889>\u041A\u043E\u0442\u0451\u043B</color></u></link> \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u0435\u0434\u0443 \u0432 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0443. \u0412\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E, \u0430 \u0432\u044B\u0445\u043E\u0434 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043D\u0435\u0433\u043E \u0438 \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u0435\u0434\u044B. \u041F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u044B \u0441 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u043C\u0438 \u0448\u0430\u043D\u0441\u0430\u043C\u0438 \u043D\u0430\u0433\u0440\u0430\u0434.\n\n\u041A\u0430\u0440\u0442\u044B \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442 \u0441\u0431\u043E\u0440, \u0434\u043E\u0431\u044B\u0447\u0443 \u0441 \u0432\u0440\u0430\u0433\u043E\u0432 \u0438 \u0443\u0440\u043E\u0436\u0430\u0439 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0434\u043B\u044F \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E \u0440\u0435\u0441\u0443\u0440\u0441\u0430. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F 1, 25, 75, 200, 750, 1\_500, 3\_500 \u0438 10\_000 \u043A\u043E\u043F\u0438\u0439; \u0431\u043E\u043D\u0443\u0441\u044B \u043A \u0432\u044B\u0445\u043E\u0434\u0443 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 1\_%, 2\_%, 3\_%, 5\_%, 7\_%, 10\_%, 15\_% \u0438 20\_%.\n\n\u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u043D\u0430\u0438\u043C\u0435\u043D\u044C\u0448\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043A\u0430\u0440\u0442\u044B \u0441\u0440\u0435\u0434\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432. \u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u043A\u0430\u0440\u0442\u044B \u0441\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u043A\u0430\u0440\u0442\u0430\u043C\u0438 \u043D\u0443\u043B\u0435\u0432\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F. \u0423\u0440\u043E\u0432\u043D\u0438 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438 \u0441 1 \u043F\u043E 8 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 2\_%, 5\_%, 10\_%, 15\_%, 20\_%, 30\_%, 40\_% \u0438 50\_% \u043A \u0432\u044B\u0445\u043E\u0434\u0443 \u044D\u0442\u043E\u0439 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438. \u0411\u043E\u043D\u0443\u0441\u044B \u043A\u0430\u0440\u0442 \u0438 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0439 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0434\u043E \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0430 \u0432 70\_%. \u041D\u0430\u0433\u0440\u0430\u0434\u044B, \u0441\u0435\u043C\u0435\u043D\u0430, \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u044B \u0438 \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u044D\u0442\u0438 \u0431\u043E\u043D\u0443\u0441\u044B.\n\n\u0423\u0440\u043E\u0432\u043D\u0438 \u043A\u0430\u0440\u0442 \u043D\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u044B \u0441 \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C\u044E \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432. \u041A\u0430\u0440\u0442\u044B \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0439 \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0443 \u0438 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C. \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0432\u0441\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0438 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0439, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0412\u0435\u0447\u043D\u044B\u0435 \u0434\u0430\u0440\u044B."
