  - m_Id: 164580255232299026
    m_Localized: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 0,02\xD7 \u043A \u043C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044E \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432, \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u0434\u043E 10\xD7. \u041C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u043F\u0440\u0438 \u0441\u043C\u0435\u0440\u0442\u0438, \u0436\u0430\u0442\u0432\u0435 \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0439 \u043F\u043E\u043F\u044B\u0442\u043A\u0435 \u0431\u0435\u0437 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u0432 \u0433\u043E\u0440\u043E\u0434.\n\n\u041F\u0440\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434 \u043E\u043D \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043A \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043C, \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u043C \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0432\u044B\u0445\u043E\u0434\u0430. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043F\u043E\u0445\u043E\u0434 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441 1\xD7."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299027
    m_Localized: "\u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, 50 \u0443\u0431\u0438\u0439\u0441\u0442\u0432 \u0434\u0430\u044E\u0442 2\xD7 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432, \u0430 450 \u2014 \u043F\u0440\u0435\u0434\u0435\u043B 10\xD7. \u0411\u043E\u043D\u0443\u0441\u043D\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0439 \u0431\u043E\u043D\u0443\u0441."
