  - m_Id: 164588427309355015
    m_Localized: "<b>\u041A\u0430\u0440\u043B</b>\n\u041A\u0430\u0440\u043B \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043F\u043E\u0445\u043E\u0434 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u043A\u0430\u0440\u0442\u044B. \u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0438 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u043D\u0430\u0432\u044B\u043A\u043E\u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F.\n\n\u0420\u0435\u043A\u0430, \u041B\u0435\u0441 \u0438 \u0428\u0430\u0445\u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 1\_% \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u043F\u0440\u0438 \u0436\u0430\u0442\u0432\u0435 \u041A\u0430\u0440\u043B\u0430 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435. \u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u043F\u0440\u0438\u0431\u0430\u0432\u043A\u0443. \u041D\u0430 \u041B\u043E\u0449\u0438\u043D\u0435 \u0432\u0440\u0430\u0433\u0438 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0441 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430\u043C\u0438, \u0430 \u0436\u0430\u0442\u0432\u044B \u043F\u043E \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044E \u043D\u0435\u0442."
