  - m_Id: 164580255232299008
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 <link=\"help:adventure\"><u><color=#EFB889>\u041F\u043E\u0445\u043E\u0434</color></u></link>, \u0430 \u0437\u0430\u0442\u0435\u043C \u043A\u0430\u0440\u0442\u0443, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0432 \u043F\u0443\u0442\u044C. \u0413\u0435\u0440\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u043C\u0435\u0436\u0434\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C\u0438 \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u044B. \u041D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u0430\u0440\u0442\u0435 \u0441\u0432\u043E\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u044B.\n\n\u0427\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B, \u043F\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0432 <link=\"help:statistics/general\"><u><color=#EFB889>\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 \u2192 \u041E\u0431\u0449\u0435\u0435</color></u></link> \u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0443. \u0417\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u043A\u0430\u0440\u0442\u044B \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0443\u0442, \u043A\u0430\u043A \u0443\u0437\u043D\u0430\u0442\u044C \u043E \u043D\u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435."
