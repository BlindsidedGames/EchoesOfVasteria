  - m_Id: 9824133185945600
    m_Localized: "\u0412\u0441\u0435\u043C \u043F\u0440\u0438\u0432\u0435\u0442, \u044D\u0442\u043E \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A. \n\n\u0415\u0441\u043B\u0438 \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0441\u043F\u0438\u0441\u043E\u043A \u0438\u043C\u0451\u043D \u0432\u0440\u0430\u0433\u043E\u0432, \u0437\u0430\u0439\u0434\u0438\u0442\u0435 \u0432 Discord \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435 \u043E\u0431 \u044D\u0442\u043E\u043C \u0432 \u0447\u0430\u0442\u0435 EoV :)\n\n\u2022 \u0414\u0443\u043C\u0430\u044E \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0440\u0443\u0431\u0435\u0436\u0435\u0439. \u0422\u043E\u0433\u0434\u0430 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0431\u0443\u0434\u0443\u0442 \u0434\u0430\u0432\u0430\u0442\u044C \u043E\u043F\u044B\u0442 \u043D\u0430\u0432\u044B\u043A\u043E\u0432 \u0432\u043C\u0435\u0441\u0442\u043E \u043D\u043E\u0432\u044B\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439! \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435, \u0447\u0442\u043E \u0434\u0443\u043C\u0430\u0435\u0442\u0435."
