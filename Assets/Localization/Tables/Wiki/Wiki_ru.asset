  - m_Id: 164588427309355014
    m_Localized: "<b>\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435</b>\n\u0413\u0435\u0440\u043E\u0439 \u043F\u043E\u0433\u0438\u0431\u0430\u0435\u0442, \u043A\u043E\u0433\u0434\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 \u043D\u0443\u043B\u044F. \u0421\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u043C\u043E\u0436\u0435\u0442 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0442\u044C \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435, \u0430 \u0440\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u044F \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0435\u0433\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442.\n\n\u0412 \u043F\u043E\u0445\u043E\u0434\u0435 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 <link=\"help:hero-stats\"><u><color=#EFB889>\u0421\u0442\u0430\u0442\u044B</color></u></link> \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u043E\u043B\u043E\u0441\u043E\u0439 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u0435\u043A\u0443\u0449\u0438\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F."
