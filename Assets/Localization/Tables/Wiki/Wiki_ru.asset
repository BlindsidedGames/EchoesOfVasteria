  - m_Id: 164580255232299023
    m_Localized: "<b>\u0420\u0435\u043A\u0430, \u041B\u0435\u0441 \u0438 \u0428\u0430\u0445\u0442\u044B</b>\n\u041A\u0430\u0440\u043B \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043F\u043E\u0445\u043E\u0434 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F. \u0416\u0430\u0442\u0432\u0430 \u043D\u0430 \u044D\u0442\u043E\u043C \u043F\u0440\u0435\u0434\u0435\u043B\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u0449\u0443\u044E \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0436\u0430\u0442\u0432\u044B \u043D\u0430 1\_%.\n\n<b>\u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F</b>\n\u041A\u0430\u0440\u043B \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043F\u043E\u0445\u043E\u0434 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F, \u043D\u043E \u0436\u0430\u0442\u0432\u0430 \u043D\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u044D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u0435\u043B.\n\n<b>\u041B\u043E\u0449\u0438\u043D\u0430</b>\n\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u0432\u0440\u0430\u0433\u043E\u0432 \u0440\u0430\u0441\u0442\u0451\u0442 \u0441 \u0447\u0438\u0441\u043B\u043E\u043C \u0443\u0431\u0438\u0439\u0441\u0442\u0432. \u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F \u043D\u0430 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0438 \u0436\u0430\u0442\u0432\u0443 \u043F\u043E \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044E \u043D\u0435\u0442.\n\n\u041F\u043E\u0441\u043B\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F \u043F\u043E\u0445\u043E\u0434\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0438 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u043D\u0430\u0432\u044B\u043A\u043E\u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F. \u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0432 \u0433\u043E\u0440\u043E\u0434, \u0447\u0442\u043E\u0431\u044B \u0441\u0434\u0430\u0442\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u0435 \u0432 <link=\"help:run-summary\"><u><color=#EFB889>\u0418\u0442\u043E\u0433\u0430\u0445 \u043F\u043E\u0445\u043E\u0434\u0430</color></u></link>. \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E \u043A\u0430\u0440\u0442\u0430\u0445 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 <link=\"help:statistics/general\"><u><color=#EFB889>\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 \u2192 \u041E\u0431\u0449\u0435\u0435</color></u></link>."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299024
    m_Localized: "<b>\u0420\u0435\u043A\u0430, \u041B\u0435\u0441 \u0438 \u0428\u0430\u0445\u0442\u044B</b>\n\u0416\u0430\u0442\u0432\u0430 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u0449\u0443\u044E \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0436\u0430\u0442\u0432\u044B \u043D\u0430 1\_% \u043E\u0442 \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u043E\u0433\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u0440\u0435\u0434\u0435\u043B\u0430 \u0441 \u0443\u0447\u0451\u0442\u043E\u043C \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0439 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0443\u0445\u043E\u0434\u0438\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435.\n\n<b>\u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F</b>\n\u041A\u0430\u0440\u043B \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043F\u043E\u0445\u043E\u0434 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F, \u043D\u043E \u0436\u0430\u0442\u0432\u0430 \u043D\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u044D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u0435\u043B.\n\n<b>\u041B\u043E\u0449\u0438\u043D\u0430</b>\n\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u0432\u0440\u0430\u0433\u043E\u0432 \u0440\u0430\u0441\u0442\u0451\u0442 \u0441 \u0447\u0438\u0441\u043B\u043E\u043C \u0443\u0431\u0438\u0439\u0441\u0442\u0432. \u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F \u043D\u0430 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0438 \u0436\u0430\u0442\u0432\u0443 \u043F\u043E \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044E \u043D\u0435\u0442."
