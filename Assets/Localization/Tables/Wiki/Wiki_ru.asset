  - m_Id: 9898115700506624
    m_Localized: "<b>\u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F</b>\n\u2022 \u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u044B \u0434\u0432\u0430 \u0437\u0430\u0434\u0430\u043D\u0438\u044F: \xAB\u0420\u0430\u0434\u0438 \u0432\u0430\u0440\u0435\u043D\u044C\u044F!\xBB \u0438 \xAB\u041F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F \u0413\u0438\u043B\u043B\u0438\u0432\u0435\u0440\u0430\xBB.\n\u2022 \u0423\u043B\u0443\u0447\u0448\u0435\u043D\u043E \u0432\u0441\u0442\u0443\u043F\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435.\n\u2022 \u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u0437\u0430\u043D\u0438\u0436\u0435\u043D\u043D\u044B\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0432 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F\u0445 \u043E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0438 \u0443\u0440\u043E\u0432\u043D\u044F.\n\u2022 \u0423\u0434\u0430\u043B\u0451\u043D \u0431\u043B\u043E\u043A \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u043D\u0430\u0434\u0435\u0442\u044B\u0445 \u0432\u0435\u0449\u0435\u0439 \u0438\u0437 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0438 \u043A\u0443\u0437\u043D\u0438\u0446\u044B.\n\u2022 \u0417\u0430\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \xAB\u041C\u043E\u0436\u043D\u043E \u0441\u0434\u0430\u0442\u044C\xBB \u0432\u043C\u0435\u0441\u0442\u043E \xAB\u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043E\xBB.\n\u2022 \u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D \u044D\u043A\u0440\u0430\u043D \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438 \u043A\u0430\u0440\u0442\u044B.\n\u2022 \u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0430 \xAB\u0421\u043C\u0435\u0448\u0430\u0442\u044C \u0432\u0441\u0451\xBB.\n<b>\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F</b>\n\u2022 A* \u043E\u0431\u043D\u043E\u0432\u043B\u0451\u043D \u0434\u043E \u043D\u043E\u0432\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438."
