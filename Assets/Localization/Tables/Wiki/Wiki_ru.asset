  - m_Id: 164580255232299015
    m_Localized: "<link=\"help:quests\"><u><color=#EFB889>\u0417\u0430\u0434\u0430\u043D\u0438\u044F</color></u></link> \u043C\u043E\u0433\u0443\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u044B, \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0432\u0440\u0430\u0433\u043E\u0432, \u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0441 NPC \u0438\u043B\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438\u0437 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F. \u041A\u043E\u0433\u0434\u0430 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B, \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u0433\u043E\u0442\u043E\u0432\u043E \u043A \u0441\u0434\u0430\u0447\u0435. \u041D\u0430\u0433\u0440\u0430\u0434\u0430 \u0432\u044B\u0434\u0430\u0451\u0442\u0441\u044F \u043F\u0440\u0438 \u0441\u0434\u0430\u0447\u0435, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0433\u043E\u0440\u043E\u0434\u0435."
