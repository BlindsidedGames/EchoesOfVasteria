    m_Localized: "<b><link=\"help:cauldron\"><u><color=#EFB889>\u041A\u043E\u0442\u0451\u043B</color></u></link></b>\n\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B \u0438 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0434\u043B\u044F \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0432 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0443. \u041F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u044B \u0441 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u043C\u0438 \u0448\u0430\u043D\u0441\u0430\u043C\u0438 \u043D\u0430\u0433\u0440\u0430\u0434. \u041A\u0430\u0440\u0442\u044B \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442 \u0441\u0431\u043E\u0440, \u0430 \u043A\u0430\u0440\u0442\u044B \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0439 \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F.\n\n\u041F\u043E\u0440\u043E\u0433\u0438 \u0443\u0440\u043E\u0432\u043D\u0435\u0439 \u043A\u0430\u0440\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0438 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0439 \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0432 <link=\"help:reference\"><u><color=#EFB889>\u0421\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u0435</color></u></link>."
