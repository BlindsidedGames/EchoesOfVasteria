    m_Localized: "<b>\u0423\u0440\u043E\u043D</b>\n\u0423\u0440\u043E\u043D \u0437\u0430 \u0443\u0434\u0430\u0440 \u0434\u043E \u0443\u0447\u0451\u0442\u0430 \u0437\u0430\u0449\u0438\u0442\u044B \u0432\u0440\u0430\u0433\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u043E\u0432. \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0430\u0442\u0430\u043A\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u0443\u0434\u0430\u0440\u043E\u0432. \u0428\u0430\u043D\u0441 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0439, \u0430 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D \u2014 \u0438\u0445 \u0441\u0438\u043B\u0443.\n\n\u0412 \u043F\u043E\u0445\u043E\u0434\u0435 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 <link=\"help:hero-stats\"><u><color=#EFB889>\u0421\u0442\u0430\u0442\u044B</color></u></link> \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u043E\u043B\u043E\u0441\u043E\u0439 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u0435\u043A\u0443\u0449\u0438\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F."
