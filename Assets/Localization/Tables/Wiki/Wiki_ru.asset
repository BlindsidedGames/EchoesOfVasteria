  - m_Id: 164588427254829056
    m_Localized: "<b>\u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F</b>\n\u0417\u0434\u0435\u0441\u044C \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442 \u0443\u0440\u043E\u0436\u0430\u0439. \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0437\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u044F \u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u043A\u0430\u0440\u0442\u0430\u0445. \u041F\u0440\u0438 \u0436\u0430\u0442\u0432\u0435 \u043D\u0430 \u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F\u0445 \u043F\u0440\u0435\u0434\u0435\u043B \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u041A\u0430\u0440\u043B\u0430 \u043D\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160704
    m_Localized: "<b>\u0417\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u0435</b>\n\u0421\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0443\u0440\u043E\u0436\u0430\u0439 \u043D\u0430 \u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F\u0445, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B \u0438 \u043E\u043F\u044B\u0442 \u0437\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u044F. \u0412\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u043D\u0438\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439 \u0447\u0435\u0440\u0435\u0437 <link=\"help:fields\"><u><color=#EFB889>\u041F\u043E\u043B\u044F</color></u></link> \u2014 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430. \u0411\u043E\u043D\u0443\u0441\u044B \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0432 <link=\"help:skills/Farming\"><u><color=#EFB889>\u041E\u0431\u0437\u043E\u0440 \u2192 \u041D\u0430\u0432\u044B\u043A\u0438 \u2192 \u0417\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u0435</color></u></link>."
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160705
    m_Localized: "<b>\u0420\u044B\u0431\u0430\u043B\u043A\u0430</b>\n\u0413\u0438\u043B\u043B \u0434\u0430\u0440\u0438\u0442 \u043F\u0435\u0440\u0432\u0443\u044E \u0443\u0434\u043E\u0447\u043A\u0443. \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0440\u044B\u0431\u0430\u043B\u043A\u0438 \u0434\u0430\u044E\u0442 \u0440\u044B\u0431\u0443 \u0438 \u043E\u043F\u044B\u0442 \u0440\u044B\u0431\u0430\u043B\u043A\u0438.\n\n\u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u0430\u0440\u0442\u044B \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0432 <link=\"help:statistics/general\"><u><color=#EFB889>\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 \u2192 \u041E\u0431\u0449\u0435\u0435</color></u></link>, \u0430 \u0431\u043E\u043D\u0443\u0441\u044B \u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u2014 \u0432 <link=\"help:skills/Fishing\"><u><color=#EFB889>\u041E\u0431\u0437\u043E\u0440 \u2192 \u041D\u0430\u0432\u044B\u043A\u0438 \u2192 \u0420\u044B\u0431\u0430\u043B\u043A\u0430</color></u></link>."
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160706
    m_Localized: "<b>\u0413\u043E\u0440\u043D\u043E\u0435 \u0434\u0435\u043B\u043E</b>\n\u0414\u043E\u0431\u044B\u0432\u0430\u0439\u0442\u0435 \u0440\u0443\u0434\u0443, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u043E\u043F\u044B\u0442 \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0434\u0435\u043B\u0430. \u041F\u0435\u0440\u0435\u043F\u043B\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0440\u0443\u0434\u0443 \u0432 \u0441\u043B\u0438\u0442\u043A\u0438 \u0432 <link=\"help:forge\"><u><color=#EFB889>\u041A\u0443\u0437\u043D\u0438\u0446\u0435</color></u></link>, \u0430 \u0437\u0430\u0442\u0435\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0438\u0445 \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F. \u0423\u0440\u043E\u0432\u043D\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0440\u0443\u0434\u044B \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0432 <link=\"help:skills/Mining\"><u><color=#EFB889>\u041E\u0431\u0437\u043E\u0440 \u2192 \u041D\u0430\u0432\u044B\u043A\u0438 \u2192 \u0413\u043E\u0440\u043D\u043E\u0435 \u0434\u0435\u043B\u043E</color></u></link>."
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160707
    m_Localized: "<b>\u0420\u0443\u0431\u043A\u0430 \u043B\u0435\u0441\u0430</b>\n\u0420\u0443\u0431\u0438\u0442\u0435 \u0434\u0435\u0440\u0435\u0432\u044C\u044F, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u043E\u043F\u044B\u0442 \u0440\u0443\u0431\u043A\u0438 \u043B\u0435\u0441\u0430. \u0417\u0430\u0434\u0430\u043D\u0438\u044F \u0411\u0430\u0440\u043A\u043B\u0438 \u043F\u0440\u0438\u0432\u0435\u0434\u0443\u0442 \u0432\u0430\u0441 \u0432 \u041B\u0435\u0441.\n\n\u0423\u0441\u043B\u043E\u0432\u0438\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0432 <link=\"help:skills/Woodcutting\"><u><color=#EFB889>\u041E\u0431\u0437\u043E\u0440 \u2192 \u041D\u0430\u0432\u044B\u043A\u0438 \u2192 \u0420\u0443\u0431\u043A\u0430 \u043B\u0435\u0441\u0430</color></u></link>. \u0427\u0442\u043E\u0431\u044B \u0443\u0441\u0438\u043B\u0438\u0442\u044C \u0448\u0430\u043D\u0441\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439, \u043E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 <link=\"help:statistics/tasks\"><u><color=#EFB889>\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 \u2192 \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F</color></u></link>."
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160708
    m_Localized: "<b>\u0413\u043E\u0442\u043E\u0432\u043E \u043A \u0441\u0434\u0430\u0447\u0435</b>\n\u0417\u0432\u0435\u0437\u0434\u0430 \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442 \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u0441 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u043C\u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438. \u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0432 \u0433\u043E\u0440\u043E\u0434 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0421\u0434\u0430\u0442\u044C\xBB, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443. \u041F\u0440\u0438 \u0441\u0434\u0430\u0447\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u044E\u0442\u0441\u044F."
