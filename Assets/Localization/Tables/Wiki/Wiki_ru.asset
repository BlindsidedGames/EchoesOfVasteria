  - m_Id: 164588427309355017
    m_Localized: "<b>\u042F\u0434\u0440\u0430</b>\n\u041A\u0430\u0436\u0434\u0430\u044F \u043A\u043E\u0432\u043A\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u043E\u0434\u043D\u043E \u044F\u0434\u0440\u043E. \u0412\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u044F\u0434\u0440\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u0448\u0430\u043D\u0441\u044B \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u0438 \u0438 \u0440\u0430\u0441\u0445\u043E\u0434 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432. \u042F\u0434\u0440\u0430 \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u0443\u0440\u043E\u0432\u043D\u0435\u0439 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0441 \u0443\u0440\u043E\u0432\u043D\u044F\u043C\u0438 \u043D\u0430\u0432\u044B\u043A\u0430 \xAB\u0411\u043E\u0439\xBB. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0432 <link=\"help:forge\"><u><color=#EFB889>\u041A\u0443\u0437\u043D\u0438\u0446\u0435</color></u></link>, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0432\u044B\u0448\u0430\u0442\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u044F\u0434\u0435\u0440."
