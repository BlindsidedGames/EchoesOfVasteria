  - m_Id: 164588427309355018
    m_Localized: "<b>\u041C\u0435\u0447</b>\n\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \xAB\u041E\u0440\u0443\u0436\u0438\u0435\xBB, \u0437\u0430\u0442\u0435\u043C \xAB\u041A\u043E\u0432\u0430\u0442\u044C\xBB. \u0423 \u043B\u044E\u0431\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F \u0435\u0441\u0442\u044C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430 \u0443\u0440\u043E\u043D\u0430. \u0421\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041D\u0430\u0434\u0435\u0442\u044C\xBB, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0442\u0435\u043A\u0443\u0449\u0435\u0435 \u043E\u0440\u0443\u0436\u0438\u0435.\n\n\u041F\u043E\u0432\u0442\u043E\u0440\u043D\u0430\u044F \u043A\u043E\u0432\u043A\u0430 \u0438\u043B\u0438 \u0441\u043C\u0435\u043D\u0430 \u044F\u0447\u0435\u0439\u043A\u0438 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442 \u043D\u0435\u043D\u0430\u0434\u0435\u0442\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
