    m_Localized: "<b>\u0421\u0430\u043F\u043E\u0433\u0438</b>\n\u0423 \u043A\u0430\u0436\u0434\u044B\u0445 \u0432\u044B\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u0441\u0430\u043F\u043E\u0433 \u0435\u0441\u0442\u044C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F, \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0449\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F. \u042D\u0442\u0430 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430 \u0432\u044B\u043F\u0430\u0434\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0441\u0430\u043F\u043E\u0433\u0430\u0445."
