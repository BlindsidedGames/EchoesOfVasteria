  - m_Id: 164588427309355008
    m_Localized: "<b>\u041E\u0440\u0443\u0436\u0438\u0435</b>\n\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0432\u044B\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F \u0435\u0441\u0442\u044C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430 \u0443\u0440\u043E\u043D\u0430. \u0421\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438, \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0442\u0435\u043A\u0443\u0449\u0435\u0435 \u043E\u0440\u0443\u0436\u0438\u0435."
