  - m_Id: 164588427309355010
    m_Localized: "<b>\u0414\u043E\u0441\u043F\u0435\u0445</b>\n\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0432\u044B\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0434\u043E\u0441\u043F\u0435\u0445\u0430 \u0435\u0441\u0442\u044C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430 \u0437\u0430\u0449\u0438\u0442\u044B. \u0427\u0435\u043C \u0432\u044B\u0448\u0435 \u0437\u0430\u0449\u0438\u0442\u0430, \u0442\u0435\u043C \u043C\u0435\u043D\u044C\u0448\u0435 \u0432\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0443\u0440\u043E\u043D, \u043D\u043E \u043F\u0440\u0438\u0440\u043E\u0441\u0442 \u043F\u043E\u043B\u044C\u0437\u044B \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F."
