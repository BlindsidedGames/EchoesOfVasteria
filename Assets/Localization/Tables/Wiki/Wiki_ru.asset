    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0435 \u0432\u044B\u0448\u0435, \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u0436\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0435\u0433\u043E \u0442\u0435\u043A\u0443\u0449\u0438\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B, \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430. \u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u043C\u043E\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u044F\u0447\u0435\u0439\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0434\u043B\u044F \u043D\u0435\u0451 \u0430\u0432\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435."
