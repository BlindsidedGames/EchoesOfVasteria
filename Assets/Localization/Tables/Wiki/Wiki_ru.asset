  - m_Id: 164588427309355022
    m_Localized: "<b>\u042D\u0445\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439</b>\n\u0421\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u044B, \u043D\u0435 \u0430\u0442\u0430\u043A\u0443\u044F \u0438 \u043D\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u044F \u0432\u0440\u0430\u0433\u043E\u0432. \u042D\u0445\u043E, \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u043D\u0430 \u0440\u0443\u0431\u0435\u0436\u0430\u0445 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u043D\u0430\u0432\u044B\u043A\u0430, \u0438\u0449\u0443\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u044D\u0442\u043E\u0433\u043E \u043D\u0430\u0432\u044B\u043A\u0430. \u0414\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0432 <link=\"help:skills\"><u><color=#EFB889>\u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0438 \u0440\u0443\u0431\u0435\u0436\u0430</color></u></link> \u0438\u043B\u0438 <link=\"help:buffs\"><u><color=#EFB889>\u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F \u043F\u0440\u0438\u0437\u044B\u0432\u0430</color></u></link>.\n\n\u042D\u0444\u0444\u0435\u043A\u0442\u044B, \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u043F\u0440\u0438\u0437\u044B\u0432\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u044B \u043D\u0438\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 164588427309355023
    m_Localized: "<b>\u042D\u0445\u043E \u0431\u043E\u044F</b>\n\u0418\u0449\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432 \u0438 \u0441\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0441 \u043D\u0438\u043C\u0438. \u042D\u0445\u043E, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F, \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u044B. \u042D\u0445\u043E, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0435 \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C, \u0438 \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F, \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438 \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432 \u0431\u043E\u0439 \u043F\u0440\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0435 \u0441 \u0432\u0440\u0430\u0433\u043E\u043C.\n\n\u042D\u0444\u0444\u0435\u043A\u0442\u044B, \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u043F\u0440\u0438\u0437\u044B\u0432\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u044B \u043D\u0438\u0436\u0435."
