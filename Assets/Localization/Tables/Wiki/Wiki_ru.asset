  - m_Id: 164580255232299017
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 <link=\"help:inventory\"><u><color=#EFB889>\u041E\u0431\u0437\u043E\u0440 \u2192 \u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C</color></u></link>, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u044B. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043D\u0430\u0434\u0435\u0442\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0433\u043E \u0431\u043E\u043D\u0443\u0441\u044B. \u0412 \u043E\u0431\u0449\u0438\u0439 \u0431\u043E\u043D\u0443\u0441 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F \u0432\u0445\u043E\u0434\u044F\u0442 \u0432\u0441\u0435 \u043D\u0430\u0434\u0435\u0442\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B.\n\n\u0421\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u0439\u0442\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0434 \u0437\u0430\u043C\u0435\u043D\u043E\u0439: \u0431\u043E\u043B\u0435\u0435 \u0440\u0435\u0434\u043A\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0435.\n\n\u0412 \u043F\u043E\u0445\u043E\u0434\u0435 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 <link=\"help:hero-stats\"><u><color=#EFB889>\u0421\u0442\u0430\u0442\u044B</color></u></link> \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u043E\u043B\u043E\u0441\u043E\u0439 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u0435\u043A\u0443\u0449\u0438\u0435 \u0431\u043E\u0435\u0432\u044B\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299018
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C\u0438. \u0412\u043D\u0443\u0442\u0440\u0438 \u043E\u0431\u0435\u0438\u0445 \u0433\u0440\u0443\u043F\u043F \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432."
