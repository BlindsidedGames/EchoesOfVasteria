    m_Localized: "\u0421\u043F\u0438\u0441\u043E\u043A \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 164590655378165760
    m_Localized: "<b>\u0412\u0435\u0440\u0441\u0438\u044f 1.5.8</b>\n\n\u2022 \u041a\u0430\u043c\u0435\u0440\u0430 \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043d\u0430 \u0441\u043e\u0431\u0435\u0441\u0435\u0434\u043d\u0438\u043a\u0430\u0445, \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044b \u043c\u0435\u0436\u0434\u0443 \u0432\u0438\u0434\u0430\u043c\u0438 \u0441\u0442\u0430\u043b\u0438 \u043f\u043b\u0430\u0432\u043d\u0435\u0435.\n\u2022 \u0423\u043b\u0443\u0447\u0448\u0435\u043d\u044b \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u044b \u0432 \u0434\u0438\u0430\u043b\u043e\u0433\u0430\u0445. \u041e\u043a\u043d\u043e \u0434\u0438\u0430\u043b\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439.\n\u2022 \u041a\u0430\u0440\u043b \u0442\u0435\u043f\u0435\u0440\u044c \u043b\u0435\u0442\u0430\u0435\u0442 \u043c\u0435\u0436\u0434\u0443 \u0432\u0430\u0448\u0438\u043c \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u043c \u0438 \u043f\u043e\u043b\u043e\u0441\u043e\u0439 \u0416\u043d\u0435\u0446\u0430.\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u044b \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0440\u044b\u0431\u0430\u043b\u043a\u0438 \u0413\u0438\u043b\u043b\u0430, \u0440\u0443\u0431\u043a\u0438 \u0411\u0430\u0440\u043a\u043b\u0438 \u0438 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0413\u0438\u043b\u043b\u0430 \u0438 \u0418\u0432\u0430\u043d\u0430 \u0432 \u0433\u043e\u0440\u043e\u0434\u0435.\n\u2022 \u0414\u0435\u0440\u0435\u0432\u044c\u044f \u043f\u043e\u043a\u0430\u0447\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043e\u0442 \u0443\u0434\u0430\u0440\u043e\u0432 \u0442\u043e\u043f\u043e\u0440\u0430, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u0443 \u042d\u0445\u043e.\n\u2022 \u0412 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u2192 \u0418\u0433\u0440\u0430 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u043f\u043e\u043b\u043d\u043e\u044d\u043a\u0440\u0430\u043d\u043d\u044b\u0439 \u0438\u043b\u0438 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u044b\u0439 \u0432\u0438\u0434 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0434\u043b\u044f \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430.\n\u2022 \u041a\u043d\u043e\u043f\u043a\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0433\u043e \u043c\u0435\u043d\u044e \u0432 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u0437\u0430\u043a\u0440\u044b\u0442\u044c \u0435\u0433\u043e. \u0412\u043e\u0437\u0432\u0440\u0430\u0442 \u0432 \u0433\u043e\u0440\u043e\u0434 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0451\u043d \u0432\u043f\u0440\u0430\u0432\u043e \u0432\u0432\u0435\u0440\u0445; \u0432\u043e\u0437\u0432\u0440\u0430\u0442 \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0443\u0434\u0430\u043b\u0451\u043d.\n\u2022 \u0423\u043b\u0443\u0447\u0448\u0435\u043d\u044b \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u0416\u043d\u0435\u0446\u0430, \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0438 \u043e\u0442\u0441\u0442\u0443\u043f\u044b \u0432 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435. \u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d, \u043f\u043e\u043a\u0430 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u0433\u043e\u0440\u043e\u0434.\n\u2022 \u041e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u0431\u043e\u043d\u0443\u0441\u044b \u043d\u0430\u0432\u044b\u043a\u043e\u0432 \u0441 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u0435\u043c \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043f\u0435\u0440\u0432\u044b\u043c\u0438.\n\u2022 \u0412 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u044f\u0434\u0440\u0430 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c \u0438 \u043d\u0430 \u0432\u043a\u043b\u0430\u0434\u043a\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432 \u041a\u0443\u0437\u043d\u0438\u0446\u044b.\n\u2022 \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u044f\u0440\u043a\u043e\u0441\u0442\u0438 \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u0442\u0435\u043c\u043d\u0435\u043d\u0438\u044f \u044d\u043a\u0440\u0430\u043d\u0430. \u0412\u0440\u0430\u0433\u0438 \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0430 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u043c\u043e\u0439 \u043c\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0438.\n\n<b>\u0412\u0435\u0440\u0441\u0438\u044f 1.5.7</b>\n\n\u2022 \u041b\u0435\u0442\u0430\u044e\u0449\u0438\u0435 \u0447\u0435\u0440\u0435\u043f\u0430 \u0438 \u043b\u0435\u0442\u0443\u0447\u0438\u0435 \u043c\u044b\u0448\u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0432 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u043c\u0435\u0441\u0442\u0430\u0445 \u041b\u043e\u0449\u0438\u043d\u044b.\n\u2022 \u0413\u043e\u0431\u043b\u0438\u043d\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0432\u043d\u0443\u0442\u0440\u0438 \u0441\u0442\u0435\u043d \u0432 \u0428\u0430\u0445\u0442\u0430\u0445.\n\u2022 \u0421\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043a\u043e\u0432\u043a\u0438 \u0438 \u0440\u0430\u043d\u0433\u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u0442\u0435\u043f\u0435\u0440\u044c \u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u0438 \u0432 \u0443\u0437\u043a\u043e\u043c \u043e\u043a\u043d\u0435 \u041a\u0443\u0437\u043d\u0438\u0446\u044b. \u0423\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u044b \u043e\u0442\u0441\u0442\u0443\u043f\u044b \u0443 \u043a\u043d\u043e\u043f\u043e\u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0438 \u044d\u043a\u0438\u043f\u0438\u0440\u043e\u0432\u043a\u0438.\n\n<b>\u0412\u0435\u0440\u0441\u0438\u044f 1.5.6</b>\n\n<b>\u0412\u0440\u0430\u0433\u0438 \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435</b>\n\u2022 \u041d\u0430 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u043a\u0430\u0440\u0442\u0430\u0445 \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0433\u043e\u0431\u043b\u0438\u043d\u044b, \u0443\u043b\u0438\u0442\u043a\u0438, \u043b\u0435\u0442\u0443\u0447\u0438\u0435 \u043c\u044b\u0448\u0438, \u043b\u0435\u0442\u0430\u044e\u0449\u0438\u0435 \u0447\u0435\u0440\u0435\u043f\u0430 \u0438 \u0432\u0437\u0440\u044b\u0432\u043d\u044b\u0435 \u0433\u0440\u0438\u0431\u044b. \u041b\u0435\u0442\u0443\u0447\u0438\u0435 \u043c\u044b\u0448\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u0438 \u0432 \u0428\u0430\u0445\u0442\u0430\u0445.\n\u2022 \u0418\u0437\u043c\u0435\u043d\u0435\u043d\u044b \u0447\u0430\u0441\u0442\u043e\u0442\u0430 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f, \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u0443\u0440\u043e\u043d \u0438 \u0442\u0435\u043c\u043f \u0430\u0442\u0430\u043a \u0432\u0440\u0430\u0433\u043e\u0432. \u041f\u0435\u0440\u0432\u044b\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0432 \u041b\u0435\u0441\u0443 \u0441\u0442\u0430\u043b\u0438 \u043c\u044f\u0433\u0447\u0435, \u0430 \u0441\u043b\u0430\u0439\u043c\u044b \u0440\u0435\u0436\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0420\u0435\u043a\u0435.\n\u2022 \u0412\u0437\u0440\u044b\u0432\u043d\u044b\u0435 \u0433\u0440\u0438\u0431\u044b \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442 \u043a \u0446\u0435\u043b\u0438 \u0438 \u043f\u043e\u0434\u0436\u0438\u0433\u0430\u044e\u0442 \u0434\u0432\u0443\u0445\u0441\u0435\u043a\u0443\u043d\u0434\u043d\u044b\u0439 \u0444\u0438\u0442\u0438\u043b\u044c. \u041f\u043e\u0431\u0435\u0434\u0438\u0442\u0435 \u0438\u0445, \u043f\u043e\u043a\u0430 \u0436\u0451\u043b\u0442\u0430\u044f \u043f\u043e\u043b\u043e\u0441\u043a\u0430 \u043d\u0435 \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u043b\u0430\u0441\u044c. \u0418\u0437 \u043d\u0438\u0445 \u0432\u044b\u043f\u0430\u0434\u0430\u044e\u0442 \u0413\u0440\u0438\u0431\u044b \u2014 \u043d\u043e\u0432\u044b\u0439 \u0438\u043d\u0433\u0440\u0435\u0434\u0438\u0435\u043d\u0442 \u0434\u043b\u044f \u041a\u043e\u0442\u043b\u0430.\n\u2022 \u0423\u043b\u0443\u0447\u0448\u0435\u043d\u044b \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0438 \u0430\u0442\u0430\u043a\u0438 \u0432\u0440\u0430\u0433\u043e\u0432. \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b \u0438\u0445 \u0440\u0430\u0437\u043c\u0435\u0440\u044b, \u043f\u043e\u043b\u043e\u0441\u043a\u0438 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f \u0438 \u0442\u043e\u0447\u043a\u0438 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u043d\u0430\u0440\u044f\u0434\u043e\u0432.\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u044b \u0434\u0435\u043a\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u0434\u0435\u0440\u0435\u0432\u044c\u044f, \u0447\u0442\u043e\u0431\u044b \u041b\u0435\u0441 \u043e\u0441\u0442\u0430\u0432\u0430\u043b\u0441\u044f \u043b\u0435\u0441\u043e\u043c \u043f\u043e\u0441\u043b\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u0447.\n\u2022 \u0422\u0440\u0435\u0431\u0443\u0435\u043c\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u0443\u0431\u0438\u0439\u0441\u0442\u0432 \u0441\u043b\u0430\u0439\u043c\u043e\u0432 \u0432 \u0437\u0430\u0434\u0430\u043d\u0438\u044f\u0445 \u0441\u043d\u0438\u0436\u0435\u043d\u043e \u0441 \u0443\u0447\u0451\u0442\u043e\u043c \u043d\u043e\u0432\u043e\u0433\u043e \u0441\u043e\u0441\u0442\u0430\u0432\u0430 \u0432\u0440\u0430\u0433\u043e\u0432.\n\n<b>\u0421\u043b\u0430\u0439\u043c\u044b \u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430</b>\n\u2022 \u0421\u043b\u0430\u0439\u043c\u044b \u0442\u0435\u043f\u0435\u0440\u044c \u0441\u043e\u0431\u0440\u0430\u043d\u044b \u0432 \u0442\u0440\u0438 \u0437\u0430\u043f\u0438\u0441\u0438: \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435, \u0441\u0440\u0435\u0434\u043d\u0438\u0435 \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u0435. \u0412 \u043c\u0438\u0440\u0435 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u0432\u0441\u0435 \u043f\u044f\u0442\u044c \u0446\u0432\u0435\u0442\u043e\u0432.\n\u2022 \u0423\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0432\u0441\u0435\u0445 \u0446\u0432\u0435\u0442\u043e\u0432 \u0441\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0434\u043b\u044f \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u0438\u044f \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a \u0438 \u0431\u043e\u043d\u0443\u0441\u043d\u043e\u0433\u043e \u0443\u0440\u043e\u043d\u0430 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430. \u041f\u0440\u0435\u0436\u043d\u0438\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b. \u0412 \u0437\u0430\u0434\u0430\u043d\u0438\u044f\u0445 \u043d\u0430 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0439 \u0446\u0432\u0435\u0442 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u043d.\n\u2022 \u0420\u0430\u0437\u0432\u0435\u0440\u043d\u0438\u0442\u0435 \u0437\u0430\u043f\u0438\u0441\u044c \u0441\u043b\u0430\u0439\u043c\u0430, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0447\u0438\u0441\u043b\u043e \u0443\u0431\u0438\u0439\u0441\u0442\u0432 \u043f\u043e \u0446\u0432\u0435\u0442\u0430\u043c. \u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0437\u043d\u0430\u0447\u043e\u043a \u043c\u0435\u043d\u044f\u0435\u0442 \u0446\u0432\u0435\u0442 \u043f\u043e \u043c\u0435\u0440\u0435 \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u0438\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438.\n\u2022 \u041e\u0431\u0449\u0438\u0439 \u0440\u0430\u0437\u0434\u0435\u043b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0432\u0441\u0435\u0445 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0445 \u0432\u0440\u0430\u0433\u043e\u0432 \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u044b. \u041d\u0435\u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u043a\u0430\u0436\u0434\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u0441\u043e\u0431\u0440\u0430\u043d\u044b \u0432 \u043e\u0434\u043d\u0443 \u044f\u0447\u0435\u0439\u043a\u0443 \u0441 \u0438\u0445 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e\u043c.\n\u2022 \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0432\u0440\u0430\u0433\u0430 \u0438\u043b\u0438 \u0440\u0435\u0441\u0443\u0440\u0441 \u0432 \u043e\u0431\u0449\u0435\u043c \u0440\u0430\u0437\u0434\u0435\u043b\u0435, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c.\n\u2022 \u0412 \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u043e\u0431\u0449\u0438\u0439 \u0440\u0430\u0437\u0434\u0435\u043b \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u043f\u0438\u0441\u043a\u043e\u043c \u043a\u0430\u0440\u0442. \u041d\u0435\u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u043a\u0430\u0440\u0442\u044b \u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0441\u0438\u043b\u0443\u044d\u0442.\n\u2022 \u0423\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u0435\u043d\u044b \u0441\u0447\u0451\u0442\u0447\u0438\u043a\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0439, \u043e\u0431\u0449\u0430\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0438 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e \u043d\u0435\u0434\u0430\u0432\u043d\u0438\u0445 \u0432\u044b\u043b\u0430\u0437\u043a\u0430\u0445.\n\n<b>\u0417\u0430\u0434\u0430\u043d\u0438\u044f \u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435</b>\n\u2022 \u0417\u0430\u0434\u0430\u043d\u0438\u0435 \u041d\u0430\u0439\u0442\u0438 \u0418\u0432\u0430\u043d\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0434\u043e \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u043f\u043e\u0445\u043e\u0434\u0430 \u0432 \u041b\u0435\u0441. \u0412 \u044d\u0442\u043e\u043c \u043f\u043e\u0445\u043e\u0434\u0435 \u0443 \u0432\u0430\u0441 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u0434\u043e \u043d\u0435\u0433\u043e \u0434\u043e \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u0440\u0430\u0433\u043e\u0432.\n\u2022 \u041f\u0435\u0440\u0432\u044b\u043c \u0442\u0435\u043f\u0435\u0440\u044c \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u042d\u0445\u043e \u0437\u0430\u0434\u0430\u0447, \u0430 \u042d\u0445\u043e \u0431\u043e\u044f \u2014 \u043f\u043e\u0437\u0436\u0435. \u041f\u0435\u0440\u0435\u0434 \u0432\u044b\u0445\u043e\u0434\u043e\u043c \u041e\u0440\u0438\u043d \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442, \u043a\u0430\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043f\u0435\u0440\u0432\u0443\u044e \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c.\n\u2022 \u0411\u043e\u0435\u0432\u044b\u0435 \u042d\u0445\u043e \u0438\u0434\u0443\u0442 \u0432\u043f\u0435\u0440\u0451\u0434, \u0447\u0442\u043e\u0431\u044b \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u0432\u0440\u0430\u0433\u043e\u0432, \u0430 \u043d\u0435 \u043f\u043b\u0435\u0442\u0443\u0442\u0441\u044f \u0441\u0437\u0430\u0434\u0438.\n\u2022 \u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u044b \u0434\u0438\u0430\u043b\u043e\u0433\u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u044b \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u044e\u0449\u0438\u0435 \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u044b \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439 \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0442\u0435\u043a\u0443\u0449\u0438\u043c \u0441\u044e\u0436\u0435\u0442\u043e\u043c.\n\u2022 \u041f\u043e\u0441\u043b\u0435 \u0430\u043d\u0438\u043c\u0430\u0446\u0438\u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0432\u044b \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0435\u0441\u044c \u043d\u0430 \u043f\u0440\u0435\u0436\u043d\u0435\u0435 \u043c\u0435\u0441\u0442\u043e \u0432 \u0441\u043f\u0438\u0441\u043a\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0439.\n\u2022 \u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u043d\u0430 \u043f\u0443\u0433\u0430\u043b\u043e \u043e\u043d\u043e \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432\u043e\u0437\u043b\u0435 \u0434\u043e\u043c\u0430 \u0415\u0432\u044b. \u0414\u043e\u0440\u043e\u0436\u043a\u0438 \u0443 \u043f\u043e\u043b\u0435\u0439 \u0443\u043b\u0443\u0447\u0448\u0430\u044e\u0442\u0441\u044f \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u043c \u0433\u043e\u0440\u043e\u0434\u043a\u043e\u043c.\n\u2022 \u041a\u0430\u0440\u0442\u0430 Spooky \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u041b\u043e\u0449\u0438\u043d\u0430. \u0412 \u0437\u0430\u0434\u0430\u043d\u0438\u0438 \u0415\u0432\u044b \u0417\u0430\u043a\u043b\u0438\u043d\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u041b\u043e\u0449\u0438\u043d\u044b \u043d\u0443\u0436\u043d\u043e 100 000 \u0421\u043b\u0438\u0437\u0438, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0438\u0442\u044c \u0447\u0430\u0441\u0442\u044c \u0433\u043e\u0440\u043e\u0434\u043a\u0430 \u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u043f\u0443\u0442\u044c. \u0420\u0430\u043d\u0435\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f.\n\u2022 \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f \u043a\u043d\u043e\u043f\u043e\u043a \u0438 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0443\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f-\u0440\u0443\u043a\u0438 \u0432 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0438 \u0434\u043b\u044f \u043e\u0431\u0435\u0438\u0445 \u043e\u0440\u0438\u0435\u043d\u0442\u0430\u0446\u0438\u0439 \u044d\u043a\u0440\u0430\u043d\u0430.\n\n<b>\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435</b>\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u0417\u0430\u0442\u0435\u043c\u043d\u0438\u0442\u044c \u044d\u043a\u0440\u0430\u043d: \u0438\u0433\u0440\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0441\u044f \u0437\u0430 \u0442\u0451\u043c\u043d\u044b\u043c \u044d\u043a\u0440\u0430\u043d\u043e\u043c, \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u044e\u0449\u0438\u043c \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0435 \u043d\u0430\u0436\u0430\u0442\u0438\u044f. \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043f\u0430\u043b\u0435\u0446, \u0447\u0442\u043e\u0431\u044b \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f.\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u041f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0442\u044c \u043e\u0442\u0441\u0447\u0451\u0442 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0430.\n\u2022 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u044b \u043d\u0430 \u041f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0435\u043d\u0438\u044f, \u0418\u0433\u0440\u043e\u0432\u043e\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0438 \u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f. \u0412\u0435\u0440\u0441\u0438\u044f \u0438\u0433\u0440\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u0438\u0434\u043d\u0430.\n\u2022 \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u0432\u043d\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0433\u043e \u043c\u0435\u043d\u044e, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043a\u0440\u044b\u0442\u044c \u0435\u0433\u043e. \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0435 \u043d\u0430\u0436\u0430\u0442\u0438\u0435 \u043a\u043d\u043e\u043f\u043a\u0438 \u0434\u043e\u0431\u044b\u0447\u0438 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0435\u0451 \u043f\u0430\u043d\u0435\u043b\u044c.\n\u2022 \u0423\u043b\u0443\u0447\u0448\u0435\u043d\u044b \u043e\u0442\u0441\u0442\u0443\u043f\u044b \u0432 \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u0438 \u0432\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u0435 \u043a\u043d\u043e\u043f\u043a\u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0430.\n\n<b>\u0412\u0435\u0440\u0441\u0438\u044f 1.5.5</b>\n\n\u2022 \u0412 \u0437\u0430\u0434\u0430\u043d\u0438\u044f\u0445 \u0442\u0435\u043f\u0435\u0440\u044c \u0432\u0438\u0434\u0435\u043d \u0433\u043e\u0432\u043e\u0440\u044f\u0449\u0438\u0439 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436. \u041e\u0440\u0438\u043d \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d \u0430\u043d\u0438\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u043e\u0433\u043e\u043d\u044c\u043a\u043e\u043c.\n\u2022 \u0417\u0430\u0434\u0430\u043d\u0438\u044f, \u0434\u043b\u044f \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0443\u0436\u043d\u044b \u0440\u0435\u0441\u0443\u0440\u0441\u044b \u0432\u044b\u0448\u0435 \u0432\u0430\u0448\u0435\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u043d\u0430\u0432\u044b\u043a\u0430, \u0441\u043e\u0431\u0440\u0430\u043d\u044b \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u0417\u0430\u043a\u0440\u044b\u0442\u044b\u0435\u00bb. \u0420\u044f\u0434\u043e\u043c \u0441 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0443\u043a\u0430\u0437\u0430\u043d \u043d\u0443\u0436\u043d\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c.\n\u2022 \u0415\u0441\u043b\u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u0435 \u043c\u0435\u043d\u044f\u0435\u0442 \u0433\u043e\u0440\u043e\u0434, \u043a\u0430\u043c\u0435\u0440\u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u043e\u0441\u0442\u0440\u043e\u0439\u043a\u0443, \u0430 \u0437\u0430\u0442\u0435\u043c \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u043a \u0441\u043f\u0438\u0441\u043a\u0443 \u0437\u0430\u0434\u0430\u043d\u0438\u0439. \u0410\u043d\u0438\u043c\u0430\u0446\u0438\u044e \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c.\n\u2022 \u0424\u043b\u043e\u0440\u0430 \u0438 \u0422\u0438\u043b\u043b\u043c\u0430\u043d \u0442\u0435\u043f\u0435\u0440\u044c \u0432\u044b\u0434\u0430\u044e\u0442 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u043d\u0430 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u0435\u0439. \u0423\u0436\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0435 \u0443\u0447\u0430\u0441\u0442\u043a\u0438 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c\u0438.\n\u2022 \u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f \u043f\u043e\u043b\u0435\u0439 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u044b \u043f\u043e \u0431\u043e\u043b\u044c\u0448\u0435\u043c\u0443 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0443 \u0443\u0440\u043e\u0432\u043d\u0435\u0439. \u0414\u043b\u044f \u043f\u043e\u0437\u0434\u043d\u0438\u0445 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0431\u043e\u043b\u044c\u0448\u0435 \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043d\u044b.\n\u2022 \u041c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435 \u0434\u0435\u0440\u0435\u0432\u044c\u044f \u0432\u0435\u0440\u043d\u0443\u043b\u0438\u0441\u044c. \u041c\u0430\u043b\u0435\u043d\u044c\u043a\u0438\u0435, \u0441\u0440\u0435\u0434\u043d\u0438\u0435 \u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0434\u0435\u0440\u0435\u0432\u044c\u044f \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u044f\u0445 \u0440\u0443\u0431\u043a\u0438 1/15/38 \u0434\u043b\u044f \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0434\u0435\u0440\u0435\u0432\u044c\u0435\u0432, 29/46/64 \u0434\u043b\u044f \u0434\u0443\u0431\u043e\u0432, 55/72/90 \u0434\u043b\u044f \u0431\u0435\u0440\u0451\u0437 \u0438 81/98/107 \u0434\u043b\u044f \u0435\u043b\u0435\u0439.\n\u2022 \u041d\u043e\u0432\u044b\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0440\u0443\u0431\u043a\u0438 \u043d\u0435 \u043c\u0435\u043d\u044f\u044e\u0442 \u0432\u0440\u0435\u043c\u044f \u0440\u043e\u0441\u0442\u0430 \u0434\u0435\u0440\u0435\u0432\u044c\u0435\u0432 \u0432 \u0441\u0430\u0434\u0443 \u0438 \u043e\u043f\u044b\u0442 \u0437\u0430 \u0441\u0431\u043e\u0440 \u0443\u0440\u043e\u0436\u0430\u044f.\n\u2022 \u041f\u0430\u043a\u0435\u0442\u044b \u0441\u0435\u043c\u044f\u043d \u0442\u0435\u043f\u0435\u0440\u044c \u0432\u044b\u043f\u0430\u0434\u0430\u044e\u0442 \u0441 \u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e\u0441\u0442\u044c\u044e 7% \u043f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0437\u0430\u0434\u0430\u0447.\n\u2022 \u041d\u0430 \u043f\u043e\u043b\u044f\u0445 \u0434\u0435\u0440\u0435\u0432\u043e \u043c\u043e\u0436\u043d\u043e \u0441\u0440\u0443\u0431\u0438\u0442\u044c \u043f\u0440\u0438 \u0441\u0440\u0435\u0434\u043d\u0435\u043c \u0440\u0430\u0437\u043c\u0435\u0440\u0435 \u0438\u043b\u0438 \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u00ab\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0440\u043e\u0441\u0442\u00bb. \u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0432\u044b\u0440\u043e\u0441\u0448\u0435\u0435 \u0434\u0435\u0440\u0435\u0432\u043e \u0434\u0430\u0451\u0442 \u0432\u0434\u0432\u043e\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u0438 \u043e\u043f\u044b\u0442\u0430. \u0410\u0432\u0442\u043e\u0440\u0435\u0436\u0438\u043c \u0436\u0434\u0451\u0442 \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u0440\u043e\u0441\u0442\u0430.\n\u2022 \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043a\u0430\u0434\u0440\u043e\u0432 \u0440\u043e\u0441\u0442\u0430 \u043e\u0433\u0443\u0440\u0446\u0430.\n\u2022 \u0412 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0443 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u043e \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043f\u043e \u043f\u043e\u043b\u044f\u043c.\n\u2022 \u0412 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0435\u043d\u0438\u044f\u0445 \u0437\u0430\u0434\u0430\u0447 \u043f\u0435\u0440\u0432\u044b\u043c\u0438 \u0438\u0434\u0443\u0442 \u043d\u0430\u0432\u044b\u043a\u0438, \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0432\u0430\u0436\u043d\u044b\u0435 \u0434\u043b\u044f \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u043a\u0430\u0440\u0442\u044b. \u0423\u0431\u0440\u0430\u043d\u044b \u043b\u0438\u0448\u043d\u0438\u0435 \u0444\u0438\u043b\u044c\u0442\u0440\u044b \u0438 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430. \u0427\u0438\u0441\u043b\u043e \u043d\u0435\u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0445 \u0437\u0430\u0434\u0430\u0447 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u0432\u043d\u0438\u0437\u0443 \u0441\u043f\u0438\u0441\u043a\u0430.\n\u2022 \u041d\u0430 \u0433\u0440\u0430\u0444\u0438\u043a\u0430\u0445 \u043f\u043e\u0445\u043e\u0434\u043e\u0432 \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u043a\u043d\u043e\u043f\u043a\u0438 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430. \u0421\u0442\u043e\u043b\u0431\u0446\u044b \u0432\u044b\u0448\u0435 \u0432\u0438\u0434\u0438\u043c\u043e\u0433\u043e \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d\u0430 \u043e\u0442\u043c\u0435\u0447\u0435\u043d\u044b \u0441\u0442\u0440\u0435\u043b\u043a\u043e\u0439. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0442\u0430\u043a\u043e\u0439 \u0441\u0442\u043e\u043b\u0431\u0435\u0446, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u043f\u043e\u043b\u043d\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435.\n\u2022 \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0448\u0438\u0440\u0438\u043d\u044b \u0441\u043f\u0438\u0441\u043a\u0430 \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u0451\u043d\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0445\u043e\u0434\u043e\u0432 \u0432 \u0430\u043b\u044c\u0431\u043e\u043c\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435.\n\u2022 \u0412 \u043c\u0435\u043d\u044e Hub \u0438 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0447\u0430\u0441\u044b, \u043a\u043e\u0433\u0434\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0431\u043e\u043d\u0443\u0441. \u0417\u0432\u0451\u0437\u0434\u043e\u0447\u043a\u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u0442\u0435\u043f\u0435\u0440\u044c \u0441\u0442\u043e\u044f\u0442 \u0440\u044f\u0434\u043e\u043c \u0441 \u0442\u0435\u043a\u0441\u0442\u043e\u043c \u043c\u0435\u043d\u044e.\n\u2022 \u0421\u0442\u0430\u0440\u044b\u0439 \u0431\u043b\u043e\u043a \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u044f \u0443\u0431\u0440\u0430\u043d \u0438\u0437 \u0437\u0430\u0434\u0430\u043d\u0438\u0439. \u0421\u0441\u044b\u043b\u043a\u0438 \u043d\u0430 \u0440\u0435\u0441\u0443\u0440\u0441\u044b \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u044c.\n\u2022 \u0428\u0443\u0442\u043a\u0438 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u044d\u043a\u0440\u0430\u043d\u0435 \u0432\u0434\u0432\u043e\u0435 \u0434\u043e\u043b\u044c\u0448\u0435.\n\n<b>\u0412\u0435\u0440\u0441\u0438\u044f 1.5.4</b>\n\n\u2022 \u041d\u0430 iOS \u0438 Android \u0442\u0435\u043f\u0435\u0440\u044c \u043c\u043e\u0436\u043d\u043e \u0441\u043c\u0435\u043d\u0438\u0442\u044c \u044f\u0437\u044b\u043a \u0432 \u043c\u0435\u043d\u044e \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u2192 \u041e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435.\n\u2022 \u041f\u0440\u0438 \u043d\u043e\u0432\u043e\u0439 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u044f\u0437\u044b\u043a \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430, \u0435\u0441\u043b\u0438 \u043e\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f. \u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0439 \u0432\u044b\u0431\u043e\u0440 \u044f\u0437\u044b\u043a\u0430 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0432 \u0441\u0438\u043b\u0435.\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d \u0432\u044b\u0431\u043e\u0440 \u043e\u0440\u0438\u0435\u043d\u0442\u0430\u0446\u0438\u0438: \u0430\u0432\u0442\u043e, \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u043d\u0430\u044f \u0438 \u0430\u043b\u044c\u0431\u043e\u043c\u043d\u0430\u044f.\n\u2022 \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f \u043d\u0435 \u0440\u0430\u0437\u043c\u0435\u0449\u0430\u0442\u044c \u0438\u0433\u0440\u043e\u0432\u0443\u044e \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043f\u043e\u0434 \u0432\u044b\u0440\u0435\u0437\u043e\u043c \u043a\u0430\u043c\u0435\u0440\u044b.\n\u2022 \u0423\u043b\u0443\u0447\u0448\u0435\u043d\u044b \u043e\u0442\u0441\u0442\u0443\u043f\u044b \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445.\n\u2022 \u041f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0435\u043d\u0438\u044f \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u0441\u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u043f\u043e \u043d\u0430\u0432\u044b\u043a\u0430\u043c. \u0412 \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u0435\u0441\u0442\u044c \u0432\u044b\u0431\u043e\u0440 \u043d\u0430\u0432\u044b\u043a\u0430, \u0432 \u0430\u043b\u044c\u0431\u043e\u043c\u043d\u043e\u043c \u2014 \u0434\u043e \u0442\u0440\u0451\u0445 \u0441\u0442\u043e\u043b\u0431\u0446\u043e\u0432.\n\u2022 \u0423 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u0435\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u00ab\u0427\u0430\u0449\u0435\u00bb, \u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u0445\u043e\u0434\u0430 \u2014 \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u0448\u0430\u043d\u0441. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443, \u043f\u0440\u043e\u0433\u043d\u043e\u0437 \u0448\u0430\u043d\u0441\u0430 \u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435.\n\u2022 \u041d\u0435\u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u0441\u0432\u0451\u0440\u043d\u0443\u0442\u044b. \u0421\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432\u0432\u0435\u0440\u0445\u0443 \u0441\u043f\u0438\u0441\u043a\u0430.\n\u2022 \u0421\u0443\u043d\u0434\u0443\u043a\u0438 \u0434\u0430\u044e\u0442 \u0432\u0434\u0432\u043e\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u043e\u043f\u044b\u0442\u0430 \u0441\u0431\u043e\u0440\u0430 \u0434\u043e\u0431\u044b\u0447\u0438.\n\u2022 \u0421\u0443\u043d\u0434\u0443\u043a\u0438 \u0438\u0437 \u0437\u043e\u043b\u043e\u0442\u0430, \u0438\u0437 \u043e\u0433\u043d\u044f, \u043b\u0438\u0440\u0438\u0435\u0432\u044b\u0435 \u0441\u0443\u043d\u0434\u0443\u043a\u0438 \u0438 \u0441\u0443\u043d\u0434\u0443\u043a\u0438 \u043a\u043e\u043f\u0438\u0443\u043c\u0430 \u0442\u0435\u043f\u0435\u0440\u044c \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u044f\u0445 \u0441\u0431\u043e\u0440\u0430 \u0434\u043e\u0431\u044b\u0447\u0438 14, 20, 27 \u0438 36.\n\u2022 \u0417\u043d\u0430\u0447\u043a\u0438 \u043d\u0430\u0432\u044b\u043a\u0430 \u00ab\u0421\u0431\u043e\u0440 \u0434\u043e\u0431\u044b\u0447\u0438\u00bb \u0442\u0435\u043f\u0435\u0440\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u044f\u0434\u0440\u0430 \u0438\u0437 \u043a\u0443\u0437\u043d\u0438\u0446\u044b.\n\u2022 \u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0439\u0442\u0435 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0438\u0445 \u0438\u0437 \u00ab\u0421\u043c\u0435\u0448\u0430\u0442\u044c \u0432\u0441\u0451\u00bb. \u0412\u044b\u0431\u043e\u0440 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f.\n\u2022 \u041f\u0440\u0435\u0434\u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u00ab\u0421\u043c\u0435\u0448\u0430\u0442\u044c \u0432\u0441\u0451\u00bb \u043d\u0435 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b. \u041e\u043d\u0438 \u0437\u0430\u0442\u0435\u043c\u043d\u0435\u043d\u044b, \u0430 \u0437\u043d\u0430\u0447\u043a\u0438 \u0437\u0430\u043c\u043a\u043e\u0432 \u043b\u0443\u0447\u0448\u0435 \u0432\u0438\u0434\u043d\u044b \u0432 \u043e\u0431\u0435\u0438\u0445 \u0442\u0435\u043c\u0430\u0445.\n\u2022 \u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u044b \u043f\u044f\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0439 \u0440\u044b\u0431: \u0418\u043b\u043e\u0435\u0434, \u0421\u044d\u0440 \u041f\u043b\u044e\u0445, \u0411\u043b\u0443\u043f\u0438\u043a\u0443\u0441, \u041d\u0438\u0431\u043b\u0435\u0442 \u0438 \u0424\u043b\u0438\u043f\u043f\u0438.\n\u2022 \u041f\u043e\u043b\u044f \u043c\u043e\u0436\u043d\u043e \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u0442\u044c \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e, \u0431\u0435\u0437 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0434\u0430\u0447\u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u044f. \u0417\u0430\u0442\u0440\u0430\u0442\u044b \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f.\n\u2022 \u041a\u043e\u0433\u0434\u0430 \u0440\u0443\u0447\u043d\u043e\u0439 \u0443\u0440\u043e\u0436\u0430\u0439 \u0433\u043e\u0442\u043e\u0432, \u043d\u0430 \u043a\u043d\u043e\u043f\u043a\u0435 \u0433\u043e\u0440\u043e\u0434\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0437\u043d\u0430\u0447\u043e\u043a \u043f\u043e\u043b\u0435\u0439.\n\u2022 \u0412 \u0430\u043b\u044c\u0431\u043e\u043c\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u0432\u0435\u0440\u0445\u043d\u0435\u0433\u043e \u043c\u0435\u043d\u044e \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0442\u0435\u043a\u0443\u0449\u0435\u0435 \u043e\u043a\u043d\u043e, \u043a\u0430\u043a \u0438 \u0432 \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u043d\u043e\u043c.\n\u2022 \u0417\u043d\u0430\u0447\u043a\u0438 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u0438 \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u0432 \u043a\u0443\u0437\u043d\u0438\u0446\u0435 \u043f\u0440\u0438\u0434\u0432\u0438\u043d\u0443\u0442\u044b \u043a \u043a\u043d\u043e\u043f\u043a\u0435 \u00ab\u041a\u043e\u0432\u0430\u0442\u044c\u00bb. \u0421\u043f\u0440\u0430\u0432\u0430 \u043f\u043e\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u00ab\u041d\u0430\u0434\u0435\u0442\u044c\u00bb, \u043a\u043e\u0433\u0434\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0433\u043e\u0442\u043e\u0432.\n\u2022 \u0423\u0431\u0440\u0430\u043d \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f \u0432 \u043a\u0443\u0437\u043d\u0438\u0446\u0435, \u0441\u0442\u0440\u043e\u043a\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a \u043f\u043e\u0434\u043d\u044f\u0442\u044b \u0432\u044b\u0448\u0435.\n\u2022 \u00ab\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u0432\u0430\u0442\u0440\u0438\u0443\u043c\u0435\u00bb \u0441\u043a\u0440\u044b\u0442\u043e, \u043f\u043e\u043a\u0430 \u0432\u044b \u043d\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0442\u0435 \u044f\u0434\u0440\u043e \u0432\u0430\u0442\u0440\u0438\u0443\u043c\u0430.\n\n<b>\u0412\u0435\u0440\u0441\u0438\u044f 1.5.3</b>\n\n\u2022 \u0412 \u0437\u0430\u0434\u0430\u043d\u0438\u044f\u0445 \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0440\u0435\u0436\u0438\u043c \u00ab\u041a\u0440\u0430\u0442\u043a\u043e\u00bb, \u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f. \u0412\u044b\u0431\u043e\u0440 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f.\n\u2022 \u0412 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u044e\u0442\u0441\u044f \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u043e\u043b\u0431\u0446\u043e\u0432, \u0435\u0441\u043b\u0438 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043c\u0435\u0441\u0442\u0430. \u0423\u0441\u043b\u043e\u0432\u0438\u044f \u043c\u043e\u0433\u0443\u0442 \u0441\u0442\u043e\u044f\u0442\u044c \u0440\u044f\u0434\u043e\u043c \u0432 \u043e\u0431\u0435\u0438\u0445 \u043e\u0440\u0438\u0435\u043d\u0442\u0430\u0446\u0438\u044f\u0445.\n\u2022 \u041d\u0430\u0433\u0440\u0430\u0434\u044b \u0442\u0435\u043f\u0435\u0440\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u044b \u043d\u0430\u0434 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u043c\u0438. \u0423 \u0433\u043e\u0442\u043e\u0432\u044b\u0445 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u043a\u043d\u043e\u043f\u043a\u0430 \u00ab\u0421\u0434\u0430\u0442\u044c\u00bb \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0440\u044f\u0434\u043e\u043c \u0441 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c, \u0430 \u0440\u0430\u0441\u0445\u043e\u0434\u0443\u0435\u043c\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0432\u0438\u0434\u043d\u044b \u0431\u0435\u0437 \u043f\u043e\u043b\u043e\u0441 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430.\n\u2022 \u0417\u043d\u0430\u0447\u043a\u0438 \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u0434\u0432\u0438\u043d\u0443\u0442\u044b \u043a \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f\u043c: \u0443 \u0437\u0430\u043a\u0440\u0435\u043f\u043b\u0451\u043d\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u043e\u043d\u0438 \u0441\u0442\u043e\u044f\u0442 \u043f\u0440\u044f\u043c\u043e, \u0443 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u2014 \u043f\u043e\u0434 \u043d\u0430\u043a\u043b\u043e\u043d\u043e\u043c.\n\u2022 \u0423\u0431\u0440\u0430\u043d\u044b \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043b\u0438\u043d\u0438\u0438 \u043c\u0435\u0436\u0434\u0443 \u0437\u0430\u0434\u0430\u043d\u0438\u044f\u043c\u0438 \u0438 \u043f\u043e\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b \u043e\u0442\u0441\u0442\u0443\u043f\u044b \u0443 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u043e\u0432 \u0438 \u043a\u043d\u043e\u043f\u043e\u043a.\n\u2022 \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u043e\u0448\u0438\u0431\u043a\u0430, \u0438\u0437-\u0437\u0430 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u0431\u044b\u043b \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u043d\u0430 Android \u0438 \u0432 Steam.\n\u2022 \u0426\u0435\u043d\u044b Steam \u0442\u0435\u043f\u0435\u0440\u044c \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0441\u0438\u043c\u0432\u043e\u043b \u0432\u0430\u043b\u044e\u0442\u044b \u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u0437\u043d\u0430\u043a\u043e\u0432 \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u043f\u044f\u0442\u043e\u0439.\n\u2022 \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u0447\u0451\u0440\u043d\u0430\u044f \u0438\u043b\u0438 \u0441\u043c\u0435\u0449\u0451\u043d\u043d\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430 \u0438\u0437 \u0433\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0430 \u0432 \u0432\u0435\u0440\u0442\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439.\n\u2022 \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u043c\u043e\u0436\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0438 \u0441\u043c\u0435\u043d\u0438\u0442\u044c \u0442\u0435\u043c\u0443, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0441 \u0442\u043e\u0433\u043e \u0436\u0435 \u043c\u0435\u0441\u0442\u0430.\n\u2022 \u0421\u0441\u044b\u043b\u043a\u0438 \u0432 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0438 \u0441\u0442\u0430\u043b\u043e \u043b\u0435\u0433\u0447\u0435 \u0447\u0438\u0442\u0430\u0442\u044c \u0432 \u0441\u0432\u0435\u0442\u043b\u043e\u0439 \u0442\u0435\u043c\u0435.\n\u2022 \u041b\u043e\u0433\u043e\u0442\u0438\u043f Discord \u0442\u0435\u043f\u0435\u0440\u044c \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0435\u0442 \u0441 \u0446\u0432\u0435\u0442\u043e\u043c \u0442\u0435\u043a\u0441\u0442\u0430 HUD \u0432 \u043e\u0431\u0435\u0438\u0445 \u0442\u0435\u043c\u0430\u0445.\n\n<b>\u0412\u0435\u0440\u0441\u0438\u044f 1.5.2</b>\n\n\u2022 \u041c\u043d\u043e\u0436\u0438\u0442\u0435\u043b\u044c \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0441\u043c\u0435\u0440\u0442\u0438 \u0438 \u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u043f\u043e\u0445\u043e\u0434\u0430\u0445 \u0434\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u0432 \u0433\u043e\u0440\u043e\u0434. \u041c\u0430\u043a\u0441\u0438\u043c\u0443\u043c \u2014 \u00d710.\n\u2022 \u0415\u0434\u0430 \u0434\u0430\u0451\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u043e\u0445\u043b\u0451\u0431\u043a\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0446\u0435\u043d\u043d\u044b\u0435 \u0438\u043d\u0433\u0440\u0435\u0434\u0438\u0435\u043d\u0442\u044b.\n\u2022 \u041a\u0443\u0440\u044f\u0442\u0438\u043d\u0430, \u0441\u0432\u0438\u043d\u0438\u043d\u0430, \u0431\u0430\u0440\u0430\u043d\u0438\u043d\u0430 \u0438 \u0441\u0442\u0435\u0439\u043a \u0434\u0430\u044e\u0442 \u043d\u0430 50% \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u043e\u0445\u043b\u0451\u0431\u043a\u0438.\n\u2022 \u0412 \u043a\u043e\u0442\u0451\u043b \u0432\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c \u043a\u043d\u043e\u043f\u043a\u0430 \u00ab\u0421\u043c\u0435\u0448\u0430\u0442\u044c \u0432\u0441\u0451\u00bb. \u041e\u043d\u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u043e\u0445\u043b\u0451\u0431\u043a\u0438 \u0438 \u0437\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430.\n\u2022 \u0412 \u043a\u0443\u0437\u043d\u0438\u0446\u0435 \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u00ab\u041d\u0435 \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0442\u044c\u0441\u044f\u00bb. \u041e\u043d\u0430 \u043e\u0442\u043c\u0435\u043d\u044f\u0435\u0442 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438: \u043a\u043e\u0432\u043a\u0430 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0441\u044f, \u043f\u043e\u043a\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432.\n\u2022 \u0413\u0435\u0440\u043e\u0439 \u0438 \u042d\u0445\u043e \u0438\u043c\u0435\u044e\u0442 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0435 \u0448\u0430\u043d\u0441\u044b \u043d\u0430\u0439\u0442\u0438 \u0441\u0435\u043c\u0435\u043d\u0430 \u0438 \u0441\u0430\u0436\u0435\u043d\u0446\u044b. \u041f\u043e\u0437\u0434\u043d\u0438\u0435 \u0440\u0430\u0437\u043d\u043e\u0432\u0438\u0434\u043d\u043e\u0441\u0442\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u0440\u0435\u0436\u0435; \u0434\u043b\u044f \u043a\u0443\u043b\u044c\u0442\u0443\u0440, \u043f\u043b\u043e\u0434\u043e\u0432\u044b\u0445 \u0438 \u043b\u0435\u0441\u043d\u044b\u0445 \u0434\u0435\u0440\u0435\u0432\u044c\u0435\u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0448\u0430\u043d\u0441\u043e\u0432.\n\u2022 \u0421\u0434\u0430\u0442\u044c \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u043c\u043e\u0436\u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0433\u043e\u0440\u043e\u0434\u0435.\n\u2022 \u041c\u0435\u043b\u043a\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u0441\u0442\u0430\u043b \u043a\u0440\u0443\u043f\u043d\u0435\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432 \u0437\u0430\u0434\u0430\u043d\u0438\u044f\u0445.\n\u2022 \u0417\u043d\u0430\u0447\u043a\u0438 \u043d\u0430\u0433\u0440\u0430\u0434 \u0437\u0430 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u043a \u0435\u0434\u0438\u043d\u043e\u043c\u0443 \u0432\u0438\u0434\u0443, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u0430\u043a\u0435\u0442\u044b \u0441\u0435\u043c\u044f\u043d. \u0423\u043c\u0435\u043d\u044c\u0448\u0435\u043d\u044b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043a\u0440\u0443\u043f\u043d\u044b\u0435 \u0437\u043d\u0430\u0447\u043a\u0438 \u0441\u0430\u0436\u0435\u043d\u0446\u0435\u0432 \u0438 \u0443\u0431\u0440\u0430\u043d\u044b \u0437\u0430\u0437\u043e\u0440\u044b \u043c\u0435\u0436\u0434\u0443 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u043f\u043e\u043b\u0435\u0439.\n\u2022 \u0418\u0442\u043e\u0433\u0438 \u043f\u043e\u0445\u043e\u0434\u0430 \u0438 \u0441\u043f\u0438\u0441\u043e\u043a \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u044b\u0435 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438, \u0438\u0442\u043e\u0433 \u043f\u0440\u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0438 \u0438 \u0431\u043e\u043d\u0443\u0441\u044b. \u0412 \u0430\u043b\u044c\u0431\u043e\u043c\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u0441\u043f\u0438\u0441\u043a\u0438 \u0437\u0430\u043d\u0438\u043c\u0430\u044e\u0442 \u0434\u0432\u0430 \u0438\u043b\u0438 \u0442\u0440\u0438 \u0441\u0442\u043e\u043b\u0431\u0446\u0430.\n\u2022 \u041a\u0430\u0440\u043c\u0430\u043d\u043d\u044b\u0435 \u0447\u0430\u0441\u044b \u043c\u0435\u043d\u044f\u044e\u0442 \u0441\u0442\u0443\u043f\u0435\u043d\u044c \u043f\u043e \u043c\u0435\u0440\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432\u043d\u0435 \u0433\u043e\u0440\u043e\u0434\u0430, \u0430 \u0441\u0443\u043d\u0434\u0443\u043a\u0438 \u2014 \u043f\u043e \u043c\u0435\u0440\u0435 \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u044f \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432.\n\u2022 \u0423\u043b\u0443\u0447\u0448\u0435\u043d\u0430 \u043f\u0440\u043e\u043a\u0440\u0443\u0442\u043a\u0430 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u0432 \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435: \u043d\u0438\u0436\u043d\u044f\u044f \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044f \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439.\n\u2022 \u041f\u0440\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0445 \u0432\u0438\u0434\u043d\u044b \u0438\u043c\u0435\u043d\u0430 \u041d\u0418\u041f. \u0417\u0434\u043e\u0440\u043e\u0432\u044c\u0435, \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u0438 \u0438 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u0432\u0438\u0434\u0438\u043c\u044b\u043c\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f.\n\u2022 \u041d\u0443\u0436\u043d\u044b\u0435 \u043a\u043d\u043e\u043f\u043a\u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043e\u0442\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u0441\u044f. \u041f\u0435\u0440\u0435\u0445\u043e\u0434 \u0447\u0435\u0440\u0435\u0437 \u043c\u0435\u043d\u044e \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0443\u0440\u043e\u043a, \u0430 \u043a\u043d\u043e\u043f\u043a\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043c\u0435\u043d\u044e \u2014 \u0437\u0430\u043a\u0440\u044b\u0442\u044c \u043e\u043a\u043d\u043e \u043f\u043e \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044e.\n\u2022 \u0411\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0441\u043f\u0438\u0441\u043e\u043a \u0442\u0435\u043c. \u0423 \u0437\u0430\u043c\u0435\u0442\u043e\u043a \u043e\u0431 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u0445 \u043f\u043e\u044f\u0432\u0438\u043b\u0441\u044f \u0437\u043d\u0430\u0447\u043e\u043a \u0434\u043d\u0435\u0432\u043d\u0438\u043a\u0430.\n\u2022 \u0417\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u044f\u0447\u0435\u0439\u043a\u0438 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 \u0437\u0430\u043c\u043e\u043a \u0432\u043c\u0435\u0441\u0442\u043e \u0442\u0435\u043a\u0441\u0442\u0430.\n\u2022 \u041f\u0435\u0440\u0435\u0432\u043e\u0434\u044b \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u044b \u0438 \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b, \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u043a \u0435\u0434\u0438\u043d\u043e\u043c\u0443 \u0432\u0438\u0434\u0443.\n\u2022 \u0414\u0435\u0433\u0443\u0441\u0442\u0430\u0446\u0438\u044f \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u043d\u0430\u0436\u0430\u0442\u0438\u044e \u043a\u043d\u043e\u043f\u043a\u0438, \u043f\u0435\u0440\u0432\u0430\u044f \u043f\u0440\u043e\u0431\u0430 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0441\u0440\u0430\u0437\u0443. \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0440\u0430\u0441\u0442\u0451\u0442 \u0441 2/\u0441 \u0434\u043e 10/\u0441 \u043d\u0430 12-\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u0415\u0432\u044b \u0438 \u0434\u043e 100/\u0441 \u043d\u0430 42-\u043c.\n\u2022 \u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u043a\u043e\u0442\u043b\u0430 \u0432 \u043f\u043e\u0440\u0442\u0440\u0435\u0442\u043d\u043e\u043c \u0438 \u0430\u043b\u044c\u0431\u043e\u043c\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0430\u0445. \u041d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0435 \u043e\u043a\u043d\u043e \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u0438 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c \u0438 \u043f\u043e\u043d\u044f\u0442\u043d\u0435\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0431\u043e\u043d\u0443\u0441\u044b \u043a\u0430\u0440\u0442\u044b, \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u0438 \u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 164590655378165761
    m_Localized: "<b>\u041F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F</b>\n\n<b>\u041D\u0430\u0447\u0430\u043B\u043E \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435</b>\n\u2022 \u041F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u044B \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E \u0441 NPC.\n\u2022 \u0413\u0438\u043B\u043B \u0432\u0435\u0434\u0451\u0442 \u0438\u0433\u0440\u043E\u043A\u043E\u0432 \u043A \u0420\u0435\u043A\u0435, \u0430 \u0411\u0430\u0440\u043A\u043B\u0438 \u2014 \u043A \u041B\u0435\u0441\u0443.\n\u2022 \u0413\u0438\u043B\u043B \u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u0435\u0442 \u0421\u0442\u0430\u0440\u044B\u043C\u0438 \u0441\u0430\u043F\u043E\u0433\u0430\u043C\u0438. \u0418\u0432\u0430\u043D \u0432\u044B\u0434\u0430\u0451\u0442 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0438 \u0443\u0447\u0438\u0442 \u043A\u043E\u0432\u0430\u0442\u044C \u0438 \u043D\u0430\u0434\u0435\u0432\u0430\u0442\u044C \u043F\u0435\u0440\u0432\u044B\u0439 \u043C\u0435\u0447.\n\u2022 \u041C\u0435\u043D\u044E \u0438 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B.\n\u2022 \u0417\u0430\u0434\u0430\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E \u0441\u0434\u0430\u0432\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0433\u043E\u0440\u043E\u0434\u0435.\n\n<b>\u0418\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441</b>\n\u2022 \u041F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u044B \u0418\u0442\u043E\u0433\u0438 \u043F\u043E\u0445\u043E\u0434\u0430 \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0430\u044F \u043F\u0430\u043D\u0435\u043B\u044C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A \u0432 \u043F\u043E\u0445\u043E\u0434\u0435.\n\u2022 \u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430\u0434\u0435\u0442\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438 \u0431\u043E\u043D\u0443\u0441\u044B \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F.\n\u2022 \u0412\u043E \u0432\u0441\u0451\u043C \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430 \u043F\u0440\u043E\u043A\u0440\u0443\u0442\u043A\u0430 \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u0435\u043C.\n\u2022 \u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u0430: \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u044B \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B \u043F\u043E \u0442\u0435\u043C\u0430\u043C, \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u044B\u0435 \u0442\u0430\u0431\u043B\u0438\u0446\u044B \u0438 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u043C\u044B\u0435 \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u044F \u0437\u043D\u0430\u0447\u043A\u043E\u0432.\n\n<b>\u0418\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0438 \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F</b>\n\u2022 \u0423\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u0430 \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0432 \u043F\u0435\u0440\u0432\u043E\u043C \u043F\u043E\u0445\u043E\u0434\u0435 \u043D\u0430 \u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F.\n\u2022 \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0437\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u044F \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F\u0445.\n\u2022 \u0423\u0440\u043E\u0432\u043D\u0438 \u044F\u0434\u0435\u0440 \u0438 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 \u043D\u0430\u0432\u044B\u043A \xAB\u0411\u043E\u0439\xBB.\n\u2022 \u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043F\u043E\u043B\u043E\u0441 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0432\u0440\u0430\u0433\u043E\u0432 \u0438 \u043E\u0448\u0438\u0431\u043A\u0438 \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438 \u0440\u044B\u0431\u0430\u043B\u043A\u0438.\n\u2022 \u0423\u0434\u0430\u043B\u0435\u043D\u044B \u0442\u0430\u0431\u043B\u0438\u0446\u044B \u043B\u0438\u0434\u0435\u0440\u043E\u0432.\n\n<b>\u041F\u0440\u043E\u0448\u043B\u044B\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F</b>\n\n\u2022 \u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u044B \xAB\u0420\u0430\u0434\u0438 \u0432\u0430\u0440\u0435\u043D\u044C\u044F!\xBB \u0438 \xAB\u041F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F \u0413\u0438\u043B\u043B\u0438\u0432\u0435\u0440\u0430\xBB.\n\u2022 \u0423\u043B\u0443\u0447\u0448\u0435\u043D\u043E \u0432\u0432\u043E\u0434\u043D\u043E\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435.\n\u2022 \u0418\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F \u043E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0438 \u0443\u0440\u043E\u0432\u043D\u044F, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0432\u0448\u0438\u0435 \u0437\u0430\u043D\u0438\u0436\u0435\u043D\u043D\u044B\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F.\n\u2022 \u0418\u0437 \u041A\u0443\u0437\u043D\u0438\u0446\u044B \u0443\u0434\u0430\u043B\u0451\u043D \u0431\u043B\u043E\u043A \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u043D\u0430\u0434\u0435\u0442\u043E\u0433\u043E \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F.\n\u2022 \u0417\u0430\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \xAB\u0413\u043E\u0442\u043E\u0432\u043E \u043A \u0441\u0434\u0430\u0447\u0435\xBB \u0432\u043C\u0435\u0441\u0442\u043E \xAB\u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043E\xBB.\n\u2022 \u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D \u044D\u043A\u0440\u0430\u043D \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438 \u043F\u0440\u0438 \u0441\u043C\u0435\u043D\u0435 \u043A\u0430\u0440\u0442\u044B.\n\u2022 \u0412 \u041A\u043E\u0442\u0451\u043B \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0430 \xAB\u0421\u043C\u0435\u0448\u0430\u0442\u044C \u0432\u0441\u0451\xBB.\n\u2022 \u041E\u0431\u043D\u043E\u0432\u043B\u0451\u043D \u043F\u0430\u043A\u0435\u0442 \u043F\u043E\u0438\u0441\u043A\u0430 \u043F\u0443\u0442\u0438."
