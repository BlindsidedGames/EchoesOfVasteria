  m_TableData:
  - m_Id: 25772880722018304
    m_Localized: "\u0410\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438\u0439 (en)"
    m_Metadata:
      m_Items: []
  - m_Id: 188400156672
    m_Localized: "\u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u0410\u043B\u044C\u0442\u0435\u0440-\u044D\u0445\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F. \u0421\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0432 \u043F\u043E\u0445\u043E\u0434\u0430\u0445 \u0438\u043B\u0438 \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0439\u0442\u0435 \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0443\u0440\u043E\u0436\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 478381752320
    m_Localized: "<link=\"help:buffs\"><u><color=#EFB889>\u0423\u0441\u0438\u043B\u0435\u043D\u0438\u044F</color></u></link> \u2014 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0441\u0438\u043B\u044B. \u041E\u043D\u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u043E \u0438\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u0438 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438\u043B\u0438 \u043F\u0440\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434.\n\n\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u043C\u043E\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u044F\u0447\u0435\u0439\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0430\u0432\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435. \u0418\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u043E\u043D\u043E \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043E. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u044F\u0447\u0435\u0439\u043A\u0443 \u0432 <link=\"help:buffs\"><u><color=#EFB889>\u041E\u0431\u0437\u043E\u0440 \u2192 \u0423\u0441\u0438\u043B\u0435\u043D\u0438\u044F</color></u></link>, \u0447\u0442\u043E\u0431\u044B \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0438\u043B\u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0435\u0433\u043E.\n\n<link=\"help:cauldron\"><u><color=#EFB889>\u041A\u043E\u0442\u0451\u043B</color></u></link> \u0415\u0432\u044B \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0443 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 492340396032
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432 \u0431\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0438 \u043B\u0438\u0448\u044C \u0441 \u0432\u0440\u0430\u0433\u0430\u043C\u0438 \u043D\u0430 \u043F\u0443\u0442\u0438! \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u0435\u043B\u0430, \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F.\n\nD' = D \xD7 (1 - A / (A + N))\n\nD = \u0432\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0443\u0440\u043E\u043D\nA = \u0437\u0430\u0449\u0438\u0442\u0430 (\u043D\u0435 \u043D\u0438\u0436\u0435 0)\nN = \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439 \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442 \u0443\u0431\u044B\u0432\u0430\u044E\u0449\u0435\u0439 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 (\u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E = 25)\nD' = \u0438\u0442\u043E\u0433\u043E\u0432\u044B\u0439 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u043D\n\n10-\u0435, 100-\u0435, 1\_000-\u0435 \u0438 10\_000-\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0433\u043E \u0432\u0440\u0430\u0433\u0430 \u0434\u0430\u0451\u0442 25\_% \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0435\u0433\u043E.\n25\_000-\u0435 \u0438 100\_000-\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0433\u043E \u0432\u0440\u0430\u0433\u0430 \u0434\u0430\u0451\u0442 50\_% \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 512217202688
    m_Localized: "\u042D\u0445\u043E \u2014 \u0432\u0435\u0440\u0441\u0438\u0438 \u0432\u0430\u0448\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u044F \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0435\u0439. \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u0432\u043E\u0439 \u043D\u0430\u0431\u043E\u0440 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439.\n\n\u0411\u043E\u0435\u0432\u044B\u0435 \u044D\u0445\u043E \u0438\u0449\u0443\u0442 \u0432\u0440\u0430\u0433\u043E\u0432. \u042D\u0445\u043E, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0438 \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F, \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438 \u0432\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0432 \u0431\u043E\u0439 \u043F\u0440\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0435 \u0441 \u0432\u0440\u0430\u0433\u043E\u043C. \u042D\u0445\u043E, \u043D\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0435 \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F, \u043D\u0435 \u0430\u0442\u0430\u043A\u0443\u044E\u0442 \u0438 \u043D\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u044E\u0442 \u0432\u0440\u0430\u0433\u043E\u0432.\n\n\u042D\u0445\u043E, \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u043D\u0430 \u0440\u0443\u0431\u0435\u0436\u0430\u0445 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u043D\u0430\u0432\u044B\u043A\u0430, \u0438\u0449\u0443\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u044D\u0442\u043E\u0433\u043E \u043D\u0430\u0432\u044B\u043A\u0430. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u044D\u0445\u043E \u0440\u0443\u0431\u043A\u0438 \u043B\u0435\u0441\u0430 \u0438\u0449\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0440\u0443\u0431\u043A\u0438 \u043B\u0435\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 532437942272
    m_Localized: "\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0445\u043E\u0434\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u0432 \u0433\u043E\u0440\u043E\u0434, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C. \u041A\u0430\u0436\u0434\u043E\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 2\_% \u043A \u0431\u043E\u043D\u0443\u0441\u0443 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0437\u0430 \u043E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435; \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0435.\n\n\u0415\u0441\u043B\u0438 \u0437\u0430\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0431\u043E\u044F, \u0433\u0435\u0440\u043E\u0439 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442 \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u0435.\n\n\u0411\u043E\u043D\u0443\u0441 \u0432\u044B\u0434\u0430\u0451\u0442\u0441\u044F, \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0432\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0436\u0438\u0432\u044B\u043C. \u0421\u043C\u0435\u0440\u0442\u044C \u0438\u043B\u0438 \u0436\u0430\u0442\u0432\u0430 \u043B\u0438\u0448\u0430\u044E\u0442 \u0435\u0433\u043E, \u043D\u043E \u0443\u0436\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 698595295232
    m_Localized: "\u0413\u0435\u0440\u043E\u0439 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u044B. \u0411\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043D\u0430\u0432\u044B\u043A\u0430 \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435.\n\n\u0423 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0435\u0441\u0442\u044C \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u0438 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F. \u0417\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435\u043C \u0432\u0435\u0441 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0430 90\_%. \u0415\u0441\u043B\u0438 \u0432\u0441\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0443\u0436\u0435 \u0437\u0430 \u0441\u0432\u043E\u0438\u043C\u0438 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438, \u0438\u0445 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0432\u0435\u0441\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0442 \u0447\u0430\u0441\u0442\u043E\u0442\u0443 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 505754247643136
    m_Localized: "\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0437\u0430\u0442\u0435\u043C \u0441\u0434\u0430\u0439\u0442\u0435 \u0435\u0433\u043E \u0432 \u0433\u043E\u0440\u043E\u0434\u0435.\n\n<b>\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F:</b> \u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0438\u043B\u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0441\u044E\u0436\u0435\u0442 \u0438\u043B\u0438 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435.\n<b>\u0421\u0431\u043E\u0440:</b> \u041F\u0440\u0438\u043D\u0435\u0441\u0438\u0442\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B. \u041F\u0440\u0438 \u0441\u0434\u0430\u0447\u0435 \u043E\u043D\u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u044E\u0442\u0441\u044F.\n<b>\u0423\u0431\u0438\u0439\u0441\u0442\u0432\u0430:</b> \u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435 \u043D\u0443\u0436\u043D\u044B\u0445 \u0432\u0440\u0430\u0433\u043E\u0432, \u0437\u0430\u0442\u0435\u043C \u0434\u043E\u043B\u043E\u0436\u0438\u0442\u0435 \u043E\u0431 \u044D\u0442\u043E\u043C.\n<b>\u0412\u0441\u0442\u0440\u0435\u0447\u0430:</b> \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0433\u043E NPC \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u0441 \u043D\u0438\u043C. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u0433\u043E \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 3785742338113536
    m_Localized: "\u041A\u0430\u0440\u043B \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043F\u043E\u0445\u043E\u0434, \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0435 \u043F\u0440\u0435\u0434\u0435\u043B\u0430 \u043A\u0430\u0440\u0442\u044B. \u041F\u0440\u0435\u0434\u0435\u043B\u044B \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0432 <link=\"help:statistics/general\"><u><color=#EFB889>\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430 \u2192 \u041E\u0431\u0449\u0435\u0435</color></u></link>.\n\n\u0416\u0430\u0442\u0432\u0430 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043D\u0430 1\_% \u043D\u0430 \u0420\u0435\u043A\u0435, \u0432 \u041B\u0435\u0441\u0443 \u0438 \u0432 \u0428\u0430\u0445\u0442\u0430\u0445. \u0421\u0435\u043B\u044C\u0445\u043E\u0437\u0443\u0433\u043E\u0434\u044C\u044F \u043D\u0435 \u0434\u0430\u044E\u0442 \u043F\u0440\u0438\u0431\u0430\u0432\u043A\u0438. \u041D\u0430 \u041B\u043E\u0449\u0438\u043D\u0435 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0432\u0440\u0430\u0433\u043E\u0432 \u0440\u0430\u0441\u0442\u0451\u0442 \u0441 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430\u043C\u0438, \u0438 \u043B\u0438\u043C\u0438\u0442\u0430 \u0443\u0431\u0438\u0439\u0441\u0442\u0432 \u043D\u0435\u0442. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0442\u0430\u043A\u0436\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442 \u043F\u0440\u0435\u0434\u0435\u043B \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F."
