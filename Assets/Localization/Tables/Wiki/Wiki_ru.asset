  - m_Id: 164580255232299028
    m_Localized: "\u041A\u0443\u0437\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299029
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0441 \u0418\u0432\u0430\u043D\u043E\u043C \u043E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 <link=\"help:forge\"><u><color=#EFB889>\u0413\u043E\u0440\u043E\u0434 \u2192 \u041A\u0443\u0437\u043D\u0438\u0446\u0430</color></u></link>.\n\n1. \u041F\u0435\u0440\u0435\u043F\u043B\u0430\u0432\u044C\u0442\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0432 \u0441\u043B\u0438\u0442\u043A\u0438.\n2. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u044F\u0434\u0440\u043E, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0449\u0435\u0435 \u0448\u0430\u043D\u0441\u044B \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u0438 \u0438 \u0440\u0430\u0441\u0445\u043E\u0434 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432.\n3. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u044F\u0447\u0435\u0439\u043A\u0443 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F, \u0437\u0430\u0442\u0435\u043C \xAB\u041A\u043E\u0432\u0430\u0442\u044C\xBB. \u041A\u0430\u0436\u0434\u0430\u044F \u043A\u043E\u0432\u043A\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u0441\u043B\u0438\u0442\u043A\u0438 \u0438 \u043E\u0434\u043D\u043E \u044F\u0434\u0440\u043E.\n4. \u0421\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442. \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041D\u0430\u0434\u0435\u0442\u044C\xBB, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0442\u0435\u043A\u0443\u0449\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442.\n\n\u0412\u043D\u0435 \u0443\u0440\u043E\u043A\u0430 \u0418\u0432\u0430\u043D\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043D\u0430\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438, \u0435\u0441\u043B\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F \u044F\u0447\u0435\u0439\u043A\u0430 \u043F\u0443\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299030
    m_Localized: "<b>\u0420\u0430\u0437\u0431\u043e\u0440</b>\n\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043a\u043e\u0432\u0430\u0442\u044c \u0441\u043d\u043e\u0432\u0430 \u0438\u043b\u0438 \u043c\u0435\u043d\u044f\u0442\u044c \u044f\u0447\u0435\u0439\u043a\u0443: \u043e\u0431\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044e\u0442 \u043d\u0435\u043d\u0430\u0434\u0435\u0442\u044b\u0439 \u043f\u0440\u0435\u0434\u043c\u0435\u0442.\n\n<b>\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044f \u2014 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e <link=\"help:forge\"><u><color=#EFB889>\u041a\u0443\u0437\u043d\u0438\u0446\u044b</color></u></link> \u0443\u0440\u043e\u0432\u043d\u044f 3</b>\n\u00ab\u041f\u043e\u0432\u0442\u043e\u0440\u044f\u0442\u044c \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435\u00bb \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u043a\u043e\u0432\u043a\u0443, \u0440\u0430\u0441\u0445\u043e\u0434\u0443\u044f \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b \u043f\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u0439 \u043f\u043e\u043f\u044b\u0442\u043a\u0435.\n\n\u00ab\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u0432\u0430\u0442\u0440\u0438\u0443\u043c\u0435\u00bb \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043a\u043e\u0432\u043a\u0443 \u043f\u0440\u0438 \u043b\u044e\u0431\u043e\u043c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0435 \u0438\u0437 \u0432\u0430\u0442\u0440\u0438\u0443\u043c\u0430, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u043e\u043d \u0445\u0443\u0436\u0435.\n\n\u041f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u043e\u043c \u00ab\u0421\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u00bb \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u0442\u0430\u043a\u0436\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0438\u043c\u0435\u0442\u044c \u0442\u0435 \u0436\u0435 \u0442\u0438\u043f\u044b \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a, \u0447\u0442\u043e \u0438 \u043d\u0430\u0434\u0435\u0442\u044b\u0439 \u043f\u0440\u0435\u0434\u043c\u0435\u0442. \u0422\u043e\u043b\u044c\u043a\u043e \u0442\u043e\u0433\u0434\u0430 \u043a\u043e\u0432\u043a\u0430 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f.\n\n\u0423\u0441\u043b\u043e\u0432\u0438\u044f \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f \u044f\u0434\u0435\u0440 \u0438 \u043a\u0440\u0438\u0441\u0442\u0430\u043b\u043b\u043e\u0432 \u0443\u043a\u0430\u0437\u0430\u043d\u044b \u0432 <link=\"help:skills/Combat\"><u><color=#EFB889>\u041e\u0431\u0437\u043e\u0440 \u2192 \u041d\u0430\u0432\u044b\u043a\u0438 \u2192 \u0411\u043e\u0439</color></u></link>."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299031
    m_Localized: "\u0423\u0441\u0438\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299032
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0437\u043D\u0430\u0447\u043E\u043A \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0433\u043E \u0442\u0435\u043A\u0443\u0449\u0438\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B, \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0443. \u042D\u0442\u0438 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044E\u0442 \u0432\u0430\u0448\u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F.\n\n\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 <link=\"help:buffs\"><u><color=#EFB889>\u041E\u0431\u0437\u043E\u0440 \u2192 \u0423\u0441\u0438\u043B\u0435\u043D\u0438\u044F</color></u></link>, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0437\u043D\u0430\u0447\u0438\u0442\u044C \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F \u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0430\u0432\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435. \u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u043C\u043E\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u044F\u0447\u0435\u0439\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0430\u0432\u0442\u043E\u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u043D\u0435\u0451.\n\n<link=\"help:buffs\"><u><color=#EFB889>\u0423\u0441\u0438\u043B\u0435\u043D\u0438\u044F</color></u></link> \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u043E \u0438\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u0438 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438\u043B\u0438 \u043F\u0440\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299033
    m_Localized: "<link=\"help:cauldron\"><u><color=#EFB889>\u041A\u043E\u0442\u0451\u043B</color></u></link> \u0415\u0432\u044B \u0434\u0430\u0451\u0442 \u043A\u0430\u0440\u0442\u044B \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0439, \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0449\u0438\u0435 \u0438\u0445 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C \u0438 \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u044E\u0449\u0438\u0435 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299034
    m_Localized: "\u041A\u043E\u0442\u0451\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299035
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 <link=\"help:cauldron\"><u><color=#EFB889>\u0413\u043E\u0440\u043E\u0434 \u2192 \u041A\u043E\u0442\u0451\u043B</color></u></link>. \u0421\u043C\u0435\u0448\u0430\u0439\u0442\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B \u0432 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0443, \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0451, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u044B. \u041F\u0435\u0440\u0435\u0434 \u043F\u0440\u043E\u0431\u043E\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0448\u0430\u043D\u0441\u044B \u043D\u0430\u0433\u0440\u0430\u0434.\n\n\u041A\u0430\u0440\u0442\u044B \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u043C\u043E\u0433\u043E \u0440\u0435\u0441\u0443\u0440\u0441\u0430. \u041A\u0430\u0440\u0442\u044B \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0439 \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F. \u0423\u0440\u043E\u0432\u043D\u0438 \u043A\u0430\u0440\u0442 \u0438 \u0443\u0440\u043E\u0432\u043D\u0438 \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u2014 \u0440\u0430\u0437\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299036
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438 \u0440\u0430\u0432\u0435\u043D \u043D\u0430\u0438\u043C\u0435\u043D\u044C\u0448\u0435\u043C\u0443 \u0443\u0440\u043E\u0432\u043D\u044E \u043A\u0430\u0440\u0442\u044B \u0441\u0440\u0435\u0434\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u044D\u0442\u043E\u0439 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438. \u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u0440\u0442\u043E\u0439 \u043D\u0443\u043B\u0435\u0432\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F.\n\n\u0411\u043E\u043D\u0443\u0441\u044B \u043A\u0430\u0440\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0438 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0439 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0434\u043E \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0430 \u0432 70\_%. \u041E\u043D\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043D\u0430 \u0441\u0431\u043E\u0440, \u0434\u043E\u0431\u044B\u0447\u0443 \u0441 \u0432\u0440\u0430\u0433\u043E\u0432 \u0438 \u0443\u0440\u043E\u0436\u0430\u0439 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u041E\u043D\u0438 \u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043D\u0430 \u043D\u0430\u0433\u0440\u0430\u0434\u044B, \u0441\u0435\u043C\u0435\u043D\u0430, \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u044B \u0438 \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F.\n\n\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0432\u0441\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0438 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0439, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0412\u0435\u0447\u043D\u044B\u0435 \u0434\u0430\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299037
    m_Localized: "\u042D\u0445\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299038
    m_Localized: "\u042D\u0445\u043E \u2014 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u043A\u043E\u043F\u0438\u0438 \u0432\u0430\u0448\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u044F, \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0449\u0438\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0438\u043B\u0438 \u0441\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u0435\u0441\u044F \u0441 \u0432\u0440\u0430\u0433\u0430\u043C\u0438.\n\n\u041C\u0438\u0440\u044B \u041E\u0440\u0438\u043D\u0430 \u0441\u0432\u044F\u0437\u0430\u043D\u044B \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439. \u0412\u0441\u043F\u043B\u0435\u0441\u043A\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u044D\u0445\u0443 \u0432\u0430\u0448\u0435\u0433\u043E \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C \u043C\u0435\u0436\u0434\u0443 \u043C\u0438\u0440\u0430\u043C\u0438 \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u0432\u0430\u043C. \u041F\u043E\u043C\u043E\u0449\u044C \u0433\u043E\u0440\u043E\u0436\u0430\u043D\u0430\u043C \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u0442\u044C \u044D\u0445\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E.\n\n\u042D\u0445\u043E, \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u043D\u0430 \u0440\u0443\u0431\u0435\u0436\u0430\u0445 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u043D\u0430\u0432\u044B\u043A\u0430, \u0438\u0449\u0443\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u044D\u0442\u043E\u0433\u043E \u043D\u0430\u0432\u044B\u043A\u0430. \u0420\u0443\u0431\u0435\u0436\u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0432 <link=\"help:skills\"><u><color=#EFB889>\u041E\u0431\u0437\u043E\u0440 \u2192 \u041D\u0430\u0432\u044B\u043A\u0438</color></u></link>, \u0430 \u044D\u0444\u0444\u0435\u043A\u0442\u044B \u043F\u0440\u0438\u0437\u044B\u0432\u0430 \u2014 \u0432 <link=\"help:buffs\"><u><color=#EFB889>\u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0438 \u043F\u0440\u0438\u0437\u044B\u0432\u0430</color></u></link>."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299039
    m_Localized: "\u042D\u0445\u043E, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0438 \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F, \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0438 \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432 \u0431\u043E\u0439 \u043F\u0440\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0435 \u0441 \u0432\u0440\u0430\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299040
    m_Localized: "\u0423\u0440\u043E\u0432\u043D\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299041
    m_Localized: "\u0421\u0431\u043E\u0440 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0430, \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E.\n\n\u0423\u0440\u043E\u0436\u0430\u0439 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0431\u043E\u043D\u0443\u0441 \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F, \u043D\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0432\u044B\u0448\u0430\u0442\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C.\n\n\u041F\u0430\u043A\u0435\u0442\u044B \u0441\u0435\u043C\u044F\u043D \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0443\u0440\u043E\u0432\u043D\u0438 \u0438 \u0431\u043E\u043D\u0443\u0441\u044B \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u0438.\n\n\u0423\u0440\u043E\u0432\u043D\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432, \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F \u0438 \u0443\u0440\u043E\u0432\u043D\u0438 \u043A\u0430\u0440\u0442 <link=\"help:cauldron\"><u><color=#EFB889>\u041A\u043E\u0442\u043B\u0430</color></u></link> \u2014 \u0440\u0430\u0437\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299042
    m_Localized: "\u0420\u0435\u0441\u0443\u0440\u0441\u044B \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0441 \u0443\u0440\u043E\u0432\u043D\u044F 1. \u041A\u0430\u0436\u0434\u044B\u0439 \u0448\u0430\u043D\u0441 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u0441\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E \u0440\u0435\u0441\u0443\u0440\u0441\u0430 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F."
