  - m_Id: 167163636583370780
    m_Localized: "\u041F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u044C\u0441\u044F \u0441 \u0424\u043B\u043E\u0440\u043E\u0439 \u0438 \u0422\u0438\u043B\u043B\u043C\u0430\u043D\u043E\u043C \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0439 \u0438\u0445 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0443\u0447\u0430\u0441\u0442\u043A\u0438. \u0414\u043B\u044F \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0439 \u043D\u0443\u0436\u043D\u044B \u0443\u0440\u043E\u0432\u043D\u0438 \u041F\u043E\u043B\u0435\u0439 \u0438 \u0441\u0442\u0440\u043E\u0439\u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B. \u0423\u0445\u0430\u0436\u0438\u0432\u0430\u0442\u044C \u0437\u0430 \u043F\u043E\u0441\u0430\u0434\u043A\u0430\u043C\u0438 \u043C\u043E\u0436\u043D\u043E \u0432 \u0440\u0430\u0437\u0434\u0435\u043B\u0435 \xAB\u0413\u043E\u0440\u043E\u0434 \u2192 \u041F\u043E\u043B\u044F\xBB.\n\n\u0414\u043B\u044F \u043F\u043E\u0441\u0430\u0434\u043A\u0438 \u043D\u0443\u0436\u043D\u044B \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u043F\u0430\u043A\u0435\u0442\u044B \u0441\u0435\u043C\u044F\u043D \u0438\u043B\u0438 \u0441\u0430\u0436\u0435\u043D\u0446\u044B. \u041A\u0430\u0436\u0434\u0430\u044F \u043F\u043E\u0441\u0430\u0434\u043A\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u043E\u0434\u0438\u043D \u043F\u0430\u043A\u0435\u0442 \u0438\u043B\u0438 \u0441\u0430\u0436\u0435\u043D\u0435\u0446.\n\n\u0423\u0440\u043E\u0436\u0430\u0439 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F, \u0444\u0440\u0443\u043A\u0442\u044B \u0438\u043B\u0438 \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0443 \u0438 \u043E\u043F\u044B\u0442 \u041F\u043E\u043B\u0435\u0439. \u0421 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0440\u0430\u0441\u0442\u0443\u0442 \u0443\u0440\u043E\u0436\u0430\u0439\u043D\u043E\u0441\u0442\u044C \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0440\u043E\u0441\u0442\u0430. \u041D\u0430\u0432\u044B\u043A\u0438 \u0441\u0431\u043E\u0440\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0442, \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u0430\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 167163636583370781
    m_Localized: "<b>\u041F\u0430\u043A\u0435\u0442\u044B \u0441\u0435\u043C\u044F\u043D</b>\n\u041A\u0430\u0436\u0434\u043E\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u043F\u043E \u0441\u0431\u043E\u0440\u0443 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F, \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0435 \u0433\u0435\u0440\u043E\u0435\u043C \u0438\u043B\u0438 \u042D\u0445\u043E\u043C, \u0441 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C\u044E 7% \u0434\u0430\u0451\u0442 \u043E\u0434\u0438\u043D \u043F\u0430\u043A\u0435\u0442 \u0441\u0435\u043C\u044F\u043D. \u0411\u043E\u043D\u0443\u0441\u044B \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u043D\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442 \u044D\u0442\u043E\u0442 \u0432\u044B\u0445\u043E\u0434. \u0423\u0440\u043E\u0436\u0430\u0439 \u0441 \u041F\u043E\u043B\u0435\u0439 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u0435\u043C\u0435\u043D\u0430.\n\n<b>\u041F\u043E\u043B\u0438\u0432</b>\n\u041F\u043E\u043B\u0438\u0432 \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u0440\u0435\u043C\u044F \u0440\u043E\u0441\u0442\u0430 \u0432\u0434\u0432\u043E\u0435.\n\n<b>\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044F</b>\n\u0421 \u0443\u0440\u043E\u0432\u043D\u044F \u041F\u043E\u043B\u0435\u0439 20 \u0440\u0435\u0436\u0438\u043C \xAB\u0410\u0432\u0442\u043E\xBB \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u0443\u0440\u043E\u0436\u0430\u0439 \u0438 \u0441\u0430\u0436\u0430\u0435\u0442 \u0437\u0430\u043D\u043E\u0432\u043E, \u043F\u043E\u043A\u0430 \u0435\u0441\u0442\u044C \u043D\u0443\u0436\u043D\u044B\u0435 \u0441\u0435\u043C\u0435\u043D\u0430 \u0438\u043B\u0438 \u0441\u0430\u0436\u0435\u043D\u0446\u044B. \u0421 \u0443\u0440\u043E\u0432\u043D\u044F 50 \u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u0441\u0430\u0434\u043A\u0438 \u043F\u043E\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.\n\n<b>\u0414\u0435\u0440\u0435\u0432\u044C\u044F \u043D\u0430 \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0443</b>\n\u0420\u0443\u0431\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430 \u0438\u043B\u0438 \u0432\u044B\u0431\u0435\u0440\u0438 \xAB\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0440\u043E\u0441\u0442\xBB: \u043E\u0431\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0440\u043E\u0441\u0442\u0430, \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0438 \u043E\u043F\u044B\u0442 \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u044E\u0442\u0441\u044F. \xAB\u0410\u0432\u0442\u043E\xBB \u0436\u0434\u0451\u0442 \u043F\u043E\u043B\u043D\u043E\u0433\u043E \u0440\u043E\u0441\u0442\u0430 \u043F\u0435\u0440\u0435\u0434 \u0440\u0443\u0431\u043A\u043E\u0439.\n\n<b>\u0420\u043E\u0441\u0442</b>\n\u041F\u043E\u043B\u044F \u0440\u0430\u0441\u0442\u0443\u0442 \u0438 \u0432 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F\u0445, \u0438 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u041F\u0440\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439 \u0438\u0433\u0440\u0435 \u0440\u043E\u0441\u0442 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
