  - m_Id: 478381752320
    m_Localized: "<link=\"help:buffs\"><u><color=#EFB889>\u30D0\u30D5</color></u></link>\u306F\u4E00\u6642\u7684\u306A\u529B\u3067\u3059\u3002\u6301\u7D9A\u6642\u9593\u304C\u5207\u308C\u308B\u304B\u3001\u753A\u306B\u623B\u308B\u3068\u7D42\u4E86\u3057\u307E\u3059\u3002\n\n\u30B9\u30ED\u30C3\u30C8\u3054\u3068\u306E\u6307\u5B9A\u30AF\u30A8\u30B9\u30C8\u3092\u9054\u6210\u3059\u308B\u3068\u3001\u81EA\u52D5\u767A\u52D5\u304C\u30AA\u30F3\u306E\u72B6\u614B\u3067\u958B\u653E\u3055\u308C\u307E\u3059\u3002<link=\"help:buffs\"><u><color=#EFB889>\u62E0\u70B9 \u2192 \u30D0\u30D5</color></u></link>\u3067\u305D\u306E\u30B9\u30ED\u30C3\u30C8\u3092\u9078\u3076\u3068\u3001\u30AA\u30F3\u30FB\u30AA\u30D5\u3092\u5207\u308A\u66FF\u3048\u3089\u308C\u307E\u3059\u3002\n\n\u30A8\u30F4\u30A1\u306E<link=\"help:cauldron\"><u><color=#EFB889>\u5927\u91DC</color></u></link>\u3067\u3001\u30D0\u30D5\u306E\u30AF\u30FC\u30EB\u30C0\u30A6\u30F3\u3092\u77ED\u7E2E\u3067\u304D\u307E\u3059\u3002"
