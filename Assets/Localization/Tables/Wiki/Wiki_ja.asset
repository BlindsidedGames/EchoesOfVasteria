    m_Localized: "<b><link=\"help:cauldron\"><u><color=#EFB889>\u5927\u91DC</color></u></link></b>\n\u98DF\u6599\u3068\u6295\u5165\u91CF\u3092\u9078\u3073\u3001\u30B7\u30C1\u30E5\u30FC\u306B\u6DF7\u305C\u307E\u3057\u3087\u3046\u3002\u5473\u898B\u3059\u308B\u3068\u3001\u8868\u793A\u3055\u308C\u305F\u78BA\u7387\u3067\u30AB\u30FC\u30C9\u3092\u7372\u5F97\u3067\u304D\u307E\u3059\u3002\u8CC7\u6E90\u30AB\u30FC\u30C9\u306F\u63A1\u96C6\u91CF\u3092\u5897\u3084\u3057\u3001\u30D0\u30D5\u30AB\u30FC\u30C9\u306F\u30D0\u30D5\u3092\u5F37\u5316\u3057\u307E\u3059\u3002\n\n\u8CC7\u6E90\u30AB\u30FC\u30C9\u3068\u30AB\u30C6\u30B4\u30EA\u30FC\u306E\u6BB5\u968E\u6761\u4EF6\u306F<link=\"help:reference\"><u><color=#EFB889>\u53C2\u8003\u8CC7\u6599</color></u></link>\u3067\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
