  - m_Id: 492340396032
    m_Localized: "\u3042\u306A\u305F\u306E\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306F\u81EA\u52D5\u7684\u306B\u6226\u95D8\u306B\u5165\u308A\u3001\u884C\u304F\u624B\u3092\u963B\u3080\u6575\u3068\u3060\u3051\u6226\u3044\u307E\u3059\uFF01\u307E\u305A\u306F\u4F5C\u696D\u3001\u304A\u697D\u3057\u307F\u306F\u305D\u306E\u3042\u3068\u3002\n\nD' = D \xD7 (1 - A / (A + N))\n\nD = \u53D7\u3051\u308B\u30C0\u30E1\u30FC\u30B8\nA = \u9632\u5FA1\u529B (0\u4EE5\u4E0A\u306B\u5236\u9650)\nN = \u52B9\u679C\u306E\u9013\u6E1B\u3092\u8ABF\u6574\u3059\u308B\u5B9A\u6570 (\u521D\u671F\u5024 = 25)\nD' = \u6700\u7D42\u7684\u306A\u88AB\u30C0\u30E1\u30FC\u30B8\n\n\u7279\u5B9A\u306E\u6575\u306E\u8A0E\u4F10\u6570\u304C10\u3001100\u30011,000\u300110,000\u306B\u9054\u3059\u308B\u305F\u3073\u3001\u305D\u306E\u6575\u306B\u4E0E\u3048\u308B\u30C0\u30E1\u30FC\u30B8\u306B25%\u306E\u30DC\u30FC\u30CA\u30B9\u3092\u5F97\u307E\u3059\u3002\n\u7279\u5B9A\u306E\u6575\u306E\u8A0E\u4F10\u6570\u304C25,000\u3001100,000\u306B\u9054\u3059\u308B\u305F\u3073\u3001\u305D\u306E\u6575\u306B\u4E0E\u3048\u308B\u30C0\u30E1\u30FC\u30B8\u306B50%\u306E\u30DC\u30FC\u30CA\u30B9\u3092\u5F97\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 512217202688
    m_Localized: "\u30A8\u30B3\u30FC\u306F\u5225\u306E\u73FE\u5B9F\u306B\u3044\u308B\u4E3B\u4EBA\u516C\u306E\u59FF\u3067\u3059\u3002\u305D\u308C\u305E\u308C\u7570\u306A\u308B\u80FD\u529B\u3092\u6301\u3063\u3066\u3044\u307E\u3059\u3002\n\n\u6226\u95D8\u5C02\u7528\u306E\u30A8\u30B3\u30FC\u306F\u6575\u3092\u63A2\u3057\u307E\u3059\u3002\u63A1\u96C6\u3068\u6226\u95D8\u306E\u4E21\u65B9\u304C\u3067\u304D\u308B\u30A8\u30B3\u30FC\u306F\u4F5C\u696D\u3092\u512A\u5148\u3057\u3001\u4EA4\u6226\u3059\u308B\u3068\u6226\u3044\u307E\u3059\u3002\u6226\u3048\u306A\u3044\u30A8\u30B3\u30FC\u306F\u6575\u3092\u653B\u6483\u3057\u305F\u308A\u5F15\u304D\u5BC4\u305B\u305F\u308A\u3057\u307E\u305B\u3093\u3002\n\n\u30B9\u30AD\u30EB\u306E\u7BC0\u76EE\u3067\u958B\u653E\u3055\u308C\u305F\u30A8\u30B3\u30FC\u306F\u3001\u305D\u306E\u30B9\u30AD\u30EB\u306E\u4F5C\u696D\u3092\u63A2\u3057\u307E\u3059\u3002\u305F\u3068\u3048\u3070\u3001\u4F10\u63A1\u306E\u30A8\u30B3\u30FC\u306F\u4F10\u63A1\u306E\u4F5C\u696D\u3092\u63A2\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 532437942272
    m_Localized: "\u5192\u967A\u4E2D\u306B\u753A\u3078\u623B\u308B\u64CD\u4F5C\u3092\u3059\u308B\u3068\u64A4\u9000\u3057\u307E\u3059\u3002\u8A0E\u4F101\u4F53\u306B\u3064\u304D\u64A4\u9000\u6642\u306E\u8CC7\u6E90\u30DC\u30FC\u30CA\u30B9\u304C2%\u5897\u3048\u3001\u5E30\u9084\u30DC\u30BF\u30F3\u306B\u8868\u793A\u3055\u308C\u307E\u3059\u3002\n\n\u6226\u95D8\u4E2D\u306B\u5E30\u9084\u3092\u6307\u793A\u3057\u305F\u5834\u5408\u306F\u3001\u305D\u306E\u6226\u95D8\u3092\u7D42\u3048\u3066\u304B\u3089\u623B\u308A\u307E\u3059\u3002\n\n\u3053\u306E\u30DC\u30FC\u30CA\u30B9\u3092\u5F97\u3089\u308C\u308B\u306E\u306F\u3001\u751F\u304D\u3066\u5E30\u9084\u3057\u305F\u5834\u5408\u3060\u3051\u3067\u3059\u3002\u6B7B\u4EA1\u3057\u305F\u308A\u9B42\u3092\u5208\u3089\u308C\u305F\u308A\u3059\u308B\u3068\u5931\u308F\u308C\u307E\u3059\u304C\u3001\u3059\u3067\u306B\u96C6\u3081\u305F\u8CC7\u6E90\u306F\u6B8B\u308A\u307E\u3059\u3002"
