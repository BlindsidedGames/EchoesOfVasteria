  - m_Id: 164590655378165760
    m_Localized: "<b>\u30d0\u30fc\u30b8\u30e7\u30f31.5.3</b>\n\n\u2022 \u30af\u30a8\u30b9\u30c8\u306b\u300c\u7c21\u7565\u300d\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\u3002\u8aac\u660e\u6587\u3092\u975e\u8868\u793a\u306b\u3067\u304d\u3001\u9078\u629e\u306f\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\n\u2022 \u6a2a\u753b\u9762\u3067\u306f\u3001\u5e45\u306b\u5fdc\u3058\u3066\u30af\u30a8\u30b9\u30c8\u304c\u8907\u6570\u5217\u3067\u4e26\u3073\u307e\u3059\u3002\u7e26\u753b\u9762\u30fb\u6a2a\u753b\u9762\u3068\u3082\u306b\u3001\u6761\u4ef6\u3092\u6a2a\u306b\u4e26\u3079\u3066\u8868\u793a\u3067\u304d\u307e\u3059\u3002\n\u2022 \u5831\u916c\u3092\u6761\u4ef6\u306e\u4e0a\u306b\u8868\u793a\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u305f\u3002\u5831\u544a\u3067\u304d\u308b\u30af\u30a8\u30b9\u30c8\u306f\u540d\u524d\u306e\u6a2a\u306b\u300c\u5831\u544a\u300d\u3092\u8868\u793a\u3057\u3001\u6d88\u8cbb\u3059\u308b\u30a2\u30a4\u30c6\u30e0\u306f\u9032\u884c\u30d0\u30fc\u3092\u7701\u3044\u3066\u8868\u793a\u3057\u307e\u3059\u3002\n\u2022 \u30d4\u30f3\u3092\u540d\u524d\u306b\u8fd1\u3065\u3051\u307e\u3057\u305f\u3002\u30d4\u30f3\u7559\u3081\u4e2d\u306f\u7e26\u5411\u304d\u3001\u305d\u308c\u4ee5\u5916\u306f\u659c\u3081\u5411\u304d\u306b\u306a\u308a\u307e\u3059\u3002\n\u2022 \u30af\u30a8\u30b9\u30c8\u9593\u306e\u533a\u5207\u308a\u7dda\u3092\u306a\u304f\u3057\u3001\u898b\u51fa\u3057\u3084\u30dc\u30bf\u30f3\u5468\u308a\u306e\u9593\u9694\u3092\u8abf\u6574\u3057\u307e\u3057\u305f\u3002\n\u2022 Android\u3068Steam\u3067\u30b7\u30e7\u30c3\u30d7\u304c\u5229\u7528\u4e0d\u53ef\u306b\u306a\u308b\u4e0d\u5177\u5408\u3092\u4fee\u6b63\u3057\u307e\u3057\u305f\u3002\n\u2022 Steam\u306e\u4fa1\u683c\u306b\u901a\u8ca8\u8a18\u53f7\u3068\u6b63\u3057\u3044\u5c0f\u6570\u6841\u6570\u3092\u8868\u793a\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u305f\u3002\n\u2022 \u6a2a\u753b\u9762\u304b\u3089\u7e26\u753b\u9762\u306b\u5207\u308a\u66ff\u3048\u308b\u3068\u3001\u5192\u967a\u753b\u9762\u304c\u9ed2\u304f\u306a\u3063\u305f\u308a\u3001\u305a\u308c\u305f\u308a\u3059\u308b\u4e0d\u5177\u5408\u3092\u4fee\u6b63\u3057\u307e\u3057\u305f\u3002\n\u2022 \u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u4e2d\u3082\u8a2d\u5b9a\u3092\u958b\u3044\u3066\u8868\u793a\u30c6\u30fc\u30de\u3092\u5909\u66f4\u3067\u304d\u3001\u540c\u3058\u3068\u3053\u308d\u304b\u3089\u7d9a\u3051\u3089\u308c\u307e\u3059\u3002\n\u2022 \u30e9\u30a4\u30c8\u30e2\u30fc\u30c9\u3067\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u5185\u306e\u30ea\u30f3\u30af\u304c\u8aad\u307f\u3084\u3059\u304f\u306a\u308a\u307e\u3057\u305f\u3002\n\u2022 Discord\u306e\u30ed\u30b4\u304c\u3001\u4e21\u30c6\u30fc\u30de\u3067HUD\u306e\u6587\u5b57\u3068\u540c\u3058\u8272\u306b\u306a\u308a\u307e\u3057\u305f\u3002\n\n<b>\u30d0\u30fc\u30b8\u30e7\u30f31.5.2</b>\n\n\u2022 \u8cc7\u6e90\u500d\u7387\u304c\u6b7b\u4ea1\u5f8c\u3084\u6b21\u306e\u5192\u967a\u306b\u3082\u5f15\u304d\u7d99\u304c\u308c\u3001\u753a\u306b\u623b\u308b\u307e\u3067\u7dad\u6301\u3055\u308c\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u4e0a\u9650\u306f10\u500d\u3067\u3059\u3002\n\u2022 \u98df\u6750\u304b\u3089\u4f5c\u308c\u308b\u30b7\u30c1\u30e5\u30fc\u304c\u5897\u3048\u307e\u3057\u305f\u3002\u4fa1\u5024\u306e\u9ad8\u3044\u98df\u6750\u307b\u3069\u5897\u52a0\u91cf\u304c\u5927\u304d\u304f\u306a\u308a\u307e\u3059\u3002\n\u2022 \u9d8f\u8089\u30fb\u8c5a\u8089\u30fb\u7f8a\u8089\u30fb\u30b9\u30c6\u30fc\u30ad\u304b\u3089\u5f97\u3089\u308c\u308b\u30b7\u30c1\u30e5\u30fc\u304c50%\u5897\u3048\u307e\u3057\u305f\u3002\n\u2022 \u5927\u91dc\u306b\u300c\u3059\u3079\u3066\u6df7\u305c\u308b\u300d\u304c\u623b\u308a\u3001\u4f5c\u308c\u308b\u30b7\u30c1\u30e5\u30fc\u306e\u91cf\u3092\u78ba\u8a8d\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u98df\u6750\u3054\u3068\u306b\u9078\u3093\u3060\u6295\u5165\u91cf\u3082\u8a18\u61b6\u3057\u307e\u3059\u3002\n\u2022 \u935b\u51b6\u5834\u306b\u300c\u505c\u6b62\u3057\u306a\u3044\u300d\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\u3002\u4ed6\u306e\u505c\u6b62\u6761\u4ef6\u3092\u7121\u8996\u3057\u3001\u6750\u6599\u304c\u3042\u308b\u9650\u308a\u88fd\u4f5c\u3092\u7d9a\u3051\u307e\u3059\u3002\n\u2022 \u4e3b\u4eba\u516c\u3068\u30a8\u30b3\u30fc\u304c\u7a2e\u3084\u82d7\u6728\u3092\u898b\u3064\u3051\u308b\u78ba\u7387\u3092\u7d71\u4e00\u3057\u307e\u3057\u305f\u3002\u5f8c\u534a\u306e\u54c1\u7a2e\u307b\u3069\u51fa\u306b\u304f\u304f\u306a\u308a\u3001\u4f5c\u7269\u30fb\u679c\u6a39\u30fb\u6728\u6750\u7528\u306e\u6728\u306f\u305d\u308c\u305e\u308c\u5225\u306b\u78ba\u7387\u304c\u4e0b\u304c\u308a\u307e\u3059\u3002\n\u2022 \u30af\u30a8\u30b9\u30c8\u306f\u753a\u3067\u306e\u307f\u5831\u544a\u3067\u304d\u307e\u3059\u3002\n\u2022 \u5c0f\u3055\u306a\u6587\u5b57\u3092\u5927\u304d\u304f\u3057\u307e\u3057\u305f\u3002\u7279\u306b\u30af\u30a8\u30b9\u30c8\u753b\u9762\u3092\u8aad\u307f\u3084\u3059\u304f\u3057\u3066\u3044\u307e\u3059\u3002\n\u2022 \u7a2e\u888b\u3092\u542b\u3080\u30af\u30a8\u30b9\u30c8\u5831\u916c\u306e\u30a2\u30a4\u30b3\u30f3\u3092\u7d71\u4e00\u3057\u307e\u3057\u305f\u3002\u5927\u304d\u3059\u304e\u305f\u82d7\u6728\u30a2\u30a4\u30b3\u30f3\u3092\u7e2e\u5c0f\u3057\u3001\u7551\u306e\u753b\u50cf\u306e\u9699\u9593\u3092\u4fee\u6b63\u3057\u307e\u3057\u305f\u3002\n\u2022 \u5192\u967a\u7d50\u679c\u3068\u8cc7\u6e90\u4e00\u89a7\u306b\u3001\u30b3\u30f3\u30d1\u30af\u30c8\u306a\u6570\u5024\u8868\u793a\u30fb\u5e30\u9084\u6642\u306e\u5408\u8a08\u30fb\u8cc7\u6e90\u30dc\u30fc\u30ca\u30b9\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\u3002\u6a2a\u753b\u9762\u3067\u306f\u4e00\u89a7\u30922\uff5e3\u5217\u3067\u8868\u793a\u3057\u307e\u3059\u3002\n\u2022 \u753a\u3092\u96e2\u308c\u3066\u3044\u308b\u6642\u9593\u306b\u5fdc\u3058\u3066\u61d0\u4e2d\u6642\u8a08\u306e\u6bb5\u968e\u304c\u5909\u308f\u308a\u3001\u8cc7\u6e90\u306e\u5408\u8a08\u304c\u5897\u3048\u308b\u3068\u5b9d\u7bb1\u306e\u6bb5\u968e\u3082\u5909\u308f\u308a\u307e\u3059\u3002\n\u2022 \u7e26\u753b\u9762\u306e\u30af\u30a8\u30b9\u30c8\u30fb\u8cc7\u6e90\u4e00\u89a7\u3092\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u3084\u3059\u304f\u3057\u3001\u4e0b\u90e8\u306e\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u3092\u64cd\u4f5c\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u305f\u3002\n\u2022 NPC\u3068\u306e\u906d\u9047\u6642\u306b\u540d\u524d\u3092\u8868\u793a\u3057\u307e\u3059\u3002\u5f85\u6a5f\u4e2d\u3082\u4f53\u529b\u30fb\u30b9\u30c6\u30fc\u30bf\u30b9\u30fb\u30a2\u30d3\u30ea\u30c6\u30a3\u30fb\u30ba\u30fc\u30e0\u64cd\u4f5c\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\n\u2022 \u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u62bc\u3059\u3079\u304d\u30dc\u30bf\u30f3\u304c\u7121\u52b9\u306b\u306a\u308b\u554f\u984c\u3092\u4fee\u6b63\u3057\u307e\u3057\u305f\u3002\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u3082\u624b\u9806\u3092\u9032\u3081\u3089\u308c\u3001\u6307\u793a\u306b\u5fdc\u3058\u3066\u958b\u3044\u3066\u3044\u308b\u30e1\u30cb\u30e5\u30fc\u306e\u30dc\u30bf\u30f3\u3067\u753b\u9762\u3092\u9589\u3058\u3089\u308c\u307e\u3059\u3002\n\u2022 \u30e9\u30a4\u30d6\u30e9\u30ea\u306f\u30c8\u30d4\u30c3\u30af\u4e00\u89a7\u304b\u3089\u958b\u304f\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u66f4\u65b0\u60c5\u5831\u306b\u65e5\u8a8c\u30a2\u30a4\u30b3\u30f3\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\u3002\n\u2022 \u30ed\u30c3\u30af\u3055\u308c\u305f\u30d0\u30d5\u67a0\u3092\u6587\u5b57\u3067\u306f\u306a\u304f\u9375\u30a2\u30a4\u30b3\u30f3\u3067\u8868\u793a\u3057\u307e\u3059\u3002\n\u2022 \u7ffb\u8a33\u3092\u7c21\u6f54\u306b\u4fee\u6b63\u3057\u3001\u7d20\u6750\u540d\u3092\u7d71\u4e00\u3057\u307e\u3057\u305f\u3002\n\u2022 \u8a66\u98df\u306f\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u305f\u3068\u304d\u3060\u3051\u59cb\u307e\u308a\u3001\u6700\u521d\u306e1\u56de\u306f\u3059\u3050\u306b\u884c\u308f\u308c\u307e\u3059\u3002\u6bce\u79d22\u56de\u304b\u3089\u3001\u30a8\u30f4\u30a1\u306e\u30ec\u30d9\u30eb12\u306710\u56de\u300142\u3067100\u56de\u306b\u5897\u3048\u307e\u3059\u3002\n\u2022 \u7e26\u753b\u9762\u3068\u6a2a\u753b\u9762\u306e\u5927\u91dc\u306e\u914d\u7f6e\u3092\u898b\u76f4\u3057\u307e\u3057\u305f\u3002\u30e2\u30d0\u30a4\u30eb\u3067\u306f\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u306e\u8a73\u7d30\u753b\u9762\u304c\u958b\u3044\u305f\u307e\u307e\u306b\u306a\u308a\u3001\u30ab\u30fc\u30c9\u3068\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u306e\u30dc\u30fc\u30ca\u30b9\u3001\u6b21\u306e\u5f37\u5316\u3092\u78ba\u8a8d\u3057\u3084\u3059\u304f\u306a\u308a\u307e\u3057\u305f\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164590655378165761
    m_Localized: "<b>\u4EE5\u524D\u306E\u66F4\u65B0</b>\n\n<b>\u5E8F\u76E4\u3068\u9032\u884C</b>\n\u2022 \u5E8F\u76E4\u306E\u30AF\u30A8\u30B9\u30C8\u3068NPC\u306E\u767B\u5834\u5834\u9762\u3092\u6539\u826F\u3057\u307E\u3057\u305F\u3002\n\u2022 \u30AE\u30EB\u304C\u5DDD\u3078\u3001\u30D0\u30FC\u30AF\u30EA\u30FC\u304C\u68EE\u3078\u6848\u5185\u3057\u307E\u3059\u3002\n\u2022 \u30AE\u30EB\u306E\u5831\u916C\u306B\u53E4\u3044\u30D6\u30FC\u30C4\u3092\u8FFD\u52A0\u3057\u307E\u3057\u305F\u3002\u30A4\u30F4\u30A1\u30F3\u306F\u6750\u6599\u3092\u6E21\u3057\u3001\u6700\u521D\u306E\u5263\u306E\u88FD\u4F5C\u3068\u88C5\u5099\u3092\u6559\u3048\u307E\u3059\u3002\n\u2022 \u30E1\u30CB\u30E5\u30FC\u3068\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u306F\u3001\u5404\u6A5F\u80FD\u304C\u5FC5\u8981\u306B\u306A\u308B\u3068\u8868\u793A\u3055\u308C\u307E\u3059\u3002\n\u2022 \u30AF\u30A8\u30B9\u30C8\u3092\u5831\u544A\u3067\u304D\u308B\u306E\u306F\u753A\u306B\u3044\u308B\u9593\u3060\u3051\u306B\u306A\u308A\u307E\u3057\u305F\u3002\n\n<b>\u30A4\u30F3\u30BF\u30FC\u30D5\u30A7\u30FC\u30B9</b>\n\u2022 \u5192\u967A\u306E\u7D50\u679C\u3092\u518D\u8A2D\u8A08\u3057\u3001\u5192\u967A\u4E2D\u306B\u4F7F\u3048\u308B\u5C0F\u578B\u306E\u80FD\u529B\u5024\u30D1\u30CD\u30EB\u3092\u8FFD\u52A0\u3057\u307E\u3057\u305F\u3002\n\u2022 \u6240\u6301\u54C1\u753B\u9762\u306B\u88C5\u5099\u4E2D\u306E\u30A2\u30A4\u30C6\u30E0\u3068\u88C5\u5099\u30DC\u30FC\u30CA\u30B9\u3092\u8868\u793A\u3057\u307E\u3059\u3002\n\u2022 \u30A4\u30F3\u30BF\u30FC\u30D5\u30A7\u30FC\u30B9\u5168\u4F53\u3067\u30C9\u30E9\u30C3\u30B0\u306B\u3088\u308B\u30B9\u30AF\u30ED\u30FC\u30EB\u306B\u5BFE\u5FDC\u3057\u307E\u3057\u305F\u3002\n\u2022 \u30E9\u30A4\u30D6\u30E9\u30EA\u3092\u4F5C\u308A\u76F4\u3057\u3001\u30C8\u30D4\u30C3\u30AF\u79FB\u52D5\u3001\u53C2\u7167\u8868\u3001\u9078\u629E\u3067\u304D\u308B\u30A2\u30A4\u30B3\u30F3\u306E\u8AAC\u660E\u3092\u8FFD\u52A0\u3057\u307E\u3057\u305F\u3002\n\n<b>\u30B2\u30FC\u30E0\u5185\u5BB9\u3068\u4FEE\u6B63</b>\n\u2022 \u6700\u521D\u306E\u8FB2\u5730\u3067\u306E\u5192\u967A\u3067\u3001\u4F5C\u696D\u306E\u5BC6\u5EA6\u3092\u4E0B\u3052\u307E\u3057\u305F\u3002\n\u2022 \u8FB2\u696D\u306E\u4F5C\u696D\u306F\u8FB2\u5730\u306B\u306E\u307F\u51FA\u73FE\u3057\u307E\u3059\u3002\n\u2022 \u30B3\u30A2\u3068\u7D50\u6676\u306E\u6BB5\u968E\u306F\u3001\u6226\u95D8\u30EC\u30D9\u30EB\u306B\u5FDC\u3058\u3066\u958B\u653E\u3055\u308C\u307E\u3059\u3002\n\u2022 \u6575\u306E\u4F53\u529B\u30D0\u30FC\u306E\u91CD\u306A\u308A\u3068\u91E3\u308A\u30A2\u30CB\u30E1\u30FC\u30B7\u30E7\u30F3\u306E\u554F\u984C\u3092\u4FEE\u6B63\u3057\u307E\u3057\u305F\u3002\n\u2022 \u30E9\u30F3\u30AD\u30F3\u30B0\u3092\u524A\u9664\u3057\u307E\u3057\u305F\u3002\n\n<b>\u904E\u53BB\u306E\u30D1\u30C3\u30C1\u30CE\u30FC\u30C8</b>\n\n\u2022 \u300C\u30B8\u30E3\u30E0\u306E\u305F\u3081\u306B\uFF01\u300D\u3068\u300C\u30AE\u30EB\u30F4\u30A1\u30FC\u65C5\u884C\u8A18\u300D\u3092\u8FFD\u52A0\u3057\u307E\u3057\u305F\u3002\n\u2022 \u5C0E\u5165\u30E1\u30C3\u30BB\u30FC\u30B8\u3092\u6539\u5584\u3057\u307E\u3057\u305F\u3002\n\u2022 \u30EC\u30D9\u30EB\u30A2\u30C3\u30D7\u901A\u77E5\u3067\u3001\u672C\u6765\u3088\u308A\u4F4E\u3044\u6570\u5024\u304C\u8868\u793A\u3055\u308C\u308B\u554F\u984C\u3092\u4FEE\u6B63\u3057\u307E\u3057\u305F\u3002\n\u2022 \u935B\u51B6\u5834\u306E\u300C\u88C5\u5099\u54C1\u8CEA\u300D\u6B04\u3092\u524A\u9664\u3057\u307E\u3057\u305F\u3002\n\u2022 \u30D4\u30F3\u7559\u3081\u3057\u305F\u30AF\u30A8\u30B9\u30C8\u3067\u3001\u300C\u5B8C\u4E86\u300D\u306E\u4EE3\u308F\u308A\u306B\u300C\u5831\u544A\u53EF\u80FD\u300D\u3092\u8868\u793A\u3057\u307E\u3059\u3002\n\u2022 \u30DE\u30C3\u30D7\u5207\u308A\u66FF\u3048\u6642\u306B\u8AAD\u307F\u8FBC\u307F\u753B\u9762\u3092\u8FFD\u52A0\u3057\u307E\u3057\u305F\u3002\n\u2022 \u5927\u91DC\u306B\u300C\u3059\u3079\u3066\u6DF7\u305C\u308B\u300D\u30DC\u30BF\u30F3\u3092\u8FFD\u52A0\u3057\u307E\u3057\u305F\u3002\n\u2022 \u7D4C\u8DEF\u63A2\u7D22\u30D1\u30C3\u30B1\u30FC\u30B8\u3092\u66F4\u65B0\u3057\u307E\u3057\u305F\u3002"
