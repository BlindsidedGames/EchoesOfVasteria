    m_Localized: "<b>\u5DDD\u30FB\u68EE\u30FB\u9271\u5C71</b>\n\u8DDD\u96E2\u306E\u4E0A\u9650\u3067\u30AB\u30FC\u30EB\u304C\u5192\u967A\u3092\u7D42\u308F\u3089\u305B\u307E\u3059\u3002\u305D\u306E\u4E0A\u9650\u3067\u9B42\u3092\u5208\u3089\u308C\u308B\u3068\u3001\u5171\u901A\u306E\u9B42\u5208\u308A\u8DDD\u96E2\u304C1%\u4F38\u3073\u307E\u3059\u3002\n\n<b>\u8FB2\u5730</b>\n\u8DDD\u96E2\u306E\u4E0A\u9650\u3067\u30AB\u30FC\u30EB\u304C\u5192\u967A\u3092\u7D42\u308F\u3089\u305B\u307E\u3059\u304C\u3001\u9B42\u3092\u5208\u3089\u308C\u3066\u3082\u8DDD\u96E2\u306F\u4F38\u3073\u307E\u305B\u3093\u3002\n\n<b>\u4E0D\u6C17\u5473\u306A\u5730</b>\n\u8A0E\u4F10\u6570\u306B\u5FDC\u3058\u3066\u6575\u306E\u30EC\u30D9\u30EB\u304C\u4E0A\u304C\u308A\u307E\u3059\u3002\u8A0E\u4F10\u6570\u306E\u4E0A\u9650\u3084\u8DDD\u96E2\u306B\u3088\u308B\u9B42\u5208\u308A\u306F\u3042\u308A\u307E\u305B\u3093\u3002\n\n\u5192\u967A\u304C\u7D42\u308F\u3063\u3066\u3082\u3001\u96C6\u3081\u305F\u8CC7\u6E90\u3068\u30B9\u30AD\u30EB\u306E\u9032\u6357\u306F\u6B8B\u308A\u307E\u3059\u3002\u753A\u306B\u623B\u3063\u3066\u30AF\u30A8\u30B9\u30C8\u3092\u5831\u544A\u3057\u3001<link=\"help:run-summary\"><u><color=#EFB889>\u5192\u967A\u306E\u7D50\u679C</color></u></link>\u3067\u7372\u5F97\u5185\u5BB9\u3092\u78BA\u8A8D\u3057\u307E\u3057\u3087\u3046\u3002\u30DE\u30C3\u30D7\u60C5\u5831\u306F<link=\"help:statistics/general\"><u><color=#EFB889>\u7D71\u8A08 \u2192 \u5168\u822C</color></u></link>\u306B\u3042\u308A\u307E\u3059\u3002"
