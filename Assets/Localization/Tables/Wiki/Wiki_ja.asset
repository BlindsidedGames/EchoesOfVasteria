  - m_Id: 164580255232299029
    m_Localized: "\u30A4\u30F4\u30A1\u30F3\u306B\u4F1A\u3063\u305F\u3089\u3001<link=\"help:forge\"><u><color=#EFB889>\u753A \u2192 \u935B\u51B6\u5834</color></u></link>\u3092\u958B\u304D\u307E\u3057\u3087\u3046\u3002\n\n1. \u5FC5\u8981\u306A\u6750\u6599\u3092\u7CBE\u932C\u3057\u3001\u30A4\u30F3\u30B4\u30C3\u30C8\u3092\u4F5C\u308A\u307E\u3059\u3002\n2. \u30B3\u30A2\u3092\u9078\u3073\u3001\u30EC\u30A2\u5EA6\u306E\u78BA\u7387\u3068\u5FC5\u8981\u306A\u6750\u6599\u3092\u6C7A\u3081\u307E\u3059\u3002\n3. \u88C5\u5099\u30B9\u30ED\u30C3\u30C8\u3092\u9078\u3093\u3067\u300C\u88FD\u4F5C\u300D\u3092\u62BC\u3057\u307E\u3059\u3002\u88FD\u4F5C\u3059\u308B\u305F\u3073\u306B\u30A4\u30F3\u30B4\u30C3\u30C8\u3068\u30B3\u30A21\u500B\u3092\u6D88\u8CBB\u3057\u307E\u3059\u3002\n4. \u5B8C\u6210\u54C1\u3092\u6BD4\u8F03\u3057\u3001\u300C\u88C5\u5099\u300D\u3092\u9078\u3076\u3068\u4ECA\u306E\u88C5\u5099\u3068\u4EA4\u63DB\u3067\u304D\u307E\u3059\u3002\n\n\u30A4\u30F4\u30A1\u30F3\u306E\u30EC\u30C3\u30B9\u30F3\u4E2D\u3092\u9664\u304D\u3001\u5BFE\u5FDC\u3059\u308B\u88C5\u5099\u30B9\u30ED\u30C3\u30C8\u304C\u7A7A\u306A\u3089\u5B8C\u6210\u54C1\u306F\u81EA\u52D5\u3067\u88C5\u5099\u3055\u308C\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299030
    m_Localized: "<b>\u5206\u89E3</b>\n\u3082\u3046\u4E00\u5EA6\u88FD\u4F5C\u3057\u305F\u308A\u3001\u5225\u306E\u30B9\u30ED\u30C3\u30C8\u3078\u5207\u308A\u66FF\u3048\u305F\u308A\u3059\u308B\u524D\u306B\u5B8C\u6210\u54C1\u3092\u78BA\u8A8D\u3057\u307E\u3057\u3087\u3046\u3002\u3069\u3061\u3089\u306E\u64CD\u4F5C\u3067\u3082\u3001\u672A\u88C5\u5099\u306E\u5B8C\u6210\u54C1\u306F\u5206\u89E3\u3055\u308C\u307E\u3059\u3002\n\n<b>\u81EA\u52D5\u5316 \u2014 <link=\"help:forge\"><u><color=#EFB889>\u935B\u51B6\u5834</color></u></link>\u306E\u719F\u7DF4\u5EA6\u30EC\u30D9\u30EB3</b>\n\u300C\u88FD\u4F5C\u3092\u7E70\u308A\u8FD4\u3059\u300D\u306F\u6BCE\u56DE\u6750\u6599\u3092\u6D88\u8CBB\u3057\u3066\u88FD\u4F5C\u3092\u7D9A\u3051\u307E\u3059\u3002\n\n\u300C\u30F4\u30A1\u30B9\u30C6\u30A3\u30A6\u30E0\u3067\u505C\u6B62\u300D\u306F\u3001\u80FD\u529B\u304C\u4E0B\u304C\u308B\u3082\u306E\u3082\u542B\u3081\u3001\u30F4\u30A1\u30B9\u30C6\u30A3\u30A6\u30E0\u306E\u88C5\u5099\u304C\u3067\u304D\u305F\u6642\u70B9\u3067\u505C\u6B62\u3057\u307E\u3059\u3002\n\n\u300C\u80FD\u529B\u5024\u306E\u7A2E\u985E\u3092\u4E00\u81F4\u300D\u304C\u6709\u52B9\u306A\u5834\u5408\u306F\u3001\u88C5\u5099\u4E2D\u306E\u30A2\u30A4\u30C6\u30E0\u3068\u80FD\u529B\u5024\u306E\u7A2E\u985E\u304C\u4E00\u81F4\u3059\u308B\u66F4\u65B0\u54C1\u304C\u3067\u304D\u308B\u307E\u3067\u505C\u6B62\u3057\u307E\u305B\u3093\u3002\n\n\u30B3\u30A2\u3068\u7D50\u6676\u306E\u958B\u653E\u6761\u4EF6\u306F<link=\"help:skills/Combat\"><u><color=#EFB889>\u62E0\u70B9 \u2192 \u30B9\u30AD\u30EB \u2192 \u6226\u95D8</color></u></link>\u3067\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
