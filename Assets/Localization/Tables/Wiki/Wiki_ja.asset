    m_Localized: "<b>\u4F5C\u696D\u30A8\u30B3\u30FC</b>\n\u6575\u3092\u653B\u6483\u3057\u305F\u308A\u5F15\u304D\u5BC4\u305B\u305F\u308A\u305B\u305A\u3001\u8CC7\u6E90\u3092\u96C6\u3081\u307E\u3059\u3002\u30B9\u30AD\u30EB\u306E\u7BC0\u76EE\u3067\u958B\u653E\u3055\u308C\u305F\u30A8\u30B3\u30FC\u306F\u3001\u305D\u306E\u30B9\u30AD\u30EB\u306E\u4F5C\u696D\u3092\u63A2\u3057\u307E\u3059\u3002\u6301\u7D9A\u6642\u9593\u3068\u80FD\u529B\u306F<link=\"help:skills\"><u><color=#EFB889>\u7BC0\u76EE</color></u></link>\u3084<link=\"help:buffs\"><u><color=#EFB889>\u53EC\u559A\u30D0\u30D5</color></u></link>\u3067\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002\n\n\u73FE\u5728\u306E\u53EC\u559A\u306E\u52B9\u679C\u3001\u6301\u7D9A\u6642\u9593\u3001\u30AF\u30FC\u30EB\u30C0\u30A6\u30F3\u306F\u4E0B\u306B\u8868\u793A\u3055\u308C\u307E\u3059\u3002"
