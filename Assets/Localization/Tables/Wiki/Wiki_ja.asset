    m_Localized: "\u30A2\u30EB\u30BF\u30FC\u30A8\u30B3\u30FC\u306B\u3088\u308B\u751F\u7523\u306F\u5EC3\u6B62\u3055\u308C\u307E\u3057\u305F\u3002\u5192\u967A\u3067\u8CC7\u6E90\u3092\u96C6\u3081\u308B\u304B\u3001\u81EA\u5206\u3067\u690D\u3048\u305F\u4F5C\u7269\u3092\u53CE\u7A6B\u3057\u307E\u3057\u3087\u3046\u3002"
