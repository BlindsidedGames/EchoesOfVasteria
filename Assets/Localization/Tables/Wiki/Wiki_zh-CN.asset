  - m_Id: 12027031164698624
    m_Localized: "\u5927\u9505\u5C06\u9009\u4E2D\u7684\u98DF\u7269\u8F6C\u5316\u4E3A\u7096\u6C64\u3002\u4F60\u53EF\u4EE5\u9009\u62E9\u6DF7\u5408\u6570\u91CF\uFF1B\u83B7\u5F97\u7684\u7096\u6C64\u53D6\u51B3\u4E8E\u98DF\u7269\u8BBE\u5B9A\u7684\u4EF7\u503C\u548C\u6570\u91CF\u3002\u54C1\u5C1D\u7096\u6C64\uFF0C\u6839\u636E\u4F0A\u5A03\u663E\u793A\u7684\u5956\u52B1\u6743\u91CD\u83B7\u5F97\u5361\u724C\u3002\n\n\u8D44\u6E90\u5361\u724C\u4F1A\u63D0\u5347\u5BF9\u5E94\u8D44\u6E90\u7684\u6B63\u5E38\u91C7\u96C6\u3001\u654C\u4EBA\u6389\u843D\u548C\u9547\u5185\u4F5C\u7269\u6536\u83B7\u91CF\u3002\u5361\u724C\u6570\u91CF\u95E8\u69DB\u4E3A1\u300125\u300175\u3001200\u3001750\u30011500\u30013500\u548C10000\uFF1B\u4EA7\u91CF\u52A0\u6210\u4E3A1%\u30012%\u30013%\u30015%\u30017%\u300110%\u300115%\u548C20%\u3002\n\n\u8D44\u6E90\u7C7B\u522B\u91C7\u7528\u5176\u5DF2\u89E3\u9501\u8D44\u6E90\u4E2D\u6700\u4F4E\u7684\u5361\u724C\u9636\u7EA7\u3002\u672A\u62E5\u6709\u7684\u5361\u724C\u6309\u96F6\u9636\u8BA1\u7B97\u3002\u7C7B\u522B\u9636\u7EA71\u81F38\u5206\u522B\u4E3A\u8BE5\u7C7B\u522B\u589E\u52A02%\u30015%\u300110%\u300115%\u300120%\u300130%\u300140%\u548C50%\u4EA7\u91CF\u3002\u5361\u724C\u4E0E\u7C7B\u522B\u52A0\u6210\u76F8\u52A0\uFF0C\u6700\u9AD870%\u3002\u5956\u52B1\u3001\u79CD\u5B50\u3001\u9000\u6B3E\u548C\u8F6C\u6362\u4E0D\u4EAB\u53D7\u8FD9\u4E9B\u52A0\u6210\u3002\n\n\u8FD9\u4E9B\u5361\u724C\u9636\u7EA7\u4E0E\u8D44\u6E90\u7A00\u6709\u5EA6\u76F8\u4E92\u72EC\u7ACB\u3002\u73B0\u6709\u589E\u76CA\u5361\u724C\u7684\u51B7\u5374\u548C\u6548\u679C\u52A0\u6210\u4E0D\u53D8\u3002\u5B8C\u6210\u6240\u6709\u53EF\u7528\u7684\u8D44\u6E90\u548C\u589E\u76CA\u6536\u96C6\uFF0C\u4FBF\u53EF\u89E3\u9501\u6C38\u6052\u6069\u8D50\u3002"
