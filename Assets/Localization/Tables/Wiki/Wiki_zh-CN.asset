  - m_Id: 164588427254829056
    m_Localized: "<b>\u519C\u7530</b>\n\u5728\u8FD9\u91CC\u91C7\u96C6\u4F5C\u7269\u3002\u519C\u8015\u4EFB\u52A1\u4E0D\u4F1A\u5728\u5176\u4ED6\u5730\u56FE\u51FA\u73B0\u3002\u5728\u519C\u7530\u88AB\u6536\u5272\u65F6\uFF0C\u5361\u5C14\u7684\u8DDD\u79BB\u4E0A\u9650\u4E0D\u4F1A\u589E\u52A0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160704
    m_Localized: "<b>\u519C\u8015</b>\n\u6536\u83B7\u519C\u7530\u4E2D\u7684\u4F5C\u7269\uFF0C\u53EF\u83B7\u5F97\u4F5C\u7269\u548C\u519C\u8015\u7ECF\u9A8C\u3002\u901A\u8FC7<link=\"help:fields\"><u><color=#EFB889>\u7530\u5730</color></u></link>\u81EA\u5DF1\u79CD\u690D\u4F5C\u7269\u662F\u53E6\u4E00\u5957\u7CFB\u7EDF\u3002\u52A0\u6210\u548C\u89E3\u9501\u5185\u5BB9\u8BF7\u67E5\u770B<link=\"help:skills/Farming\"><u><color=#EFB889>\u4E2D\u5FC3 \u2192 \u6280\u80FD \u2192 \u519C\u8015</color></u></link>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160705
    m_Localized: "<b>\u9493\u9C7C</b>\n\u5409\u5C14\u4F1A\u9001\u4F60\u7B2C\u4E00\u6839\u9C7C\u7AFF\u3002\u9493\u9C7C\u4EFB\u52A1\u4F1A\u5956\u52B1\u9C7C\u548C\u9493\u9C7C\u7ECF\u9A8C\u3002\n\n\u5404\u5730\u56FE\u5DF2\u53D1\u73B0\u7684\u8D44\u6E90\u8BF7\u67E5\u770B<link=\"help:statistics/general\"><u><color=#EFB889>\u7EDF\u8BA1 \u2192 \u5E38\u89C4</color></u></link>\uFF0C\u52A0\u6210\u548C\u89E3\u9501\u5185\u5BB9\u8BF7\u67E5\u770B<link=\"help:skills/Fishing\"><u><color=#EFB889>\u4E2D\u5FC3 \u2192 \u6280\u80FD \u2192 \u9493\u9C7C</color></u></link>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160706
    m_Localized: "<b>\u91C7\u77FF</b>\n\u5F00\u91C7\u77FF\u77F3\u53EF\u83B7\u5F97\u91C7\u77FF\u7ECF\u9A8C\u3002\u5728<link=\"help:forge\"><u><color=#EFB889>\u953B\u9020</color></u></link>\u4E2D\u5C06\u77FF\u77F3\u7194\u70BC\u6210\u91D1\u5C5E\u952D\uFF0C\u518D\u7528\u6765\u5236\u4F5C\u88C5\u5907\u3002\u77FF\u77F3\u89E3\u9501\u7B49\u7EA7\u8BF7\u67E5\u770B<link=\"help:skills/Mining\"><u><color=#EFB889>\u4E2D\u5FC3 \u2192 \u6280\u80FD \u2192 \u91C7\u77FF</color></u></link>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160707
    m_Localized: "<b>\u4F10\u6728</b>\n\u780D\u4F10\u6728\u6750\u53EF\u83B7\u5F97\u4F10\u6728\u7ECF\u9A8C\u3002\u5DF4\u514B\u5229\u7684\u4EFB\u52A1\u4F1A\u5E26\u4F60\u524D\u5F80\u6811\u6797\u3002\n\n\u89E3\u9501\u5185\u5BB9\u8BF7\u67E5\u770B<link=\"help:skills/Woodcutting\"><u><color=#EFB889>\u4E2D\u5FC3 \u2192 \u6280\u80FD \u2192 \u4F10\u6728</color></u></link>\uFF1B\u60F3\u63D0\u5347\u4EFB\u52A1\u51FA\u73B0\u6982\u7387\uFF0C\u8BF7\u6253\u5F00<link=\"help:statistics/tasks\"><u><color=#EFB889>\u7EDF\u8BA1 \u2192 \u4EFB\u52A1</color></u></link>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427305160708
    m_Localized: "<b>\u53EF\u63D0\u4EA4</b>\n\u661F\u6807\u8868\u793A\u4EFB\u52A1\u8981\u6C42\u5DF2\u7ECF\u6EE1\u8DB3\u3002\u8FD4\u56DE\u9547\u5B50\u540E\uFF0C\u9009\u62E9\u201C\u63D0\u4EA4\u201D\u5373\u53EF\u9886\u53D6\u5956\u52B1\u3002\u63D0\u4EA4\u8D44\u6E90\u4F1A\u6D88\u8017\u5217\u51FA\u7684\u7269\u54C1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427309355008
    m_Localized: "<b>\u6B66\u5668</b>\n\u5236\u4F5C\u51FA\u7684\u6B66\u5668\u5FC5\u5B9A\u9644\u5E26\u4F24\u5BB3\u5C5E\u6027\u3002\u66FF\u6362\u5F53\u524D\u6B66\u5668\u524D\uFF0C\u8BF7\u6BD4\u8F83\u5B83\u7684\u5176\u4ED6\u5C5E\u6027\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427309355009
    m_Localized: "<b>\u5934\u76D4</b>\n\u5236\u4F5C\u51FA\u7684\u5934\u76D4\u5FC5\u5B9A\u9644\u5E26\u751F\u547D\u5C5E\u6027\u3002\u5176\u4ED6\u5C5E\u6027\u8FD8\u53EF\u4EE5\u63D0\u5347\u653B\u51FB\u3001\u9632\u5FA1\u6216\u6062\u590D\u80FD\u529B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427309355010
    m_Localized: "<b>\u80F8\u7532</b>\n\u5236\u4F5C\u51FA\u7684\u80F8\u7532\u5FC5\u5B9A\u9644\u5E26\u9632\u5FA1\u5C5E\u6027\u3002\u9632\u5FA1\u8D8A\u9AD8\uFF0C\u53D7\u5230\u7684\u4F24\u5BB3\u8D8A\u5C11\uFF0C\u4F46\u6536\u76CA\u4F1A\u9010\u6E10\u9012\u51CF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427309355011
    m_Localized: "<b>\u9774\u5B50</b>\n\u5236\u4F5C\u51FA\u7684\u9774\u5B50\u5FC5\u5B9A\u9644\u5E26\u79FB\u52A8\u5C5E\u6027\uFF0C\u63D0\u9AD8\u884C\u8FDB\u901F\u5EA6\u3002\u53EA\u6709\u9774\u5B50\u4F1A\u968F\u673A\u83B7\u5F97\u79FB\u52A8\u5C5E\u6027\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427309355012
    m_Localized: "<b>\u4F24\u5BB3</b>\n\u6BCF\u6B21\u547D\u4E2D\u5728\u8BA1\u7B97\u654C\u4EBA\u9632\u5FA1\u548C\u5176\u4ED6\u4FEE\u6B63\u524D\u7684\u4F24\u5BB3\u3002\u653B\u51FB\u901F\u5EA6\u51B3\u5B9A\u653B\u51FB\u9891\u7387\uFF1B\u66B4\u51FB\u7387\u51B3\u5B9A\u66B4\u51FB\u9891\u7387\uFF0C\u66B4\u51FB\u4F24\u5BB3\u51B3\u5B9A\u66B4\u51FB\u5A01\u529B\u3002\n\n\u5192\u9669\u65F6\uFF0C\u9009\u62E9\u751F\u547D\u6761\u65C1\u8FB9\u7684<link=\"help:hero-stats\"><u><color=#EFB889>\u5C5E\u6027</color></u></link>\uFF0C\u5373\u53EF\u67E5\u770B\u5F53\u524D\u6570\u503C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427309355013
    m_Localized: "<b>\u9632\u5FA1</b>\n\u51CF\u5C11\u53D7\u5230\u7684\u4F24\u5BB3\u3002\u9632\u5FA1\u8FBE\u5230{0:0.##}\u65F6\u627F\u53D7\u4E00\u534A\u4F24\u5BB3\uFF0C\u8FBE\u5230{1:0.##}\u65F6\u627F\u53D7\u56DB\u5206\u4E4B\u4E00\u4F24\u5BB3\u3002\u9632\u5FA1\u4E0D\u80FD\u5B8C\u5168\u963B\u6B62\u4F24\u5BB3\u3002\u516C\u5F0F\u8BF7\u67E5\u770B<link=\"help:reference\"><u><color=#EFB889>\u53C2\u8003\u8D44\u6599</color></u></link>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427309355014
    m_Localized: "<b>\u751F\u547D</b>\n\u751F\u547D\u964D\u81F30\u65F6\uFF0C\u82F1\u96C4\u4F1A\u6B7B\u4EA1\u3002\u88C5\u5907\u53EF\u4EE5\u63D0\u9AD8\u6700\u5927\u751F\u547D\uFF0C\u518D\u751F\u5219\u4F1A\u968F\u65F6\u95F4\u6062\u590D\u751F\u547D\u3002\n\n\u5192\u9669\u65F6\uFF0C\u9009\u62E9\u751F\u547D\u6761\u65C1\u8FB9\u7684<link=\"help:hero-stats\"><u><color=#EFB889>\u5C5E\u6027</color></u></link>\uFF0C\u5373\u53EF\u67E5\u770B\u5F53\u524D\u6570\u503C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164588427309355015
    m_Localized: "<b>\u5361\u5C14</b>\n\u5361\u5C14\u4F1A\u5728\u5730\u56FE\u7684\u8DDD\u79BB\u4E0A\u9650\u5904\u7ED3\u675F\u5192\u9669\u3002\u5DF2\u91C7\u96C6\u7684\u8D44\u6E90\u548C\u6280\u80FD\u8FDB\u5EA6\u90FD\u4F1A\u4FDD\u7559\u3002\n\n\u5728\u6CB3\u6D41\u3001\u6811\u6797\u548C\u77FF\u4E95\u7684\u4E0A\u9650\u5904\u88AB\u5361\u5C14\u6536\u5272\uFF0C\u4F1A\u589E\u52A01%\u8DDD\u79BB\uFF1B\u519C\u7530\u4E0D\u4F1A\u589E\u52A0\u3002\u8BE1\u79D8\u4E2D\u7684\u654C\u4EBA\u5F3A\u5EA6\u968F\u51FB\u6740\u6570\u63D0\u5347\uFF0C\u4E5F\u6CA1\u6709\u8DDD\u79BB\u6536\u5272\u4E0A\u9650\u3002"
