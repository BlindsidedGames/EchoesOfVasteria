  - m_Id: 164580255232299027
    m_Localized: "\u4F8B\u5982\uFF0C\u51FB\u674050\u4E2A\u654C\u4EBA\u53EF\u83B7\u5F972\u500D\u8D44\u6E90\uFF0C\u51FB\u6740450\u4E2A\u5219\u8FBE\u523010\u500D\u4E0A\u9650\u3002\u52A0\u6210\u4EA7\u751F\u7684\u8D44\u6E90\u4E0D\u4F1A\u518D\u6B21\u83B7\u5F97\u52A0\u6210\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299028
    m_Localized: "\u953B\u9020"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299029
    m_Localized: "\u4E0E\u4F0A\u4E07\u89C1\u9762\u540E\uFF0C\u6253\u5F00<link=\"help:forge\"><u><color=#EFB889>\u9547\u5B50 \u2192 \u953B\u9020</color></u></link>\u3002\n\n1. \u5C06\u6240\u9700\u6750\u6599\u7194\u70BC\u6210\u91D1\u5C5E\u952D\u3002\n2. \u9009\u62E9\u6838\u5FC3\uFF0C\u786E\u5B9A\u7A00\u6709\u5EA6\u6982\u7387\u548C\u6750\u6599\u6D88\u8017\u3002\n3. \u9009\u62E9\u88C5\u5907\u69FD\u4F4D\uFF0C\u518D\u9009\u62E9\u201C\u5236\u4F5C\u201D\u3002\u6BCF\u6B21\u5236\u4F5C\u90FD\u4F1A\u6D88\u8017\u91D1\u5C5E\u952D\u548C\u4E00\u4E2A\u6838\u5FC3\u3002\n4. \u6BD4\u8F83\u6210\u54C1\uFF0C\u9009\u62E9\u201C\u88C5\u5907\u201D\u6765\u66FF\u6362\u5F53\u524D\u7269\u54C1\u3002\n\n\u9664\u4F0A\u4E07\u7684\u6559\u5B66\u671F\u95F4\u5916\uFF0C\u5982\u679C\u5BF9\u5E94\u69FD\u4F4D\u4E3A\u7A7A\uFF0C\u5236\u4F5C\u51FA\u7684\u88C5\u5907\u4F1A\u81EA\u52A8\u88C5\u5907\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299030
    m_Localized: "<b>\u5206\u89E3</b>\n\u518D\u6B21\u5236\u4F5C\u6216\u5207\u6362\u69FD\u4F4D\u524D\uFF0C\u8BF7\u5148\u67E5\u770B\u6210\u54C1\u3002\u8FD9\u4E24\u79CD\u64CD\u4F5C\u90FD\u4F1A\u5206\u89E3\u5C1A\u672A\u88C5\u5907\u7684\u6210\u54C1\u3002\n\n<b>\u81EA\u52A8\u5316 \u2014 <link=\"help:forge\"><u><color=#EFB889>\u953B\u9020</color></u></link>\u7CBE\u901A\u7B49\u7EA73</b>\n\u201C\u91CD\u590D\u5236\u4F5C\u201D\u4F1A\u6301\u7EED\u5236\u4F5C\uFF0C\u6BCF\u6B21\u90FD\u4F1A\u6D88\u8017\u6750\u6599\u3002\n\n\u542F\u7528\u201C\u9047\u5230Vastium\u505C\u6B62\u201D\u540E\uFF0C\u53EA\u8981\u5F97\u5230Vastium\u88C5\u5907\u5C31\u4F1A\u505C\u6B62\uFF0C\u5373\u4F7F\u5B83\u6BD4\u5F53\u524D\u88C5\u5907\u5DEE\u3002\n\n\u5F00\u542F\u201C\u5C5E\u6027\u5339\u914D\u201D\u540E\uFF0C\u6210\u54C1\u4E0D\u4EC5\u8981\u66F4\u597D\uFF0C\u5C5E\u6027\u7C7B\u578B\u4E5F\u5FC5\u987B\u4E0E\u5F53\u524D\u88C5\u5907\u76F8\u540C\uFF0C\u624D\u4F1A\u505C\u6B62\u5236\u4F5C\u3002\n\n\u6838\u5FC3\u548C\u6676\u4F53\u7684\u89E3\u9501\u6761\u4EF6\u8BF7\u67E5\u770B<link=\"help:skills/Combat\"><u><color=#EFB889>\u4E2D\u5FC3 \u2192 \u6280\u80FD \u2192 \u6218\u6597</color></u></link>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299031
    m_Localized: "\u589E\u76CA"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299032
    m_Localized: "\u9009\u62E9\u589E\u76CA\u56FE\u6807\uFF0C\u53EF\u67E5\u770B\u5B83\u5F53\u524D\u7684\u6548\u679C\u3001\u6301\u7EED\u65F6\u95F4\u548C\u51B7\u5374\u65F6\u95F4\u3002\u8FD9\u4E9B\u6570\u503C\u5DF2\u5305\u542B\u5347\u7EA7\u6548\u679C\u3002\n\n\u6253\u5F00<link=\"help:buffs\"><u><color=#EFB889>\u4E2D\u5FC3 \u2192 \u589E\u76CA</color></u></link>\uFF0C\u53EF\u5206\u914D\u589E\u76CA\u5E76\u7BA1\u7406\u81EA\u52A8\u65BD\u653E\u3002\u5B8C\u6210\u69FD\u4F4D\u8981\u6C42\u7684\u4EFB\u52A1\u540E\uFF0C\u5373\u53EF\u89E3\u9501\u8BE5\u69FD\u4F4D\u7684\u81EA\u52A8\u65BD\u653E\u3002\n\n<link=\"help:buffs\"><u><color=#EFB889>\u589E\u76CA</color></u></link>\u4F1A\u5728\u6301\u7EED\u65F6\u95F4\u8017\u5C3D\u6216\u8FD4\u56DE\u9547\u5B50\u65F6\u7ED3\u675F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299033
    m_Localized: "\u4F0A\u5A03\u7684<link=\"help:cauldron\"><u><color=#EFB889>\u5927\u9505</color></u></link>\u53EF\u4EE5\u63D0\u4F9B\u589E\u76CA\u5361\u724C\uFF0C\u7528\u6765\u589E\u5F3A\u6548\u679C\u5E76\u7F29\u77ED\u51B7\u5374\u65F6\u95F4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299034
    m_Localized: "\u5927\u9505"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299035
    m_Localized: "\u6253\u5F00<link=\"help:cauldron\"><u><color=#EFB889>\u9547\u5B50 \u2192 \u5927\u9505</color></u></link>\u3002\u5C06\u98DF\u7269\u6DF7\u5165\u7096\u6C64\uFF0C\u518D\u54C1\u5C1D\u7096\u6C64\u83B7\u5F97\u5361\u724C\u3002\u54C1\u5C1D\u524D\u53EF\u4EE5\u67E5\u770B\u5956\u52B1\u6982\u7387\u3002\n\n\u8D44\u6E90\u5361\u724C\u4F1A\u589E\u52A0\u5BF9\u5E94\u8D44\u6E90\u7684\u91C7\u96C6\u91CF\uFF0C\u589E\u76CA\u5361\u724C\u5219\u4F1A\u5F3A\u5316\u589E\u76CA\u3002\u5361\u724C\u7B49\u7EA7\u4E0E\u8D44\u6E90\u7A00\u6709\u5EA6\u9636\u7EA7\u662F\u4E0D\u540C\u7684\u7CFB\u7EDF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299036
    m_Localized: "\u4E00\u4E2A\u7C7B\u522B\u7684\u9636\u7EA7\uFF0C\u7B49\u4E8E\u5176\u4E2D\u5DF2\u89E3\u9501\u8D44\u6E90\u5361\u724C\u7684\u6700\u4F4E\u9636\u7EA7\u3002\u5C1A\u672A\u62E5\u6709\u7684\u5361\u724C\u63090\u9636\u8BA1\u7B97\u3002\n\n\u8D44\u6E90\u5361\u724C\u52A0\u6210\u4E0E\u7C7B\u522B\u52A0\u6210\u76F8\u52A0\uFF0C\u4E0A\u9650\u4E3A70%\u3002\u52A0\u6210\u9002\u7528\u4E8E\u91C7\u96C6\u3001\u654C\u4EBA\u6389\u843D\u548C\u9547\u5185\u4F5C\u7269\u6536\u83B7\uFF0C\u4E0D\u9002\u7528\u4E8E\u5956\u52B1\u3001\u79CD\u5B50\u3001\u8FD4\u8FD8\u6216\u8F6C\u6362\u3002\n\n\u5B8C\u6210\u6240\u6709\u53EF\u7528\u7684\u8D44\u6E90\u548C\u589E\u76CA\u6536\u85CF\uFF0C\u5373\u53EF\u89E3\u9501\u201C\u6C38\u6052\u6069\u8D50\u201D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299037
    m_Localized: "\u56DE\u54CD"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299038
    m_Localized: "\u56DE\u54CD\u662F\u82F1\u96C4\u7684\u4E34\u65F6\u5206\u8EAB\uFF0C\u4F1A\u5E2E\u4F60\u91C7\u96C6\u8D44\u6E90\u6216\u6218\u6597\u3002\n\n\u5965\u6797\u7684\u5404\u4E2A\u4E16\u754C\u5F7C\u6B64\u76F8\u8FDE\u3002\u65F6\u95F4\u80FD\u91CF\u7684\u6D8C\u52A8\u8BA9\u8FC7\u53BB\u7684\u4F60\u7559\u4E0B\u7684\u56DE\u54CD\u80FD\u591F\u7A7F\u8D8A\u4E16\u754C\uFF0C\u524D\u6765\u76F8\u52A9\u3002\u5E2E\u52A9\u9547\u91CC\u7684\u5C45\u6C11\u540E\uFF0C\u4F60\u4E5F\u80FD\u4EB2\u81EA\u53EC\u5524\u56DE\u54CD\u3002\n\n\u901A\u8FC7\u6280\u80FD\u91CC\u7A0B\u7891\u89E3\u9501\u7684\u56DE\u54CD\uFF0C\u4F1A\u5BFB\u627E\u5BF9\u5E94\u6280\u80FD\u7684\u4EFB\u52A1\u3002\u91CC\u7A0B\u7891\u8BF7\u67E5\u770B<link=\"help:skills\"><u><color=#EFB889>\u4E2D\u5FC3 \u2192 \u6280\u80FD</color></u></link>\uFF0C\u53EC\u5524\u6548\u679C\u8BF7\u67E5\u770B<link=\"help:buffs\"><u><color=#EFB889>\u53EC\u5524\u589E\u76CA</color></u></link>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299039
    m_Localized: "\u540C\u65F6\u5177\u5907\u91C7\u96C6\u548C\u6218\u6597\u80FD\u529B\u7684\u56DE\u54CD\u4F1A\u4F18\u5148\u8FDB\u884C\u4EFB\u52A1\uFF0C\u906D\u9047\u654C\u4EBA\u65F6\u518D\u6218\u6597\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 164580255232299040
