  - m_Id: 9824133160779776
    m_Localized: "\u65E0\u8BBA\u5728\u9547\u91CC\u8FD8\u662F\u5192\u9669\u4E2D\uFF0C\u90FD\u53EF\u4EE5\u6253\u5F00<link=\"help:forge\"><u><color=#EFB889>\u9547\u5B50 \u2192 \u953B\u9020</color></u></link>\u5236\u4F5C\u88C5\u5907\u3002\n\n\u5236\u4F5C\u9009\u9879\uFF1A\n\n<b>\u9047\u5230Vastium\u505C\u6B62\uFF1A</b>\u53EA\u8981\u5236\u4F5C\u51FAVastium\u88C5\u5907\u5C31\u4F1A\u505C\u6B62\uFF0C\u5373\u4F7F\u5B83\u6BD4\u5F53\u524D\u88C5\u5907\u5DEE\u3002\n\n<b>\u5C5E\u6027\u5339\u914D\uFF1A</b>\u5F00\u542F\u540E\uFF0C\u953B\u9020\u4F1A\u6301\u7EED\u8FDB\u884C\uFF0C\u76F4\u5230\u83B7\u5F97\u6BD4\u5F53\u524D\u88C5\u5907\u66F4\u597D\u3001\u4E14\u5C5E\u6027\u7C7B\u578B\u5B8C\u5168\u76F8\u540C\u7684\u88C5\u5907\u3002\n\n\u54C1\u8D28\u7528\u8FD9\u4E2A\u56FE\u6807\u8868\u793A\uFF1A<sprite=206>\n\n\u4F60\u53EF\u4EE5\u5728\u8FD9\u91CC\u5236\u4F5C\u88C5\u5907\uFF0C\u6311\u9009\u9002\u5408\u81EA\u5DF1\u642D\u914D\u7684\u5C5E\u6027\u3002\n\u88C5\u5907\u53EF\u4EE5\u968F\u673A\u83B7\u5F978\u79CD\u5C5E\u6027\uFF0C\u6BCF\u4E2A\u69FD\u4F4D\u90FD\u4FDD\u8BC1\u62E5\u6709\u5176\u4E2D\u4E00\u79CD\u3002\n\n<sprite=198> = \u4F24\u5BB3\u3002\n<sprite=200> = \u653B\u51FB\u901F\u5EA6\u3002\n<sprite=199> = \u66B4\u51FB\u7387\u3002\n<sprite=205> = \u66B4\u51FB\u4F24\u5BB3\u3002\n\n<sprite=202> = \u751F\u547D\u3002\n<sprite=203> = \u518D\u751F\u3002\n<sprite=201> = \u9632\u5FA1\u3002\n<sprite=204> = \u79FB\u52A8\u3002\n\n<sprite=192> = \u63D0\u5347\u3002\n<sprite=193> = \u964D\u4F4E\u3002\n<sprite=194> = \u65E0\u53D8\u5316\u3002\n<sprite=195> \u65B0\u7269\u54C1\u6CA1\u6709\u6B64\u5C5E\u6027\u3002\n<sprite=196> \u65E7\u7269\u54C1\u6CA1\u6709\u6B64\u5C5E\u6027\u3002\n\n<b>\u6B66\u5668</b> | \u4FDD\u8BC1\u62E5\u6709<sprite=198>\u3002\n<b>\u5934\u76D4</b> | \u4FDD\u8BC1\u62E5\u6709<sprite=202>\u3002\n<b>\u80F8\u7532</b> | \u4FDD\u8BC1\u62E5\u6709<sprite=201>\u3002\n<b>\u9774\u5B50</b> | \u4FDD\u8BC1\u62E5\u6709<sprite=204>\uFF0C\u6B64\u5C5E\u6027\u4EC5\u9650\u8BE5\u69FD\u4F4D\u3002\n\n\u5236\u4F5C\u65B0\u88C5\u5907\u3001\u9009\u62E9\u5176\u4ED6\u69FD\u4F4D\u6216\u5173\u95ED\u6E38\u620F\u65F6\uFF0C\u5C1A\u672A\u88C5\u5907\u7684\u6210\u54C1\u4F1A\u81EA\u52A8\u5206\u89E3\u3002\n\n\u6839\u636E\u7A00\u6709\u5EA6\uFF0C\u4E00\u4EF6\u88C5\u5907\u6700\u591A\u53EF\u62E5\u67095\u9879\u5C5E\u6027\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 9824133185945600
    m_Localized: "\u5927\u5BB6\u597D\uFF0C\u6211\u662F\u5F00\u53D1\u8005\u3002 \n\n\u5982\u679C\u60F3\u8BA9\u4F60\u7684\u540D\u5B57\u52A0\u5165\u654C\u4EBA\u968F\u673A\u540D\u5B57\u6C60\uFF0C\u8BF7\u5230Discord\u7684EoV\u804A\u5929\u9891\u9053\u63D0\u51FA :)\n\n\u2022 \u6211\u5728\u8003\u8651\u628A\u4EFB\u52A1\u89E3\u9501\u79FB\u5230\u91CC\u7A0B\u7891\u7CFB\u7EDF\u4E2D\uFF0C\u8BA9\u59D4\u6258\u5956\u52B1\u6280\u80FD\u7ECF\u9A8C\uFF0C\u800C\u4E0D\u662F\u89E3\u9501\u91C7\u96C6\u4EFB\u52A1\uFF01\u6B22\u8FCE\u544A\u8BC9\u6211\u4F60\u7684\u60F3\u6CD5\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 9898115700506624
    m_Localized: "<b>\u6539\u52A8</b>\n\u2022 \u65B0\u589E\u4E24\u4E2A\u4EFB\u52A1\uFF1A\u300A\u4E3A\u4E86\u679C\u9171\uFF01\u300B\u4E0E\u300A\u5409\u5C14\u6E38\u8BB0\u300B\u3002\n\u2022 \u6539\u8FDB\u4ECB\u7ECD\u4FE1\u606F\u3002\n\u2022 \u4FEE\u590D\u5347\u7EA7\u63D0\u793A\u663E\u793A\u8F83\u4F4E\u6570\u503C\u7684\u95EE\u9898\u3002\n\u2022 \u79FB\u9664\u953B\u9020\u7EDF\u8BA1\u7684\u5DF2\u88C5\u5907\u54C1\u8D28\u533A\u5757\u3002\n\u2022 \u5DF2\u7F6E\u9876\u4EFB\u52A1\u73B0\u5728\u663E\u793A\u201C\u53EF\u4EE5\u63D0\u4EA4\u201D\uFF0C\u4E0D\u518D\u663E\u793A\u201C\u5B8C\u6210\u201D\u3002\n\u2022 \u52A0\u5165\u5730\u56FE\u52A0\u8F7D\u906E\u7F69\u3002\n\u2022 \u65B0\u589E\u5168\u90E8\u6DF7\u5408\u6309\u94AE\u3002\n<b>\u540E\u53F0</b>\n\u2022 \u5C06A*\u66F4\u65B0\u5230\u8F83\u65B0\u7248\u672C\u3002"
    m_Metadata:
