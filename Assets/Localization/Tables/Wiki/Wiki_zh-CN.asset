  - m_Id: 188400156672
    m_Localized: "\u5F02\u5316\u56DE\u54CD\u751F\u4EA7\u7CFB\u7EDF\u5DF2\u505C\u7528\u3002\u8BF7\u5728\u5192\u9669\u4E2D\u91C7\u96C6\u8D44\u6E90\uFF0C\u6216\u6536\u83B7\u81EA\u5DF1\u79CD\u690D\u7684\u4F5C\u7269\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 478381752320
    m_Localized: "<link=\"help:buffs\"><u><color=#EFB889>\u589E\u76CA</color></u></link>\u662F\u4E34\u65F6\u80FD\u529B\uFF0C\u4F1A\u5728\u6301\u7EED\u65F6\u95F4\u8017\u5C3D\u6216\u8FD4\u56DE\u9547\u5B50\u65F6\u7ED3\u675F\u3002\n\n\u5B8C\u6210\u69FD\u4F4D\u8981\u6C42\u7684\u4EFB\u52A1\u540E\uFF0C\u5373\u53EF\u89E3\u9501\u81EA\u52A8\u65BD\u653E\uFF0C\u521D\u59CB\u72B6\u6001\u4E3A\u5F00\u542F\u3002\u5728<link=\"help:buffs\"><u><color=#EFB889>\u4E2D\u5FC3 \u2192 \u589E\u76CA</color></u></link>\u4E2D\u9009\u62E9\u5BF9\u5E94\u69FD\u4F4D\uFF0C\u53EF\u5C06\u5176\u5F00\u542F\u6216\u5173\u95ED\u3002\n\n\u4F0A\u5A03\u7684<link=\"help:cauldron\"><u><color=#EFB889>\u5927\u9505</color></u></link>\u53EF\u4EE5\u7F29\u77ED\u589E\u76CA\u7684\u51B7\u5374\u65F6\u95F4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 492340396032
    m_Localized: "\u4F60\u7684\u89D2\u8272\u4F1A\u81EA\u52A8\u6218\u6597\uFF0C\u53EA\u653B\u51FB\u6321\u8DEF\u7684\u654C\u4EBA\uFF01\u5148\u5E72\u6D3B\uFF0C\u518D\u73A9\u4E50\u3002\n\nD' = D \xD7 (1 - A / (A + N))\n\nD = \u53D7\u5230\u7684\u539F\u59CB\u4F24\u5BB3\nA = \u9632\u5FA1\u503C\uFF08\u6700\u4F4E\u4E3A0\uFF09\nN = \u63A7\u5236\u6536\u76CA\u9012\u51CF\u7684\u5E38\u6570\uFF08\u9ED8\u8BA4=25\uFF09\nD' = \u6700\u7EC8\u53D7\u5230\u7684\u4F24\u5BB3\n\n\u51FB\u8D25\u67D0\u79CD\u654C\u4EBA\u7684\u6B21\u6570\u8FBE\u523010\u3001100\u30011,000\u548C10,000\u65F6\uFF0C\u6BCF\u6B21\u90FD\u4F1A\u83B7\u5F97\u5BF9\u8BE5\u79CD\u654C\u4EBA25%\u7684\u989D\u5916\u4F24\u5BB3\u3002\n\u51FB\u8D25\u67D0\u79CD\u654C\u4EBA\u7684\u6B21\u6570\u8FBE\u523025,000\u548C100,000\u65F6\uFF0C\u6BCF\u6B21\u90FD\u4F1A\u83B7\u5F97\u5BF9\u8BE5\u79CD\u654C\u4EBA50%\u7684\u989D\u5916\u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 512217202688
    m_Localized: "\u56DE\u54CD\u662F\u6765\u81EA\u5176\u4ED6\u73B0\u5B9E\u7684\u82F1\u96C4\u5206\u8EAB\uFF0C\u5404\u81EA\u62E5\u6709\u4E0D\u540C\u7684\u80FD\u529B\u3002\n\n\u53EA\u4F1A\u6218\u6597\u7684\u56DE\u54CD\u4F1A\u5BFB\u627E\u654C\u4EBA\u3002\u540C\u65F6\u5177\u5907\u91C7\u96C6\u548C\u6218\u6597\u80FD\u529B\u7684\u56DE\u54CD\u4F1A\u4F18\u5148\u8FDB\u884C\u4EFB\u52A1\uFF0C\u906D\u9047\u654C\u4EBA\u65F6\u518D\u6218\u6597\u3002\u65E0\u6CD5\u6218\u6597\u7684\u56DE\u54CD\u65E2\u4E0D\u4F1A\u653B\u51FB\uFF0C\u4E5F\u4E0D\u4F1A\u5438\u5F15\u654C\u4EBA\u3002\n\n\u901A\u8FC7\u6280\u80FD\u91CC\u7A0B\u7891\u89E3\u9501\u7684\u56DE\u54CD\u4F1A\u5BFB\u627E\u5BF9\u5E94\u6280\u80FD\u7684\u4EFB\u52A1\u3002\u4F8B\u5982\uFF0C\u4F10\u6728\u56DE\u54CD\u4F1A\u5BFB\u627E\u4F10\u6728\u4EFB\u52A1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 532437942272
    m_Localized: "\u5192\u9669\u4E2D\u4F7F\u7528\u8FD4\u56DE\u9547\u5B50\u7684\u63A7\u4EF6\u5373\u53EF\u64A4\u9000\u3002\u6BCF\u6B21\u51FB\u6740\u4F1A\u589E\u52A02%\u64A4\u9000\u8D44\u6E90\u52A0\u6210\uFF0C\u6570\u503C\u663E\u793A\u5728\u8FD4\u56DE\u63A7\u4EF6\u4E0A\u3002\n\n\u5982\u679C\u5728\u6218\u6597\u4E2D\u8BF7\u6C42\u8FD4\u56DE\uFF0C\u82F1\u96C4\u4F1A\u5148\u7ED3\u675F\u5F53\u524D\u6218\u6597\uFF0C\u518D\u79BB\u5F00\u3002\n\n\u53EA\u6709\u6D3B\u7740\u8FD4\u56DE\u624D\u80FD\u83B7\u5F97\u8FD9\u9879\u52A0\u6210\u3002\u6B7B\u4EA1\u6216\u88AB\u6536\u5272\u90FD\u4F1A\u4F7F\u52A0\u6210\u5931\u6548\uFF0C\u4F46\u5DF2\u7ECF\u91C7\u96C6\u7684\u8D44\u6E90\u4ECD\u4F1A\u4FDD\u7559\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 698595295232
    m_Localized: "\u82F1\u96C4\u4F1A\u81EA\u52A8\u5B8C\u6210\u4EFB\u52A1\u4EE5\u91C7\u96C6\u8D44\u6E90\u3002\u6280\u80FD\u7B49\u7EA7\u8D8A\u9AD8\uFF0C\u5B8C\u6210\u901F\u5EA6\u8D8A\u5FEB\u3002\n\n\u4EFB\u52A1\u6709\u6700\u5C0F\u548C\u6700\u5927\u51FA\u73B0\u8DDD\u79BB\u3002\u8D85\u8FC7\u6700\u5927\u8DDD\u79BB\u540E\uFF0C\u8BE5\u4EFB\u52A1\u7684\u51FA\u73B0\u6743\u91CD\u4F1A\u964D\u4F4E90%\u3002\u5982\u679C\u6240\u6709\u7B26\u5408\u6761\u4EF6\u7684\u4EFB\u52A1\u90FD\u8D85\u8FC7\u4E86\u6700\u5927\u8DDD\u79BB\uFF0C\u5B83\u4EEC\u4E4B\u95F4\u7684\u76F8\u5BF9\u6743\u91CD\u4ECD\u4F1A\u51B3\u5B9A\u51FA\u73B0\u9891\u7387\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 505754247643136
    m_Localized: "\u6EE1\u8DB3\u4EFB\u52A1\u8981\u6C42\u540E\uFF0C\u56DE\u5230\u9547\u91CC\u63D0\u4EA4\u4EFB\u52A1\u3002\n\n<b>\u4FE1\u606F\uFF1A</b>\u9605\u8BFB\u6216\u786E\u8BA4\u4EFB\u52A1\uFF0C\u4EE5\u7EE7\u7EED\u6545\u4E8B\u6216\u6559\u5B66\u3002\n<b>\u91C7\u96C6\uFF1A</b>\u5E26\u6765\u5217\u51FA\u7684\u8D44\u6E90\uFF0C\u63D0\u4EA4\u4EFB\u52A1\u65F6\u4F1A\u6D88\u8017\u5B83\u4EEC\u3002\n<b>\u51FB\u6740\uFF1A</b>\u51FB\u8D25\u6307\u5B9A\u654C\u4EBA\uFF0C\u518D\u56DE\u6765\u62A5\u544A\u3002\n<b>\u4F1A\u9762\uFF1A</b>\u627E\u5230\u6307\u5B9ANPC\u5E76\u4EA4\u8C08\u3002\u90E8\u5206NPC\u53EA\u4F1A\u5728\u4F60\u5230\u8FBE\u7279\u5B9A\u8DDD\u79BB\u540E\u51FA\u73B0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3785742338113536
    m_Localized: "\u8FBE\u5230\u5730\u56FE\u7684\u8DDD\u79BB\u4E0A\u9650\u65F6\uFF0C\u5361\u5C14\u4F1A\u7ED3\u675F\u5192\u9669\u3002\u5404\u5730\u56FE\u4E0A\u9650\u8BF7\u67E5\u770B<link=\"help:statistics/general\"><u><color=#EFB889>\u7EDF\u8BA1 \u2192 \u5E38\u89C4</color></u></link>\u3002\n\n\u5728\u6CB3\u6D41\u3001\u6811\u6797\u548C\u77FF\u4E95\u7684\u4E0A\u9650\u5904\u88AB\u6536\u5272\uFF0C\u4F1A\u589E\u52A01%\u8DDD\u79BB\u3002\u519C\u7530\u4E0D\u4F1A\u589E\u52A0\u3002\u8BE1\u79D8\u4E2D\u7684\u654C\u4EBA\u7B49\u7EA7\u968F\u51FB\u6740\u6570\u63D0\u5347\uFF0C\u4E14\u6CA1\u6709\u51FB\u6740\u4E0A\u9650\u3002\u90E8\u5206\u4EFB\u52A1\u4E5F\u4F1A\u589E\u52A0\u4F60\u7684\u884C\u8FDB\u4E0A\u9650\u3002"
    m_Metadata:
      m_Items: []
