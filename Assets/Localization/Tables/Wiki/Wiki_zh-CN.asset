  - m_Id: 188400156672
    m_Localized: "\u5F02\u56DE\u54CD\u751F\u4EA7\u5DF2\u505C\u7528\u3002\u5728\u5192\u9669\u4E2D\u91C7\u96C6\u8D44\u6E90\uFF0C\u6216\u6536\u83B7\u79CD\u690D\u7684\u4F5C\u7269\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 478381752320
    m_Localized: "\u589E\u76CA\u662F\u77ED\u671F\u3001\u9650\u65F6\u7684\u529B\u91CF\uFF0C\u6301\u7EED\u65F6\u95F4\u7ED3\u675F\u6216\u8FD4\u56DE\u9547\u5B50\u65F6\u4FBF\u4F1A\u6D88\u5931\u3002\u5B8C\u6210\u5BF9\u5E94\u69FD\u4F4D\u7684\u4EFB\u52A1\u540E\uFF0C\u53EF\u4EE5\u81EA\u52A8\u65BD\u653E\uFF0C\u9ED8\u8BA4\u5F00\u542F\u3002\u5728\u589E\u76CA\u7BA1\u7406\u7A97\u53E3\u70B9\u51FB\u69FD\u4F4D\u5373\u53EF\u5173\u95ED\u3002\n\n\u4F0A\u5A03\u7684\u5927\u9505\u53EF\u4EE5\u7F29\u77ED\u589E\u76CA\u51B7\u5374\u65F6\u95F4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 492340396032
    m_Localized: "\u51EF\u52D2\u5E03\u4F1A\u81EA\u52A8\u6218\u6597\uFF0C\u53EA\u653B\u51FB\u6321\u8DEF\u7684\u654C\u4EBA\uFF01\u5148\u5E72\u6D3B\uFF0C\u518D\u73A9\u4E50\u3002\n\nD' = D \xD7 (1 - A / (A + N))\n\nD = \u53D7\u5230\u7684\u539F\u59CB\u4F24\u5BB3\nA = \u9632\u5FA1\u503C\uFF08\u6700\u4F4E\u4E3A0\uFF09\nN = \u63A7\u5236\u6536\u76CA\u9012\u51CF\u7684\u5E38\u6570\uFF08\u9ED8\u8BA4=25\uFF09\nD' = \u6700\u7EC8\u53D7\u5230\u7684\u4F24\u5BB3\n\n\u51FB\u8D25\u67D0\u79CD\u654C\u4EBA\u7684\u6B21\u6570\u8FBE\u523010\u3001100\u30011,000\u548C10,000\u65F6\uFF0C\u6BCF\u6B21\u90FD\u4F1A\u83B7\u5F97\u5BF9\u8BE5\u79CD\u654C\u4EBA25%\u7684\u989D\u5916\u4F24\u5BB3\u3002\n\u51FB\u8D25\u67D0\u79CD\u654C\u4EBA\u7684\u6B21\u6570\u8FBE\u523025,000\u548C100,000\u65F6\uFF0C\u6BCF\u6B21\u90FD\u4F1A\u83B7\u5F97\u5BF9\u8BE5\u79CD\u654C\u4EBA50%\u7684\u989D\u5916\u4F24\u5BB3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 512217202688
    m_Localized: "\u56DE\u54CD\u662F\u51EF\u52D2\u5E03\u7684\u5176\u4ED6\u7248\u672C\uFF0C\u4F1A\u5728\u4E0D\u540C\u60C5\u51B5\u4E0B\u7565\u5FAE\u8DE8\u5165\u4ED6\u7684\u73B0\u5B9E\uFF0C\u524D\u6765\u5E2E\u5FD9\u3002\n\n\u6BCF\u4E2A\u56DE\u54CD\u90FD\u53EF\u80FD\u62E5\u6709\u51EF\u52D2\u5E03\u7684\u90E8\u5206\u6280\u80FD\u7EC4\u5408\uFF0C\u4F46\u5927\u591A\u6570\u4E0D\u4F1A\u62E5\u6709\u5168\u90E8\u6280\u80FD\u3002\n\n\u56DE\u54CD\u884C\u4E3A\u7684\u4E3B\u8981\u5DEE\u5F02\u5728\u4E8E\u80FD\u5426\u6218\u6597\u3002\n\u53EF\u6218\u6597\u7684\u56DE\u54CD\u6709\u4E24\u79CD\u884C\u4E3A\uFF0C\u53D6\u51B3\u4E8E\u80FD\u5426\u5B8C\u6210\u4EFB\u52A1\u3002 \n\n\u4E0D\u80FD\u505A\u4EFB\u52A1\u7684\u6218\u6597\u56DE\u54CD\u4F1A\u4E13\u95E8\u5BFB\u627E\u654C\u4EBA\u3002\n\u80FD\u505A\u4EFB\u52A1\u7684\u6218\u6597\u56DE\u54CD\u4F18\u5148\u5B8C\u6210\u4EFB\u52A1\uFF0C\u53EA\u653B\u51FB\u53D1\u73B0\u5B83\u4EEC\u7684\u654C\u4EBA\u3002\n\n\u4E0D\u4F1A\u6218\u6597\u7684\u56DE\u54CD\u65E2\u4E0D\u4F1A\u88AB\u654C\u4EBA\u76EF\u4E0A\uFF0C\u4E5F\u4E0D\u4F1A\u4E3B\u52A8\u653B\u51FB\u654C\u4EBA\u3002\n\n\u5F00\u53D1\u8005\u8BF4\u660E | \u76EE\u524D\u6E38\u620F\u91CC\u6CA1\u6709\u80FD\u540C\u65F6\u6218\u6597\u548C\u505A\u4EFB\u52A1\u7684\u56DE\u54CD\u3002\u91CC\u7A0B\u7891\u751F\u6210\u7684\u56DE\u54CD\u53EA\u5BFB\u627E\u5BF9\u5E94\u6280\u80FD\u7684\u4EFB\u52A1\uFF0C\u4F8B\u5982\u4F10\u6728\u56DE\u54CD\u53EA\u4F1A\u5BFB\u627E\u4F10\u6728\u4EFB\u52A1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 532437942272
    m_Localized: "\u6BCF\u6B21\u5192\u9669\u4E2D\uFF0C\u6BCF\u51FB\u6740\u4E00\u4E2A\u654C\u4EBA\uFF0C\u8D44\u6E90\u52A0\u6210\u589E\u52A02%\u3002\u6218\u6597\u671F\u95F4\uFF0C\u8BE5\u52A0\u6210\u6682\u65F6\u5F52\u96F6\u81F30%\u3002\n\n\u5C3D\u91CF\u5728\u6218\u6597\u53D8\u5F97\u8FC7\u4E8E\u56F0\u96BE\u524D\u64A4\u9000\uFF0C\u8FD9\u6837\u80FD\u83B7\u5F97\u5C3D\u53EF\u80FD\u591A\u7684\u989D\u5916\u8D44\u6E90\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 698595295232
    m_Localized: "\u4EFB\u52A1\u662F\u51EF\u52D2\u5E03\u65C5\u7A0B\u7684\u4E3B\u8981\u76EE\u7684\u3002\u4E3A\u9547\u5B50\u91C7\u96C6\u8D44\u6E90\u662F\u53D1\u5C55\u7684\u5173\u952E\u3002\n\n\u4EFB\u52A1\u4F1A\u81EA\u52A8\u5B8C\u6210\uFF0C\u6280\u80FD\u7B49\u7EA7\u8D8A\u9AD8\uFF0C\u5B8C\u6210\u5F97\u8D8A\u5FEB\u3002\n\n\u4EFB\u52A1\u51FA\u73B0\u8303\u56F4\u6709\u6700\u5C0F\u548C\u6700\u5927\u8DDD\u79BB\uFF0C\u4F46\u8D85\u8FC7\u6700\u5927\u8DDD\u79BB\u540E\uFF0C\u5176\u51FA\u73B0\u6982\u7387\u4F1A\u964D\u4F4E90%\u3002\u5F53\u6240\u6709\u4EFB\u52A1\u90FD\u8D85\u8FC7\u6700\u5927\u8DDD\u79BB\u65F6\uFF0C\u6743\u91CD\u7CFB\u7EDF\u4F1A\u8D8B\u4E8E\u5747\u8861\uFF0C\u6240\u6709\u4EFB\u52A1\u6309\u5404\u81EA\u6743\u91CD\u51FA\u73B0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 505754247643136
    m_Localized: "\u59D4\u6258\u4EFB\u52A1\u6709\u4E0D\u540C\u7684\u63D0\u4EA4\u6761\u4EF6\u3002\n\n<b>\u8BF4\u660E</b> | \u4E3A\u5267\u60C5\u6216\u5165\u95E8\u6307\u5F15\u800C\u8BBE\uFF0C\u53EF\u7ACB\u5373\u5B8C\u6210\u3002\n<b>\u91C7\u96C6</b> | \u9700\u8981\u6536\u96C6\u8D44\u6E90\u5E76\u63D0\u4EA4\u3002\n<b>\u51FB\u6740</b> | \u51FB\u6740\u654C\u4EBA\u540E\u56DE\u62A5\u5373\u53EF\u5B8C\u6210\u3002\n<b>\u4F1A\u9762</b> | \u9700\u8981\u9047\u89C1\u6307\u5B9ANPC\uFF0C\u5927\u591A\u4F1A\u5728\u7279\u5B9A\u884C\u8FDB\u8DDD\u79BB\u51FA\u73B0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3785742338113536
    m_Localized: "\u79BB\u9547\u5B50\u8FBE\u5230\u4E00\u5B9A\u8DDD\u79BB\u540E\uFF0C\u5361\u5C14\u4F1A\u6536\u5272\u4F60\u7684\u7075\u9B42\uFF0C\u786E\u4FDD\u4F60\u4E0D\u4F1A\u8D70\u5F97\u592A\u8FDC\u3002 \n\u53EF\u5728\u7EDF\u8BA1\u7684\u5E38\u89C4\u9875\u67E5\u770B\u6700\u5927\u6536\u5272\u8DDD\u79BB\u3002\n\n\u6536\u5272\u8DDD\u79BB\u901A\u8FC7\u4EE5\u4E0B\u65B9\u5F0F\u589E\u52A0\u3002\n<b>\u88AB\u6536\u5272</b> | \u589E\u52A0\u5F53\u524D\u6700\u5927\u6536\u5272\u8DDD\u79BB\u76841%\u3002\uFF08\u519C\u7530\u9664\u5916\uFF09\n<b>\u4EFB\u52A1</b> | \u90E8\u5206\u4EFB\u52A1\u4F1A\u589E\u52A0\u6536\u5272\u8DDD\u79BB\u3002"
    m_Metadata:
      m_Items: []
