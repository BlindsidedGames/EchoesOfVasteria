.gameplay .eov-buffs-slot-icon {left:4px;top:4px;width:21px;height:21px;}
.gameplay .eov-buffs-auto {left:19px;top:-7px;width:20px;height:20px;}
.gameplay .eov-buffs-instructions {width:auto;flex-grow:1;flex-basis:0;min-width:0;padding:0;margin-left:var(--space-control);}
.gameplay .eov-buffs-label {text-shadow:none;-unity-text-outline-width:0;white-space:normal;}
.gameplay .eov-buff-line {height:auto;min-height:34px;align-items:center;}
.gameplay .eov-buff-row {padding:var(--space-control) 0;margin-bottom:var(--space-tight);}
.gameplay .eov-buff-icon-frame {width:30px;height:30px;margin-right:var(--space-control);}
.gameplay .eov-buff-assign {height:23px;width:52px;padding:var(--space-tight);}
.gameplay .eov-buff-target {align-self:flex-start;min-width:140px;height:22px;margin-left:36px;padding:0;}
.gameplay .eov-buffs-inset {padding:0;}
.gameplay .eov-buffs-slot-locked {width:29px;left:0;top:18px;}
.gameplay.eov-skills {right:auto;bottom:auto;background-color:var(--surface);padding:var(--space-panel);border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .eov-skills-left {width:35%;margin-right:var(--space-section);}
.gameplay .eov-skill-frame {padding:0;}
.gameplay .eov-skills-header {margin-bottom:var(--space-section);}
.gameplay .eov-skills-selectors {height:auto;flex-wrap:wrap;margin-bottom:var(--space-control);justify-content:flex-start;}
.gameplay .eov-skills-selector {width:32px;height:36px;margin:0 var(--space-control) var(--space-control) 0;padding:var(--space-tight);align-items:center;justify-content:flex-start;}
.gameplay .eov-skill-selector-level {position:relative;top:auto;left:auto;width:100%;height:8px;min-height:8px;margin:var(--space-tight) 0 0 0;-unity-text-align:middle-center;white-space:nowrap;}
.gameplay .skill-selector-icon {width:20px;height:20px;flex-shrink:0;}
.gameplay .eov-skill-text {text-shadow:none;-unity-text-outline-width:0;margin-bottom:var(--space-tight);}
.gameplay .eov-skill-info .eov-skill-text {height:auto;-unity-text-align:middle-left;}
.gameplay .eov-milestone-row {padding:var(--space-control) 0;margin-bottom:var(--space-section);}
.gameplay .eov-milestone-row.locked {opacity:.55;}
.gameplay .selection-outline {border-width:1px;border-color:var(--accent);}
.gameplay .eov-skill-set {margin-bottom:var(--space-section);}
.gameplay .eov-prospector {color:var(--text);}
.gameplay .eov-prospector .surface {border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .gameplay-slider .unity-base-field__input {min-height:0;background-color:transparent;border-width:0;}
.gameplay .gameplay-slider #unity-tracker {height:3px;background-color:var(--line);border-width:0;}
.gameplay .gameplay-slider #unity-dragger {width:6px;background-color:var(--accent);border-width:.5px;border-color:var(--on-accent);}
.gameplay .gameplay-slider #value-fill {background-color:var(--accent);}
.gameplay.settings-page #vsync-label {width:26px;white-space:nowrap;}
.gameplay .eov-skill-info .eov-skill-text {font-size:8px;}
.gameplay .gameplay-scroll .unity-scroller--vertical {width:3px;margin-left:var(--space-control);}
.gameplay .gameplay-scroll .unity-scroller--vertical .unity-base-slider {width:3px;}
.gameplay .gameplay-scroll .unity-scroller--vertical #unity-tracker {background-color:var(--field);width:3px;}
.gameplay .gameplay-scroll .unity-scroller--vertical #unity-dragger {background-color:var(--line);width:3px;border-width:0;}
/* Shared flat menu shell. Sections use spacing; controls retain a shallow bevel. */
.gameplay.menu-surface {right:auto;bottom:auto;background-color:var(--surface);padding:var(--space-panel);border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .eov-quest-text,.gameplay .eov-alter-text,.gameplay .eov-stat-text,.gameplay .eov-chapter-body,.gameplay .eov-chapter-title {text-shadow:none;-unity-text-outline-width:0;color:var(--text);}
.gameplay .eov-quest-row {padding:var(--space-control) 0;margin:0 0 var(--space-section) 0;}
