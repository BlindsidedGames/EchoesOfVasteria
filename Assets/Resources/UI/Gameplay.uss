/* Task choices stay compact; historical metrics are shown on demand. */
.gameplay .task-preferences-toolbar {flex-direction:row;align-items:center;justify-content:flex-end;margin-bottom:8px;flex-shrink:0;}
.gameplay .task-skill-selectors {flex-direction:row;flex-grow:1;min-width:0;}
.gameplay .task-skill-selector {width:34px;min-width:34px;height:34px;padding:4px;margin-right:3px;}
.gameplay .task-skill-selector .eov-icon {width:24px;height:24px;}
.gameplay .task-preferences-sort {width:112px;min-width:0;flex-shrink:0;margin:0;}
.gameplay .task-preferences-sort .unity-base-popup-field__input {min-height:30px;background-color:var(--control);border-color:var(--line);border-width:1px;color:var(--text);}
.gameplay .task-preferences-sort .unity-base-popup-field__text {font-size:var(--body);color:var(--text);}
.gameplay .task-preferences-context {font-size:var(--small);color:var(--muted);margin-bottom:6px;flex-shrink:0;}
.gameplay .task-preferences-grid {flex-direction:row;flex-wrap:wrap;align-items:flex-start;}
.gameplay .task-preferences-column {min-width:0;flex-shrink:0;}
.gameplay .task-preferences-group {min-width:0;flex-shrink:0;padding:0 0 14px 0;}
.gameplay .task-preferences-multi .task-preferences-group {padding-right:14px;}
.gameplay .task-preferences-heading {flex-direction:row;align-items:center;min-height:30px;margin-bottom:5px;}
.gameplay .task-preferences-heading .eov-icon {width:22px;height:22px;margin-right:6px;}
.gameplay .task-preferences-skill-name {font-size:var(--body);-unity-font-style:bold;flex-grow:1;}
.gameplay .task-preferences-favour-label {font-size:var(--small);color:var(--muted);flex-shrink:0;}
.gameplay .task-preference-row {flex-direction:row;align-items:center;min-height:36px;margin-bottom:2px;}
.gameplay .task-preference-name,.gameplay .task-preference-name:hover,.gameplay .task-preference-name:active {flex-direction:row;justify-content:flex-start;flex-grow:1;flex-basis:0;min-width:0;min-height:36px;padding:2px 0;background-color:transparent;border-width:0;}
.gameplay .task-preference-name .eov-icon {width:22px;height:22px;flex-shrink:0;margin-right:6px;}
.gameplay .task-preference-title {font-size:var(--body);-unity-font-style:normal;white-space:normal;flex-shrink:1;min-width:0;-unity-text-align:middle-left;}
.gameplay.eov-statistics .button.task-preference-name,.gameplay.eov-statistics .button.task-preference-name:hover,.gameplay.eov-statistics .button.task-preference-name:active {background-color:transparent;border-width:0;padding:2px 0;}
.gameplay .task-preference-chance {width:46px;margin-left:4px;font-size:var(--small);color:var(--muted);-unity-text-align:middle-right;flex-shrink:0;}
.gameplay .task-preference-toggle,.gameplay .task-preference-toggle:hover,.gameplay .task-preference-toggle:active {width:36px;min-width:36px;height:36px;padding:9px;margin:0 0 0 2px;background-color:transparent;border-width:0;}
.gameplay .task-preference-toggle .eov-icon {width:16px;height:16px;}
.gameplay .button.task-preference-toggle.check-control--standalone {width:36px;min-width:36px;max-width:36px;height:36px;min-height:36px;padding:9px;justify-content:center;}
.gameplay.eov-statistics .button.task-preference-toggle,.gameplay.eov-statistics .button.task-preference-toggle:hover,.gameplay.eov-statistics .button.task-preference-toggle:active {background-color:transparent;border-width:0;}
.gameplay .task-preferences-unknown-toggle,.gameplay .task-preferences-unknown-toggle:hover {font-size:var(--small);-unity-font-style:normal;-unity-text-align:middle-left;min-height:30px;padding:2px 0;background-color:transparent;border-width:0;color:var(--muted);}
.gameplay .task-details-overlay {position:absolute;left:0;right:0;top:0;bottom:0;align-items:center;justify-content:center;}
.gameplay.eov-statistics .button.task-details-backdrop,.gameplay.eov-statistics .button.task-details-backdrop:hover {position:absolute;left:0;right:0;top:0;bottom:0;background-color:rgba(0,0,0,.45);border-width:0;}
.gameplay .task-details-panel {width:90%;max-width:340px;max-height:90%;padding:12px;flex-shrink:1;}
.gameplay .task-details-heading {flex-direction:row;align-items:center;flex-shrink:0;margin-bottom:12px;}
.gameplay .task-details-heading .eov-icon {width:24px;height:24px;margin-right:6px;}
.gameplay .task-details-title {flex-grow:1;flex-shrink:1;min-width:0;font-size:var(--body);-unity-font-style:bold;white-space:normal;}
.gameplay #task-details-close {width:30px;min-width:30px;height:30px;margin-left:8px;}
.gameplay .task-details-text {font-size:var(--body);white-space:normal;margin-bottom:12px;}
.gameplay #task-details-favour {min-height:34px;flex-shrink:0;}

/* Semantic roles are shared by both routes. Rarity colours retain the original tier artwork. */
.gameplay.dark .hero-text {color:#eaddd1;}
.gameplay.dark .hero-surface {background-color:#2b2425;border-color:#7e684e;}
.gameplay.dark .hero-health-track {background-color:#684c3f;}
.gameplay .hero-health-fill {background-color:#65b944;}
.gameplay.dark .hero-stat-divider {background-color:#705649;}
.gameplay.dark .eov-skill-selector-level,.gameplay.dark .eov-skill-info .eov-skill-text {color:#ead4aa;}
.gameplay.dark .eov-navigation-progress-text,.gameplay.dark .eov-navigation-progress-distance {color:#ead4aa;}
.gameplay .eov-pinned-background {background-color:rgba(0,0,0,.502);}
.gameplay #pinned-entries Label {color:#f5e4d6;}
.gameplay.dark.loading-screen {background-color:#1f130f;}
.gameplay.dark .loading-track {background-color:#1f130f;}
.gameplay.dark .loading-fill {background-color:#78b842;}
.gameplay.dark .toast-duration-fill {background-color:#78b842;}
.gameplay.dark .graph-outcome-retreated {background-color:#b8a89c;}
.gameplay.dark .graph-outcome-reaped {background-color:#b28ac9;}
.gameplay.dark .graph-outcome-died {background-color:#d16666;}
.gameplay.dark .graph-outcome-abandoned {background-color:#6e6b6e;}
.gameplay.dark .hero-surface.button.active {background-color:var(--accent);color:var(--on-accent);}
.gameplay { position:absolute; left:0; right:0; top:0; bottom:0; overflow:hidden; --space-tight:2px; --space-control:4px; --space-section:8px; --space-panel:12px; --body:9.5px; --small:8.5px; --heading:11.5px; --title:16px; --amount:19px; font-size:var(--body); color:var(--text); }
.gameplay.dark { --surface:#292426; --text:#f5e4d6; --muted:#c8aea1; --control:#3c3032; --hover:#514042; --line:#74514a; --accent:#efb984; --on-accent:#302126; --selected:#674635; --field:#382e31; --health:#63c64d; }
.gameplay.large { --body:12.35px; --small:11.05px; --heading:14.95px; --title:20.8px; --amount:24.7px; }
.gameplay Label { white-space:normal; color:var(--text); margin:0; padding:0; flex-shrink:0; }
.gameplay .small { font-size:var(--small); }
.gameplay .muted { color:var(--muted); }
.gameplay .strong,.gameplay .heading,.gameplay .title,.gameplay .amount { -unity-font-style:bold; }
.gameplay .heading { font-size:var(--heading); margin-bottom:var(--space-control); }
.gameplay .title { font-size:var(--title); }
.gameplay .amount { font-size:var(--amount); }
.gameplay .row { flex-direction:row; }
.gameplay .between { justify-content:space-between; align-items:center; }
.gameplay .grow { flex-grow:1; min-width:0; }
.gameplay .icon { flex-shrink:0; margin-right:var(--space-control); }
.gameplay.surface,.gameplay .surface { background-color:var(--surface); border-radius:0; padding:var(--space-control); }
.gameplay .button { margin:0; padding:var(--space-control) var(--space-control); min-height:22px; flex-shrink:0; background-color:var(--control); background-image:none; color:var(--text); border-width:0.5px; border-color:transparent; border-radius:0; white-space:normal; -unity-font-style:bold; font-size:var(--body); }
.gameplay .button:hover { background-color:var(--hover); }
.gameplay .button:disabled { opacity:0.45; }
.gameplay .primary,.gameplay .active { background-color:var(--accent); color:var(--on-accent); }
.gameplay .primary:hover,.gameplay .active:hover { background-color:var(--accent); }
.gameplay .quiet { background-color:transparent; }
.gameplay .landscape,.gameplay .shade { position:absolute; left:0;right:0;top:0;bottom:0; overflow:hidden; }
.gameplay .landscape-image {position:absolute; width:143%;height:143%;left:-21.5%;top:-11.5%;}
.gameplay .shade { background-color:rgba(25,18,20,0.56); }
.gameplay .navigation { position:absolute;left:12px;right:12px;top:12px; }
.gameplay .nav-links > .button { margin-right:var(--space-control); }
.gameplay .cauldron { position:absolute;left:12px;right:12px;top:46px;bottom:12px;padding:var(--space-panel); }
.gameplay .page-heading {flex-shrink:0;margin-bottom:var(--space-panel);}
.gameplay .eva {align-items:center;}
.gameplay .eva-info {width:102.5px;}
.gameplay .track { height:2.5px; background-color:var(--line); margin-top:var(--space-tight); margin-bottom:var(--space-tight); overflow:hidden; border-radius:0; flex-shrink:0; }
.gameplay .fill { height:100%;background-color:var(--accent); }
.gameplay .health { height:4.5px; }
.gameplay .health .fill {background-color:var(--health);}
.gameplay .workspace {flex-grow:1;flex-basis:0;min-height:0;}
.gameplay .column {min-height:0;min-width:0;}
.gameplay .ingredients {width:32%;margin-right:var(--space-panel);}
.gameplay .brewing {width:24%;margin-right:var(--space-panel);}
.gameplay .collection {flex-grow:1;flex-basis:0;}
.gameplay .filters {flex-shrink:0;margin-bottom:var(--space-control); flex-wrap:wrap;}
.gameplay .search {flex-grow:1;min-width:45px;margin:0 var(--space-control) var(--space-tight) 0;}
.gameplay TextField,.gameplay DropdownField {font-size:var(--body);min-height:18px;}
.gameplay .unity-base-field__label {min-width:0;margin:0 var(--space-control) 0 0;color:var(--text);}
.gameplay .unity-base-field__input {background-color:var(--field);color:var(--text);border-color:var(--line);border-radius:0;min-height:18px;}
.gameplay .unity-text-field__input {padding:var(--space-tight) var(--space-control);}
.gameplay .scroll {flex-grow:1;flex-basis:0;min-height:0;flex-shrink:1;}
.gameplay .food-grid,.gameplay .card-grid {flex-direction:row;flex-wrap:wrap;align-content:flex-start;}
.gameplay .food {width:25%;min-width:0;min-height:56px;align-items:center;justify-content:flex-start;padding:var(--space-control) 1.5px;background-color:transparent;}
.gameplay .food .icon,.gameplay .card .icon {margin:0 0 var(--space-control) 0;}
.gameplay .food Label,.gameplay .card Label {-unity-text-align:middle-center;}
.gameplay .food .food-name {width:100%;min-width:0;white-space:nowrap;overflow:hidden;}
.gameplay .food .food-lock {position:absolute;right:0;top:0;width:22px;height:22px;min-width:22px;padding:3px;margin:0;border-width:0;background-color:transparent;}
.gameplay .food .food-lock.active,.gameplay .food .food-lock:hover,.gameplay .food .food-lock:active,.gameplay .food .food-lock:focus {background-color:transparent;border-width:0;}
.gameplay .food-lock .buff-lock-icon {width:12px;height:14px;margin:0;}
.gameplay .food-lock.locked .buff-lock-icon {color:var(--accent);}
.gameplay .selected {background-color:var(--selected);border-color:var(--accent);}
.gameplay .mix-footer {flex-shrink:0;padding-top:var(--space-control);}
.gameplay .mix-summary {align-items:center;margin-bottom:var(--space-control);}
.gameplay .selection {flex-grow:1;flex-shrink:1;flex-basis:0;min-width:0;margin-right:var(--space-control);}
.gameplay .stew-gain {flex-shrink:0;white-space:nowrap;-unity-text-align:middle-right;}
.gameplay .mix-footer .button {margin-bottom:var(--space-tight);}
.gameplay .conversion-selection {align-items:center;margin-bottom:var(--space-section);}
.gameplay .conversion-quantity {align-items:stretch;margin-bottom:var(--space-control);}
.gameplay .conversion-quantity .amount-label {align-self:center;margin-right:var(--space-control);}
.gameplay .conversion-quantity .button {min-height:27px;margin:0 0 0 var(--space-control);padding:var(--space-control);-unity-text-align:middle-center;}
.gameplay .conversion-quantity .amount-step {width:27px;}
.gameplay .conversion-quantity .amount-max {min-width:35px;}
.gameplay .conversion-input {flex-grow:1;flex-shrink:1;flex-basis:0;min-width:24px;margin:0 0 0 var(--space-control);}
.gameplay .conversion-input .unity-base-field__input {min-height:27px;border-width:0.5px;border-color:var(--line);}
.gameplay .conversion-input .unity-text-field__input {-unity-text-align:middle-center;}
.gameplay .mix-preview {flex-direction:row;justify-content:center;align-items:center;min-height:27px;}
.gameplay .mix-actions {flex-shrink:0;margin-top:4px;}
.gameplay .mix-actions .button {margin:0;}
.gameplay .mix-actions .mix-selected {min-height:30px;padding:var(--space-control);margin-bottom:6px;}
.gameplay .mix-all-main {min-height:30px;}
.gameplay .mix-preview .mix-label {white-space:nowrap;-unity-font-style:bold;}
.gameplay .mix-caption {margin-right:4px;}
.gameplay .mix-yield {justify-content:center;align-items:center;}
.gameplay .mix-preview.primary .mix-label {color:var(--on-accent);}
.gameplay .mix-stew-icon {flex-shrink:0;margin:0 4px 0 0;}
.gameplay .stew-total {justify-content:center;align-items:center;}
.gameplay .stew-total > .icon {margin:0 5px 0 0;}
.gameplay .stew-amount {font-size:12px;-unity-font-style:bold;}
.gameplay .stew-cost-label,.gameplay .stew-availability,.gameplay .stew-unit {align-items:center;}
.gameplay .stew-availability {flex-wrap:wrap;}
.gameplay .stew-unit {margin-left:3px;}
.gameplay .stew-unit .icon {margin:0 3px 0 0;}
.gameplay .conversion-error {margin-bottom:var(--space-control);}
.gameplay .brew-summary {align-items:center;margin-bottom:var(--space-section);}
.gameplay .brew-summary > .icon {margin:0 0 var(--space-control) 0;}
.gameplay .tasting-top {flex-shrink:0;margin-bottom:8px;}
.gameplay .tasting-top > .tasting-eva {margin-bottom:8px;}
.gameplay .tasting-top .odds-heading {margin-bottom:4px;}
.gameplay .tasting-actions {flex-shrink:0;}
.gameplay .tasting-actions .button {min-height:30px;padding:4px;font-size:var(--body);}
.gameplay .tasting-footer {flex-shrink:0;padding-top:4px;}
.gameplay .tasting-footer .button {margin-bottom:var(--space-tight);}
.gameplay .tasting-top > .tasting-footer {padding-top:0;margin-bottom:4px;}
.gameplay.eov-cauldron .button:disabled,.gameplay.eov-cauldron .button.primary:disabled {background-color:var(--control);color:var(--muted);border-color:var(--button-edge);border-top-color:var(--button-light);opacity:1;}
.gameplay.eov-cauldron .mix-preview:disabled .mix-label {color:var(--muted);}
.gameplay.eov-cauldron .button:disabled .icon {opacity:.6;}
.gameplay.eov-cauldron .button.food:disabled {background-color:transparent;border-color:transparent;color:var(--text);opacity:.45;}
.gameplay.eov-cauldron .button.food:disabled .icon {opacity:1;}
.gameplay .status {-unity-font-style:bold;margin-bottom:var(--space-control);}
.gameplay .readout {margin-bottom:var(--space-control);flex-wrap:wrap;}
.gameplay .odds {margin-top:var(--space-section);}
.gameplay Foldout {margin:var(--space-control) 0;flex-shrink:0;}
.gameplay .unity-foldout__content {margin-left:0;padding-top:var(--space-control);}
.gameplay .unity-toggle__text {color:var(--text);font-size:var(--body);white-space:normal;}
.gameplay .odds-row {margin-bottom:var(--space-control);}
.gameplay .tabs {flex-shrink:0;flex-wrap:nowrap;align-items:stretch;margin-bottom:var(--space-control);}
.gameplay .tab {flex-grow:1;flex-shrink:1;flex-basis:0;padding:var(--space-control);min-width:0;}
.gameplay .legend {flex-shrink:0;margin-bottom:var(--space-control);}
.gameplay .tier-swatch {flex-grow:1; -unity-text-align:middle-center; font-size:var(--small);margin-right:var(--space-tight);}
.gameplay .tier-1 {--tier-colour:#b86f50;}.gameplay .tier-2 {--tier-colour:#6c7c9d;}.gameplay .tier-3 {--tier-colour:#feae34;}.gameplay .tier-4 {--tier-colour:#ed7614;}.gameplay .tier-5 {--tier-colour:#0098dc;}.gameplay .tier-6 {--tier-colour:#33984b;}.gameplay .tier-7 {--tier-colour:#c42430;}.gameplay .tier-8 {--tier-colour:#db3ffd;}
.gameplay .group-heading {margin-top:var(--space-control);margin-bottom:var(--space-control);flex-shrink:0;}
.gameplay .card {width:31%;margin:0 2% var(--space-control) 0;min-height:58px;padding:var(--space-control) 1.5px;align-items:center;background-color:transparent;border-bottom-width:0;border-radius:0;}
.gameplay .boon {align-items:center;margin:var(--space-control) 0;}
.gameplay .modal {position:absolute;left:0;right:0;top:0;bottom:0;align-items:center;justify-content:center;background-color:rgba(15,10,13,0.72);}
.gameplay .dialog {width:230px;max-width:92%;max-height:90%;padding:var(--space-panel);}
.gameplay .dialog > Label {margin-bottom:var(--space-control);}
.gameplay .actions {justify-content:flex-end;margin-top:var(--space-section);}
.gameplay .actions .button {margin-left:var(--space-control);}
.gameplay .run-screen {position:absolute;left:12px;right:12px;top:46px;bottom:12px;}
.gameplay .location {align-self:flex-start;width:120px;}
.gameplay .hero-corner {position:absolute;left:0;bottom:0;width:220px;}
.gameplay .abilities {margin-bottom:var(--space-control);}
.gameplay .ability {align-items:center;padding:var(--space-tight) var(--space-control);margin-right:var(--space-control);min-width:32px;}
.gameplay .circle {width:21px;height:21px;align-items:center;justify-content:center;}
.gameplay .circle .icon {margin:0;}
.gameplay .radial {position:absolute;left:0;right:0;top:0;bottom:0;}
.gameplay .auto {color:var(--muted);}
.gameplay .stats {flex-wrap:wrap;margin-top:var(--space-control);}
.gameplay .metric {flex-grow:1;margin-right:var(--space-control);margin-bottom:var(--space-tight);}
.gameplay .journey {position:absolute;right:0;bottom:0;width:136px;}
.gameplay .journey .button {margin-top:var(--space-tight);}
.gameplay.narrow .navigation {left:6px;right:6px;top:6px;}
.gameplay.narrow .nav-links > .button {margin-right:var(--space-tight);padding:var(--space-control);}
.gameplay.narrow .nav-return {display:none;}
.gameplay.narrow .cauldron {left:6px;right:6px;top:36px;bottom:6px;padding:var(--space-control);}
.gameplay.narrow .page-heading {flex-direction:column;align-items:flex-start;margin-bottom:var(--space-control);}
.gameplay.narrow .title {font-size:var(--heading);margin-bottom:var(--space-control);}
.gameplay.narrow .eva {width:100%;}
.gameplay.narrow .eva-info {flex-grow:1;width:auto;}
.gameplay.narrow .workspace {flex-direction:column;}
.gameplay.narrow .column {width:100%;margin:0;flex-grow:1;flex-basis:0;}
.gameplay.narrow .food {width:33.333%;}
.gameplay.narrow .run-screen {left:6px;right:6px;top:36px;bottom:6px;}
.gameplay.narrow .hero-corner {width:100%;bottom:0;}
.gameplay.narrow .hero .heading {font-size:var(--body);}
.gameplay.narrow .abilities {justify-content:space-between;}
.gameplay.narrow .ability {min-width:0;padding:var(--space-tight) 1.5px;margin-right:0;flex-grow:1;}
.gameplay.narrow .ability .small {font-size:var(--small);}
.gameplay.narrow .hero .metric {width:29%;}
.gameplay.narrow .journey {bottom:146px;right:0;width:100%;}
.gameplay.narrow.large .journey {bottom:175px;}
.gameplay.narrow .location {width:105px;}
/* Narrow inputs keep their own row; they must not collapse behind a translated label. */
.gameplay.narrow .filters {flex-direction:column;}
.gameplay.narrow .filters > .search {width:100%;margin-right:0;margin-bottom:var(--space-control);}
.gameplay.narrow .filters > DropdownField {width:100%;margin:0;}
.gameplay.narrow.large .food {width:50%;}
.gameplay .radial {--ring-color:var(--accent);--ring-track:var(--line);}
.gameplay .unity-foldout__toggle {background-color:transparent;min-height:22px;}
.gameplay.dark .unity-foldout__toggle > .unity-toggle__checkmark,.gameplay.dark .unity-popup-field__arrow {-unity-background-image-tint-color:#efb984;}
.gameplay .return-death {position:absolute;right:0;top:0;background-color:var(--surface);padding:var(--space-control);min-height:22px;border-radius:0;}
.gameplay.narrow .return-death {display:none;}
.gameplay.narrow .journey {position:relative;bottom:auto;right:auto;width:100%;margin-bottom:var(--space-control);}
.gameplay.narrow.large .journey {bottom:auto;}
.gameplay.narrow .journey .stats {display:none;}
.gameplay.narrow .journey .heading {font-size:var(--body);margin-bottom:0;}
.gameplay.narrow .journey .button {min-height:22px;padding:var(--space-tight);}
.gameplay.narrow .hero .between {flex-wrap:wrap;}
.gameplay.narrow .card {width:48%;}
.gameplay.narrow .ability .small {font-size:var(--small);}
.gameplay.narrow .ability {width:20%;flex-grow:0;}
.gameplay .hero .grow {flex-basis:0;flex-shrink:1;}
.gameplay.narrow .column > .heading {display:none;}
.gameplay.narrow .actions {flex-direction:column;align-items:stretch;}
.gameplay.narrow .actions .button {margin:var(--space-tight) 0 0 0;}
.gameplay .cauldron:disabled {opacity:1;}
.gameplay .tier-0 {--tier-colour:var(--line);}
.gameplay .nav-links > .button:disabled {background-color:var(--surface);opacity:0.65;}

/* Autocast is a shape state, independent of translation length. */
.gameplay .ability {width:36px;flex-grow:0;}
.gameplay .autocast-mark {width:10px;height:10px;flex-shrink:0;margin-top:var(--space-tight);--autocast-ink:var(--accent);}
.gameplay .autocast-mark.off {--autocast-ink:var(--muted);}


/* Rarity is a labelled colour block; progress is independently readable below the count. */
.gameplay .rarity-badge {background-color:var(--tier-colour);color:#251b20;min-width:16px;padding:1.5px 2.5px;-unity-font-style:bold;-unity-text-align:middle-center;flex-shrink:0;}
.gameplay .rarity-badge.tier-0,.gameplay .rarity-badge.tier-7 {color:#ffffff;}
.gameplay .card-identity {width:18px;height:18px;flex-shrink:0;align-items:center;justify-content:center;margin-bottom:var(--space-tight);}
.gameplay .card-identity .icon {margin:0;}
.gameplay .card-name {margin-bottom:1px;}
.gameplay .card-progress-row {width:90%;align-items:center;margin-top:var(--space-tight);margin-bottom:1px;}
.gameplay .rarity-star {width:6px;height:6px;flex-shrink:0;margin-right:var(--space-tight);--star-colour:var(--tier-colour);}
.gameplay .collection-progress {flex-grow:1;flex-basis:0;height:3.5px;margin:0;background-color:var(--field);}
.gameplay .collection-progress .fill {background-color:var(--tier-colour);}

.gameplay .section-bonus {align-items:center;}

.gameplay.narrow .tab {padding:var(--space-control) var(--space-tight);}
/* Enlarged narrow layouts use equal full-width tabs rather than splitting words. */
.gameplay.narrow.large .tabs {flex-direction:column;}
.gameplay.narrow.large .tab {flex-basis:auto;width:100%;}

.gameplay .odds-heading {margin-bottom:var(--space-control);}
.gameplay .details-button {width:22px;min-width:22px;padding:var(--space-tight);-unity-font-style:bold;font-size:var(--heading);}

.gameplay .tasting-eva {flex-shrink:0;margin-bottom:var(--space-control);}
.gameplay .tasting-eva .eva-info {width:auto;flex-grow:1;flex-shrink:1;min-width:0;}

/* Shallow, square-edged controls. States change colour/depth, never their footprint. */
.gameplay.dark {--button-edge:#171316;--button-light:#695050;--button-pressed:#302628;--primary-hover:#ffd1a3;--primary-edge:#986344;--primary-light:#ffe0be;}
.gameplay .button {border-width:0.5px;border-bottom-width:1.5px;border-color:var(--button-edge);border-top-color:var(--button-light);}
.gameplay .button:hover {background-color:var(--hover);}
.gameplay .button:active {background-color:var(--button-pressed);}
.gameplay .button.primary,.gameplay .button.active {border-color:var(--primary-edge);border-top-color:var(--primary-light);background-color:var(--accent);}
.gameplay .button.primary:hover,.gameplay .button.active:hover {background-color:var(--primary-hover);}
.gameplay .button.primary:active,.gameplay .button.active:active {background-color:var(--accent);}
.gameplay .button.quiet {background-color:var(--control);}
.gameplay .button.quiet:hover {background-color:var(--hover);}
.gameplay .button.quiet:active {background-color:var(--button-pressed);}
/* Collection entries remain flat, without introducing framed cards inside the route. */
.gameplay .button.food,.gameplay .button.card {border-width:0.5px;border-color:transparent;background-color:transparent;}
.gameplay .button.food:hover,.gameplay .button.card:hover {background-color:var(--hover);}
.gameplay.keyboard .button.food:focus,.gameplay.keyboard .button.card:focus {border-color:var(--text);}
.gameplay .button.food.selected {background-color:var(--selected);border-color:var(--accent);}
.gameplay .button.tab {margin-right:var(--space-tight);}
.gameplay .button.tab.last-tab {margin-right:0;}
.gameplay.narrow.large .button.tab {margin-right:0;margin-bottom:var(--space-tight);}
.gameplay.narrow.large .button.tab.last-tab {margin-bottom:0;}

/* Pointer focus stays quiet; keyboard focus is a uniform outline, not a bevel. */
.gameplay.keyboard .button:focus {border-color:var(--text);}
.gameplay.dark {--panel-edge:#674c45;--panel-light:#876657;}
.gameplay.surface,.gameplay .surface {border-width:0.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .dialog {padding:var(--space-section);}
.gameplay .mix-dialog {width:250px;}
.gameplay .mix-dialog .confirmation-copy {margin-bottom:var(--space-section);}
.gameplay .mix-dialog .scroll {flex-grow:0;flex-basis:auto;}
.gameplay .confirmation-item {min-height:20px;align-items:center;padding:var(--space-tight) 0;flex-shrink:0;}
.gameplay .confirmation-name {flex-grow:1;flex-shrink:1;flex-basis:0;margin-right:var(--space-control);}
.gameplay .confirmation-count {white-space:nowrap;-unity-text-align:middle-right;}
.gameplay .confirmation-total {margin-top:var(--space-section);}
.gameplay .confirmation-total .heading {margin-bottom:0;}
.gameplay .mix-dialog .actions {margin-top:var(--space-section);}
.gameplay .mix-dialog .actions .button {flex-grow:1;flex-basis:0;margin-left:var(--space-control);}
.gameplay .mix-dialog .actions .button.cancel-action {margin-left:0;}
.gameplay.narrow .mix-dialog .actions .button {flex-basis:auto;margin-left:0;}

/* Adventure HUD rhythm: 4px groups, 2px related lines; borders stay inside the footprint. */
.gameplay .run-screen {top:38px;}
.gameplay.narrow .run-screen {top:32px;}
.gameplay .abilities {width:100%;margin-bottom:var(--space-control);}
.gameplay .button.ability {width:auto;min-width:0;flex-grow:1;flex-shrink:1;flex-basis:0;margin-right:var(--space-control);padding:var(--space-tight) var(--space-tight);}
.gameplay .button.ability.last-ability {margin-right:0;}
.gameplay .hero .hero-name {margin-bottom:0;}
.gameplay .hero .stats,.gameplay .journey .stats {margin-top:var(--space-control);}
.gameplay .hero .metric,.gameplay .journey .metric {margin-bottom:0;margin-right:var(--space-control);}
.gameplay .hero .metric.last-metric,.gameplay .journey .metric.last-metric {margin-right:0;}
.gameplay .journey > .heading {margin-bottom:0;}
.gameplay .journey .button {margin-top:var(--space-control);}
.gameplay .button.return-death {padding:var(--space-control) var(--space-control);min-height:22px;}
.gameplay .return-death .unity-toggle__input {background-color:transparent;border-width:0;align-items:center;}
.gameplay .return-death .unity-toggle__checkmark {width:9px;height:9px;margin:0 var(--space-control) 0 0;border-width:0.5px;border-color:var(--line);border-radius:0;background-color:var(--field);-unity-background-image-tint-color:var(--on-accent);}
.gameplay .return-death:checked .unity-toggle__checkmark {background-color:var(--accent);border-color:var(--accent);}
.gameplay .return-death .unity-toggle__text {margin:0;padding:0;color:var(--text);}
.gameplay.narrow .button.ability {padding:var(--space-tight) 1px;margin-right:var(--space-tight);}
.gameplay.narrow .button.ability.last-ability {margin-right:0;}
.gameplay.narrow .hero .metric {margin-bottom:var(--space-tight);}
.gameplay .button.return-death {margin:0;}
.gameplay .return-death .unity-toggle__input {min-height:0;}

/* Restore the original compact HUD information: icon stats and a two-line breakdown action. */
.gameplay .hero-content {align-items:center;}
.gameplay .hero-portrait-frame {width:36px;height:38px;flex-shrink:0;margin-right:var(--space-control);align-items:center;justify-content:center;border-width:0.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);background-color:var(--control);}
.gameplay .hero-portrait-frame .icon {margin:0;}
.gameplay .hero-icon-stats {flex-direction:row;flex-wrap:wrap;flex-grow:1;flex-shrink:1;flex-basis:0;}
.gameplay .hero-stat {width:33.333%;align-items:center;min-height:12px;}
.gameplay .hero-stat .icon {margin-right:var(--space-tight);}
.gameplay .hero-stat Label {white-space:nowrap;}
.gameplay .hero > .health {margin-top:var(--space-control);margin-bottom:0;}
.gameplay .button.run-breakdown {position:absolute;right:0;bottom:0;align-items:center;min-width:92px;}
.gameplay .run-breakdown-dialog {width:260px;}
.gameplay .breakdown-summary {margin-bottom:var(--space-control);}
.gameplay .breakdown-resource {margin-bottom:var(--space-section);}
.gameplay .breakdown-resource > .row {align-items:center;margin-bottom:var(--space-tight);}
.gameplay .breakdown-amounts {margin-left:16px;}
.gameplay.narrow .hero-content {flex-direction:column;align-items:flex-start;}
.gameplay.narrow .hero-portrait-frame {margin-right:0;margin-bottom:var(--space-control);}
.gameplay.narrow .hero-icon-stats {flex-basis:auto;width:100%;}
.gameplay.narrow .hero-stat {width:50%;min-height:13px;}
.gameplay.narrow .hero-corner {bottom:36px;}
.gameplay.narrow .button.run-breakdown {min-width:0;width:100%;}

/* Compact perimeter cooldowns, with the game's existing echo automation marker. */
.gameplay .button.ability {width:29px;height:30px;flex-grow:0;flex-shrink:0;flex-basis:auto;padding:var(--space-tight);border-width:0;}
.gameplay .ability > .icon {margin:0;}
.gameplay .border-progress {position:absolute;left:0;right:0;top:0;bottom:0;--ring-color:var(--accent);--ring-track:var(--line);}
.gameplay .ability > .ability-echo {position:absolute;right:1.5px;top:1.5px;margin:0;}
.gameplay .hero-corner {width:240px;}
.gameplay .hero-vitals {flex-grow:1;flex-shrink:1;min-width:0;}
.gameplay .hero-vital-row {justify-content:space-between;}
.gameplay .hero-vital-row .hero-stat {width:auto;}
.gameplay .hero-vitals .health {margin-top:var(--space-tight);margin-bottom:0;}
.gameplay .hero-bottom-stats {justify-content:space-between;margin-top:var(--space-control);}
.gameplay .hero-bottom-stats .hero-stat {width:auto;}
.gameplay.narrow .hero-corner {width:100%;}
.gameplay.narrow .hero-content {flex-direction:row;align-items:center;}
.gameplay.narrow .hero-portrait-frame {width:28px;height:34px;margin-right:var(--space-control);margin-bottom:0;}
.gameplay.narrow .hero-portrait-frame .icon {width:24px;height:30px;}
.gameplay.narrow .hero-vital-row {flex-wrap:wrap;}
.gameplay.narrow .hero-vital-row .hero-stat {margin-right:var(--space-tight);}
.gameplay.narrow .hero-bottom-stats {flex-wrap:wrap;justify-content:flex-start;}
.gameplay.narrow .hero-bottom-stats .hero-stat {margin-right:var(--space-control);margin-bottom:var(--space-tight);}
.gameplay.narrow .button.ability {width:29px;height:30px;padding:var(--space-tight);margin-right:var(--space-tight);flex-grow:0;}

/* Run HUD corrections: original compact route, external echo marker, compact resource ledger. */
.gameplay .location {width:95px;background-color:transparent;border-width:0;padding:0;}
.gameplay .route-progress {height:12px;justify-content:center;margin:0 var(--space-control) var(--space-tight) 0;}
.gameplay .route-progress .track {height:3px;margin:0 var(--space-control);}
.gameplay .route-progress .icon {position:absolute;top:0;margin:0;}
.gameplay .route-hero {left:0;}
.gameplay .route-reaper {right:-3px;}
.gameplay .location > Label {color:#fff1df;}
.gameplay .ability {overflow:visible;}
.gameplay .ability > .ability-echo {right:-5px;top:-6px;}
.gameplay .abilities {margin-top:var(--space-control);}
.gameplay .hero-below {margin-top:var(--space-tight);}
.gameplay .run-breakdown-dialog {width:210px;padding:var(--space-section);}
.gameplay .breakdown-summary {margin-bottom:var(--space-control);}
.gameplay .breakdown-note {margin-bottom:var(--space-control);}
.gameplay .breakdown-resource {align-items:center;margin-bottom:var(--space-control);flex-shrink:0;}
.gameplay .breakdown-resource .grow > .strong {margin-bottom:1px;}
.gameplay .breakdown-resource .grow > .row {margin-bottom:0;}
.gameplay #run-breakdown-resources {margin-bottom:var(--space-control);}
.gameplay.narrow .location {width:95px;}
.gameplay.narrow .hero-vital-row {flex-wrap:nowrap;}
.gameplay.narrow .hero-vital-row .hero-stat {margin-right:0;}
.gameplay.narrow.large .hero-below {flex-wrap:wrap;}
.gameplay.narrow .run-breakdown-dialog {padding:var(--space-control);}
.gameplay.narrow .breakdown-resource > .icon {width:12px;height:12px;margin-right:var(--space-tight);}

.gameplay .ability > .ability-echo {width:20px;height:20px;right:-7px;top:-8px;}

/* Hero footprint follows text scale; narrow screens retain the available safe width. */
.gameplay .hero-corner {width:180px;max-width:100%;}
.gameplay.large .hero-corner {width:210px;}
.gameplay.narrow .hero-corner,.gameplay.narrow.large .hero-corner {width:100%;}
.gameplay .hero-content {min-width:0;}
.gameplay .hero-vital-row .hero-stat {flex-shrink:0;}

/* Original breakdown structure: broad three-column ledger with header and footer. */
.gameplay .breakdown-sheet {width:420px;height:200px;padding:var(--space-control);}
.gameplay.large .breakdown-sheet {width:520px;height:235px;}
.gameplay .breakdown-header {align-items:center;flex-shrink:0;margin-bottom:var(--space-control);}
.gameplay .breakdown-rate {width:30%;}
.gameplay .breakdown-title {width:40%;margin:0;-unity-text-align:middle-center;}
.gameplay .breakdown-time {width:30%;margin-left:auto;-unity-text-align:middle-right;}
.gameplay #run-ledger {flex-grow:1;flex-shrink:1;min-height:0;}
.gameplay .run-ledger-grid {flex-direction:row;flex-wrap:wrap;}
.gameplay .ledger-entry {width:33.333%;min-width:0;min-height:33px;align-items:center;padding:var(--space-control) var(--space-control) var(--space-control) 0;flex-shrink:0;}
.gameplay .ledger-entry .icon {margin-right:var(--space-control);}
.gameplay .ledger-values {flex-grow:1;flex-shrink:1;min-width:0;}
.gameplay .ledger-values Label {white-space:nowrap;}
.gameplay .breakdown-footer {flex-shrink:0;justify-content:space-between;align-items:flex-end;margin-top:var(--space-control);}
.gameplay .ledger-footer-left,.gameplay .ledger-footer-right {flex-shrink:1;}
.gameplay .ledger-footer-right Label {-unity-text-align:middle-right;}
.gameplay.narrow .breakdown-sheet,.gameplay.narrow.large .breakdown-sheet {width:94%;height:280px;max-height:90%;padding:var(--space-control);}
.gameplay.narrow .breakdown-header {flex-wrap:wrap;}
.gameplay.narrow .breakdown-rate {width:100%;margin-bottom:var(--space-tight);}
.gameplay.narrow .breakdown-title {width:75%;-unity-text-align:middle-left;}
.gameplay.narrow .breakdown-time {width:25%;}
.gameplay.narrow .ledger-entry {width:100%;min-height:31px;padding-right:0;}
.gameplay.narrow .breakdown-footer {flex-direction:column;align-items:flex-start;}
.gameplay.narrow .ledger-footer-right {margin-top:var(--space-tight);}
.gameplay.narrow .ledger-footer-right Label {-unity-text-align:middle-left;}

/* Run progress sits beside Library, with larger aspect-preserved endpoint sprites. */
.gameplay .nav-links {align-items:center;}
.gameplay .nav-links .location {width:118px;margin-left:var(--space-control);flex-shrink:1;min-width:78px;align-self:center;}
.gameplay .route-progress {height:16px;margin:0 var(--space-section) 1px 0;}
.gameplay .route-progress .track {height:4px;margin:0 7px;}
.gameplay .route-progress .icon {top:-1px;}
.gameplay .route-hero {left:-1px;}
.gameplay .route-reaper {right:-6px;}
.gameplay .location > Label {font-size:var(--body);}
.gameplay.narrow .location {width:118px;max-width:100%;}

/* Original stacked retreat controls: primary-sized town action, smaller death action. */
.gameplay .navigation {align-items:flex-start;}
.gameplay .return-actions {align-items:flex-end;flex-shrink:0;margin-left:var(--space-control);}
.gameplay .button.retreat-action {min-height:22px;white-space:nowrap;}
.gameplay .button.death-return-action {min-height:14px;padding:1.5px var(--space-control);margin-top:var(--space-tight);font-size:var(--small);white-space:nowrap;}
.gameplay.narrow .return-actions {margin-left:var(--space-tight);}
.gameplay.narrow .button.retreat-action {font-size:var(--small);padding:var(--space-tight);white-space:normal;max-width:56px;}
.gameplay.narrow .button.death-return-action {font-size:var(--small);padding:1.5px var(--space-tight);white-space:normal;max-width:56px;}

/* Match visible artwork rather than padded sprite rectangles (hero 20/32 high; reaper 33/64). */
.gameplay .route-progress {height:20px;}
.gameplay .route-progress .route-hero {width:32px;height:32px;left:-7px;top:-5px;}
.gameplay .route-progress .route-reaper {width:40px;height:40px;right:-11px;top:-11.5px;}

/* Original reaper is mirrored; compensate its asymmetric transparent padding. */
.gameplay .route-progress .route-reaper {right:-16.5px;}

/* Align the distance track with its numeric label; keep the endpoint unchanged. */
.gameplay .route-progress .track {margin-left:0;}

/* Live game adapters retain existing routing and scale with the shared safe area. */
.gameplay .eov-run-return {top:8px;right:8px;}
.gameplay .eov-run-return #run-return {width:auto;height:auto;min-height:22px;font-size:var(--body);padding:var(--space-control) var(--space-control);}
.gameplay .eov-run-return #run-return-on-death {width:auto;height:auto;min-height:14px;font-size:var(--small);padding:1.5px var(--space-control);margin-top:var(--space-tight);}
.gameplay .eov-run-breakdown {right:8px;bottom:8px;width:auto;height:auto;min-width:92px;font-size:var(--body);padding:var(--space-control) var(--space-control);align-items:center;justify-content:center;}
.gameplay .run-breakdown-totals {align-self:stretch;align-items:center;justify-content:space-between;}
.gameplay .run-breakdown-resource-count {align-items:center;justify-content:center;}
.gameplay .run-breakdown-resource-count > .icon {margin-right:3px;}
.gameplay .run-breakdown-kills {align-items:center;}
.gameplay .run-breakdown-kills > .icon {margin-right:3px;}
.gameplay .run-breakdown-bonus {align-items:center;margin-left:10px;}
.gameplay .run-breakdown-bonus > .icon {margin-right:3px;translate:0 -1.5px;}
.gameplay .eov-run-button {text-shadow:none;-unity-text-outline-width:0;}
.gameplay .eov-run-overlay {top:30px;background-color:rgba(0,0,0,.45);}
.gameplay .ledger-entry Label {white-space:normal;flex-shrink:1;}
.gameplay .eov-navigation-bar,.gameplay .eov-navigation-buttons,.gameplay .eov-navigation-context {height:30px;align-items:center;}
.gameplay .eov-navigation-button {font-size:var(--body);min-height:22px;padding:var(--space-control) var(--space-control);}
.gameplay .eov-navigation-label {font-size:var(--body);text-shadow:none;-unity-text-outline-width:0;color:var(--text);}
.gameplay .eov-navigation-popup {top:32px;}
.gameplay .eov-navigation-progress {width:118px;height:30px;margin-left:var(--space-control);}
.gameplay .eov-navigation-progress-track {left:0;top:8px;width:103px;height:4px;margin:0;}
.gameplay .eov-navigation-progress-text {left:0;top:21px;font-size:var(--body);text-shadow:none;-unity-text-outline-width:0;}
.gameplay .progress-hero {width:32px;height:32px;top:-5px;}
.gameplay .progress-reaper {width:40px;height:40px;left:85.5px;top:-11.5px;}

.gameplay.live-cauldron {padding:var(--space-panel);background-color:var(--surface);border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .collection-detail {position:absolute;left:25%;right:25%;bottom:12px;padding:var(--space-section);max-height:65%;}
.gameplay .collection-detail Label {font-size:var(--small);white-space:normal;}
.gameplay .collection-dialog {width:310px;padding:12px;}
.gameplay .collection-dialog .collection-details-text {font-size:12px;white-space:normal;}
.gameplay .collection-dialog .collection-details-title {font-size:14px;-unity-font-style:bold;margin-bottom:12px;}
.gameplay .collection-dialog .collection-detail-row {align-items:flex-start;margin-bottom:8px;}
.gameplay .collection-dialog .collection-detail-name {font-size:12px;flex-grow:1;flex-shrink:1;min-width:0;}
.gameplay .collection-dialog .collection-detail-value {font-size:12px;margin-left:12px;white-space:nowrap;}
.gameplay .collection-dialog .collection-detail-total {border-top-width:.5px;border-top-color:var(--line);padding-top:8px;}
.gameplay .collection-dialog .collection-detail-next {margin-top:4px;}
.gameplay .collection-dialog .scroll {flex-shrink:1;}
.gameplay .collection-dialog .button {min-height:32px;font-size:12px;margin-top:12px;}
.gameplay .ledger-entry {flex-shrink:0;}

.gameplay.eov-navigation {height:38px;overflow:visible;}
.gameplay.eov-navigation--window-open .eov-navigation-bar {overflow:visible;}
.gameplay .eov-navigation-progress-text {color:#fff1df;}
.gameplay .button:disabled {opacity:.45;}
/* Settings retain the original groups and save-slot actions, without nested frames. */
.gameplay.settings-page {right:auto;bottom:auto;background-color:var(--surface);padding:var(--space-panel);border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay.settings-page .eov-options-frame {padding:0;margin-bottom:var(--space-section);}
.gameplay.settings-page .eov-options-slot {padding:0;margin-top:var(--space-tight);}
.gameplay.settings-page .eov-options-spaced {margin-right:var(--space-control);}
.gameplay.settings-page .eov-options-label {color:var(--text);text-shadow:none;-unity-text-outline-width:0;}
.gameplay.settings-page .eov-options-button {min-height:18px;padding:var(--space-tight) var(--space-tight);}
.gameplay.settings-page .eov-options-transfers {padding:0;margin-left:var(--space-control);}
.gameplay.settings-page .eov-options-button:disabled {opacity:.45;}
.gameplay .gameplay-slider .unity-tracker {height:3px;background-color:var(--line);border-width:0;}
.gameplay .gameplay-slider .eov-slider-fill {background-color:var(--accent);}
.gameplay .gameplay-slider .unity-dragger {width:6px;background-color:var(--accent);border-width:.5px;border-color:var(--on-accent);}
.gameplay .eov-options-dialog {border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);padding:var(--space-section);}
.gameplay .eov-options-transfer-dialog {height:190px;}
.gameplay .eov-options-input-frame {height:120px;background-color:var(--field);margin-top:var(--space-control);padding:var(--space-control);}
.gameplay .eov-options-input > .unity-base-text-field__input {color:var(--text);background-color:var(--field);}
.gameplay .eov-options-transfer-status {height:auto;min-height:12px;font-size:var(--small);white-space:normal;margin-top:var(--space-control);}
.gameplay .odds-heading {margin-top:var(--space-control);}
/* Buff assignment: stable slots, readable effects, existing assign-then-slot workflow. */
.gameplay.eov-buffs {right:auto;bottom:auto;padding:var(--space-section);background-color:var(--surface);border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .eov-buffs-header {height:auto;min-height:36px;margin-bottom:var(--space-section);align-items:center;}
.gameplay .eov-buffs-slots {width:174px;padding:var(--space-tight) 0;overflow:visible;}
.gameplay .eov-buffs-slot {width:29px;height:30px;margin-right:var(--space-control);padding:0;}
.gameplay .eov-buffs-slot-icon {left:4px;top:4px;width:21px;height:21px;}
.gameplay .eov-buffs-auto {left:19px;top:-7px;width:20px;height:20px;}
.gameplay .eov-buffs-instructions {width:auto;flex-grow:1;flex-basis:0;min-width:0;padding:0;margin-left:var(--space-control);}
.gameplay .eov-buffs-label {text-shadow:none;-unity-text-outline-width:0;white-space:normal;}
.gameplay .eov-buff-line {height:auto;min-height:34px;align-items:center;}
.gameplay .eov-buff-row {padding:var(--space-control) 0;margin-bottom:var(--space-tight);}
.gameplay .eov-buff-icon-frame {width:30px;height:30px;margin-right:var(--space-control);}
.gameplay .eov-buff-assign {height:23px;width:52px;padding:var(--space-tight);}
.gameplay .eov-buff-target {align-self:flex-start;min-width:140px;height:22px;margin-left:36px;padding:0;}
.gameplay .eov-buffs-inset {padding:0;}
.gameplay .eov-buffs-slot-locked {width:29px;left:0;top:18px;}
.gameplay.eov-skills {right:auto;bottom:auto;background-color:var(--surface);padding:var(--space-panel);border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .eov-skills-left {width:35%;margin-right:var(--space-section);}
.gameplay .eov-skill-frame {padding:0;}
.gameplay .eov-skills-header {margin-bottom:var(--space-section);}
.gameplay .eov-skills-selectors {height:auto;flex-wrap:wrap;margin-bottom:var(--space-control);justify-content:flex-start;}
.gameplay .eov-skills-selector {width:32px;height:40px;margin:0 var(--space-control) var(--space-control) 0;padding:var(--space-tight);align-items:center;justify-content:flex-start;}
.gameplay .eov-skill-selector-level {position:relative;top:auto;left:auto;width:100%;height:12px;min-height:12px;margin:var(--space-tight) 0 0 0;-unity-text-align:middle-center;white-space:nowrap;}
.gameplay .skill-selector-icon {width:20px;height:20px;flex-shrink:0;}
.gameplay .eov-skill-text {text-shadow:none;-unity-text-outline-width:0;margin-bottom:var(--space-tight);}
.gameplay .eov-skill-info .eov-skill-text {height:auto;-unity-text-align:middle-left;}
.gameplay .eov-milestone-row {padding:var(--space-control) 0;margin-bottom:var(--space-section);}
.gameplay .eov-milestone-row.locked {opacity:.55;}
.gameplay .selection-outline {border-width:1px;border-color:var(--accent);}
.gameplay .eov-skill-set {margin-bottom:var(--space-section);}
.gameplay .eov-prospector {color:var(--text);}
.gameplay .eov-prospector .surface {border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .gameplay-slider .unity-base-field__input {min-height:0;background-color:transparent;border-width:0;}
.gameplay .gameplay-slider #unity-tracker {height:3px;background-color:var(--line);border-width:0;}
.gameplay .gameplay-slider #unity-dragger {width:6px;background-color:var(--accent);border-width:.5px;border-color:var(--on-accent);}
.gameplay .gameplay-slider #value-fill {background-color:var(--accent);}
.gameplay.settings-page #vsync-label {min-width:26px;flex-shrink:0;white-space:nowrap;}
.gameplay .eov-skill-info .eov-skill-text {font-size:var(--body);}
.gameplay .gameplay-scroll .unity-scroller--vertical {width:3px;margin-left:var(--space-control);}
.gameplay .gameplay-scroll .unity-scroller--vertical .unity-base-slider {width:3px;}
.gameplay .gameplay-scroll .unity-scroller--vertical #unity-tracker {background-color:var(--field);width:3px;}
.gameplay .gameplay-scroll .unity-scroller--vertical #unity-dragger {background-color:var(--line);width:3px;border-width:0;}
/* Shared flat menu shell. Sections use spacing; controls retain a shallow bevel. */
.gameplay.menu-surface {right:auto;bottom:auto;background-color:var(--surface);padding:var(--space-panel);border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .eov-quest-text,.gameplay .eov-alter-text,.gameplay .eov-stat-text,.gameplay .eov-chapter-body,.gameplay .eov-chapter-title {text-shadow:none;-unity-text-outline-width:0;color:var(--text);}
.gameplay .eov-quest-row {padding:var(--space-control) 0;margin:0 0 var(--space-section) 0;}
.gameplay .eov-quest-instructions {height:auto;min-height:14px;margin-bottom:var(--space-control);}
.gameplay .eov-quest-entries {padding:var(--space-control) 0;}
.gameplay .eov-quest-turn-in {height:auto;min-height:22px;}
.gameplay .eov-chapter-header {height:auto;min-height:23px;padding:var(--space-control) var(--space-control);}
.gameplay .eov-chapter-title {font-size:var(--body);}
.gameplay .eov-chapter-body {font-size:var(--body);white-space:normal;}
.gameplay .eov-chapter-content {padding:var(--space-control) 0 var(--space-section) 0;}
.gameplay .eov-credit {padding:var(--space-control) 0;margin-bottom:var(--space-section);}
.gameplay .eov-stat-tabs {height:auto;min-height:22px;margin-bottom:var(--space-control);}
.gameplay .eov-stat-tab {min-height:22px;height:auto;}
.gameplay .eov-stat-summary {padding:var(--space-control) 0;margin-bottom:var(--space-section);}
.gameplay .eov-stat-summary-icon {margin-right:var(--space-section);}
.gameplay .eov-stat-body {min-height:0;}
.gameplay .eov-alter-header {height:26px;margin-bottom:var(--space-control);align-items:center;}
.gameplay .eov-alter-row {padding:var(--space-control) 0;margin-bottom:var(--space-section);}
.gameplay .eov-alter-row-main {height:auto;min-height:38px;align-items:center;}
.gameplay .eov-alter-row-labels {min-height:35px;}
.gameplay .eov-alter-action {min-height:22px;}
.gameplay .eov-alter-track {margin-top:var(--space-control);}
.gameplay .eov-alter-resource {width:38px;height:36px;padding:0;}
.gameplay .eov-text {text-shadow:none;-unity-text-outline-width:0;color:var(--text);}
.gameplay .eov-text--caption {font-size:var(--small);}
.gameplay .eov-text--body {font-size:var(--body);}
.gameplay .eov-text--subheading {font-size:var(--heading);}
.gameplay .eov-text--heading {font-size:var(--heading);}
.gameplay .eov-stat-entry {padding:var(--space-control) 0;min-height:40px;height:auto;margin-bottom:var(--space-control);}
.gameplay .eov-stat-item {height:auto;min-height:48px;padding:var(--space-control) 0;margin-bottom:var(--space-control);}
.gameplay .eov-stat-entry-field {font-size:var(--small);}
.gameplay .eov-forge-panel {padding:0;margin-bottom:var(--space-section);}
.gameplay .eov-forge-columns {height:auto;min-height:170px;}
.gameplay .eov-forge-selections {width:108px;margin-right:var(--space-section);}
.gameplay .eov-forge-slot {width:23px;height:25px;padding:var(--space-tight);min-height:25px;}
.gameplay .eov-forge-core {height:38px;min-height:38px;padding:0;align-items:center;background-color:transparent;}
.gameplay .eov-forge-core .eov-text {font-size:var(--small);}
.gameplay .eov-forge-core-frame {width:23px;height:23px;}
.gameplay .eov-forge-actions {margin-right:var(--space-section);}
.gameplay .eov-forge-results {width:135px;}
.gameplay .eov-forge-sidebar {width:178px;padding:0;}
.gameplay .eov-forge-button {height:auto;min-height:22px;font-size:var(--body);text-shadow:none;-unity-text-outline-width:0;}
.gameplay .eov-forge-toggle {min-height:30px;}
.gameplay .eov-forge-toggle .eov-text {font-size:var(--small);}
.gameplay .eov-forge-xp {height:3px;margin-top:var(--space-control);}
.gameplay .eov-forge-conversion {height:58px;padding:var(--space-tight);}
.gameplay .eov-forge-conversion .eov-text {font-size:var(--small);}
.gameplay .eov-forge-conversion .eov-icon {width:16px;height:16px;}
.gameplay .eov-forge-information-title {height:auto;min-height:24px;padding:0;}
.gameplay .eov-forge-sidebar .eov-disclosure-header {height:auto;min-height:22px;}
.gameplay .eov-resource-slot {padding:0;border-bottom-width:1px;border-bottom-color:var(--tier-colour);}
.gameplay .eov-resource-title {height:14px;}
.gameplay .eov-resource-name {font-size:var(--small);height:auto;}
.gameplay .eov-resource-count {font-size:var(--small);}
.gameplay.eov-resource-inventory {padding:var(--space-control);}
.gameplay.eov-dialog,.gameplay.eov-intro,.gameplay.eov-toast,.gameplay.eov-quit,.gameplay.eov-pinned-goals,.gameplay.compact-overlay {right:auto;bottom:auto;}
.gameplay.eov-meeting {right:auto;bottom:auto;overflow:visible;}
.gameplay.eov-pinned-goals {overflow:visible;}
.gameplay .eov-pinned-background {border-radius:0;}
.gameplay .eov-dialog-frame {padding:var(--space-panel);border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .eov-dialog-title {font-size:12px;margin-bottom:var(--space-section);}
.gameplay .eov-dialog-body {font-size:var(--body);}
.gameplay .eov-dialog-actions {margin-top:var(--space-section);}
.gameplay .eov-dialog-button {height:auto;min-height:24px;}
.gameplay .eov-intro-close {padding:var(--space-panel);border-width:.5px;border-color:var(--panel-edge);border-top-color:var(--panel-light);}
.gameplay .eov-intro-title {font-size:12px;margin-bottom:var(--space-control);}
.gameplay .eov-intro-body {font-size:var(--body);color:var(--text);}
.gameplay .eov-intro-close-label {font-size:var(--body);margin-top:var(--space-section);}
.gameplay .eov-intro-action {margin:0;padding:0;border-width:0;border-radius:0;background-color:rgba(0,0,0,0);flex-shrink:0;}
.gameplay .eov-meeting-dialogue {font-size:var(--body);color:var(--text);}
.gameplay .eov-meeting-dialogue-frame {width:160px;padding:var(--space-section);}
.gameplay .eov-meeting-button {min-height:22px;padding:var(--space-tight);}
.gameplay.eov-quit {height:auto;}
.gameplay .eov-quit-button {min-height:22px;padding:var(--space-tight);}
.gameplay #discord-icon {--unity-image-tint-color:var(--text);}
.gameplay .eov-number-field .unity-base-text-field__input {background-color:var(--field);color:var(--text);border-width:.5px;border-color:var(--line);}
.gameplay .eov-navigation-auto-pin {background-image:none;height:22px;padding:0;margin-left:var(--space-control);align-items:center;}
.gameplay .eov-navigation-toggle {width:22px;height:22px;padding:0;}
.gameplay .eov-navigation-auto-pin-label {color:var(--text);font-size:var(--small);}
.gameplay .active > Label {color:var(--on-accent);}
.gameplay .eov-alter-row {height:auto;min-height:54px;}
.gameplay .eov-alter-resource-icon {left:8px;top:2px;width:22px;height:22px;}
.gameplay .eov-alter-pending {left:1px;top:26px;width:36px;height:9px;font-size:var(--small);}
.gameplay .eov-alter-action:disabled {opacity:.45;color:var(--muted);}
.gameplay .eov-stat-summary-icon {width:56px;}
.gameplay .eov-stat-summary-icon Label {font-size:var(--body);}
.gameplay .eov-options-input-frame {flex-grow:1;min-height:0;}

.gameplay .eov-meeting-portrait-frame {overflow:hidden;}
.gameplay .eov-navigation-balance-label {color:var(--text);font-size:var(--body);}


.gameplay .gameplay-slider #unity-tracker {width:auto;left:0;right:0;}
.gameplay .eov-number-field #unity-text-input,.gameplay .eov-number-field #unity-text-input .unity-text-element {color:var(--text);background-color:var(--field);}

.gameplay .card.reward-highlight {background-color:var(--selected);border-color:var(--accent);}
.gameplay .breakdown-title {position:absolute;left:25%;width:50%;}
.gameplay .eov-run-death {width:120px;padding:var(--space-control);}
.gameplay .eov-run-death .button {margin-top:var(--space-tight);}

.gameplay.compact-width .food {width:31%;margin-right:2%;}

.gameplay.compact-width .eov-forge-sidebar {width:135px;}
.gameplay.compact-width .eov-forge-selections {width:95px;}
.gameplay.compact-width .eov-forge-results {width:95px;}
.gameplay.compact-width .forge-toggles {flex-direction:column;}
.gameplay.compact-width .eov-forge-toggle {min-height:22px;flex-basis:auto;}
.gameplay .eov-forge-main {min-height:0;}

.gameplay .gameplay-scroll .unity-scroller--vertical .unity-base-slider {min-width:3px;max-width:3px;margin:0;padding:0;}
.gameplay .gameplay-scroll .unity-scroller--vertical .unity-base-field__input {min-width:0;min-height:0;margin:0;padding:0;background-color:transparent;border-width:0;}
.gameplay .gameplay-scroll .unity-scroller--vertical #unity-dragger-border {display:none;}
.gameplay .gameplay-scroll .unity-scroller--vertical #unity-tracker {border-width:0;left:0;right:0;}
.gameplay .gameplay-scroll .unity-scroller--vertical #unity-dragger {left:0;right:0;}

/* Shared input controls. State is drawn inside one checkbox, never a second button. */
.gameplay .button.check-control {flex-direction:row;align-items:center;justify-content:flex-start;padding:var(--space-control);min-height:22px;height:auto;background-color:transparent;border-width:0;border-radius:0;}
.gameplay .button.check-control:hover {background-color:var(--hover);}
.gameplay .button.check-control--standalone {width:22px;min-width:22px;max-width:22px;height:22px;min-height:22px;justify-content:center;flex-grow:0;flex-shrink:0;}
.gameplay .check-mark {width:12px;height:12px;flex-shrink:0;margin-right:var(--space-control);border-width:1px;border-color:var(--muted);background-color:var(--field);}
.gameplay .check-control--standalone .check-mark {margin:0;}
.gameplay .check-mark.checked {background-color:var(--accent);border-color:var(--accent);}
.gameplay .eov-milestone-controls {height:22px;align-items:center;}
.gameplay .eov-milestone-body {margin-right:var(--space-section);}
.gameplay .eov-milestone-right {min-width:44px;}
.gameplay .close-control {width:22px;min-width:22px;height:22px;min-height:22px;padding:0;font-size:16px;-unity-text-align:middle-center;}
.gameplay .eov-navigation-row {margin-right:var(--space-control);}
.gameplay .eov-navigation-popup .eov-navigation-row {margin-bottom:var(--space-control);}
.gameplay .eov-stat-entry {padding:var(--space-control) 0;margin-bottom:var(--space-section);}
.gameplay .eov-stat-entry-header {margin-bottom:var(--space-control);}
.gameplay .eov-options-spaced {margin-right:var(--space-section);}
.gameplay .eov-skill-info {padding:0;}

.gameplay.keyboard .check-control:focus .check-mark {border-color:var(--text);border-width:2px;}

/* Dad-o-cado is an in-scene conversation, never a dimmed window. */
.gameplay .eov-town-joke {right:auto;bottom:auto;width:54.45px;height:17px;min-height:17px;padding:2px 4px;font-size:var(--small);}
.gameplay .town-joke-bubble {position:absolute;width:84.39px;min-height:32px;padding:4px 9px 6px 5px;}
.gameplay .town-joke-text {white-space:normal;font-size:var(--small);color:rgb(60,38,49);-unity-font-style:bold;}

.gameplay .town-joke-art {position:absolute;left:0;right:0;top:0;bottom:0;scale:-1 1;}

.gameplay .town-joke-countdown {position:absolute;left:5px;right:9px;bottom:3px;height:1.5px;background-color:rgba(60,38,49,.2);}
.gameplay .town-joke-countdown-fill {height:100%;width:100%;background-color:rgb(60,38,49);}

/* Skills: one consistent entry, with a restrained divider rather than nested cards. */
.gameplay .skill-entry-divider {position:absolute;left:0;right:0;bottom:0;height:.5px;background-color:rgba(239,209,180,.10);}
.gameplay .skill-entry-icon-frame {width:24px;height:24px;flex-shrink:0;margin-right:var(--space-control);padding:0;background-color:var(--control);border-width:.5px;border-color:var(--panel-edge);align-items:center;justify-content:center;}
.gameplay .skill-entry-heading {flex-direction:row;align-items:baseline;flex-wrap:nowrap;}
.gameplay .skill-entry-name {-unity-font-style:bold;white-space:nowrap;margin-right:var(--space-control);}
.gameplay .skill-entry-next {color:var(--muted);font-size:var(--small);white-space:nowrap;}
.gameplay .eov-milestone-right {min-width:22px;}
.gameplay .skill-all-bonuses {align-self:flex-start;margin-top:var(--space-control);padding:var(--space-control);-unity-text-align:middle-center;}

.gameplay .skill-entry-icon-crop {width:100%;height:100%;flex-shrink:0;overflow:hidden;align-items:center;justify-content:center;}

.gameplay .eov-milestone-row.unlocked .skill-entry-icon-frame {border-color:#d0a166;}
.gameplay .eov-milestone-row.milestone-enabled .skill-entry-icon-frame {border-color:#b38ac9;}

.gameplay .skill-summary-line {flex-direction:row;align-items:center;min-height:16px;margin-bottom:2px;}
.gameplay .skill-summary-icon {width:16px;height:16px;flex-shrink:0;overflow:hidden;align-items:center;justify-content:center;margin-right:var(--space-control);}

.gameplay .skill-summary-line .eov-skill-text {margin-bottom:0;}

/* Shared task/enemy statistics rows: native-scale art and aligned information. */
.gameplay .eov-stat-entry {align-items:center;min-height:48px;padding:var(--space-control) 0;margin-bottom:0;border-bottom-width:.5px;border-bottom-color:rgba(239,209,180,.10);}
.gameplay .eov-stat-entry .eov-stat-entry-icon {width:32px;height:32px;min-height:32px;padding:0;margin-right:var(--space-section);background-color:var(--control);border-width:.5px;border-color:var(--panel-edge);}
.gameplay .eov-stat-entry.known .eov-stat-entry-icon {border-color:#d0a166;}
.gameplay .eov-task-entry.boosted .eov-stat-entry-icon {border-color:#b38ac9;}
.gameplay .stat-icon-crop {width:100%;height:100%;flex-shrink:0;overflow:hidden;align-items:center;justify-content:center;}
.gameplay .eov-stat-entry .eov-stat-entry-header {align-items:baseline;margin-bottom:var(--space-tight);}
.gameplay .eov-stat-entry .eov-stat-entry-header > .eov-text {flex-grow:0;-unity-font-style:bold;white-space:normal;}
.gameplay .eov-stat-entry .eov-stat-entry-header > .stat-entry-id {flex-grow:0;margin-left:var(--space-control);font-size:var(--small);color:var(--muted);-unity-font-style:normal;}
.gameplay .eov-stat-entry .eov-stat-entry-fields {flex-wrap:wrap;}
.gameplay .eov-task-entry .eov-stat-entry-field {min-width:128px;margin-right:var(--space-section);white-space:normal;}
.gameplay .eov-task-entry .eov-stat-entry-toggle {width:auto;height:auto;min-width:48px;align-self:center;margin-left:var(--space-control);}
.gameplay .task-boost-label {font-size:var(--small);white-space:nowrap;}

.gameplay .eov-enemy-entry .eov-stat-entry-field {min-width:104px;margin-right:var(--space-control);white-space:normal;}
.gameplay .eov-enemy-entry .eov-stat-entry-field.row-end {margin-right:0;}
.gameplay .eov-enemy-entry .eov-stat-entry-progress {height:3px;margin-top:var(--space-control);}
.gameplay .eov-stat-distance {padding:var(--space-control) 0;margin-top:var(--space-control);margin-bottom:var(--space-control);}

.gameplay .enemy-stat-column {flex-grow:1;flex-basis:0;min-width:104px;margin-right:var(--space-control);}
.gameplay .enemy-stat-column.row-end {margin-right:0;}
.gameplay .enemy-stat-metric {flex-direction:row;align-items:center;min-height:16px;}
.gameplay .enemy-stat-symbol {width:16px;height:16px;flex-shrink:0;align-items:center;justify-content:center;overflow:hidden;margin-right:var(--space-control);}
.gameplay .enemy-stat-name {font-size:var(--small);color:var(--muted);margin-right:var(--space-control);}
.gameplay .enemy-stat-value {font-size:var(--small);white-space:nowrap;}

/* Items share the statistics row rhythm; tier colour remains meaningful. */
.gameplay .eov-stat-item {align-items:center;min-height:48px;padding:var(--space-control) 0;margin-bottom:0;border-bottom-width:.5px;border-bottom-color:rgba(239,209,180,.10);}
.gameplay .eov-stat-item-icon-frame {width:32px;height:32px;flex-shrink:0;padding:0;margin-right:var(--space-section);background-image:none;background-color:var(--control);border-width:.5px;border-color:var(--panel-edge);}

.gameplay .eov-stat-item-icon-mask {position:relative;left:0;top:0;width:100%;height:100%;margin:0;padding:0;overflow:hidden;align-items:center;justify-content:center;}
.gameplay .item-stat-content {flex-grow:1;flex-basis:0;min-width:0;}
.gameplay .item-stat-heading {flex-direction:row;align-items:baseline;margin-bottom:var(--space-tight);}
.gameplay .item-stat-title {flex-shrink:1;min-width:0;font-size:var(--body);-unity-font-style:bold;white-space:normal;}
.gameplay .item-stat-rarity {flex-direction:row;align-items:center;margin-left:var(--space-control);flex-shrink:0;color:var(--muted);}
.gameplay .item-stat-count {font-size:var(--small);-unity-font-style:normal;margin-bottom:var(--space-tight);}
.gameplay .item-stat-fields {flex-direction:row;}
.gameplay .item-stat-totals,.gameplay .item-stat-detail {flex-grow:1;flex-basis:0;min-width:0;font-size:var(--small);white-space:normal;color:var(--muted);}
.gameplay .item-stat-totals {margin-right:var(--space-control);}

.gameplay .item-stat-id {margin-left:auto;padding-left:var(--space-control);font-size:var(--small);color:var(--muted);flex-shrink:0;}

/* General statistics share the list spacing and native-pixel artwork treatment. */
.gameplay .eov-stat-summary {align-items:center;padding:var(--space-tight) 0;margin-bottom:0;border-bottom-width:.5px;border-bottom-color:rgba(239,209,180,.10);}
.gameplay .general-identity {width:80px;flex-shrink:0;align-items:center;margin-right:var(--space-section);}
.gameplay .general-art-frame {width:32px;height:32px;background-color:var(--control);border-width:.5px;border-color:var(--panel-edge);}
.gameplay .general-art-mask {width:100%;height:100%;overflow:hidden;align-items:center;justify-content:center;}
.gameplay .general-title {font-size:var(--body);-unity-font-style:bold;margin-top:var(--space-tight);white-space:normal;-unity-text-align:middle-center;}
.gameplay .general-metrics {flex-grow:1;min-width:0;flex-direction:row;}
.gameplay .general-column {flex-grow:1;flex-basis:0;min-width:0;margin-right:var(--space-section);}
.gameplay .general-column.general-column-last {margin-right:0;}
.gameplay .general-metric {flex-direction:row;align-items:baseline;min-height:9px;margin-bottom:0;}
.gameplay .general-metric-name {font-size:var(--small);color:var(--muted);flex-grow:1;flex-shrink:1;white-space:normal;}
.gameplay .general-metric-value {font-size:var(--small);flex-shrink:0;margin-left:var(--space-control);-unity-text-align:middle-right;}
.gameplay .journal-layout {flex-direction:row;flex-grow:1;min-height:0;}
.gameplay .journal-selectors {flex-direction:column;flex-shrink:0;width:72px;margin-right:var(--space-section);}
.gameplay .journal-selector {flex-grow:1;flex-basis:0;min-height:40px;min-width:0;flex-direction:column;align-items:center;justify-content:center;margin-bottom:var(--space-control);padding:var(--space-tight);}
.gameplay .journal-selector.journal-selector-last {margin-bottom:0;}
.gameplay .journal-selector Label {font-size:var(--small);-unity-font-style:bold;}
.gameplay .journal-art {width:28px;height:28px;overflow:hidden;align-items:center;justify-content:center;flex-shrink:0;}
.gameplay .journal-heading {font-size:11px;-unity-font-style:bold;margin-bottom:var(--space-section);}
.gameplay .journal-content {flex-grow:1;min-width:0;min-height:0;}
.gameplay .journal-columns {flex-direction:row;flex-grow:1;min-height:0;}
.gameplay .journal-main {flex-grow:2;flex-basis:0;min-width:0;margin-right:16px;}
.gameplay .journal-side {flex-grow:3;flex-basis:0;min-width:0;min-height:0;}
.gameplay .journal-section-title {font-size:var(--body);-unity-font-style:bold;margin-bottom:var(--space-control);}
.gameplay .journal-note {font-size:var(--small);color:var(--muted);white-space:normal;margin-bottom:var(--space-control);}
.gameplay .journal-rates {flex-direction:row;margin-top:var(--space-control);margin-bottom:var(--space-section);}
.gameplay .journal-rate {flex-grow:1;flex-basis:0;min-width:0;}
.gameplay .journal-rate-value {font-size:10px;}
.gameplay .journal-run {height:20px;min-height:20px;flex-direction:row;align-items:center;justify-content:flex-start;padding:var(--space-control) 0;margin:0;background-color:transparent;border-width:0;border-bottom-width:.5px;border-bottom-color:rgba(239,209,180,.10);}
.gameplay .journal-run Label {font-size:var(--small);}
.gameplay .journal-run-number {width:28px;flex-shrink:0;}
.gameplay .journal-run-duration {width:46px;flex-shrink:0;color:var(--muted);}
.gameplay .journal-run-rewards {flex-grow:1;}
.gameplay .journal-run .journal-run-outcome {font-size:var(--small);color:var(--muted);}
.gameplay .journal-run-detail {font-size:var(--small);white-space:normal;margin-top:var(--space-control);}
.gameplay .journal-lifetime {border-bottom-width:0;padding:0;}
.gameplay .journal-lifetime .general-metrics {flex-direction:column;}
.gameplay .journal-lifetime .general-column {margin-right:0;flex-basis:auto;}
.gameplay .journal-lifetime .general-column.general-column-first {padding-bottom:var(--space-control);margin-bottom:var(--space-control);border-bottom-width:.5px;border-bottom-color:rgba(239,209,180,.10);}
.gameplay .journal-lifetime .general-metric {min-height:12px;}
.gameplay .journal-collection {margin-top:var(--space-section);}
.gameplay .journal-collection-heading {flex-direction:row;align-items:baseline;}
.gameplay .journal-collection-heading .journal-note {margin-left:auto;}
.gameplay .journal-collection-groups {flex-direction:column;}
.gameplay .journal-loot {min-width:0;margin-top:var(--space-section);}
.gameplay .journal-foes {min-width:0;}
.gameplay .journal-collection-label {font-size:var(--small);margin-bottom:var(--space-control);}
.gameplay .journal-discoveries {flex-direction:row;flex-wrap:wrap;}
.gameplay .journal-discovery {width:24px;height:24px;min-width:24px;min-height:24px;padding:0;margin:0 var(--space-tight) var(--space-tight) 0;border-width:.5px;border-color:var(--panel-edge);}
.gameplay .journal-discovery.known {border-color:#d0a166;}
.gameplay .journal-discovery .journal-art {width:100%;height:100%;}
.gameplay .journal-unknown {position:absolute;left:0;right:0;top:0;bottom:0;-unity-text-align:middle-center;}
.gameplay .journal-empty {font-size:var(--small);white-space:normal;margin-top:var(--space-section);}




.gameplay .journal-show-all {height:18px;min-height:18px;align-self:flex-start;font-size:var(--small);padding:var(--space-tight) var(--space-control);margin-top:var(--space-tight);}
/* Rank: shared controls, a readable three-column list, and a persistent personal result. */

.gameplay .graph-controls,.gameplay .graph-map-filters {flex-direction:row;flex-shrink:0;margin-bottom:var(--space-section);}
.gameplay .graph-choice {height:22px;min-height:22px;font-size:var(--small);padding:var(--space-control) var(--space-section);margin-right:var(--space-control);}
.gameplay .graph-choice.graph-last-choice {margin-right:0;}
.gameplay .graph-controls {align-items:center;}
.gameplay .graph-controls > .graph-choice {flex-grow:1;flex-basis:0;min-width:0;}
.gameplay .graph-units {flex-direction:row;flex-shrink:0;margin-left:var(--space-control);}
.gameplay .graph-map-filters .graph-choice {flex-grow:1;flex-basis:0;min-width:0;}
.gameplay .graph-summary-row {flex-direction:row;align-items:baseline;margin-bottom:var(--space-section);flex-shrink:0;}
.gameplay .graph-summary {font-size:var(--body);-unity-font-style:bold;}
.gameplay .graph-sample {font-size:var(--small);color:var(--muted);margin-left:auto;white-space:normal;}
.gameplay .graph-chart {flex-direction:row;flex-grow:1;min-height:72px;}
.gameplay .graph-axis {width:42px;flex-shrink:0;position:relative;}
.gameplay .graph-tick {position:absolute;right:var(--space-control);font-size:var(--small);color:var(--muted);-unity-text-align:middle-right;}
.gameplay .graph-plot {flex-grow:1;position:relative;min-width:0;}
.gameplay .graph-grid-line {position:absolute;left:0;right:0;height:.5px;background-color:rgba(200,174,161,.15);}
.gameplay .graph-bars {position:absolute;left:0;right:0;top:0;bottom:0;flex-direction:row;justify-content:space-between;}
.gameplay .graph-run-bar {height:100%;min-width:0;margin:0;padding:0;border-width:0;background-color:transparent;flex-shrink:0;}
.gameplay .graph-run-bar:hover,.gameplay .graph-run-bar:focus,.gameplay .graph-run-bar.selected {background-color:rgba(245,228,214,.07);}
.gameplay .graph-run-fill {position:absolute;left:1px;right:1px;bottom:0;}
.gameplay .graph-run-bar.selected .graph-run-fill {border-width:.5px;border-color:var(--accent);}
.gameplay .graph-average {position:absolute;left:0;right:0;height:.5px;background-color:var(--accent);}
.gameplay .graph-average-label {position:absolute;right:0;bottom:1px;font-size:var(--small);color:var(--accent);background-color:var(--surface);padding-left:var(--space-tight);}
.gameplay .graph-empty {position:absolute;left:0;right:0;top:35%;-unity-text-align:middle-center;font-size:var(--body);color:var(--muted);}
.gameplay .graph-x-labels {flex-direction:row;margin-left:42px;min-height:14px;flex-shrink:0;align-items:center;}
.gameplay .graph-first,.gameplay .graph-last {width:50px;font-size:var(--small);color:var(--muted);}
.gameplay .graph-last {-unity-text-align:middle-right;}
.gameplay .graph-x-title {flex-grow:1;-unity-text-align:middle-center;font-size:var(--small);color:var(--muted);}
.gameplay .graph-legend {flex-direction:row;justify-content:center;margin-bottom:var(--space-section);flex-shrink:0;}
.gameplay .graph-legend-item {flex-direction:row;align-items:center;margin-right:var(--space-section);}
.gameplay .graph-legend-item Label {font-size:var(--small);color:var(--muted);}
.gameplay .graph-legend-swatch {width:5px;height:5px;margin-right:var(--space-tight);}
.gameplay .graph-detail-heading {flex-direction:row;align-items:baseline;margin-bottom:var(--space-control);flex-shrink:0;}
.gameplay .graph-detail-title {font-size:var(--body);-unity-font-style:bold;}
.gameplay .graph-detail-hint {font-size:var(--small);color:var(--muted);margin-left:auto;}
.gameplay .graph-details {flex-direction:row;flex-wrap:wrap;flex-shrink:0;}
.gameplay .graph-detail-pair {width:25%;flex-direction:row;align-items:baseline;padding-right:var(--space-section);margin-bottom:var(--space-control);}
.gameplay .graph-detail-key {font-size:var(--small);color:var(--muted);margin-right:var(--space-control);}
.gameplay .graph-detail-value {font-size:var(--small);}

/* Forge: shared spacing, native-pixel art and a single companion column. */
.gameplay.eov-forge {padding:var(--space-section);}
.gameplay.eov-forge .eov-forge-main {margin-right:0;flex-grow:1;}
.gameplay.eov-forge .eov-forge-sidebar {width:220px;min-width:0;}
.gameplay.eov-forge .forge-sidebar-tabs {margin-bottom:var(--space-section);}
.gameplay.eov-forge .forge-sidebar-tabs > Button {flex-grow:1;flex-basis:0;margin:0;}
.gameplay.eov-forge .forge-sidebar-body {flex-grow:1;min-height:0;}
.gameplay.eov-forge .forge-sidebar-body .eov-recessed-scroll {padding:0;border-width:0;}
.gameplay.eov-forge .forge-embedded-inventory {padding:0;border-width:0;background-color:transparent;}
.gameplay.eov-forge .eov-resource-frame {padding:0;}
.gameplay.eov-forge .eov-resource-grid {align-self:center;}
.gameplay.eov-forge .eov-resource-slot-background {overflow:hidden;align-items:center;justify-content:center;}
.gameplay.eov-forge .eov-resource-icon {position:relative;left:auto;top:auto;flex-shrink:0;}
.gameplay.eov-forge .eov-forge-header {height:32px;margin-bottom:var(--space-section);}
.gameplay.eov-forge .eov-forge-columns {min-height:0;height:auto;}
.gameplay.eov-forge .eov-forge-selections {width:172px;margin-right:var(--space-panel);}
.gameplay.eov-forge .eov-forge-selections > .eov-text--heading {font-size:var(--body);margin-bottom:var(--space-control);}
.gameplay.eov-forge .eov-forge-slot-column {margin-bottom:var(--space-section);}
.gameplay.eov-forge .eov-forge-slot {width:36px;height:32px;min-height:32px;padding:0;}
.gameplay.eov-forge .eov-forge-core-grid {margin-top:0;}
.gameplay.eov-forge .eov-forge-core {height:47px;min-height:47px;}
.gameplay.eov-forge .eov-forge-core .eov-text {font-size:var(--small);}
.gameplay.eov-forge .eov-forge-core-frame {width:32px;height:28px;border-width:.5px;border-color:var(--line);background-color:var(--field);}
.gameplay.eov-forge .forge-icon-mask {width:100%;height:100%;overflow:hidden;align-items:center;justify-content:center;flex-shrink:0;}
.gameplay.eov-forge .eov-forge-selection {top:0;left:0;bottom:0;right:0;border-width:1px;border-color:var(--accent);background-image:none;}
.gameplay.eov-forge .eov-forge-actions {margin-right:0;}
.gameplay.eov-forge .eov-forge-actions > Button {margin-bottom:var(--space-control);}
.gameplay.eov-forge .forge-toggles {flex-direction:row;flex-wrap:wrap;margin-bottom:var(--space-control);}
.gameplay.eov-forge .eov-forge-toggle {min-height:20px;height:20px;flex-basis:auto;flex-grow:0;justify-content:flex-start;padding:0;margin-right:5px;background-color:transparent;border-width:0;}
.gameplay.eov-forge .eov-forge-toggle .eov-text {font-size:var(--small);flex-basis:auto;flex-grow:0;flex-shrink:0;white-space:nowrap;}
.gameplay.eov-forge .eov-forge-odds {width:48px;height:48px;margin:0 8px 0 0;}
.gameplay.eov-forge .forge-comparison-section {margin-bottom:var(--space-section);}
.gameplay.eov-forge .forge-comparison-heading {align-items:center;margin-bottom:var(--space-control);}
.gameplay.eov-forge .forge-comparison-heading .eov-text--heading {font-size:var(--body);}
.gameplay.eov-forge .forge-comparison-heading Button {width:88px;}
.gameplay.eov-forge .forge-metric {flex-direction:row;align-items:center;min-height:17px;padding:2px 0;border-bottom-width:.5px;border-bottom-color:var(--line);flex-shrink:0;}
.gameplay.eov-forge .forge-stat-icon {width:14px;height:14px;margin-right:4px;flex-shrink:0;}
.gameplay.eov-forge .forge-metric .eov-text {font-size:var(--small);white-space:normal;}
.gameplay.eov-forge .forge-metric-name {flex-grow:1;flex-shrink:1;min-width:0;}
.gameplay.eov-forge .forge-metric-value {width:70px;flex-shrink:0;-unity-text-align:middle-right;}
.gameplay.eov-forge .forge-metric-header .eov-text {color:var(--muted);font-size:var(--small);}
.gameplay.eov-forge .forge-gain {color:rgb(157,192,139);}
.gameplay.eov-forge .forge-loss {color:rgb(216,140,133);}
.gameplay.eov-forge .forge-empty-result {color:var(--muted);margin-top:var(--space-control);}
.gameplay.eov-forge .eov-forge-sidebar .forge-metric-value {width:50px;}
.gameplay.eov-forge .forge-history-section {margin-top:var(--space-section);}
.gameplay.eov-forge .forge-history-section .eov-disclosure-content {padding:0;}
.gameplay.eov-forge .forge-history-section .forge-metric-value {width:auto;max-width:115px;flex-shrink:1;margin-left:var(--space-control);}
.gameplay.eov-forge .forge-history-subtitle {margin-top:var(--space-control);color:var(--muted);}
.gameplay.eov-forge .eov-forge-conversions {border-top-width:0;padding-top:0;}
.gameplay.eov-forge .eov-forge-conversion {width:100%;height:auto;min-height:40px;margin-bottom:var(--space-control);padding:0;align-items:center;}
.gameplay.eov-forge .eov-forge-conversion > .eov-forge-row {width:180px;}
.gameplay.eov-forge .eov-forge-conversion-control {flex-direction:row;align-items:center;flex-wrap:wrap;}
.gameplay.eov-forge .eov-forge-conversion-control > .eov-text {width:100%;color:var(--muted);}
.gameplay.eov-forge .eov-forge-conversion .eov-forge-button {width:72px;margin-right:4px;}
.gameplay.eov-forge .eov-forge-conversion .eov-number-field {flex-grow:1;width:65px;height:22px;min-width:0;}
.gameplay.eov-forge.forge-narrow .eov-forge-sidebar {width:185px;}
/* Keep selection, crafting and comparison together above conversions. */
.gameplay.eov-forge .eov-forge-selections {width:126px;margin-right:8px;}
.gameplay.eov-forge .eov-forge-slot {width:27px;height:28px;min-height:28px;}
.gameplay.eov-forge .eov-forge-core-frame {width:27px;height:24px;}
.gameplay.eov-forge .eov-forge-core {height:42px;min-height:42px;}
.gameplay.eov-forge .eov-forge-actions {flex-basis:0;margin-right:8px;}
.gameplay.eov-forge .eov-forge-toggle .eov-text {-unity-text-align:middle-left;margin-left:4px;}
.gameplay.eov-forge .forge-comparison-section {width:46%;flex-shrink:0;}
.gameplay.eov-forge .forge-comparison-heading {flex-direction:row;align-items:center;}
.gameplay.eov-forge .forge-comparison-heading > .eov-text {margin-bottom:4px;}
.gameplay.eov-forge .forge-comparison-heading Button {width:80px;}
.gameplay.eov-forge .forge-comparison-section .forge-metric-name {display:flex;}
.gameplay.eov-forge .forge-comparison-section .forge-metric {min-height:18px;}
.gameplay.eov-forge .forge-comparison-section .forge-metric-header .forge-metric-name {display:flex;font-size:var(--small);}
.gameplay.eov-forge .forge-comparison-section .forge-metric-value {flex-grow:0;width:70px;}
.gameplay.eov-forge .eov-forge-conversion {min-height:42px;}
.gameplay.eov-forge .eov-forge-conversion {flex-direction:column;align-items:stretch;min-height:0;min-width:0;flex-basis:0;flex-grow:1;padding:6px;border-width:.5px;border-color:var(--line);background-color:var(--control);}
.gameplay.eov-forge .forge-conversion-title {font-size:var(--body);margin-bottom:4px;}
.gameplay.eov-forge .eov-forge-conversion > .eov-forge-row {width:auto;height:36px;}
.gameplay.eov-forge .eov-forge-conversion .eov-forge-button {width:47px;margin:0 0 0 4px;}
.gameplay.eov-forge .eov-forge-conversion .eov-number-field {width:40px;flex-basis:0;flex-grow:1;}
.gameplay.eov-forge .eov-forge-conversion .eov-text {font-size:var(--small);}
.gameplay.eov-forge .forge-toggles {margin-top:4px;}
.gameplay.eov-forge .eov-forge-sidebar .forge-metric-value {font-size:var(--small);}
.gameplay.eov-forge .eov-forge-conversion .eov-number-field {flex-basis:auto;}
.gameplay.eov-forge .eov-forge-conversion .eov-number-field,
.gameplay.eov-forge .eov-forge-conversion .eov-number-field .unity-text-element {font-size:var(--small);}
.gameplay.eov-forge .eov-forge-conversion .eov-number-field {border-width:1px;border-color:#a88b79;background-color:#241e1f;}
.gameplay.eov-forge .eov-forge-conversion .eov-number-field .unity-base-text-field__input,
.gameplay.eov-forge .eov-forge-conversion .eov-number-field #unity-text-input {background-color:#241e1f;color:var(--text);border-width:0;padding-left:5px;padding-right:5px;}
.gameplay.eov-forge .eov-forge-conversion .eov-number-field #unity-text-input .unity-text-element {background-color:transparent;color:var(--text);}
.gameplay.eov-forge .eov-forge-conversion .eov-number-field:hover,
.gameplay.eov-forge .eov-forge-conversion .eov-number-field:focus {border-color:var(--accent);}
.gameplay.eov-forge .eov-forge-conversion .eov-number-field .unity-base-text-field__input:focus {border-width:1px;border-color:var(--accent);}
.gameplay.eov-forge .eov-forge-conversion .forge-conversion-title {font-size:var(--body);}

/* Forge resource readability: one owned count, larger masks, selection rarity. */
.gameplay.eov-forge .eov-forge-core {height:37px;min-height:37px;}
.gameplay.eov-forge .eov-forge-core-frame {height:27px;}
.gameplay.eov-forge .eov-resource-slot {border-width:.5px;border-color:var(--line);}
.gameplay.eov-forge .eov-resource-slot.resource-selected {border-color:var(--accent);border-width:1px;}
.gameplay.eov-forge .eov-resource-slot-background {left:1px;top:1px;width:30px;height:26px;}
.gameplay.eov-forge .eov-resource-selection {display:none;}
.gameplay.eov-forge .eov-resource-count {left:1px;top:27px;width:30px;height:10px;font-size:var(--small);}
.gameplay.eov-forge .eov-resource-title {height:22px;flex-direction:row;align-items:center;margin-bottom:4px;}
.gameplay.eov-forge .eov-resource-name {font-size:var(--body);flex-grow:1;flex-shrink:1;min-width:0;-unity-text-align:middle-left;overflow:hidden;text-overflow:ellipsis;}
.gameplay.eov-forge .forge-resource-rarity {flex-direction:row;align-items:center;margin-left:4px;flex-shrink:0;}
.gameplay.eov-forge .forge-resource-rarity Label {font-size:var(--small);color:var(--muted);}
.gameplay.eov-forge .forge-ingredient {align-items:center;min-height:18px;}
.gameplay.eov-forge .forge-ingredient .eov-icon {margin-right:3px;flex-shrink:0;}
.gameplay.eov-forge .forge-ingredient .eov-text {white-space:nowrap;}

/* Core quantities float below their framed artwork, like equipment slots. */
.gameplay.eov-forge .eov-forge-core,
.gameplay.eov-forge .eov-forge-core:hover,
.gameplay.eov-forge .eov-forge-core:active,
.gameplay.eov-forge .eov-forge-core:focus {background-color:transparent;border-width:0;}
.gameplay.eov-forge .eov-forge-core {height:42px;min-height:42px;}
.gameplay.eov-forge .eov-forge-core-frame {width:27px;height:28px;margin-bottom:3px;border-width:.5px;}
.gameplay.eov-forge .forge-odds-summary {align-items:center;margin:2px 0;}
.gameplay.eov-forge .forge-odds-legend {flex-grow:1;min-width:0;}
.gameplay.eov-forge .forge-odds-legend > .eov-text--heading {font-size:var(--body);margin-bottom:3px;}
.gameplay.eov-forge .forge-odds-rows {flex-direction:row;flex-wrap:wrap;}
.gameplay.eov-forge .forge-odds-row {flex-direction:row;align-items:center;min-height:12px;width:50%;padding-right:6px;}
.gameplay.eov-forge .forge-odds-row .eov-text {font-size:var(--small);white-space:nowrap;}
.gameplay.eov-forge .forge-odds-swatch {width:6px;height:6px;margin-right:4px;flex-shrink:0;}
.gameplay.eov-forge .forge-odds-row .forge-odds-name {flex-grow:1;flex-shrink:1;min-width:0;white-space:normal;}
.gameplay.eov-forge .forge-odds-value {width:36px;flex-shrink:0;-unity-text-align:middle-right;}
.gameplay.eov-forge .forge-odds-zero {opacity:.35;}
.gameplay.eov-forge .forge-craft-controls {align-items:center;margin-bottom:4px;}
.gameplay.eov-forge .forge-craft-controls > Button {width:82px;min-height:28px;margin-right:8px;flex-shrink:0;}
.gameplay.eov-forge .forge-craft-recipe {flex-grow:1;justify-content:flex-start;min-width:0;}
.gameplay.eov-forge .forge-craft-controls > #forge-replace {margin-left:8px;margin-right:0;}
.gameplay.eov-forge #forge-automation-area {min-height:24px;}
.gameplay.eov-forge .eov-forge-conversions {margin-top:auto;margin-bottom:0;flex-shrink:0;}


/* Buff selection uses the shared framed icons and an explicit loadout. */
.gameplay.buffs-reviewed {padding:var(--space-panel);}
.gameplay .buff-icon-mask {width:100%;height:100%;overflow:hidden;align-items:center;justify-content:center;}
.gameplay .buff-slot-auto {border-color:#9876a7;}
.gameplay .awaiting-assignment {border-color:var(--accent);}
.gameplay .buff-list-frame {padding:0;border-width:0;}
.gameplay .buff-list-content {flex-direction:row;flex-wrap:wrap;}
.gameplay .buff-entry {padding:var(--space-section) 0;border-bottom-width:.5px;border-bottom-color:var(--line);min-width:0;}
.gameplay .buff-entry-heading {flex-direction:row;align-items:center;margin-bottom:var(--space-control);}
.gameplay .buff-entry-icon {width:32px;height:32px;border-width:.5px;border-color:var(--accent);background-color:var(--field);margin-right:var(--space-section);flex-shrink:0;}
.gameplay .buff-entry-title {flex-grow:1;flex-shrink:1;min-width:0;-unity-font-style:bold;}
.gameplay .buff-entry-assign {width:62px;margin-left:var(--space-control);}
.gameplay .buff-equipped .buff-entry-icon {border-color:#9876a7;}
.gameplay .buff-choosing .buff-entry-assign {background-color:var(--selected);border-color:var(--accent);}
.gameplay .buff-entry-effects {white-space:normal;}
.gameplay .buff-entry-timing {margin-top:var(--space-control);color:var(--muted);}

/* Reviewed town pages share the same type scale, spacing and flat section boundaries. */
.gameplay.settings-page .settings-heading,.gameplay .book-heading,.gameplay .quests-heading {font-size:12px;-unity-font-style:bold;margin:0 0 var(--space-section) 0;flex-shrink:0;}
.gameplay.settings-page .settings-tabs {margin-bottom:var(--space-panel);}
.gameplay.settings-page .settings-tabs > Button {margin-right:var(--space-control);}
.gameplay.settings-page .settings-tabs > Button.row-end {margin-right:0;}
.gameplay.settings-page .eov-options-scroll {min-height:0;}
.gameplay.settings-page .eov-options-frame {margin-bottom:var(--space-section);padding-bottom:var(--space-control);border-bottom-width:.5px;border-bottom-color:var(--line);}
.gameplay.settings-page .settings-section-title {margin-bottom:var(--space-control);-unity-font-style:bold;}
.gameplay.settings-page .eov-options-label {white-space:normal;}
.gameplay.settings-page .settings-column {margin-right:var(--space-section);}
.gameplay.settings-page .settings-column.row-end {margin-right:0;}
.gameplay.settings-page .settings-actions {align-items:center;}
.gameplay.settings-page .settings-actions > Button {margin-right:var(--space-control);}
.gameplay.settings-page .settings-actions > Button.row-end {margin-right:0;}
.gameplay.settings-page .settings-labelled-toggle {flex-direction:row;justify-content:flex-start;align-self:flex-start;height:22px;}
.gameplay.settings-page .settings-labelled-toggle .eov-options-label {margin-left:var(--space-control);white-space:nowrap;}
.gameplay.settings-page .settings-floating-row {align-items:center;margin-bottom:var(--space-control);}
.gameplay.settings-page .settings-floating-label {width:152px;margin-left:var(--space-control);margin-right:var(--space-section);}
.gameplay.settings-page .settings-save-row {padding:var(--space-control) 0;border-bottom-width:.5px;border-bottom-color:var(--line);margin-bottom:var(--space-control);align-items:center;}
.gameplay.settings-page .settings-save-row .eov-options-label {margin-bottom:var(--space-tight);}
.gameplay.settings-page .settings-save-actions {width:136px;margin-left:var(--space-panel);}
.gameplay.settings-page .settings-save-note {margin-top:var(--space-section);color:var(--muted);}
.gameplay.settings-page .settings-footer {margin-top:var(--space-section);align-items:center;}
.gameplay.settings-page .settings-footer > Button {margin-right:var(--space-control);}
.gameplay.settings-page .settings-version {margin-left:var(--space-control);color:var(--muted);}
.gameplay.book-reviewed .eov-book-frame {padding:0;}
.gameplay.book-reviewed .eov-chapter-header,.gameplay.quests-reviewed .eov-chapter-header {flex-direction:row;align-items:center;min-height:26px;padding:var(--space-control) var(--space-section);}
.gameplay.book-reviewed .eov-chapter-title,.gameplay.quests-reviewed .eov-chapter-title {white-space:normal;flex-shrink:1;}
.gameplay .book-disclosure {width:16px;flex-shrink:0;font-size:12px;-unity-text-align:middle-center;color:var(--muted);}
.gameplay.book-reviewed .eov-chapter {margin-bottom:var(--space-control);}
.gameplay.book-reviewed .eov-chapter-content {padding:var(--space-section);}
.gameplay.book-reviewed .eov-chapter-body {font-size:var(--body);-unity-font-style:normal;}
.gameplay.library-reader .library-layout {flex-direction:row;flex-grow:1;min-height:0;}
.gameplay.library-reader .library-topics {width:160px;min-width:160px;flex-shrink:0;margin-right:var(--space-panel);padding-right:var(--space-control);border-right-width:.5px;border-right-color:var(--line);}
.gameplay.library-reader.library-topics-home .library-topics {width:auto;min-width:0;flex-grow:1;margin-right:0;padding-right:0;border-right-width:0;}
.gameplay.library-reader .library-topic-group {flex-shrink:0;margin-bottom:var(--space-section);}
.gameplay.library-reader .library-group-title {font-size:var(--small);color:var(--muted);margin:3px 0 4px 4px;}
.gameplay.library-reader .library-topic {flex-direction:row;align-items:center;min-height:22px;margin:0 0 2px 0;padding:3px 5px;border-width:0;border-left-width:1px;border-left-color:rgba(0,0,0,0);border-radius:0;background-color:rgba(0,0,0,0);}
.gameplay.library-reader .library-topic:hover {background-color:var(--hover);}
.gameplay.library-reader .library-topic.active {background-color:var(--control);border-left-color:var(--text);}
.gameplay.library-reader .library-topic .icon {margin-right:5px;flex-shrink:0;}
.gameplay.library-reader .library-topic-title {font-size:var(--body);white-space:normal;flex-shrink:1;margin:0;padding:0;color:var(--text);}
.gameplay.library-reader .library-article {flex-grow:1;flex-basis:0;min-width:0;min-height:0;}
.gameplay.library-reader .library-title-row {flex-direction:row;align-items:center;flex-shrink:0;margin-bottom:var(--space-section);}
.gameplay.library-reader .library-title-row .icon {margin-right:8px;flex-shrink:0;}
.gameplay.library-reader .library-article-title {font-size:12px;-unity-font-style:bold;white-space:normal;flex-shrink:1;margin:0;}
.gameplay.library-reader .library-tabs {flex-direction:row;flex-shrink:0;margin-bottom:var(--space-section);border-bottom-width:.5px;border-bottom-color:var(--line);}
.gameplay.library-reader .library-tab {background-color:rgba(0,0,0,0);border-width:0;border-bottom-width:1px;border-bottom-color:rgba(0,0,0,0);border-radius:0;margin:0 12px 0 0;padding:0 0 5px 0;font-size:var(--body);color:var(--muted);}
.gameplay.library-reader .library-tab.active {color:var(--text);border-bottom-color:var(--text);}
.gameplay.library-reader .library-article-scroll {flex-grow:1;min-height:0;}
.gameplay.library-reader .library-prose {font-size:var(--body);white-space:normal;flex-shrink:0;margin:0;padding:0;}
.gameplay.library-reader .library-illustrations {flex-direction:row;flex-wrap:wrap;flex-shrink:0;margin-bottom:var(--space-section);padding-bottom:var(--space-section);border-bottom-width:.5px;border-bottom-color:var(--line);}
.gameplay.library-reader .library-figure {width:88px;min-width:68px;margin:0 8px 4px 0;padding:4px 2px;border-width:0;border-bottom-width:1px;border-bottom-color:rgba(0,0,0,0);border-radius:0;background-color:rgba(0,0,0,0);flex-grow:0;flex-shrink:0;align-items:center;}
.gameplay.library-reader .library-figure:hover {background-color:var(--hover);}
.gameplay.library-reader .library-figure.active {background-color:var(--control);border-bottom-color:var(--text);}
.gameplay.library-reader .library-illustration-description {font-size:var(--body);white-space:normal;flex-shrink:0;margin:0 0 var(--space-section) 0;padding:0;}
.gameplay.library-reader .library-figure-art {width:64px;height:24px;flex-shrink:0;}
.gameplay.library-reader .library-figure-caption {font-size:var(--small);color:var(--muted);white-space:normal;-unity-text-align:upper-center;margin-top:4px;}
.gameplay.library-reader .library-table {flex-shrink:0;margin-top:var(--space-section);}
.gameplay.library-reader .library-table-row {flex-direction:row;flex-shrink:0;border-bottom-width:.5px;border-bottom-color:var(--line);padding:6px 0;}
.gameplay.library-reader .library-table-cell {flex-grow:1;flex-basis:0;min-width:0;font-size:var(--body);white-space:normal;padding:0 6px 0 0;margin:0;}
.gameplay.library-reader .library-table-header .library-table-cell {color:var(--muted);font-size:var(--small);}
.gameplay.library-reader .library-table-identity {flex-direction:row;align-items:flex-start;}
.gameplay.library-reader .library-table-identity .icon {margin-right:5px;flex-shrink:0;}
.gameplay.library-reader .library-table-label {font-size:var(--body);white-space:normal;flex-shrink:1;margin:0;padding:0;}
.gameplay.library-reader.library-narrow .library-topics {width:124px;min-width:124px;margin-right:8px;}
.gameplay.library-reader.library-narrow .library-topic-title {font-size:var(--small);}
.gameplay.library-reader.library-narrow .library-figure-art {height:20px;}
.gameplay.book-reviewed .eov-credit {flex-direction:row;align-items:flex-start;padding:var(--space-panel) 0;margin:0;border-bottom-width:.5px;border-bottom-color:var(--line);}
.gameplay.book-reviewed .eov-credit .eov-chapter-title {width:176px;flex-grow:0;flex-shrink:0;margin-right:var(--space-panel);-unity-text-align:upper-left;}
.gameplay.book-reviewed .eov-credit .eov-chapter-body {flex-grow:1;flex-basis:0;min-width:0;-unity-text-align:upper-left;color:var(--muted);}
.gameplay.quests-reviewed .eov-quest-instructions {color:var(--muted);margin-bottom:var(--space-section);}
.gameplay.quests-reviewed .eov-quest-entries {padding:0;flex-direction:row;flex-wrap:wrap;align-items:stretch;}
.gameplay.quests-reviewed .eov-quest-row {padding:4px 0 10px;margin:0;}
.gameplay.quests-reviewed .quests-toolbar {margin-bottom:8px;}
.gameplay.quests-reviewed #quests-compact {min-width:66px;margin-left:var(--space-section);}
.gameplay.quests-reviewed .eov-quest-turn-in {width:64px;min-height:22px;}
.gameplay.quests-reviewed .quest-description {margin-top:var(--space-control);color:var(--muted);font-size:var(--small);}
.gameplay.quests-reviewed .quest-requirement {margin-top:var(--space-control);}
.gameplay.quests-reviewed .quest-requirement .track {margin-top:var(--space-tight);}
.gameplay.quests-reviewed .quest-reward {margin-top:var(--space-control);color:var(--muted);font-size:var(--small);}
.gameplay.quests-reviewed .quest-ready .quest-name {color:var(--accent);}
.gameplay.quests-reviewed .quest-completed .quest-name {color:var(--muted);}
.gameplay .eov-options-modal-dismiss {background-color:rgba(0,0,0,.35);}
.gameplay .eov-options-input {font-size:var(--small);}
.gameplay .eov-options-input-frame {flex-shrink:1;}

.gameplay.settings-page .settings-tabs .active .eov-options-label {color:var(--on-accent);}

/* Standalone Hub inventory uses the same canonical resource grid as Forge. */
.gameplay.quests-reviewed .quests-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.gameplay.quests-reviewed .quests-content { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; }
.gameplay.quests-reviewed .quests-inventory { width: 178px; flex-shrink: 1; min-width: 72px; min-height: 0; margin-left: 4px; border-left-width: .5px; border-left-color: var(--line); padding-left: 4px; }
.gameplay.quests-reviewed .quests-embedded-inventory { padding: 0; border-width: 0; background-color: transparent; }
.gameplay.quests-reviewed .quests-embedded-inventory .eov-resource-frame { padding: 0; }
.gameplay.quests-reviewed .quests-embedded-inventory .eov-resource-grid { align-self: center; }
.gameplay.inventory-standalone { padding: 10px; }
.inventory-standalone .eov-resource-title { height: 28px; flex-direction: row; align-items: center; }
.inventory-standalone .inventory-title-labels { flex-grow: 1; min-width: 0; height: 28px; justify-content: center; }
.inventory-standalone .inventory-title-labels .heading { height: 14px; margin-bottom: 0; padding: 0; }
.inventory-standalone .eov-resource-name { height: 12px; font-size:var(--body); margin: 0; padding: 0; -unity-text-align: middle-left; }
.inventory-standalone .eov-resource-title .button { width: 24px; min-width: 24px; }
.inventory-standalone .eov-resource-slot { width: 40px; height: 44px; }
.inventory-standalone .eov-resource-slot-background { left: 6px; top: 3px; width: 28px; height: 28px; }
.inventory-standalone .eov-resource-icon { left: 2px; top: 2px; width: 24px; height: 24px; }
.inventory-standalone .eov-resource-selection { width: 30px; height: 30px; }
.inventory-standalone .eov-resource-count { left: 1px; top: 33px; width: 38px; height: 9px; font-size:var(--small); }

/* Use the existing whole-slot frame so selection cannot offset the icon or count. */
.quests-embedded-inventory .eov-resource-slot,
.inventory-standalone .eov-resource-slot { border-bottom-width: .5px; border-bottom-color: var(--button-edge); }
.quests-embedded-inventory .eov-resource-quality,
.inventory-standalone .eov-resource-quality { position: absolute; left: 0; right: 0; bottom: 0; height: 1px; background-color: var(--tier-colour); }
.quests-embedded-inventory .eov-resource-selection,
.inventory-standalone .eov-resource-selection { opacity: 0; }
.quests-embedded-inventory .eov-resource-slot.resource-selected,
.inventory-standalone .eov-resource-slot.resource-selected { border-color: var(--accent); border-bottom-width: .5px; }

.gameplay .journal-selector > .journal-art {width:100%;}
.gameplay .journal-selector.map-locked {opacity:.65;}
.gameplay .journal-tutorial {padding:4px;margin-bottom:4px;flex-shrink:0;border-bottom-width:.5px;border-bottom-color:var(--line);}

/* Outing summary: clear totals above a named, aligned resource ledger. */
.gameplay .eov-run-overlay {background-color:transparent;padding-top:32px;padding-bottom:8px;}
.gameplay .summary-close {position:absolute;right:8px;top:8px;width:22px;min-width:22px;height:22px;padding:0;font-size:14px;}
.gameplay .summary-sheet {padding:14px;border-width:1px;border-color:var(--panel-edge);}
.gameplay .summary-sheet .breakdown-header {height:22px;margin-bottom:2px;}
.gameplay .summary-sheet .breakdown-title {position:relative;left:0;width:auto;margin:0;padding:0;font-size:13px;-unity-text-align:middle-left;}
.gameplay .summary-overview {flex-shrink:0;}
.gameplay .summary-subtitle {font-size:var(--small);margin-bottom:10px;}
.gameplay .summary-facts {margin-bottom:10px;flex-wrap:nowrap;}
.gameplay .summary-fact {width:auto;min-width:0;flex-basis:0;flex-grow:1;padding:6px 8px;background-color:var(--field);border-left-width:.5px;border-left-color:var(--line);}
.gameplay .summary-fact-label {font-size:var(--small);margin-bottom:2px;white-space:nowrap;}
.gameplay .summary-fact-value {font-size:12px;}
.gameplay .summary-distance {align-items:center;min-height:24px;padding:4px 0;margin-bottom:10px;border-bottom-width:.5px;border-bottom-color:var(--line);}
.gameplay .summary-distance-label {font-size:var(--body);flex-grow:1;}
.gameplay .summary-distance-value {font-size:var(--body);}
.gameplay .summary-distance-change {font-size:var(--body);color:var(--accent);margin-left:6px;}
.gameplay .summary-resource-heading {justify-content:space-between;align-items:center;margin-bottom:5px;flex-shrink:0;}
.gameplay .summary-resource-heading > .strong {font-size:var(--body);}
.gameplay .summary-resource-grid {flex-direction:row;flex-wrap:wrap;}
.gameplay .summary-resource {width:50%;min-width:0;min-height:24px;padding:4px 8px 4px 0;align-items:center;border-bottom-width:.5px;border-bottom-color:var(--line);flex-shrink:0;}
.gameplay .summary-resource > .icon {margin-right:6px;flex-shrink:0;}
.gameplay .summary-resource-text {flex-grow:1;flex-shrink:1;min-width:0;}
.gameplay .summary-resource-name {font-size:var(--small);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.gameplay .summary-resource-total {font-size:var(--body);min-width:28px;margin-left:8px;-unity-text-align:middle-right;}
.gameplay .summary-resource-bonus {font-size:var(--small);color:var(--accent);white-space:normal;}
.gameplay .summary-resource-bonus-line {align-items:center;}
.gameplay .summary-resource-bonus-icon {position:relative;width:12px;min-width:12px;max-width:12px;height:12px;flex-shrink:0;margin-right:2px;}
.gameplay .summary-resource-bonus-icon > .icon {position:absolute;left:2.25px;top:-1px;margin:0;}
.gameplay .summary-empty {font-size:var(--body);padding:14px 0;}
.gameplay .summary-narrow .summary-facts {flex-wrap:wrap;}
.gameplay .summary-narrow .summary-fact {width:50%;flex-basis:auto;flex-grow:0;}
.gameplay .summary-narrow .summary-resource {width:100%;}
.gameplay .summary-narrow .summary-distance {flex-wrap:wrap;}
.gameplay .summary-narrow .summary-distance-label {width:100%;margin-bottom:3px;}

.gameplay .breakdown-header {margin-right:28px;}
.gameplay .summary-resource-right {padding-left:8px;}
.gameplay .summary-return-bonus {font-size:var(--small);color:var(--accent);margin-bottom:8px;white-space:normal;}

.gameplay .summary-narrow .summary-resource-right {padding-left:0;}

/* Character creation uses the same appearance frames as the player and Echoes. */
.gameplay .inventory-equipment-header { flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:4px; }
.gameplay .inventory-equipment-header .heading { margin-bottom:0;flex-shrink:0; }
.gameplay .inventory-character-name { font-size:var(--small);margin-left:6px;flex-shrink:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--muted); }
.gameplay .inventory-character-area { flex-direction:row;flex-wrap:wrap;align-items:center;padding:4px 0 8px;margin-bottom:8px;border-bottom-width:1px;border-bottom-color:var(--line); }
.gameplay .inventory-character-column { flex-direction:row;align-items:center;margin-right:6px;flex-shrink:0; }
.gameplay .inventory-character-preview { position:relative;width:64px;height:64px;overflow:hidden;background-color:var(--control); }
.gameplay .inventory-character-turn { width:14px;min-width:14px;min-height:24px;padding:0;font-size:16px;margin:0 1px; }
.gameplay .inventory-equipment-rows { flex-grow:1;flex-basis:0;min-width:100px; }
.gameplay .inventory-equipment-row { flex-direction:row;align-items:center;margin-bottom:2px; }
.gameplay .inventory-equipment-slot { flex-direction:row;align-items:center;justify-content:flex-start;flex-grow:1;flex-basis:0;min-width:0;min-height:24px;padding:2px 3px;margin:0; }
.gameplay .inventory-equipment-icon { width:16px;height:16px;min-width:16px;margin-right:4px; }
.gameplay .inventory-equipment-slot-name { font-size:var(--small);white-space:normal;flex-shrink:1;min-width:0; }
.gameplay .inventory-visibility-button { width:24px;min-width:24px;min-height:24px;padding:3px;margin:0 0 0 3px;color:var(--muted); }
.gameplay .inventory-visibility-button.shown { color:var(--text); }
.gameplay .equipment-eye-icon { width:16px;height:16px;align-self:center; }
.gameplay.character-overlay { position:absolute;left:0;right:0;top:0;bottom:0;background-color:rgba(0,0,0,0.82); }
.gameplay .character-sheet { position:absolute;padding:14px 16px;background-color:var(--surface);border-width:1px;border-color:var(--line); }
.gameplay .character-content { flex-direction:row;flex-grow:1;min-height:0;margin-top:10px; }
.gameplay .character-preview-column { width:188px;margin-right:16px;align-items:center;justify-content:center;border-right-width:1px;border-right-color:var(--line);padding-right:12px; }
.gameplay .character-portrait-row { flex-direction:row;align-items:center;justify-content:center; }
.gameplay .character-preview { position:relative;width:124px;height:124px;background-color:var(--control);overflow:hidden; }
.gameplay .character-arrow { width:20px;min-width:20px;min-height:24px;padding:2px;margin:0;align-items:center;justify-content:center; }
.gameplay .character-arrow-icon { width:14px;height:14px; }
.gameplay .character-turn { margin:0 1px; }
.gameplay .character-preview-controls { flex-direction:row;align-items:center;width:104px;align-self:center;margin-top:8px; }
.gameplay .character-animation-label { flex-grow:1;font-size:var(--body);-unity-text-align:middle-center; }
.gameplay .character-options { flex-grow:1;min-width:0; }
.gameplay .character-options .unity-text-field { margin-bottom:10px; }
.gameplay .character-options .unity-text-field__input { min-width:0;background-color:var(--control);color:var(--text);font-size:var(--body);padding:5px; }
.gameplay .character-options .unity-base-field__label { min-width:32px;font-size:var(--body); }
.gameplay .character-options .eov-recessed-scroll { flex-grow:1;min-height:0; }
.gameplay .character-option-row { flex-direction:row;align-items:center;padding:6px 0;border-bottom-width:1px;border-bottom-color:var(--line); }
.gameplay .character-option-heading { width:44px;flex-shrink:0;align-items:center;margin-right:6px; }
.gameplay .character-option-heading .strong { font-size:var(--body); }
.gameplay .character-selectors { flex-grow:1;flex-shrink:1;min-width:0;align-items:center; }
.gameplay .character-selector { flex-grow:1;flex-shrink:1;min-width:70px;margin-right:8px; }
.gameplay .character-choice { align-items:center;min-height:22px; }
.gameplay .character-choice .button { width:20px;height:22px;min-height:22px;padding:0; }
.gameplay .character-choice-label { flex-grow:1;flex-shrink:1;width:0;white-space:normal;-unity-text-align:middle-center;font-size:var(--body);margin-left:4px;margin-right:4px; }
.gameplay .character-colour-grid { flex-direction:row;flex-wrap:wrap;width:124px;flex-shrink:0;align-content:flex-start; }
.gameplay .character-colour-button { flex-direction:row;align-items:center;width:132px;height:22px;min-height:22px;flex-shrink:0;padding:3px 5px; }
.gameplay .character-colour-button > .character-colour-swatch { flex-grow:0; }
.gameplay .character-colour-popup { position:absolute;left:0;right:0;top:0;bottom:0; }
.gameplay .character-colour-menu { position:absolute;align-items:center;background-color:var(--surface);border-width:1px;border-color:var(--line);padding:2px; }
.gameplay .character-swatch-button { width:28px;height:28px;min-width:28px;min-height:28px;flex-shrink:0;margin:1px;padding:1px;background-color:transparent;border-width:1px;border-color:transparent; }
.gameplay .character-swatch-button .character-colour-swatch { width:24px;height:24px; }
.gameplay .character-swatch-button:hover { border-color:var(--text); }
.gameplay .character-swatch-button.selected { border-color:var(--text);background-color:var(--control); }
.gameplay .character-swatch-button:focus { border-color:var(--text); }
.gameplay .character-colour-swatch { flex-grow:1;width:10px;height:10px;flex-shrink:0;border-width:1px;border-color:rgba(255,255,255,0.25); }
.gameplay .character-colour-secondary { position:absolute;top:0;bottom:0;right:0;width:50%; }
.gameplay .character-presets { flex-direction:row;align-items:center;border-top-width:1px;border-top-color:var(--line);padding-top:7px;margin-top:8px; }
.gameplay .character-presets > .strong { font-size:var(--body);width:80px;margin-right:8px; }
.gameplay .character-preset-row { flex-grow:1; }
.gameplay .character-preset { flex-direction:row;flex-grow:1;flex-basis:0;margin-right:6px; }
.gameplay .character-preset .button { font-size:var(--small);min-height:22px;padding:3px 5px; }
.gameplay .character-preset .character-load-preset { flex-grow:1;flex-shrink:1;width:0;overflow:hidden; }
.gameplay .character-status { min-height:12px;font-size:var(--small);margin-top:3px;white-space:normal; }
.gameplay .character-footer { justify-content:flex-end;margin-top:4px; }
.gameplay .character-footer .button { margin-left:6px;min-height:24px;font-size:var(--body); }
.gameplay .character-narrow .character-content { flex-direction:column; }
.gameplay .character-narrow .character-preview-column { flex-direction:row;align-items:center;justify-content:center;width:auto;height:80px;margin-right:0;border-right-width:0;padding-right:0;flex-shrink:0; }
.gameplay .character-narrow .character-preview { width:64px;height:64px; }
.gameplay .character-narrow .character-preview-controls { width:74px;flex-direction:row;margin:0 0 0 8px; }
.gameplay .character-narrow .character-preview-controls .character-arrow { width:18px;min-width:18px;padding:1px; }
.gameplay .character-narrow .character-animation-label { font-size:var(--small); }
.gameplay .character-narrow .character-option-row { flex-direction:column;align-items:stretch;padding:3px 0; }
.gameplay .character-narrow .character-option-heading { width:auto;margin:0 0 2px; }
.gameplay .character-narrow .character-colour-button { width:132px;padding:3px; }
.gameplay .character-narrow .character-presets { flex-direction:column;align-items:stretch; }
.gameplay .character-narrow .character-presets > .strong { width:auto;margin-bottom:4px; }
.gameplay .character-narrow .character-preset { flex-direction:column;min-width:0;margin-right:3px; }
.gameplay .character-narrow .character-preset .button { font-size:var(--small);min-height:18px;padding:2px; }
.gameplay .character-narrow .character-preset .character-load-preset { width:auto;flex-grow:0;flex-shrink:0; }

/* Lifetime crafting history lives in Statistics, separate from forge actions. */

/* The recipe sets its natural width; the remaining width belongs to the controls. */
.gameplay.eov-forge .eov-forge-conversion > .forge-conversion-body {height:auto;min-height:48px;align-items:center;min-width:0;flex-shrink:0;}
.gameplay.eov-forge .forge-conversion-recipe-column {flex-grow:0;flex-shrink:1;min-width:0;}
.gameplay.eov-forge .forge-conversion-recipe {height:36px;align-items:center;}
.gameplay.eov-forge .forge-conversion-maximum {color:var(--muted);white-space:nowrap;}
.gameplay.eov-forge .forge-conversion-body .eov-number-field {width:auto;min-width:0;flex-basis:auto;flex-grow:0;flex-shrink:0;margin:0 0 4px 0;}
.gameplay.eov-forge .eov-forge-conversion-control {flex-direction:column;flex-wrap:nowrap;margin:0 0 0 6px;min-width:44px;flex-basis:0;flex-grow:1;align-items:stretch;}
.gameplay.eov-forge .eov-forge-conversion-control .eov-forge-button {width:auto;min-width:0;margin:0;}
.gameplay.eov-forge .eov-forge-conversion {margin-bottom:0;}

.gameplay.eov-forge .forge-conversion-result {align-items:center;flex-shrink:0;}
.gameplay.eov-forge .forge-conversion-result .eov-text {-unity-text-align:middle-center;}

.gameplay .town-statistics-section { margin-bottom:6px; }
.gameplay .town-statistics-row { flex-direction:row; align-items:center; padding:4px 0; border-bottom-width:.5px; border-bottom-color:var(--line); }
.gameplay .town-statistics-name { flex-grow:1; flex-shrink:1; white-space:normal; min-width:0; }
.gameplay .town-statistics-value { flex-shrink:0; margin-left:12px; white-space:nowrap; -unity-text-align:middle-right; }
.gameplay .town-statistics-icon { flex-shrink:0; margin-right:6px; }
.gameplay .town-statistics-roll-title { margin-top:8px; margin-bottom:4px; }
.gameplay .town-statistics-rolls { flex-direction:row; flex-wrap:wrap; }
.gameplay .town-statistics-roll { width:48%; margin-right:2%; }
.gameplay.portrait .town-statistics-roll { width:100%; margin-right:0; }
.gameplay .town-statistics-since-update { margin-bottom:4px; }

/* Guided lessons keep their skip action directly below Next in both layouts. */
.gameplay.meeting-guided .meeting-actions {position:absolute;left:0;top:0;width:40px;flex-direction:column;}
.gameplay.meeting-guided .meeting-actions #advance,
.gameplay.meeting-guided .meeting-skip {position:relative;left:auto;top:auto;width:100%;height:auto;min-height:22px;margin:0;}
.gameplay.meeting-guided .meeting-skip {margin-top:4px;font-size:var(--small);padding:3px 1px;}

.gameplay.meeting-guided .eov-meeting-dialogue-frame {left:44px;}


/* Keep room for the recipe and readable odds on 4:3 landscape tablets. */
.gameplay.eov-forge.forge-compact-landscape .forge-comparison-section {width:38%;}
.gameplay.eov-forge.forge-compact-landscape .forge-odds-row {width:100%;}

/* Text must keep its reading size when a panel becomes narrow. */
.gameplay #selected-resource {height:auto;min-height:14px;overflow:hidden;text-overflow:ellipsis;}
.gameplay .eov-resource-count {height:12px;}
.gameplay .eov-options-transfer-status {height:auto;min-height:12px;white-space:normal;}
.gameplay.quests-reviewed .quest-name {font-size:var(--heading);}
.gameplay.quests-reviewed .quest-description {font-size:var(--body);}
.gameplay.quests-reviewed .eov-quest-turn-in {width:76px;min-height:26px;}
.gameplay .quest-resource-icon {width:12px;height:12px;}

.gameplay .eov-buffs-header {flex-shrink:0;}
.gameplay .eov-buffs-instructions {flex-shrink:0;}
.gameplay .journal-run-number,.gameplay .journal-run-duration {white-space:nowrap;}

.gameplay.quests-reviewed .quest-reward {-unity-font-style:bold;}
.gameplay.quests-reviewed.quests-compact .eov-quest-instructions {display:none;}
.gameplay.quests-reviewed .eov-quest-row {max-width:600px;}
.gameplay.quests-reviewed #quest-requirements {flex-direction:row;flex-wrap:wrap;}
.gameplay.quests-reviewed .quest-requirement {flex-shrink:0;margin-top:6px;}
.gameplay.quests-reviewed .quest-title-line {flex-direction:row;align-items:center;}
.gameplay.quests-reviewed .quest-title-line .quest-name {flex-shrink:1;min-width:0;}
.gameplay.quests-reviewed .quest-title-line .button.quest-pin {width:28px;min-width:28px;height:28px;min-height:28px;padding:0;margin:0;align-items:center;justify-content:center;background-color:transparent;border-width:0;}
.gameplay.quests-reviewed .quest-title-line .button.quest-pin:hover,
.gameplay.quests-reviewed .quest-title-line .button.quest-pin:active {background-color:transparent;}
.gameplay.keyboard.quests-reviewed .quest-pin:focus {border-width:.5px;border-color:var(--text);}
.gameplay.quests-reviewed .quest-pin-mark {width:16px;height:16px;color:var(--muted);rotate:35deg;translate:-4px 0;}
.gameplay.quests-reviewed .quest-pin.active .quest-pin-mark {color:var(--text);rotate:0deg;translate:-5px 0;}
.gameplay.quests-reviewed .quest-footer {flex-direction:row;align-items:flex-start;margin-top:6px;}
.gameplay.quests-reviewed .quest-reward-content {flex-grow:1;flex-basis:0;min-width:0;}
.gameplay.quests-reviewed .quest-reward-content .quest-reward {margin-top:0;color:var(--text);}
.gameplay.quests-reviewed .quest-actions {flex-direction:row;align-items:center;flex-shrink:0;margin-left:12px;}
.gameplay.quests-reviewed .quest-title-action .quest-name {flex-grow:1;flex-basis:0;}
.gameplay.quests-reviewed .quest-requirements-line {flex-direction:row;align-items:center;}
.gameplay.quests-reviewed #quest-requirements {flex-grow:1;flex-basis:0;min-width:0;}
.gameplay.quests-reviewed .quest-actions .eov-quest-turn-in {width:auto;min-width:64px;min-height:28px;margin:0;}
/* Shared live run resources: portrait list and responsive landscape columns. */
.gameplay .run-resources-view {flex-grow:1;min-height:0;}
.gameplay .run-resources-header {align-items:flex-start;flex-shrink:0;margin-bottom:6px;}
.gameplay .run-resources-title {flex-grow:1;flex-shrink:1;min-width:0;}
.gameplay .run-resources-header .heading {margin:0;min-height:18px;min-width:0;}
.gameplay .run-resources-metadata {align-items:flex-end;flex-shrink:0;margin-left:10px;}
.gameplay .run-resources-total {align-items:center;}
.gameplay .run-resources-total > .icon {margin-right:4px;}
.gameplay .run-resources-meta-line {align-self:stretch;align-items:center;}
.gameplay .run-resources-meta-line > .icon {margin-right:4px;flex-shrink:0;}
.gameplay .run-resources-meta-line > Label {flex-grow:1;}
.gameplay .run-resources-bonus-line > .icon {translate:0 -1px;}
.gameplay .run-resources-time {flex-shrink:0;min-height:18px;-unity-text-align:middle-right;font-size:var(--body);}
.gameplay .run-resources-bonus {font-size:var(--body);color:var(--accent);flex-shrink:0;white-space:normal;-unity-text-align:middle-right;}
.gameplay #run-resource-list {flex-grow:1;min-height:0;}
.gameplay .run-resource-grid {flex-direction:row;flex-wrap:wrap;align-content:flex-start;}
.gameplay .run-resource-entry {width:100%;min-width:0;min-height:42px;align-items:center;padding:6px 0;border-bottom-width:.5px;border-bottom-color:var(--line);flex-shrink:0;}
.gameplay .run-resource-entry > .icon {margin-right:6px;}
.gameplay .run-resource-body {flex-grow:1;flex-basis:0;min-width:0;}
.gameplay .run-resource-line {align-items:flex-start;min-width:0;}
.gameplay .run-resource-name {flex-grow:1;flex-shrink:1;min-width:0;white-space:normal;margin-right:8px;}
.gameplay .run-resource-amount {flex-shrink:0;font-size:var(--body);}
.gameplay .run-resource-line .small {font-size:var(--small);white-space:normal;}
.gameplay .run-resource-return {margin-left:6px;-unity-text-align:middle-right;color:var(--muted);}
.gameplay .run-resources-rates {flex-shrink:0;margin:0;min-height:18px;white-space:normal;font-size:var(--small);}
.gameplay .run-resources-empty {width:100%;margin-top:8px;white-space:normal;}
.gameplay .run-resources-two .run-resource-entry {width:50%;padding-right:12px;}
.gameplay .run-resources-three .run-resource-entry {width:33.333%;padding-right:12px;}
.gameplay .resource-breakdown {padding:12px;}
.gameplay .resource-breakdown .run-resources-header {margin-right:28px;}
.gameplay .buff-lock-icon {position:absolute;left:50%;top:50%;translate:-50% -50%;width:18px;height:18px;color:var(--text);}
.gameplay .ability > .buff-lock-icon {width:18px;height:18px;}
.gameplay .eov-buffs-slot > .buff-lock-icon {width:20px;height:20px;}

.gameplay .meeting-npc-name {font-size:var(--body);-unity-font-style:bold;margin:0 0 4px 0;white-space:normal;color:var(--text);}

.gameplay.eov-navigation .eov-navigation-button:disabled {opacity:.4;color:var(--muted);}

/* Keep completed summaries focused on the resources gathered. */
.gameplay .summary-map {margin-left:8px;padding-left:0;max-width:45%;font-size:var(--body);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.gameplay .summary-compact {padding:12px;}
.gameplay .summary-compact .summary-facts {margin-bottom:4px;flex-wrap:wrap;justify-content:flex-start;}
.gameplay .summary-compact .summary-fact {width:auto;flex-basis:auto;flex-grow:0;flex-shrink:0;margin-right:8px;flex-direction:row;align-items:baseline;padding:2px 0;background-color:transparent;border-left-width:0;}
.gameplay .summary-compact .summary-fact-label {margin-right:4px;margin-bottom:0;}
.gameplay .summary-compact .summary-fact-value {font-size:var(--body);-unity-font-style:normal;}
.gameplay .summary-compact .summary-distance {min-height:16px;padding:0;margin-bottom:4px;}
.gameplay .summary-compact .summary-distance-label {font-size:var(--small);}
.gameplay .summary-compact .summary-distance-value {font-size:var(--small);-unity-font-style:normal;}
.gameplay .summary-compact .summary-distance-change {font-size:var(--small);}
.gameplay .summary-compact .summary-return-bonus {margin-bottom:4px;}

.gameplay .summary-kills {font-size:var(--small);margin-bottom:2px;}
.gameplay .summary-reaping-gain {align-items:center;flex-shrink:0;min-height:20px;padding-bottom:4px;margin-bottom:6px;border-bottom-width:.5px;border-bottom-color:var(--line);}
.gameplay .summary-icon-slot {position:relative;width:20px;min-width:20px;max-width:20px;height:20px;flex-shrink:0;margin-right:2px;}
.gameplay .summary-icon-slot > .icon {position:absolute;margin:0;flex-shrink:0;}
/* Match the visible edges and centres; these sprites have different transparent padding. */
.gameplay .summary-icon-kills > .icon {left:3px;top:1.5px;}
.gameplay .summary-icon-multiplier > .icon {left:5px;top:.5px;}
.gameplay .summary-icon-time > .icon {left:3px;top:2px;}
.gameplay .summary-icon-steps > .icon {left:3px;top:2px;}
.gameplay .summary-icon-deaths > .icon {left:4.75px;top:2px;}
.gameplay .summary-icon-reaps > .icon {left:2.5px;top:2.25px;}
.gameplay .summary-icon-distance > .icon {left:-1.5px;top:.25px;}
.gameplay .summary-reaping-value {font-size:var(--body);-unity-text-align:middle-left;}
.gameplay .summary-compact .summary-icon-fact {align-items:center;}
.gameplay .summary-fact-text {align-items:baseline;flex-shrink:1;min-width:0;}
.gameplay .summary-sheet.summary-landscape .summary-facts {margin-bottom:0;}
.gameplay .summary-sheet.summary-landscape .summary-fact {padding-top:0;padding-bottom:0;}
.gameplay .summary-sheet.summary-landscape .summary-reaping-gain {padding-top:0;padding-bottom:2px;}
.gameplay .summary-sheet.summary-landscape .summary-icon-distance > .icon {left:2.5px;top:2px;}
