.gameplay.conversations { position:absolute; left:0; right:0; top:0; bottom:0; }
.gameplay .conversation-stack { position:absolute; translate:-50% -50%; }
.gameplay .conversation-dialog { padding:12px; min-height:0; flex-shrink:1; }
.gameplay .conversation-dialog .scroll { flex-grow:0; flex-basis:auto; }
.gameplay .conversation-section { margin-top:8px; margin-bottom:8px; }
.gameplay .conversation-lesson-card { flex-direction:row; align-items:center; flex-shrink:0; padding:9px 12px; margin-bottom:8px; }
.gameplay .conversation-lesson-portrait { flex-shrink:0; margin-right:8px; }
.gameplay .conversation-lesson-dialogue { flex-grow:1; flex-shrink:1; min-width:0; }
.gameplay .conversation-lesson { white-space:normal; }
.gameplay .button.conversation-tutorial-close { min-height:26px; min-width:40px; }
.gameplay .conversation-choice { flex-direction:row; align-items:center; justify-content:flex-start; min-height:34px; margin-bottom:5px; white-space:normal; -unity-text-align:middle-left; padding:6px 10px; }
.gameplay .conversation-choice Label { white-space:normal; flex-shrink:1; }
.gameplay .conversation-choice .buff-lock-icon { position:relative; left:auto; top:auto; translate:0 0; width:13px; height:13px; margin-right:8px; }
.gameplay .conversation-choice.conversation-locked { opacity:.5; }
.gameplay.conversations .mildred-choices { margin-bottom:5px; }
.gameplay.conversation-compact-stack .conversation-dialog { padding:10px 12px; }
.gameplay.conversation-compact-stack .conversation-dialog .mildred-header { margin-bottom:6px; }
.gameplay.conversation-compact-stack .conversation-section { margin-top:5px; margin-bottom:6px; }
.gameplay.conversation-compact-stack .button.conversation-choice { min-height:29px; padding:4px 8px; margin-bottom:3px; }
.gameplay.conversation-compact-stack .button.mildred-choice { height:61px; }
.gameplay.conversation-compact-stack .mildred-choice .icon { max-height:37px; }
.gameplay.conversation-compact-stack .mildred-choices { margin-bottom:2px; }
.gameplay.conversation-desktop .conversation-dialog .mildred-header { margin-bottom:6px; }
.gameplay.conversation-desktop .conversation-columns.with-companions { flex-direction:row; align-items:flex-start; }
.gameplay.conversation-desktop .conversation-history { flex-grow:1; flex-shrink:1; min-width:0; }
.gameplay.conversation-desktop .conversation-companions { width:244px; flex-shrink:0; margin-left:10px; padding-left:10px; border-left-width:1px; border-left-color:var(--line); }
.gameplay.conversation-desktop .conversation-section { margin-top:3px; margin-bottom:6px; }
.gameplay.conversation-desktop .button.conversation-choice { min-height:25px; padding:3px 6px; margin-bottom:3px; }
.gameplay.conversation-desktop .button.mildred-choice { width:42px; height:52px; }
.gameplay.conversation-desktop .mildred-choice .icon { max-width:32px; max-height:31px; }
.gameplay.conversation-desktop .mildred-colour-name { font-size:9px; }
.gameplay.conversation-desktop .companion-preview-hint { margin-bottom:5px; }
