  - id: help-cauldron
    group: 2
    icon: {fileID: -6316128909204395339, guid: de898b1a9190842419c92214290725b9, type: 3}
    title:
      key: help.cauldron.title
      bold: 0
      smallCaps: 0
      fallback: Cauldron
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.cauldron.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Open <link=\"help:cauldron\"><u><color=#EFB889>Town \u2192 Cauldron</color></u></link>. Mix food into stew, then taste the stew to receive cards. Check the reward chances before tasting.\n\nResource cards increase how much of that resource you gather. Buff cards improve buffs. Card levels and resource rarity tiers are separate systems."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.cauldron.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: "A category\u2019s tier is the lowest card tier among its unlocked resources. A card you do not own counts as tier zero.\n\nResource-card and category bonuses add together, up to 70%. They apply to gathering, enemy drops and town crop harvests. They do not apply to rewards, seeds, refunds or conversions.\n\nComplete all available resource and buff collections to unlock Eternal Boons."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.cauldron.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: -6316128909204395339, guid: de898b1a9190842419c92214290725b9, type: 3}
      buff: {fileID: 0}
      caption:
