          m_KeyId: 0
          m_Key: help.buffs.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Select a buff icon to see its current effects, duration and cooldown. These values include your upgrades.\n\nOpen <link=\"help:buffs\"><u><color=#EFB889>Hub \u2192 Buffs</color></u></link> to assign buffs and manage autocasting. Complete a slot\u2019s required quest to unlock autocasting for that slot.\n\n<link=\"help:buffs\"><u><color=#EFB889>Buffs</color></u></link> end when their duration runs out or you return to town."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.buffs.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: Eva's <link="help:cauldron"><u><color=#EFB889>Cauldron</color></u></link> provides buff cards that improve power and cooldowns.
      localized:
