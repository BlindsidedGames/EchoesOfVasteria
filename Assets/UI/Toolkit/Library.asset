          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      value:
        key:
        bold: 0
        smallCaps: 0
        fallback: How often attacks occur
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.row.1.value
          m_FallbackState: 0
