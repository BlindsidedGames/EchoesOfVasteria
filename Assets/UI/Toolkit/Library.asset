%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b4113c993c57d424ab10aaaca10df887, type: 3}
  m_Name: Library
  m_EditorClassIdentifier: Assembly-CSharp::TimelessEchoes.UI.Toolkit.ToolkitBookDefinition
  presentation: 0
  sections:
  - id: help-adventures
    group: 0
    icon: {fileID: -2997195532997922311, guid: e36f7692c71d2a34383e21fe9d44dc80, type: 3}
    title:
      key: help.adventures.title
      bold: 0
      smallCaps: 0
      fallback: Adventures & Maps
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.adventures.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "<b>Start:</b> Adventure \u2192 select a map.\n\nYour character travels between tasks and gathers resources automatically. Each map has different resources.\n\n<b>Map information:</b> Statistics \u2192 General \u2192 select a map. Discovered resources are shown there. Locked maps show where to learn more."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.adventures.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: Farming tasks appear only in Farmlands. Quests and NPC encounters unlock other routes.
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.adventures.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: -2997195532997922311, guid: e36f7692c71d2a34383e21fe9d44dc80, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Farmlands
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.adventures.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Farmlands</b>

          Gather crops here. Farming tasks do not appear on other maps. Carl''s distance limit does not increase when you are reaped in Farmlands.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.adventures.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns: []
    referenceRows: []
    expanded: 0
    visibility: []
  - id: help-tasks
    group: 0
    icon: {fileID: -263682996174179970, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
    title:
      key: help.tasks.title
      bold: 0
      smallCaps: 0
      fallback: Tasks & Skills
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tasks.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Tasks award resources and skill XP.\n\n<b>Skill bonuses and unlocks:</b> Hub \u2192 Skills \u2192 select a skill.\n\n<b>Task chances:</b> Statistics \u2192 Tasks. Adjust a task's weight to change how often it appears among eligible tasks."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tasks.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Task weights do not unlock tasks or change which maps they appear on. Map, distance, and progression still apply.\n\nCombat levels unlock higher core and crystal tiers. Required levels are listed under Skills \u2192 Combat."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tasks.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: -263682996174179970, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Farming
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: "<b>Farming</b>\nHarvest crop patches in Farmlands to gain crops and Farming XP. These adventure tasks are separate from planting crops in town. Check Skills \u2192 Farming for bonuses and unlocks."
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: -5728692859750609351, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Fishing
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.1
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: "<b>Fishing</b>\nGill provides your first rod. Fishing tasks catch fish and award Fishing XP. Check Statistics \u2192 General for a map's discovered resources, and Skills \u2192 Fishing for progression."
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.1.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: -6623575528231689321, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Mining
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.2
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: "<b>Mining</b>\nMining tasks provide ores and Mining XP. Smelt ores into ingots at the Forge to craft equipment. Check Skills \u2192 Mining for ore unlock levels."
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.2.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: 3201700494366066137, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Woodcutting
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.3
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: "<b>Woodcutting</b>\nWoodcutting tasks provide wood resources and Woodcutting XP. Follow Barkley's quests to progress into the Woods. Check Skills \u2192 Woodcutting for unlocks and Statistics \u2192 Tasks to adjust eligible task chances."
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.3.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns: []
    referenceRows: []
    expanded: 0
    visibility: []
  - id: help-quests
    group: 0
    icon: {fileID: 3947923570558630869, guid: 27d08327615764bc9a976be93fb999d3, type: 3}
    title:
      key: help.quests.title
      bold: 0
      smallCaps: 0
      fallback: Quests
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.quests.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: '<b>Open:</b> Quests.


        Accept a quest, complete its requirements, then turn it in while in town. Resource hand-ins spend the requested items.


        Tracked quests appear on your HUD. Untracked quests remain in the quest list.'
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.quests.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: 'A quest can require resources, enemy kills, an NPC meeting, or a guided interaction. Meeting its requirements makes it ready to turn in; rewards are claimed at turn-in.


        Quests cannot be turned in during an adventure.'
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.quests.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: 3947923570558630869, guid: 27d08327615764bc9a976be93fb999d3, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Quest ready to turn in
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.quests.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Ready to turn in</b>

          The star marks a quest whose requirements are met. Return to town and select Turn In to claim its reward. Resource hand-ins spend the listed items.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.quests.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns: []
    referenceRows: []
    expanded: 0
    visibility: []
  - id: help-equipment
    group: 1
    icon: {fileID: -5938119891582100046, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
    title:
      key: help.equipment.title
      bold: 0
      smallCaps: 0
      fallback: Inventory & Equipment
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.equipment.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "<b>Open:</b> Hub \u2192 Inventory.\n\nSelect an equipped slot to inspect its bonuses. Total equipment bonuses combine all equipped items.\n\nCompare stat values when replacing equipment. Higher rarity does not guarantee a better item.\n\n<b>Current combat stats:</b> in-run HUD \u2192 Stats."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.equipment.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: Discovered resources appear first, followed by undiscovered resources. Each group keeps your chosen sort order.
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.equipment.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: 5064720189575774579, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Weapon
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Weapon</b>

          Crafted weapons guarantee damage. Compare the other rolled stats before replacing your current weapon.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: -5938119891582100046, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Helmet
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.1
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Helmet</b>

          Crafted helmets guarantee health. Other rolled stats can improve offense, defense, or recovery.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.1.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: 3631121382201776489, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Chest
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.2
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Chest</b>

          Crafted chest pieces guarantee defense. Defense reduces incoming damage with diminishing returns.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.2.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: -4207116279972355936, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Boots
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.3
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Boots</b>

          Crafted boots guarantee movement, which increases travel speed. Movement rolls are exclusive to this slot.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.3.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns: []
    referenceRows: []
    expanded: 0
    visibility: []
  - id: help-combat
    group: 0
    icon: {fileID: -1557160357, guid: 2d1ea1fa2e7dca4448ad7af961b8896b, type: 3}
    title:
      key: help.combat.title
      bold: 0
      smallCaps: 0
      fallback: Combat
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Your character fights enemies automatically, then returns to their task.\n\n<b>Current stats:</b> in-run HUD \u2192 Stats.\n<b>Enemy stats and kill bonuses:</b> Statistics \u2192 Enemies."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: "<b>Defense:</b> with default tuning, damage taken = incoming damage \xD7 25 \xF7 (defense + 25). Negative defense is treated as zero.\n\nRepeated kills against an enemy grant bonus damage against that enemy. Its Statistics entry shows the bonus and next milestone."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: -1557160357, guid: 2d1ea1fa2e7dca4448ad7af961b8896b, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Damage
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Damage</b>

          Determines damage dealt per hit before enemy defense and other modifiers. Attack speed controls how often you hit; critical chance and critical damage affect critical hits. View current values in the in-run Stats panel.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: 967639951, guid: 2d1ea1fa2e7dca4448ad7af961b8896b, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Defense
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.1
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Defense</b>

          Reduces incoming damage. At 25 defense you take half damage; at 75 defense you take one quarter. Defense does not prevent damage completely. The formula is in Reference.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.1.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: 134269120, guid: 2d1ea1fa2e7dca4448ad7af961b8896b, type: 3}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Health
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.2
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Health</b>

          Your character dies when health reaches zero. Equipment can increase maximum health; regeneration restores health over time. Check the health bar and current Stats during a run.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.2.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns:
    - key:
      bold: 0
      smallCaps: 0
      fallback: Stat
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.column.0
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    - key:
      bold: 0
      smallCaps: 0
      fallback: Effect
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.column.1
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    referenceRows:
