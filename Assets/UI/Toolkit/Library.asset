    body:
      key: library.5.body
      bold: 0
      smallCaps: 0
      fallback: Buffs are short-term, timed powers that expire when they run out or if you return to town.  They cost resources to activate and give you powerful bonuses for your run.
      localized:
        m_TableReference:
          m_TableCollectionName: GUID:bfa36fdea331abe4cb2b293833ff63a0
        m_TableEntryReference:
          m_KeyId: 478381752320
          m_Key: 
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    expanded: 0
    visibility:
