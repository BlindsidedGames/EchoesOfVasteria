%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b4113c993c57d424ab10aaaca10df887, type: 3}
  m_Name: Library
  m_EditorClassIdentifier: Assembly-CSharp::TimelessEchoes.UI.Toolkit.ToolkitBookDefinition
  presentation: 0
  sections:
  - id: help-adventures
    group: 0
    icon: {fileID: -2997195532997922311, guid: e36f7692c71d2a34383e21fe9d44dc80, type: 3}
    title:
      key: help.adventures.title
      bold: 0
      smallCaps: 0
      fallback: Adventures & Maps
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.adventures.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Choose <link=\"help:adventure\"><u><color=#EFB889>Adventure</color></u></link>, then a map to start a run. Your hero moves between tasks and gathers resources automatically. Each map has different resources.\n\nTo see what you\u2019ve discovered, open <link=\"help:statistics/general\"><u><color=#EFB889>Statistics \u2192 General</color></u></link> and choose a map. Locked maps show how to learn more."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.adventures.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: Farming tasks appear only in Farmlands. <link="help:quests"><u><color=#EFB889>Quests</color></u></link> and NPC encounters unlock other routes.
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.adventures.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: -2997195532997922311, guid: e36f7692c71d2a34383e21fe9d44dc80, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Farmlands
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.adventures.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Farmlands</b>

          Gather crops here. Farming tasks do not appear on other maps. Carl''s distance limit does not increase when you are reaped in Farmlands.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.adventures.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns: []
    referenceRows: []
    expanded: 0
    visibility: []
  - id: help-tasks
    group: 0
    icon: {fileID: -263682996174179970, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
    title:
      key: help.tasks.title
      bold: 0
      smallCaps: 0
      fallback: Tasks & Skills
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tasks.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Complete tasks to earn resources and skill XP.\n\nOpen <link=\"help:skills\"><u><color=#EFB889>Hub \u2192 Skills</color></u></link> and choose a skill to see its bonuses and unlocks.\n\nOpen <link=\"help:statistics/tasks\"><u><color=#EFB889>Statistics \u2192 Tasks</color></u></link> and use Boost to make a task more common within its category. Boosting also gives that category a smaller increase in how often it appears on the map."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tasks.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Boosting a task does not unlock it or change which maps it appears on. Map, distance and progression requirements still apply.\n\nCombat levels unlock higher core and crystal tiers. See <link=\"help:skills/Combat\"><u><color=#EFB889>Hub \u2192 Skills \u2192 Combat</color></u></link> for the required levels."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tasks.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: -263682996174179970, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Farming
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: "<b>Farming</b>\nHarvest crop patches in Farmlands to earn crops and Farming XP. Growing your own crops through <link=\"help:fields\"><u><color=#EFB889>Fields</color></u></link> is a separate system. See <link=\"help:skills/Farming\"><u><color=#EFB889>Hub \u2192 Skills \u2192 Farming</color></u></link> for bonuses and unlocks."
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: -5728692859750609351, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Fishing
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.1
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: "<b>Fishing</b>\nGill gives you your first rod. Fishing tasks award fish and Fishing XP.\n\nSee <link=\"help:statistics/general\"><u><color=#EFB889>Statistics \u2192 General</color></u></link> for each map\u2019s discovered resources, or <link=\"help:skills/Fishing\"><u><color=#EFB889>Hub \u2192 Skills \u2192 Fishing</color></u></link> for bonuses and unlocks."
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.1.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: -6623575528231689321, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Mining
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.2
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: "<b>Mining</b>\nMine ore to earn Mining XP. Smelt ore into ingots at the <link=\"help:forge\"><u><color=#EFB889>Forge</color></u></link>, then use them to craft equipment. See <link=\"help:skills/Mining\"><u><color=#EFB889>Hub \u2192 Skills \u2192 Mining</color></u></link> for ore unlock levels."
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.2.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: 3201700494366066137, guid: 22ed88aefbda3ed4bb433eff8c8ce8ad, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Woodcutting
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.3
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: "<b>Woodcutting</b>\nChop wood to earn Woodcutting XP. Barkley\u2019s quests lead you into the Woods.\n\nSee <link=\"help:skills/Woodcutting\"><u><color=#EFB889>Hub \u2192 Skills \u2192 Woodcutting</color></u></link> for unlocks, or <link=\"help:statistics/tasks\"><u><color=#EFB889>Statistics \u2192 Tasks</color></u></link> to boost task chances."
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.tasks.art.3.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns: []
    referenceRows: []
    expanded: 0
    visibility: []
  - id: help-quests
    group: 0
    icon: {fileID: 3947923570558630869, guid: 27d08327615764bc9a976be93fb999d3, type: 3}
    title:
      key: help.quests.title
      bold: 0
      smallCaps: 0
      fallback: Quests
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.quests.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Open <link=\"help:quests\"><u><color=#EFB889>Quests</color></u></link> to view your objectives. Complete a quest\u2019s requirements, then turn it in while in town to claim the reward. Resource hand-ins spend the listed items.\n\nPinned quests appear during a run. Other quests stay in the quest list."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.quests.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: <link="help:quests"><u><color=#EFB889>Quests</color></u></link> may ask for resources, enemy kills, an NPC meeting or a tutorial action. Meeting the requirements makes a quest ready to turn in. You receive its reward when you turn it in, which you can only do in town.
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.quests.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: 3947923570558630869, guid: 27d08327615764bc9a976be93fb999d3, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Quest ready to turn in
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.quests.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Ready to turn in</b>

          The star marks a quest whose requirements are met. Return to town and select Turn In to claim its reward. Resource hand-ins spend the listed items.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.quests.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns: []
    referenceRows: []
    expanded: 0
    visibility: []
  - id: help-equipment
    group: 1
    icon: {fileID: -5938119891582100046, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
    title:
      key: help.equipment.title
      bold: 0
      smallCaps: 0
      fallback: Inventory & Equipment
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.equipment.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Open <link=\"help:inventory\"><u><color=#EFB889>Hub \u2192 Inventory</color></u></link> to inspect your equipment and resources. Select an equipped item to see its bonuses. Your total equipment bonuses include every equipped item.\n\nCompare the stats before replacing an item: a rarer item is not always an upgrade.\n\nDuring a run, select <link=\"help:hero-stats\"><u><color=#EFB889>Stats</color></u></link> beside your health bar to see your current combat stats."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.equipment.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: Discovered resources appear before undiscovered ones. Both groups use a fixed resource order.
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.equipment.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: 5064720189575774579, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Weapon
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Weapon</b>

          Every crafted weapon has a damage stat. Compare its other stats before replacing your current weapon.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: -5938119891582100046, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Helmet
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.1
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Helmet</b>

          Every crafted helmet has a health stat. Its other stats can improve offense, defense or recovery.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.1.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: 3631121382201776489, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Chest
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.2
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Chest</b>

          Every crafted chest piece has a defense stat. More defense reduces incoming damage, with diminishing returns.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.2.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: -4207116279972355936, guid: fffb6aee16bdecb4cb3248697c59ee9f, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Boots
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.3
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Boots</b>

          Every crafted pair of boots has a movement stat, which increases travel speed. Only boots can roll movement.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.equipment.art.3.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns: []
    referenceRows: []
    expanded: 0
    visibility: []
  - id: help-combat
    group: 0
    icon: {fileID: -1557160357, guid: 2d1ea1fa2e7dca4448ad7af961b8896b, type: 3}
    title:
      key: help.combat.title
      bold: 0
      smallCaps: 0
      fallback: Combat
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Your hero fights enemies automatically, then returns to their task.\n\nSelect <link=\"help:hero-stats\"><u><color=#EFB889>Stats</color></u></link> beside your health bar during a run to see your current stats. Open <link=\"help:statistics/enemies\"><u><color=#EFB889>Statistics \u2192 Enemies</color></u></link> to see enemy stats and your kill bonuses."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Damage taken = incoming damage \xD7 {0:0.##} \xF7 (defense + {0:0.##}). Defense below zero counts as zero.\n\nRepeated kills of the same enemy unlock bonus damage against it. See <link=\"help:statistics/enemies\"><u><color=#EFB889>Statistics \u2192 Enemies</color></u></link> for your current bonus and next milestone."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.details
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    illustrations:
    - sprite: {fileID: -1557160357, guid: 2d1ea1fa2e7dca4448ad7af961b8896b, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Damage
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Damage</b>

          Damage per hit, before enemy defense and other modifiers. Attack speed determines how often you hit. Critical chance determines how often you land a critical hit; critical damage determines its strength.


          Select <link="help:hero-stats"><u><color=#EFB889>Stats</color></u></link> beside your health bar during a run to see your current values.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.0.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: 967639951, guid: 2d1ea1fa2e7dca4448ad7af961b8896b, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Defense
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.1
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Defense</b>

          Reduces incoming damage. At {0:0.##} defense you take half damage; at {1:0.##} defense you take one quarter. Defense does not prevent damage completely. See <link="help:reference"><u><color=#EFB889>Reference</color></u></link> for the formula.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.1.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    - sprite: {fileID: 134269120, guid: 2d1ea1fa2e7dca4448ad7af961b8896b, type: 3}
      buff: {fileID: 0}
      caption:
        key:
        bold: 0
        smallCaps: 0
        fallback: Health
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.2
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b>Health</b>

          Your hero dies when health reaches zero. Equipment can increase maximum health, and regeneration restores health over time.


          Select <link="help:hero-stats"><u><color=#EFB889>Stats</color></u></link> beside your health bar during a run for your current values.'
        localized:
          m_TableReference:
            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.combat.art.2.description
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
    referenceColumns:
    - key:
      bold: 0
      smallCaps: 0
      fallback: Stat
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.column.0
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    - key:
      bold: 0
      smallCaps: 0
      fallback: Effect
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.combat.column.1
        m_FallbackState: 0
        m_WaitForCompletion: 0
