            m_TableCollectionName: Wiki
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: help.cauldron.art.0
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
      description:
        key:
        bold: 0
        smallCaps: 0
        fallback: '<b><link="help:cauldron"><u><color=#EFB889>Cauldron</color></u></link></b>

          Choose food and how much to mix into stew. Taste the stew to receive cards, using the displayed reward chances. Resource cards increase gathering yield; buff cards improve buffs.


          See <link="help:reference"><u><color=#EFB889>Reference</color></u></link> for resource-card and category thresholds.'
        localized:
