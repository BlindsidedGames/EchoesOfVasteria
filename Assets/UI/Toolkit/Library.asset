  - id: help-fields
    group: 1
    icon: {fileID: -1319403273844478748, guid: 9cb02e74c571af045af4e6f90876850b, type: 3}
    title:
      key: help.fields.title
      bold: 0
      smallCaps: 0
      fallback: "Fields"
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.fields.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key: help.fields.body
      bold: 0
      smallCaps: 0
      fallback: "Meet Flora and Tillman in Farmlands, then open <link=\"help:fields\"><u><color=#EFB889>Town → Fields</color></u></link> to build your first plots. Expand them as your Fields level and resources allow.\n\nPlant crops with matching seed packs and trees with matching saplings. Each planting uses one pack or sapling.\n\nHarvests give crops, fruit or timber and Fields XP. Higher Fields levels increase yields and shorten growth times. Your gathering skills determine which crops and trees you can plant."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.fields.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key: help.fields.details
      bold: 0
      smallCaps: 0
      fallback: "<b>Seed packs</b>\nEach matching crop task completed by your hero or an Echo has a 7% chance to give one seed pack. Resource bonuses do not increase seed drops. Fields harvests do not return seeds.\n\n<b>Watering</b>\nWatering halves growth time.\n\n<b>Automation</b>\nAt Fields level 20, Auto harvests and replants while you have matching seeds or saplings. At level 50, new plantings are watered automatically.\n\n<b>Timber trees</b>\nChop at medium size, or choose Keep growing for twice the resources and XP over twice the total growth time. Auto waits for full size before chopping.\n\n<b>Growth</b>\nFields grow during adventures and while you are in town. Growth stops while the game is closed."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
