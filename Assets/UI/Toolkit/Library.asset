  - id: help-tiers
    group: 1
    icon: {fileID: 511531087981754570, guid: 1dc8e874f9facc24fa08bd9484c90178, type: 3}
    title:
      key: help.tiers.title
      bold: 0
      smallCaps: 0
      fallback: Resource Tiers
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tiers.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: "Gathering can raise a resource\u2019s rarity tier, permanently increasing how much of it you collect.\n\nTown crop harvests receive your current tier bonus but cannot raise the tier.\n\nSeed packs do not gain rarity tiers or rarity bonuses.\n\nResource tiers, equipment rarity and <link=\"help:cauldron\"><u><color=#EFB889>Cauldron</color></u></link> card levels are separate systems."
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tiers.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: Resources start at Tier 1. Each upgrade chance applies when you collect an eligible resource at the previous tier.
      localized:
        m_TableReference:
