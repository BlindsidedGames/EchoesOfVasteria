      quest: {fileID: 11400000, guid: 18cb43a77b364b24fb75a31ff790efc5, type: 2}
      npcId: 
  - id: chapter-6
    title:
      key: library.6.title
      bold: 1
      smallCaps: 1
      fallback: 'Combat

'
      localized:
        m_TableReference:
          m_TableCollectionName: 
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: 
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key: library.6.body
      bold: 0
      smallCaps: 0
      fallback: 'Caleb will enter combat automatically, and only engage enemies who get in the way! Tasks first fun later.


        You may notice floating damage numbers EG. <color=#C69B60>4.27<font-weight=400></font-weight><size=80%><color=#60C560> +1.45<font-weight=400></font-weight></color></size><size=70%> -0.10<font-weight=400></font-weight></color></size>

        The first is your base damage, the second is your bonus damage and the last one is the reduction from enemy defense.


        Reaching your 10th, 100th, 1,000th, and 10,000th kill against a specific enemy will grant you 25% bonus damage against that specific enemy. This is where the majority of the green damage you see comes from.'
      localized:
        m_TableReference:
          m_TableCollectionName: GUID:bfa36fdea331abe4cb2b293833ff63a0
        m_TableEntryReference:
          m_KeyId: 492340396032
          m_Key: 
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    expanded: 0
    visibility: []
  - id: chapter-7
    title:
      key: library.7.title
      bold: 1
      smallCaps: 1
      fallback: Reaping
      localized:
        m_TableReference:
          m_TableCollectionName: 
