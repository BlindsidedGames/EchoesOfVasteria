  - id: help-tiers
    group: 1
    icon: {fileID: 511531087981754570, guid: 1dc8e874f9facc24fa08bd9484c90178, type: 3}
    title:
      key: help.tiers.title
      bold: 0
      smallCaps: 0
      fallback: Resource Tiers
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tiers.title
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    body:
      key:
      bold: 0
      smallCaps: 0
      fallback: 'Gathering can raise a resource''s rarity tier. Higher tiers permanently increase future yield for that resource.


        Town crop harvests use your current tier bonus but do not roll upgrades.


        Resource tiers, equipment rarity, and Cauldron card levels are separate systems.'
      localized:
        m_TableReference:
          m_TableCollectionName: Wiki
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: help.tiers.body
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
    details:
      key:
      bold: 0
      smallCaps: 0
      fallback: Upgrade chances are per eligible collection at the previous tier. Tier 1 is the starting tier.
